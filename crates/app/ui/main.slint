// SPDX-License-Identifier: GPL-3.0-only
// 界面 chrome 配色：由 Rust 侧按当前主题写入。
export struct ThemeColors {
    bg: color,
    surface: color,
    raise: color,
    hover: color,
    border: color,
    text: color,
    subtext: color,
    muted: color,
    accent: color,
    accent-text: color,
    danger: color,
}

// 默认值 = Tokyo Night（与 core::Theme 的默认主题保持一致）。
export global Palette {
    in-out property <ThemeColors> colors: {
        bg: #1a1b26,
        surface: #16161e,
        raise: #24283b,
        hover: #292e42,
        border: #3b4261,
        text: #c0caf5,
        subtext: #a9b1d6,
        muted: #565f89,
        accent: #7aa2f7,
        accent-text: #1a1b26,
        danger: #f7768e,
    };
}

export struct ThemeChoice {
    id: string,
    label: string,
}

/// 设置 → Hotkeys 的一行：命令标题 + 当前生效 chord + 状态。
export struct HotkeyRow {
    command: string,
    title: string,
    chord: string,
    /// 有用户 override（不再是默认绑定）
    custom: bool,
    /// 当前生效 chord 与其他命令冲突
    conflict: bool,
}

export struct DividerView {
    index: int,
    x: length,
    y: length,
    w: length,
    h: length,
    /// true = 左右分屏（竖线，拖 x）；false = 上下分屏（横线，拖 y）
    vertical: bool,
}

export struct PaneView {
    id: int,
    image: image,
    x: length,
    y: length,
    w: length,
    h: length,
    focused: bool,
    iw: length,
    ih: length,
    /// 终端启用了鼠标上报（1000/1002/1003）：中键/右键/滚轮要转发给 PTY。
    mouse-reporting: bool,
}

export struct TabView {
    title: string,
    active: bool,
    /// OSC 9;4 状态：0=清除 1=进行中 2=错误 3=不确定 4=暂停
    progress-state: int,
    /// 进度条比例 0.0..=1.0（不确定进度由 Rust 侧给固定比例）
    progress-ratio: float,
    /// 百分比文本（如 "42%"）；无合法百分比时为空
    progress-label: string,
    /// 未读通知点
    attention: bool,
    /// 刚完成（进度从有到清除）的完成标记
    completed: bool,
}

/// Profiles 面板的一行：过滤/星标都在 Rust 侧算好，UI 只负责画。
export struct ProfileRow {
    /// Profile 稳定 ID（调试/未来扩展用）
    id: int,
    /// 形如 `[local] work`
    label: string,
    /// 是否为“新 Tab 默认 Profile”（行首星标）
    is-default: bool,
}

component MenuRow inherits Rectangle {
    in property <string> label;
    callback picked();

    height: 28px;
    border-radius: 4px;
    background: hit.has-hover ? Palette.colors.hover : transparent;

    hit := TouchArea {
        clicked => { root.picked(); }
    }

    Text {
        x: 10px;
        text: root.label;
        color: Palette.colors.text;
        font-size: 12px;
        vertical-alignment: center;
        width: parent.width - 12px;
    }
}

component MiniBtn inherits Rectangle {
    in property <string> label;
    callback clicked();

    width: 26px;
    height: 26px;
    border-radius: 6px;
    background: hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
    border-width: 1px;
    border-color: Palette.colors.border;

    hit := TouchArea {
        clicked => { root.clicked(); }
    }
    Text {
        text: root.label;
        color: Palette.colors.text;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

// 设置页里的动作按钮（Vault 等）
component ActionBtn inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    in property <length> font-size: 11px;
    callback clicked();

    height: 26px;
    border-radius: 6px;
    background: hit.has-hover
        ? (root.danger ? Palette.colors.danger : Palette.colors.hover)
        : Palette.colors.raise;
    border-width: 1px;
    border-color: root.danger ? Palette.colors.danger : Palette.colors.border;

    hit := TouchArea {
        clicked => { root.clicked(); }
    }
    Text {
        text: root.label;
        color: root.danger && hit.has-hover ? Palette.colors.accent-text : Palette.colors.text;
        font-size: root.font-size;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
        overflow: elide;
    }
}

component FormRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> text;
    /// true = 密码输入（Slint 负责 masked 显示）
    in property <bool> masked: false;
    spacing: 8px;

    Text {
        width: 64px;
        text: root.label;
        color: Palette.colors.subtext;
        font-size: 12px;
        vertical-alignment: center;
    }
    Rectangle {
        height: 26px;
        horizontal-stretch: 1;
        border-radius: 4px;
        background: Palette.colors.bg;
        border-width: 1px;
        border-color: Palette.colors.border;

        TextInput {
            x: 6px;
            width: parent.width - 12px;
            height: parent.height;
            text <=> root.text;
            single-line: true;
            input-type: root.masked ? InputType.password : InputType.text;
            color: Palette.colors.text;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

// 设置面板里的开关行
component ToggleRow inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback toggled();

    height: 26px;

    Text {
        x: 0px;
        width: parent.width - 56px;
        text: root.label;
        color: Palette.colors.text;
        font-size: 12px;
        vertical-alignment: center;
    }

    Rectangle {
        x: parent.width - 44px;
        y: 4px;
        width: 40px;
        height: 18px;
        border-radius: 9px;
        background: root.on ? Palette.colors.accent : Palette.colors.hover;

        Rectangle {
            x: root.on ? parent.width - 16px : 2px;
            y: 2px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: Palette.colors.bg;
        }

        TouchArea {
            clicked => { root.toggled(); }
        }
    }
}

/// 设置页的透明度滑块：0.2–1.0。拖动时 preview（不落盘），松手 changed（保存）。
component OpacitySlider inherits Rectangle {
    in-out property <float> value: 1.0;
    callback preview(float);
    callback changed(float);

    height: 22px;
    background: transparent;

    // 轨道左右各留 4px，滑块圆心也限制在轨道内。
    Rectangle {
        x: 4px;
        y: (parent.height - 4px) / 2;
        width: parent.width - 8px;
        height: 4px;
        border-radius: 2px;
        background: Palette.colors.border;
    }

    Rectangle {
        x: 4px;
        y: (parent.height - 4px) / 2;
        width: (parent.width - 8px) * Math.max(0.0, Math.min(1.0, (root.value - 0.2) / 0.8));
        height: 4px;
        border-radius: 2px;
        background: Palette.colors.accent;
    }

    Rectangle {
        x: 4px + (parent.width - 8px) * Math.max(0.0, Math.min(1.0, (root.value - 0.2) / 0.8)) - 6px;
        y: (parent.height - 12px) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Palette.colors.text;
        border-width: 1px;
        border-color: Palette.colors.bg;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down || event.kind == PointerEventKind.move) {
                // length 需除以 1px 转成普通数字再算比例。
                let track = (self.width - 8px) / 1px;
                let x = (self.mouse-x - 4px) / 1px;
                let t = track <= 0.0 ? 0.0 : Math.max(0.0, Math.min(1.0, x / track));
                // 不直接写 root.value：父级用绑定把 main.background-opacity 流回来，
                // 直接赋值会打断绑定导致外部（Rust）更新滑块时不同步。
                root.preview(0.2 + t * 0.8);
                return EventResult.accept;
            }
            if (event.kind == PointerEventKind.up) {
                root.changed(root.value);
                return EventResult.accept;
            }
            EventResult.reject
        }
    }
}

component ChoiceBtn inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <length> font-size: 12px;
    callback clicked();

    width: 76px;
    height: 26px;
    border-radius: 6px;
    background: root.active ? Palette.colors.accent : (hit.has-hover ? Palette.colors.hover : Palette.colors.raise);
    border-width: 1px;
    border-color: root.active ? Palette.colors.accent : Palette.colors.border;

    hit := TouchArea {
        clicked => { root.clicked(); }
    }
    Text {
        text: root.label;
        color: root.active ? Palette.colors.accent-text : Palette.colors.text;
        font-size: root.font-size;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
        overflow: elide;
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: 30px;
    border-radius: 6px;
    background: root.active ? Palette.colors.accent : (hit.has-hover ? Palette.colors.hover : transparent);

    hit := TouchArea {
        clicked => { root.clicked(); }
    }
    Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.label;
        color: root.active ? Palette.colors.accent-text : Palette.colors.text;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }
}

component ResizeHandle inherits TouchArea {
    in property <int> direction: 0;
    callback begin(int);
    callback drag();
    callback stop();

    pointer-event(event) => {
        if (event.kind == PointerEventKind.down) {
            // 只允许左键发起窗口缩放；右键在窗口边缘不做任何事。
            if (event.button != PointerEventButton.left) {
                return EventResult.reject;
            }
            root.begin(root.direction);
            return EventResult.accept;
        }
        if (event.kind == PointerEventKind.move && self.pressed) {
            root.drag();
            return EventResult.accept;
        }
        if (event.kind == PointerEventKind.up) {
            root.stop();
            return EventResult.accept;
        }
        EventResult.reject
    }
}

export component MainWindow inherits Window {
    in property <[PaneView]> panes;
    in property <[DividerView]> dividers;
    in property <[TabView]> tabs;
    in property <length> tabbar-height: 32px;
    in-out property <bool> menu-open: false;
    in property <length> menu-x: 0px;
    in property <length> menu-y: 0px;
    in property <int> menu-pane: -1;

    callback key-input(string, bool, bool, bool);
    // 右键事件到达 UI 层的追踪（日志排查用）
    callback input-trace(string, int, length, length);
    /// 拖动分屏分隔条：index + 内容区坐标
    callback divider-dragged(int, length, length);
    /// 无边框窗口拖边缩放：0=左上 1=上 2=右上 3=右 4=右下 5=下 6=左下 7=左
    callback start-window-resize(int);
    callback window-resize-drag();
    callback end-window-resize();
    /// IME 上屏（无修饰键语义），与物理按键分开，避免中文触发 Ctrl 快捷键。
    callback ime-commit(string);
    callback pane-clicked(int);
    callback pane-right-clicked(int, length, length);
    callback pane-right-up(int, length, length);
    callback pane-middle-click(int);
    /// 菜单被点外部关闭（便于自动化验证）
    callback menu-dismissed();
    /// 由分隔线/边缘等非 pane 控件发起：按内容区坐标找最近的 pane 开菜单
    callback pane-right-clicked-at(length, length);
    callback menu-action(int, int);
    callback pane-mouse-down(int, length, length, int, int);
    callback pane-mouse-move(int, length, length, int, int);
    callback pane-mouse-up(int, length, length, int, int);
    callback pane-scrolled(int, length, length, length, int);
    callback tab-clicked(int);
    callback tab-closed(int);
    callback new-tab();
    // “+” 下拉：默认新 Tab + 各 Profile
    in-out property <bool> profilemenu-open: false;
    in-out property <length> profilemenu-x: 0px;
    in property <[string]> profilemenu-items: [];
    callback profilemenu-menu();
    callback profilemenu-pick(int);
    callback profilemenu-manage();
    callback resized(length, length);
    callback close-window();
    callback minimize-window();
    callback toggle-maximize();
    callback set-theme(string);
    callback tabbar-context(length, length);
    callback tabbar-menu-action(int);
    in-out property <bool> tabmenu-open: false;
    in-out property <length> tabmenu-x: 0px;
    in-out property <length> tabmenu-y: 32px;
    // 关闭确认弹窗
    in-out property <bool> confirm-open: false;
    in-out property <string> confirm-text: "";
    callback confirm-accept();
    callback confirm-cancel();
    // Tab 重命名：内联输入框（Enter 提交 / Esc 取消）
    in-out property <bool> rename-open: false;
    in-out property <string> rename-text: "";
    in-out property <int> rename-index: -1;
    callback tab-rename(int);
    callback rename-committed(int, string);
    callback rename-cancelled();
    // 设置项开关状态（由 Rust 侧从 Config 下发）
    in-out property <bool> cfg-copy-on-select: true;
    in-out property <bool> cfg-confirm-close: true;
    in-out property <bool> cfg-confirm-paste: true;
    in-out property <string> cfg-right-click: "menu";
    in-out property <bool> cfg-paste-middle: true;
    in-out property <bool> cfg-desktop-notifications: true;
    in-out property <bool> cfg-quake: false;
    in-out property <bool> broadcast: false;
    callback toggle-copy-on-select();
    callback toggle-confirm-close();
    callback toggle-confirm-paste();
    callback set-right-click(string);
    callback toggle-paste-middle();
    callback toggle-desktop-notifications();
    callback toggle-quake();
    // 多行粘贴确认
    in-out property <bool> paste-open: false;
    in-out property <string> paste-preview: "";
    in-out property <int> paste-lines: 0;
    callback paste-accept();
    callback paste-always();
    callback paste-cancel();
    callback settings-toggled(bool);
    // Profiles（连接配置）
    in-out property <bool> profiles-open: false;
    in property <[ProfileRow]> profile-items: [];
    /// 搜索框内容：输入即按 name/host/kind 过滤；清空恢复全部。
    in-out property <string> profile-query: "";
    /// 面板底部提示：新 Tab 默认使用的 Profile（或系统 shell）。
    in property <string> profile-default-info: "";
    callback profile-open(int);
    callback profile-new();
    callback profile-delete(int);
    callback profile-set-default(int);
    callback profile-duplicate(int);
    callback profile-filter(string);
    callback profiles-close();
    // Profile 表单（新建）
    in-out property <bool> profile-form-open: false;
    in-out property <string> form-name: "";
    /// 0=local 1=ssh 2=serial 3=telnet
    in-out property <int> form-kind: 0;
    in-out property <string> form-shell: "";
    in-out property <string> form-args: "";
    in-out property <string> form-cwd: "";
    in-out property <string> form-host: "";
    in-out property <string> form-port: "";
    in-out property <string> form-user: "";
    in-out property <string> form-auth: "";
    in-out property <string> form-key: "";
    /// 仅 auth=password 时使用；不回填已有密码，空 = 保留 Vault 原值。
    in-out property <string> form-password: "";
    in-out property <bool> form-save-password: false;
    in-out property <string> form-extra: "";
    in-out property <string> form-forwards: "";
    /// -1 = 新建；>0 = 正在编辑的 Profile ID
    in-out property <int> form-edit-id: -1;
    callback profile-edit(int);
    in-out property <string> form-serial-port: "";
    in-out property <string> form-baud: "";
    in-out property <string> form-error: "";
    callback profile-form-save();
    callback profile-form-cancel();
    // SFTP 面板
    in-out property <bool> sftp-open: false;
    in property <[string]> sftp-profiles: [];
    in property <[string]> sftp-items: [];
    in-out property <int> sftp-profile: 0;
    in-out property <string> sftp-remote: "/";
    in-out property <string> sftp-local: "/tmp/tervo-sftp";
    in-out property <string> sftp-target: "";
    in-out property <int> sftp-selected: -1;
    in-out property <string> sftp-status: "";
    // 传输进行中：显示当前文件 + 进度（-1 = 不确定）+ Cancel；操作按钮暂时禁用。
    in-out property <bool> sftp-transfer-active: false;
    in property <string> sftp-transfer-name: "";
    in property <int> sftp-transfer-percent: -1;
    in property <string> sftp-transfer-detail: "";
    callback sftp-list();
    callback sftp-pick(int);
    callback sftp-download();
    callback sftp-upload();
    callback sftp-mkdir();
    callback sftp-rename();
    callback sftp-delete();
    callback sftp-cancel();
    callback sftp-close();
    // Port Forwards 面板
    in-out property <bool> fwd-open: false;
    in property <[string]> fwd-profiles: [];
    in property <[string]> fwd-items: [];
    in-out property <int> fwd-profile: 0;
    in-out property <string> fwd-new: "";
    in-out property <string> fwd-status: "";
    callback fwd-select(int);
    callback fwd-add();
    callback fwd-delete(int);
    callback fwd-close();
    // 后台会话列表
    in-out property <bool> bg-open: false;
    in property <[string]> background-items: [];
    callback bg-reattach(int);
    callback bg-close();
    // Command Palette
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query: "";
    in property <[string]> palette-items: [];
    in-out property <int> palette-selected: 0;
    // Tab 搜索（Chrome 风格，最左侧按钮）
    in-out property <bool> tabsearch-open: false;
    in-out property <string> tabsearch-query: "";
    in property <[string]> tabsearch-items: [];
    in-out property <int> tabsearch-selected: 0;
    callback tabsearch-open-requested();
    callback tabsearch-query-changed(string);
    callback tabsearch-move(int);
    callback tabsearch-accept();
    callback tabsearch-cancel();
    callback tabsearch-pick(int);
    callback palette-query-changed(string);
    callback palette-move(int);
    callback palette-accept();
    callback palette-cancel();
    callback palette-pick(int);
    // Tab 拖拽排序：按下记起点，抬起按 x 落位
    property <int> drag-tab: -1;
    property <length> drag-x: 0px;
    property <length> drag-start: 0px;
    callback tab-reorder(int, length, length);
    // 单个 Tab 的右键菜单（窗口坐标）
    in-out property <bool> tabctx-open: false;
    in-out property <length> tabctx-x: 0px;
    in-out property <int> tabctx-index: -1;
    callback tab-context(int, length);
    callback tab-menu-action(int, int);
    /// 绑定到 Window 内置的 always-on-top
    property <bool> pinned: false;
    callback bump-font-size(int);
    callback bump-scrollback(int);
    in-out property <bool> settings-open: false;
    in property <string> theme-name: "auto";
    /// Auto 主题当前解析到的主题短名（如 "Yaru Dark"）；非 auto 时为空。
    in property <string> auto-resolved: "";
    in property <[ThemeChoice]> theme-choices: [];
    /// 窗口底层背景图。Rust 侧只在路径校验/解码成功后置 has-background-image。
    in property <image> background-image;
    in property <bool> has-background-image: false;
    in-out property <string> background-image-path: "";
    in property <string> background-image-error: "";
    /// 终端默认背景不透明度（0.2–1.0）；实际 alpha 由 Rust 渲染器写入像素。
    in-out property <float> background-opacity: 1.0;
    callback background-image-changed(string);
    callback background-opacity-preview(float);
    callback background-opacity-changed(float);
    /// 设置面板高度：主题数量变多时由 Rust 侧按行数下发。
    /// 设置分类：0=Appearance 1=Terminal 2=Window 3=Config 4=Hotkeys 5=Plugins 6=Vault
    in-out property <int> settings-category: 0;
    in-out property <string> settings-path: "";
    in-out property <string> settings-query: "";
    in property <[string]> settings-results: [];
    callback settings-filter(string);
    callback settings-open-result(int);
    callback settings-category-changed(int);
    in property <string> hotkey-summary: "";
    in property <[HotkeyRow]> hotkey-rows: [];
    /// 正在录制的行下标；-1 = 未录制
    in-out property <int> hotkey-recording-row: -1;
    in property <int> hotkey-conflict-count: 0;
    in-out property <string> hotkey-error: "";
    in-out property <string> hotkey-status: "";
    callback hotkey-start-edit(int);
    callback hotkey-cancel-edit();
    callback hotkey-reset(int);
    callback hotkey-reset-all();
    in property <[string]> plugin-items: [];
    in property <string> plugin-summary: "";
    in property <string> plugin-dir: "";
    // 最近插件命令/事件活动（新→旧，最多 8 条；只读展示）
    in property <[string]> plugin-activity-items: [];
    in-out property <string> config-status: "";
    // Vault（加密凭据）
    in-out property <string> vault-status: "";
    in-out property <string> vault-path: "";
    in-out property <int> vault-entries: 0;
    in-out property <string> vault-password: "";
    in-out property <string> vault-error: "";
    in-out property <string> vault-notice: "";
    callback vault-set-master();
    callback vault-unlock();
    callback vault-lock();
    callback vault-clear();
    callback config-import-tabby();
    callback config-export-tabby();
    callback settings-open-path();
    /// 录制结束/关闭设置后把键盘焦点还给终端 IME 宿主，否则按键会丢失。
    public function focus-terminal() {
        ime.focus();
    }
    in property <int> font-size: 15;
    in property <int> scrollback: 2000;
    in-out property <bool> search-open: false;
    in-out property <string> search-query: "";
    in property <string> search-status: "";
    /// IME 候选窗锚点：聚焦 pane 光标的像素位置（内容区坐标，由 Rust 侧更新）。
    in-out property <length> ime-x: 0px;
    in-out property <length> ime-y: 0px;

    /// 窗口标题：CLI --title 覆盖；默认保持原品牌名。
    in-out property <string> window-title: "Tervo";

    title: root.window-title;
    // 不让内容（长 Tab 标题/很多 Tab）决定窗口最小宽度：否则加 Tab 会把窗口撑大。
    min-width: 240px;
    min-height: 160px;
    background: Palette.colors.surface;
    no-frame: true;
    always-on-top: root.pinned;
    icon: @image-url("../../../assets/icon.png");

    changed width => { root.resized(root.width, root.height); }
    changed height => { root.resized(root.width, root.height); }

    // TabBar 位置可切（上/下）：用绝对定位而不是 VerticalLayout，
    // 否则元素的布局顺序没法在运行时反转。
    in-out property <bool> tabbar-bottom: false;
    // Tab 自动收缩：把扣除左侧搜索/品牌、+、Profile、窗口按钮后的宽度均分给 Tab。
    // 40px 是可用下限（标题 elide、close 仅在 hover/宽度足够时显示）；再窄就滚动。
    property <length> tab-width-cap: Math.max(40px, Math.min(180px,
        (root.width - 266px - 4px * root.tabs.length) / Math.max(1, root.tabs.length)));

    Rectangle {
        width: 100%;
        height: 100%;

        // 窗口最底层：背景图铺满并保持比例裁切（cover）。TabBar/设置面板
        // 仍是不透明的，终端默认背景的不透明度由 Rust 写进帧 alpha。
        Image {
            visible: root.has-background-image;
            width: 100%;
            height: 100%;
            source: root.background-image;
            image-fit: cover;
        }

        // ---------------- 标签栏 ----------------
        Rectangle {
            y: root.tabbar-bottom ? root.height - root.tabbar-height : 0px;
            width: 100%;
            height: root.tabbar-height;
            clip: true;
            // 极轻的上下渐变 + 顶部高光，避免整条纯色的“塑料感”
            background: @linear-gradient(180deg, Palette.colors.surface 0%, Palette.colors.bg 100%);
            horizontal-stretch: 0;

            Rectangle {
                y: 0px;
                width: 100%;
                height: 1px;
                background: #ffffff0d;
            }

            // 底部分隔线
            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Palette.colors.border;
            }

            // 品牌图标
            Image {
                x: 32px;
                y: 6px;
                width: 18px;
                height: 18px;
                source: @image-url("../../../assets/icon-small.png");
                image-fit: contain;
            }

            // 没有原生标题栏：整条标签栏空白处可拖动窗口
            WindowMoveArea {
                width: 100%;
                height: 100%;

                // 双击标题栏 = 最大化 / 还原；右键 = 标签栏菜单（置顶等）
                title-hit := TouchArea {
                    width: 100%;
                    height: 100%;
                    double-clicked => { root.toggle-maximize(); }
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                            root.tabbar-context(
                                title-hit.mouse-x,
                                // 菜单贴在 TabBar 所在的那一侧
                                root.tabbar-bottom ? root.height - root.tabbar-height - 366px : root.tabbar-height,
                            );
                            return EventResult.accept;
                        }
                        EventResult.reject
                    }
                }
            }

            // Tab 条放进 Flickable：视口固定，内容再宽也不会把窗口的 preferred/min 宽度撑大
            Flickable {
                x: 0px;
                y: 0px;
                width: parent.width - 204px;
                height: parent.height;
                interactive: true;
                content-width: tab-strip.preferred-width;
                content-height: parent.height;

                tab-strip := HorizontalLayout {
                padding-left: 58px;
                padding-right: 0px;
                padding-top: 4px;
                spacing: 4px;
                alignment: start;

                for tab[i] in root.tabs : Rectangle {
                    property <bool> show-status: tab.attention || tab.completed
                        || tab.progress-state == 2 || tab.progress-label != "";
                    property <bool> show-close: tab-hit.has-hover || parent.width >= 68px;
                    height: 22px;
                    // 自动收缩：少量 Tab 按标题宽度，多 Tab 均分可用宽度；40px 下限后滚动。
                    width: Math.max(40px, Math.min(root.tab-width-cap, tab-area.preferred-width + 36px));
                    animate width { duration: 120ms; easing: ease-out; }
                    border-radius: 6px;
                    background: tab.active
                        ? Palette.colors.bg
                        : (tab-hit.has-hover ? Palette.colors.raise : transparent);
                    border-width: 1px;
                    border-color: tab.active ? Palette.colors.border : transparent;

                    // 激活态底部的强调线（Yaru 橙 / 主题 accent）
                    Rectangle {
                        visible: tab.active;
                        x: 8px;
                        y: parent.height - 2px;
                        width: parent.width - 16px;
                        height: 2px;
                        border-radius: 1px;
                        background: Palette.colors.accent;
                    }

                    // 进度条：盖在强调线上；错误红、暂停灰、进行中/不确定用 accent。
                    Rectangle {
                        visible: tab.progress-state == 1 || tab.progress-state == 2
                            || tab.progress-state == 3 || tab.progress-state == 4;
                        x: 8px;
                        y: parent.height - 2px;
                        width: parent.width - 16px;
                        height: 2px;
                        border-radius: 1px;
                        background: transparent;

                        Rectangle {
                            width: parent.width * tab.progress-ratio;
                            height: 100%;
                            border-radius: 1px;
                            background: tab.progress-state == 2
                                ? Palette.colors.danger
                                : (tab.progress-state == 4 ? Palette.colors.muted : Palette.colors.accent);
                        }
                    }

                    // 未读通知点（Tab 非活动时由 Rust 置位，切到该 Tab 清除）
                    Text {
                        visible: tab.attention;
                        x: parent.width - 44px;
                        y: 0px;
                        width: 18px;
                        height: 22px;
                        text: "●";
                        color: Palette.colors.accent;
                        font-size: 9px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // 错误标记
                    Text {
                        visible: !tab.attention && tab.progress-state == 2;
                        x: parent.width - 44px;
                        y: 0px;
                        width: 18px;
                        height: 22px;
                        text: "!";
                        color: Palette.colors.danger;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // 完成标记（进度从有到清除；切 Tab 时清除）
                    Text {
                        visible: !tab.attention && tab.progress-state == 0 && tab.completed;
                        x: parent.width - 44px;
                        y: 0px;
                        width: 18px;
                        height: 22px;
                        text: "✓";
                        color: Palette.colors.accent;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // 百分比文本（有合法 percent 时）
                    Text {
                        visible: !tab.attention && tab.progress-state != 2
                            && !tab.completed && tab.progress-label != "";
                        x: parent.width - 48px;
                        y: 0px;
                        width: 24px;
                        height: 22px;
                        text: tab.progress-label;
                        color: Palette.colors.muted;
                        font-size: 9px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }

                    tab-area := Text {
                        x: 8px;
                        width: parent.width - (show-close ? 34px : 16px) - (show-status ? 22px : 0px);
                        text: tab.title;
                        color: tab.active ? Palette.colors.text : Palette.colors.muted;
                        font-size: 12px;
                        font-weight: tab.active ? 600 : 400;
                        overflow: elide;
                        vertical-alignment: center;
                    }

                    tab-hit := TouchArea {
                        clicked => {
                            root.tabctx-open = false;
                            root.tab-clicked(i);
                        }
                        double-clicked => {
                            root.tab-rename(i);
                        }
                        pointer-event(event) => {
                            // 左键拖动：记起点，抬起时把落点交给 Rust 算
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                root.drag-tab = i;
                                root.drag-x = self.mouse-x + parent.x;
                                root.drag-start = root.drag-x;
                                return EventResult.reject;   // 不抢按下，否则 clicked/双击会被吞
                            }
                            if (event.kind == PointerEventKind.move && root.drag-tab == i) {
                                root.drag-x = self.mouse-x + parent.x;
                                return EventResult.accept;
                            }
                            if (event.kind == PointerEventKind.up && root.drag-tab == i) {
                                root.drag-tab = -1;
                                // 只有真的拖动过才接管；否则放行给 clicked / double-clicked
                                if (Math.abs(root.drag-x - root.drag-start) > 6px) {
                                    root.tab-reorder(i, root.drag-x, tab-strip.preferred-width);
                                    return EventResult.accept;
                                }
                                return EventResult.reject;
                            }
                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                // 菜单锚在 Tab 上沿：窗口 x ≈ tabbar 左内边距 + tab 偏移
                                root.tab-context(i, 32px + parent.x);
                                return EventResult.accept;
                            }
                            EventResult.reject
                        }
                    }

                    close-hit := TouchArea {
                        visible: show-close;
                        x: parent.width - 22px;
                        y: 1px;
                        width: 20px;
                        height: 20px;
                        clicked => { root.tab-closed(i); }

                        Text {
                            text: "×";
                            color: close-hit.has-hover ? Palette.colors.danger : Palette.colors.muted;
                            font-size: 14px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }

            }
            }

        // 固定新建 / Profile 按钮：不随 Tab 内容滚走（Chrome 的 + 固定）
        Rectangle {
            x: parent.width - 200px;
            y: 4px;
            width: 24px;
            height: 24px;
            border-radius: 5px;
            background: new-hit.has-hover ? Palette.colors.raise : transparent;

            new-hit := TouchArea {
                clicked => { root.new-tab(); }
            }

            Text {
                text: "+";
                color: Palette.colors.text;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Rectangle {
            x: parent.width - 170px;
            y: 4px;
            width: 26px;
            height: 24px;
            border-radius: 5px;
            background: profile-menu-hit.has-hover ? Palette.colors.raise : transparent;

            profile-menu-hit := TouchArea {
                clicked => {
                    root.profilemenu-x = self.absolute-position.x;
                    root.profilemenu-open = true;
                    root.profilemenu-menu();
                }
            }

            Text {
                text: ">_";
                color: Palette.colors.subtext;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        // 最左侧 Tab 搜索按钮（Chrome 风格）：搜索当前窗口所有 Tab
        Rectangle {
            x: 4px;
            y: 4px;
            width: 24px;
            height: 24px;
            border-radius: 5px;
            background: tabsearch-btn.has-hover ? Palette.colors.hover : Palette.colors.raise;

            tabsearch-btn := TouchArea {
                clicked => {
                    root.tabsearch-query = "";
                    root.tabsearch-open = true;
                    root.tabsearch-open-requested();
                }
            }

            Text {
                text: "⌕";
                color: Palette.colors.text;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        // 设置
        win-gear := TouchArea {
            x: parent.width - 132px;
            y: 4px;
            width: 28px;
            height: 24px;
            clicked => {
                root.settings-open = !root.settings-open;
                root.settings-toggled(root.settings-open);
            }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 5px;
                background: win-gear.has-hover ? Palette.colors.hover : Palette.colors.raise;
                Text {
                    text: "⚙";
                    color: Palette.colors.text;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }

        // 窗口按钮（无边框后必须自带）
        win-min := TouchArea {
            x: parent.width - 100px;
            y: 4px;
            width: 28px;
            height: 24px;
            clicked => { root.minimize-window(); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 5px;
                background: win-min.has-hover ? Palette.colors.hover : Palette.colors.raise;
                Text {
                    text: "─";
                    color: Palette.colors.text;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }

        win-max := TouchArea {
            x: parent.width - 68px;
            y: 4px;
            width: 28px;
            height: 24px;
            clicked => { root.toggle-maximize(); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 5px;
                background: win-max.has-hover ? Palette.colors.hover : Palette.colors.raise;
                Text {
                    text: root.maximized ? "❐" : "□";
                    color: Palette.colors.text;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }

        win-close := TouchArea {
            x: parent.width - 36px;
            y: 4px;
            width: 28px;
            height: 24px;
            clicked => { root.close-window(); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 5px;
                background: win-close.has-hover ? Palette.colors.danger : Palette.colors.raise;

                Text {
                    text: "✕";
                    color: win-close.has-hover ? Palette.colors.bg : Palette.colors.text;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }
        }

        // ---------------- 分屏内容区 ----------------
        Rectangle {
            y: root.tabbar-bottom ? 0px : root.tabbar-height;
            width: 100%;
            height: root.height - root.tabbar-height;
            // 有背景图时让终端帧的透明背景直接透出图片；否则保持主题底色。
            background: root.has-background-image ? transparent : Palette.colors.bg;

            // focus-on-click 必须关掉：否则点击 pane 时 FocusScope 会把焦点
            // 从下面的 TextInput 抢走，输入法（以及所有按键）立刻失效。
            fs := FocusScope {
                width: 100%;
                height: 100%;
                focus-on-click: false;

                // 隐藏的 IME 宿主。Slint 里只有 TextInput 会向 winit 申请输入法
                // 上下文（XIM/fcitx/ibus），中文上屏经由 edited 转发给 PTY。
                // 放在 pane 之前，保证鼠标事件仍由 pane 的 TouchArea 接收。
                ime := TextInput {
                    x: root.ime-x;
                    y: root.ime-y;
                    width: 2px;
                    height: 2px;
                    text: "";
                    single-line: true;
                    color: transparent;
                    selection-foreground-color: transparent;
                    selection-background-color: transparent;
                    text-cursor-width: 0px;
                    init => { self.focus(); }

                    key-pressed(event) => {
                        // 拼音组合中：回车=上屏候选、退格=删拼音、Esc=取消，
                        // 这些键归输入法，一个字节都不能写进 PTY
                        //（这正是之前“回车没用 / 键盘像失灵”的根源）。
                        if (self.preedit-text != "") {
                            return EventResult.reject;
                        }
                        if (event.text == "\u{1b}" && (root.menu-open || root.tabmenu-open || root.tabctx-open || root.profilemenu-open)) {
                            root.menu-open = false;
                            root.tabmenu-open = false;
                            root.tabctx-open = false;
                            root.profilemenu-open = false;
                            root.menu-dismissed();
                            return EventResult.accept;
                        }
                        root.key-input(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
                        EventResult.accept
                    }

                    // 输入法提交（中文、emoji 等）；TextInput 的 text 只当提交缓冲区用。
                    edited => {
                        if (self.text != "") {
                            root.ime-commit(self.text);
                            self.text = "";
                        }
                    }
                }

                for p in root.panes : Rectangle {
                    x: p.x;
                    y: p.y;
                    width: p.w;
                    height: p.h;
                    background: root.has-background-image ? transparent : Palette.colors.bg;
                    clip: true;
                    // 多分屏时用 1px accent 边框标出输入焦点；单 pane 不画，避免常驻边框。
                    border-width: (p.focused && root.panes.length > 1) ? 1px : 0px;
                    border-color: Palette.colors.accent;

                    Image {
                        source: p.image;
                        // 1:1 像素显示，右侧/底部余量露出 pane 背景（与终端同色）
                        width: p.iw;
                        height: p.ih;
                    }

                    pane-hit := TouchArea {
                        // 修饰键位：1=Shift 2=Alt 4=Ctrl，由 Rust 侧解码成 xterm 位掩码。
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                if (event.button == PointerEventButton.right) {
                                    root.input-trace(
                                        event.modifiers.shift ? "pane-down-right-shift" : "pane-down-right",
                                        p.id, pane-hit.mouse-x, pane-hit.mouse-y);
                                }
                                if (event.button == PointerEventButton.left) {
                                    ime.focus();
                                    root.pane-clicked(p.id);
                                    root.pane-mouse-down(p.id, pane-hit.mouse-x, pane-hit.mouse-y, 0,
                                        (event.modifiers.shift ? 1 : 0) + (event.modifiers.alt ? 2 : 0) + (event.modifiers.control ? 4 : 0));
                                    return EventResult.accept;
                                }
                                // 中键：Tabby 语义，始终由 Tervo 处理（配置开启时粘贴），不转发给 TUI。
                                if (event.button == PointerEventButton.middle) {
                                    ime.focus();
                                    root.pane-clicked(p.id);
                                    root.pane-middle-click(p.id);
                                    return EventResult.accept;
                                }
                                // 只剩 Shift+右键转发给 TUI；普通右键留给 Tervo 的菜单/粘贴模式。
                                if (p.mouse-reporting
                                    && event.button == PointerEventButton.right
                                    && event.modifiers.shift) {
                                    if (event.button == PointerEventButton.right) {
                                        root.input-trace("pane-right-forward", p.id,
                                            pane-hit.mouse-x, pane-hit.mouse-y);
                                    }
                                    ime.focus();
                                    root.pane-clicked(p.id);
                                    root.pane-mouse-down(p.id, pane-hit.mouse-x, pane-hit.mouse-y,
                                        event.button == PointerEventButton.right ? 2 : 1,
                                        (event.modifiers.shift ? 1 : 0) + (event.modifiers.alt ? 2 : 0) + (event.modifiers.control ? 4 : 0));
                                    return EventResult.accept;
                                }
                                // 非上报模式：右键在“按下”时开菜单并 accept。
                                // 之前只在 up 开：down 被 reject 时 Slint 不保证把 up 再送给本 TouchArea，
                                // 鼠标轻微移动/经过分隔线就会丢事件，表现为“有时候右键唤不出菜单”。
                                if (event.button == PointerEventButton.right) {
                                    ime.focus();
                                    root.pane-clicked(p.id);
                                    root.pane-right-clicked(p.id, p.x + pane-hit.mouse-x, p.y + pane-hit.mouse-y);
                                    return EventResult.accept;
                                }
                            }
                            if (event.kind == PointerEventKind.move) {
                                // 按住拖动 + 1003 悬停都走这里；是否真的上报由 Rust 按模式位过滤。
                                if (pane-hit.pressed || p.mouse-reporting) {
                                    root.pane-mouse-move(p.id, pane-hit.mouse-x, pane-hit.mouse-y, 0,
                                        (event.modifiers.shift ? 1 : 0) + (event.modifiers.alt ? 2 : 0) + (event.modifiers.control ? 4 : 0));
                                    return EventResult.accept;
                                }
                            }
                            if (event.kind == PointerEventKind.up) {
                                if (event.button == PointerEventButton.right) {
                                    root.input-trace("pane-up-right", p.id,
                                        pane-hit.mouse-x, pane-hit.mouse-y);
                                }
                                if (event.button == PointerEventButton.left) {
                                    root.pane-mouse-up(p.id, pane-hit.mouse-x, pane-hit.mouse-y, 0,
                                        (event.modifiers.shift ? 1 : 0) + (event.modifiers.alt ? 2 : 0) + (event.modifiers.control ? 4 : 0));
                                    return EventResult.accept;
                                }
                                if (event.button == PointerEventButton.middle) {
                                    return EventResult.accept;
                                }
                                if (p.mouse-reporting
                                    && event.button == PointerEventButton.right
                                    && event.modifiers.shift) {
                                    root.pane-mouse-up(p.id, pane-hit.mouse-x, pane-hit.mouse-y,
                                        event.button == PointerEventButton.right ? 2 : 1,
                                        (event.modifiers.shift ? 1 : 0) + (event.modifiers.alt ? 2 : 0) + (event.modifiers.control ? 4 : 0));
                                    return EventResult.accept;
                                }
                                if (event.button == PointerEventButton.right) {
                                    // 抬起交给 Rust：menu 模式在按下已弹菜单；paste/clipboard
                                    // 用抬起时间判断短按/长按（<250ms 粘贴，否则弹菜单）。
                                    root.pane-right-up(p.id, p.x + pane-hit.mouse-x, p.y + pane-hit.mouse-y);
                                    return EventResult.accept;
                                }
                            }
                            EventResult.reject
                        }
                        scroll-event(event) => {
                            // 1000/1002/1003 下滚轮要上交给应用（tmux/vim 翻页），否则本地回滚。
                            root.pane-scrolled(p.id, event.delta-y, pane-hit.mouse-x, pane-hit.mouse-y,
                                (event.modifiers.shift ? 1 : 0) + (event.modifiers.alt ? 2 : 0) + (event.modifiers.control ? 4 : 0));
                            EventResult.accept
                        }
                    }
                }

                // ---------------- 分屏分隔线（可拖拽调整比例） ----------------
                for d in root.dividers : Rectangle {
                    x: d.x;
                    y: d.y;
                    width: d.w;
                    height: d.h;

                    Rectangle {
                        x: d.vertical ? (parent.width - 1px) / 2 : 0px;
                        y: d.vertical ? 0px : (parent.height - 1px) / 2;
                        width: d.vertical ? 1px : parent.width;
                        height: d.vertical ? parent.height : 1px;
                        background: Palette.colors.border;
                    }

                    TouchArea {
                        // 命中区比 1px 线宽 4px，方便抓取
                        x: d.vertical ? -2px : 0px;
                        y: d.vertical ? 0px : -2px;
                        width: d.vertical ? d.w + 4px : d.w;
                        height: d.vertical ? d.h : d.h + 4px;
                        mouse-cursor: d.vertical ? ew-resize : ns-resize;
                        // 只接管左键拖拽。Slint 的 TouchArea 按下会无条件 grab，
                        // 以前这里对任何按键都 accept，右键落在 4px 命中带里就被吞掉，
                        // 表现为「有时候右键呼叫不出菜单」。
                        property <bool> dragging: false;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                if (event.button == PointerEventButton.left) {
                                    self.dragging = true;
                                    return EventResult.accept;
                                }
                                // 右键：占住这次按下，等 up 再开菜单（否则事件不会回落给 pane）
                                return event.button == PointerEventButton.right
                                    ? EventResult.accept
                                    : EventResult.reject;
                            }
                            if (event.kind == PointerEventKind.move && self.dragging) {
                                root.divider-dragged(
                                    d.index,
                                    d.vertical ? d.x - 2px + self.mouse-x : d.x + self.mouse-x,
                                    d.vertical ? d.y + self.mouse-y : d.y - 2px + self.mouse-y,
                                );
                                return EventResult.accept;
                            }
                            if (event.kind == PointerEventKind.up) {
                                self.dragging = false;
                                if (event.button == PointerEventButton.right) {
                                    root.pane-right-clicked-at(
                                        d.vertical ? d.x - 2px + self.mouse-x : d.x + self.mouse-x,
                                        d.vertical ? d.y + self.mouse-y : d.y - 2px + self.mouse-y,
                                    );
                                }
                                return EventResult.accept;
                            }
                            EventResult.reject
                        }
                    }
                }

                // 菜单打开时，点菜单以外的任何地方都先关掉菜单（否则残留菜单会挡住后续右键）。
                // 这层在 pane 之上、菜单之下：菜单项仍然可点。
                if root.menu-open : TouchArea {
                    width: 100%;
                    height: 100%;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            // 左键：关菜单。右键：关掉后在新的位置重新打开，
                            // 避免连续右键时「第二次只是把菜单关掉」看起来像唤不出菜单。
                            let reopen = event.button == PointerEventButton.right;
                            root.menu-open = false;
                            root.menu-dismissed();
                            if (reopen) {
                                root.pane-right-clicked-at(self.mouse-x, self.mouse-y);
                            }
                            return EventResult.accept;
                        }
                        EventResult.reject
                    }
                }

                // ---------------- 右键菜单 ----------------
                if root.menu-open : Rectangle {
                    // 菜单坐标系是内容区（顶部被 tabbar 占掉 32px），夹取必须按内容区高度算：
                    // 否则「Close Pane」那行会落到窗口之外，右键靠下时根本点不到关闭。
                    x: Math.max(0px, Math.min(root.menu-x, root.width - 150px));
                    y: Math.max(0px, Math.min(root.menu-y, root.height - root.tabbar-height - 276px));
                    width: 150px;
                    height: 276px;
                    background: Palette.colors.raise;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Palette.colors.hover;
                    drop-shadow-blur: 18px;
                    drop-shadow-offset-y: 6px;
                    drop-shadow-color: #000000a8;

                    VerticalLayout {
                        padding: 4px;
                        spacing: 2px;

                        MenuRow {
                            label: "Copy";
                            picked => { root.menu-open = false; root.menu-action(root.menu-pane, 3); }
                        }
                        MenuRow {
                            label: "Paste";
                            picked => { root.menu-open = false; root.menu-action(root.menu-pane, 4); }
                        }
                        MenuRow {
                            label: "Split Right";
                            picked => { root.menu-open = false; root.menu-action(root.menu-pane, 0); }
                        }
                        MenuRow {
                            label: "Split Down";
                            picked => { root.menu-open = false; root.menu-action(root.menu-pane, 1); }
                        }
                        MenuRow {
                            label: "Close Pane";
                            picked => { root.menu-open = false; root.menu-action(root.menu-pane, 2); }
                        }
                        MenuRow {
                            label: "Find";
                            picked => { root.menu-open = false; root.menu-action(root.menu-pane, 5); }
                        }
                        MenuRow {
                            label: "Select All";
                            picked => { root.menu-open = false; root.menu-action(root.menu-pane, 6); }
                        }
                        MenuRow {
                            label: "Clear";
                            picked => { root.menu-open = false; root.menu-action(root.menu-pane, 7); }
                        }
                        MenuRow {
                            label: root.broadcast ? "Broadcast Input: ON" : "Broadcast Input: OFF";
                            picked => { root.menu-open = false; root.menu-action(root.menu-pane, 8); }
                        }
                    }
                }
            }
        }
    }

    // Profile 选择器菜单：点外部关闭
    if root.profilemenu-open : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.profilemenu-open = false;
                    root.menu-dismissed();
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }
    }

    if root.profilemenu-open : Rectangle {
        x: Math.max(0px, Math.min(root.profilemenu-x, root.width - 220px));
        y: root.tabbar-bottom
            ? root.height - root.tabbar-height - self.height
            : root.tabbar-height;
        width: 220px;
        height: Math.min(root.profilemenu-items.length * 28px + 40px, root.height - root.tabbar-height - 8px);
        background: Palette.colors.raise;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 20px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #000000b0;
        clip: true;

        VerticalLayout {
            padding: 4px;
            spacing: 0px;

            for item[i] in root.profilemenu-items : MenuRow {
                label: item;
                picked => { root.profilemenu-open = false; root.profilemenu-pick(i); }
            }

            Rectangle {
                height: 1px;
                background: Palette.colors.border;
            }

            MenuRow {
                label: "Manage Profiles…";
                picked => { root.profilemenu-open = false; root.profilemenu-manage(); }
            }
        }
    }

    // 点菜单外的任意位置关闭 TabBar / Tab 菜单（此前只能点菜单项，菜单会一直留着）。
    // 这层放在两个菜单之前（下面），菜单项仍在最上层可点。
    if root.tabmenu-open || root.tabctx-open : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.tabmenu-open = false;
                    root.tabctx-open = false;
                    root.menu-dismissed();
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }
    }

    if root.tabmenu-open : Rectangle {
        x: Math.min(root.tabmenu-x, root.width - 180px);
        y: root.tabmenu-y;
        width: 170px;
        // 13 行：13×28 + 12×2 + 上下 padding 8 = 396（新增 New Window 行后正好占满）
        height: 396px;
        background: Palette.colors.raise;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.colors.hover;
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #000000a8;

        VerticalLayout {
            padding: 4px;
            spacing: 2px;

            MenuRow {
                label: root.pinned ? "Always on Top  ✓" : "Always on Top";
                picked => { root.tabmenu-open = false; root.pinned = !root.pinned; }
            }
            MenuRow {
                label: "New Tab";
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(1); }
            }
            MenuRow {
                label: "New Window";
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(13); }
            }
            MenuRow {
                label: "Settings";
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(2); }
            }
            MenuRow {
                // 存布局 + cwd，重启进程后按快照恢复（不丢分屏）
                label: "Restart Session";
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(4); }
            }
            MenuRow {
                label: "Command Palette";
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(5); }
            }
            MenuRow {
                label: root.tabbar-bottom ? "Tab Bar: Bottom" : "Tab Bar: Top";
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(6); }
            }
            MenuRow {
                label: "Background Sessions";
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(8); }
            }
            MenuRow {
                label: "Profiles";
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(9); }
            }
            MenuRow {
                label: "SFTP";
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(10); }
            }
            MenuRow {
                label: "Port Forwards";
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(11); }
            }
            MenuRow {
                label: "Reopen Closed Tab";
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(12); }
            }
            MenuRow {
                label: "Close Window";
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(3); }
            }
        }
    }

    if root.tabctx-open : Rectangle {
        x: Math.max(0px, Math.min(root.tabctx-x, root.width - 180px));
        // 菜单 126 高：TabBar 在上时贴其下沿，在下时贴其上沿
        y: root.tabbar-bottom ? root.height - root.tabbar-height - 126px : root.tabbar-height;
        width: 170px;
        height: 126px;
        background: Palette.colors.raise;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.colors.hover;
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #000000a8;

        VerticalLayout {
            padding: 4px;
            spacing: 2px;

            MenuRow {
                label: "Close";
                picked => { root.tabctx-open = false; root.tab-menu-action(root.tabctx-index, 0); }
            }
            MenuRow {
                label: "Close Others";
                picked => { root.tabctx-open = false; root.tab-menu-action(root.tabctx-index, 1); }
            }
            MenuRow {
                label: "Duplicate";
                picked => { root.tabctx-open = false; root.tab-menu-action(root.tabctx-index, 2); }
            }
            MenuRow {
                label: "Rename";
                picked => { root.tabctx-open = false; root.tab-menu-action(root.tabctx-index, 3); }
            }
        }
    }

    // profiles-open 的遮罩：点外部（左右键都行）关闭
    if root.profiles-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000040;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.profiles-open = false;
                    root.profiles-close();
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }
    }

    if root.profiles-open : Rectangle {
        x: (root.width - 420px) / 2;
        y: (root.height - 404px) / 2;
        width: 420px;
        height: 404px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        // 吃掉面板内空白处的点击，避免穿透到遮罩把面板关掉；
        // 右键直接关闭面板（面板内没有右键菜单）。
        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.right) {
                    root.profiles-open = false; root.profiles-close();
                }
                EventResult.accept
            }
        }

        Text {
            x: 16px; y: 10px;
            text: "Profiles";
            color: Palette.colors.text;
            font-size: 15px;
            font-weight: 600;
        }

        // 搜索框：输入即过滤，× 或 Esc 清空后恢复完整列表。
        Rectangle {
            x: 16px; y: 38px;
            width: 388px; height: 28px;
            border-radius: 5px;
            background: Palette.colors.bg;
            border-width: 1px;
            border-color: Palette.colors.border;

            TextInput {
                x: 8px;
                width: parent.width - 40px;
                height: parent.height;
                text <=> root.profile-query;
                single-line: true;
                color: Palette.colors.text;
                font-size: 11px;
                vertical-alignment: center;
                init => { self.focus(); }
                edited => { root.profile-filter(self.text); }
                key-pressed(event) => {
                    if (event.text == "\u{1b}") {
                        if (root.profile-query != "") {
                            root.profile-query = "";
                            root.profile-filter("");
                        } else {
                            root.profiles-open = false;
                            root.profiles-close();
                        }
                        return EventResult.accept;
                    }
                    EventResult.reject
                }
            }

            // 占位提示放在 TextInput 之后（上层），空查询时可见。
            Text {
                x: 8px;
                width: parent.width - 40px;
                height: parent.height;
                text: "Search name / host / kind…";
                color: Palette.colors.muted;
                font-size: 11px;
                vertical-alignment: center;
                visible: root.profile-query == "";
            }

            if root.profile-query != "" : Rectangle {
                x: parent.width - 26px;
                y: 4px;
                width: 20px; height: 20px;
                border-radius: 4px;
                background: prof-search-clear.has-hover ? Palette.colors.hover : transparent;

                Text {
                    text: "×";
                    color: Palette.colors.muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }

                prof-search-clear := TouchArea {
                    clicked => {
                        root.profile-query = "";
                        root.profile-filter("");
                    }
                }
            }
        }

        Rectangle {
            x: 16px; y: 74px;
            width: 388px; height: 1px;
            background: Palette.colors.border;
        }

        // 列表放进 Flickable：过滤后仍可能超过一屏，滚动而不是撑破面板。
        Flickable {
            x: 16px; y: 84px;
            width: 388px; height: 208px;
            interactive: true;
            content-width: self.width;
            content-height: root.profile-items.length * 34px;

            VerticalLayout {
                width: parent.width;
                spacing: 4px;

                for item[i] in root.profile-items : Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    background: profile-pick-hit.has-hover ? Palette.colors.hover : transparent;

                    Text {
                        x: 30px;
                        width: parent.width - 114px;
                        text: item.label;
                        color: Palette.colors.text;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    profile-pick-hit := TouchArea {
                        clicked => { root.profile-open(i); }
                    }

                    // 星标：★ = 新 Tab 默认 Profile；点击切换/取消。
                    Rectangle {
                        x: 2px; y: 3px;
                        width: 24px; height: 24px;
                        border-radius: 4px;
                        background: prof-star-hit.has-hover ? Palette.colors.hover : transparent;

                        Text {
                            text: item.is-default ? "★" : "☆";
                            color: item.is-default ? Palette.colors.accent : Palette.colors.muted;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        prof-star-hit := TouchArea {
                            clicked => { root.profile-set-default(i); }
                        }
                    }

                    // Duplicate：复制该行 Profile（名字自动 `(copy N)` 去重）。
                    Rectangle {
                        x: parent.width - 82px; y: 3px;
                        width: 30px; height: 24px;
                        border-radius: 4px;
                        background: prof-dup-hit.has-hover ? Palette.colors.hover : transparent;

                        Text {
                            text: "Dup";
                            color: Palette.colors.muted;
                            font-size: 9px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        prof-dup-hit := TouchArea {
                            clicked => { root.profile-duplicate(i); }
                        }
                    }

                    Rectangle {
                        x: parent.width - 52px;
                        y: 3px;
                        width: 22px;
                        height: 24px;
                        border-radius: 4px;
                        background: prof-edit-hit.has-hover ? Palette.colors.hover : transparent;

                        Text {
                            text: "✎";
                            color: Palette.colors.muted;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        prof-edit-hit := TouchArea {
                            clicked => { root.profile-edit(i); }
                        }
                    }

                    Rectangle {
                        x: parent.width - 26px;
                        y: 3px;
                        width: 22px;
                        height: 24px;
                        border-radius: 4px;
                        background: prof-del-hit.has-hover ? Palette.colors.danger : transparent;

                        Text {
                            text: "×";
                            color: prof-del-hit.has-hover ? Palette.colors.bg : Palette.colors.muted;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        prof-del-hit := TouchArea {
                            clicked => { root.profile-delete(i); }
                        }
                    }
                }
            }
        }

        // 空列表提示区分「没有 Profile」与「搜索无命中」。
        Text {
            x: 16px; y: 150px;
            width: 388px;
            text: "No profiles yet — click New Profile to create one";
            color: Palette.colors.muted;
            font-size: 11px;
            horizontal-alignment: center;
            wrap: word-wrap;
            visible: root.profile-items.length == 0 && root.profile-query == "";
        }

        Text {
            x: 16px; y: 150px;
            width: 388px;
            text: "No profiles match the search";
            color: Palette.colors.muted;
            font-size: 11px;
            horizontal-alignment: center;
            wrap: word-wrap;
            visible: root.profile-items.length == 0 && root.profile-query != "";
        }

        Text {
            x: 16px; y: 297px;
            width: 388px;
            text: "Click to open · ★ default for new tabs · Dup = duplicate";
            color: Palette.colors.muted;
            font-size: 10px;
            horizontal-alignment: center;
        }

        Rectangle {
            x: 16px; y: 320px; width: 120px; height: 28px; border-radius: 6px;
            background: prof-save-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            prof-save-hit := TouchArea {
                clicked => { root.profile-new(); }
            }
            Text {
                text: "New Profile";
                color: Palette.colors.text;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Rectangle {
            x: 324px; y: 320px; width: 80px; height: 28px; border-radius: 6px;
            background: prof-close-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            prof-close-hit := TouchArea {
                clicked => { root.profiles-open = false; root.profiles-close(); }
            }
            Text {
                text: "Close";
                color: Palette.colors.text;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        // 新 Tab 默认行为提示（由 Rust 按 config.default_profile_id 解析后下发）。
        Text {
            x: 16px; y: 368px;
            width: 388px;
            text: root.profile-default-info;
            color: Palette.colors.subtext;
            font-size: 11px;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    if root.profile-form-open : Rectangle {
        x: (root.width - 440px) / 2;
        y: (root.height - 480px) / 2;
        width: 440px;
        height: 480px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        // 绝对定位：切换类型时字段数量变化，布局不会整体位移（否则自动化/点击都不稳）
        Text {
            x: 16px;
            y: 14px;
            text: root.form-edit-id < 0 ? "New Profile" : "Edit Profile";
            color: Palette.colors.text;
            font-size: 15px;
            font-weight: 600;
        }

        HorizontalLayout {
            x: 16px;
            y: 44px;
            width: 408px;
            height: 24px;
            spacing: 8px;

            ChoiceBtn {
                width: 92px; height: 24px; font-size: 11px;
                label: "Local"; active: root.form-kind == 0;
                clicked => { root.form-kind = 0; root.form-error = ""; }
            }
            ChoiceBtn {
                width: 92px; height: 24px; font-size: 11px;
                label: "SSH"; active: root.form-kind == 1;
                clicked => { root.form-kind = 1; root.form-error = ""; }
            }
            ChoiceBtn {
                width: 92px; height: 24px; font-size: 11px;
                label: "Serial"; active: root.form-kind == 2;
                clicked => { root.form-kind = 2; root.form-error = ""; }
            }
            ChoiceBtn {
                width: 92px; height: 24px; font-size: 11px;
                label: "Telnet"; active: root.form-kind == 3;
                clicked => { root.form-kind = 3; root.form-error = ""; }
            }
        }

        FormRow {
            x: 16px; y: 80px; width: 408px; height: 26px;
            label: "Name"; text <=> root.form-name;
        }

        if root.form-kind == 0 : VerticalLayout {
            x: 16px; y: 116px; width: 408px; height: 130px;
            spacing: 12px;
            FormRow { label: "Shell"; text <=> root.form-shell; }
            FormRow { label: "Args"; text <=> root.form-args; }
            FormRow { label: "Cwd"; text <=> root.form-cwd; }
        }

        if root.form-kind == 1 : VerticalLayout {
            x: 16px; y: 116px; width: 408px; height: 290px;
            spacing: 5px;
            FormRow { label: "Host"; text <=> root.form-host; }
            FormRow { label: "Port"; text <=> root.form-port; }
            FormRow { label: "User"; text <=> root.form-user; }
            FormRow { label: "Auth"; text <=> root.form-auth; }
            FormRow { label: "Key"; text <=> root.form-key; }
            if root.form-auth == "password" : VerticalLayout {
                spacing: 5px;
                FormRow {
                    label: "Password";
                    text <=> root.form-password;
                    masked: true;
                }
                ToggleRow {
                    label: "Save password to Vault";
                    on: root.form-save-password;
                    toggled => { root.form-save-password = !root.form-save-password; }
                }
            }
            FormRow { label: "Extra"; text <=> root.form-extra; }
            FormRow { label: "Forwards"; text <=> root.form-forwards; }
        }

        if root.form-kind == 2 : VerticalLayout {
            x: 16px; y: 116px; width: 408px; height: 80px;
            spacing: 12px;
            FormRow { label: "Serial"; text <=> root.form-serial-port; }
            FormRow { label: "Baud"; text <=> root.form-baud; }
        }

        if root.form-kind == 3 : VerticalLayout {
            x: 16px; y: 116px; width: 408px; height: 80px;
            spacing: 12px;
            FormRow { label: "Host"; text <=> root.form-host; }
            FormRow { label: "Port"; text <=> root.form-port; }
        }

        Text {
            x: 16px;
            y: 410px;
            width: 408px;
            text: root.form-error;
            color: Palette.colors.danger;
            font-size: 11px;
            wrap: word-wrap;
        }

        Rectangle {
            x: 252px; y: 442px; width: 80px; height: 28px; border-radius: 6px;
            background: form-cancel-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            form-cancel-hit := TouchArea {
                clicked => { root.profile-form-open = false; root.profile-form-cancel(); }
            }
            Text {
                text: "Cancel";
                color: Palette.colors.text;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Rectangle {
            x: 340px; y: 442px; width: 80px; height: 28px; border-radius: 6px;
            background: form-save-hit.has-hover ? Palette.colors.danger : Palette.colors.accent;
            form-save-hit := TouchArea {
                clicked => { root.profile-form-save(); }
            }
            Text {
                text: "Save";
                color: Palette.colors.accent-text;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
    }

    // sftp-open 的遮罩：点外部（左右键都行）关闭
    if root.sftp-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000040;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    if (!root.sftp-transfer-active) {
                        root.sftp-open = false;
                        root.sftp-close();
                    }
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }
    }

    if root.sftp-open : Rectangle {
        x: (root.width - 460px) / 2;
        y: (root.height - 490px) / 2;
        width: 460px;
        height: 490px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        // 吃掉面板内空白处的点击，避免穿透到遮罩把面板关掉；
        // 右键直接关闭面板（面板内没有右键菜单）。
        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.right
                    && !root.sftp-transfer-active) {
                    root.sftp-open = false; root.sftp-close();
                }
                EventResult.accept
            }
        }

        Text {
            x: 16px; y: 10px;
            text: "SFTP";
            color: Palette.colors.text;
            font-size: 15px;
            font-weight: 600;
        }

        // SSH Profile 选择（只列 SSH 类型）
        HorizontalLayout {
            x: 16px; y: 38px;
            width: 428px; height: 24px;
            spacing: 8px;
            for p[i] in root.sftp-profiles : ChoiceBtn {
                width: 120px; height: 24px; font-size: 11px;
                label: p;
                active: root.sftp-profile == i;
                clicked => { root.sftp-profile = i; }
            }
        }

        FormRow {
            x: 16px; y: 72px; width: 428px; height: 26px;
            label: "Remote"; text <=> root.sftp-remote;
        }

        Rectangle {
            x: 16px; y: 108px; width: 80px; height: 26px; border-radius: 5px;
            background: sftp-list-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-list-hit := TouchArea { clicked => { root.sftp-list(); } }
            Text {
                text: "List";
                color: Palette.colors.text;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Text {
            x: 104px; y: 114px;
            width: 340px;
            text: root.sftp-status;
            color: Palette.colors.muted;
            font-size: 11px;
            overflow: elide;
        }

        // 远端条目列表（固定行高 24px）
        Rectangle {
            x: 16px; y: 142px; width: 428px; height: 150px;
            background: Palette.colors.bg;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.colors.border;

            VerticalLayout {
                x: 2px; y: 2px; width: 424px; height: 146px;
                spacing: 0px;

                for item[i] in root.sftp-items : Rectangle {
                    height: 24px;
                    background: root.sftp-selected == i
                        ? Palette.colors.hover
                        : (row-hit.has-hover ? Palette.colors.surface : transparent);

                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        text: item;
                        color: Palette.colors.text;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    row-hit := TouchArea {
                        clicked => { root.sftp-pick(i); }
                    }
                }
            }
        }

        FormRow {
            x: 16px; y: 300px; width: 428px; height: 26px;
            label: "Target"; text <=> root.sftp-target;
        }

        FormRow {
            x: 16px; y: 332px; width: 428px; height: 26px;
            label: "Local"; text <=> root.sftp-local;
        }

        Rectangle {
            x: 16px; y: 366px; width: 140px; height: 24px; border-radius: 5px;
            background: sftp-get-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-get-hit := TouchArea { clicked => { root.sftp-download(); } }
            Text {
                text: "Download selected";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Rectangle {
            x: 162px; y: 366px; width: 90px; height: 24px; border-radius: 5px;
            background: sftp-put-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-put-hit := TouchArea { clicked => { root.sftp-upload(); } }
            Text {
                text: "Upload";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Rectangle {
            x: 258px; y: 366px; width: 82px; height: 24px; border-radius: 5px;
            background: sftp-mkdir-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-mkdir-hit := TouchArea { clicked => { root.sftp-mkdir(); } }
            Text {
                text: "New Dir";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Rectangle {
            x: 346px; y: 366px; width: 82px; height: 24px; border-radius: 5px;
            background: sftp-rename-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-rename-hit := TouchArea { clicked => { root.sftp-rename(); } }
            Text {
                text: "Rename";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Rectangle {
            x: 16px; y: 400px; width: 82px; height: 24px; border-radius: 5px;
            background: sftp-del-hit.has-hover ? Palette.colors.danger : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-del-hit := TouchArea { clicked => { root.sftp-delete(); } }
            Text {
                text: "Delete";
                color: sftp-del-hit.has-hover ? Palette.colors.bg : Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Rectangle {
            x: 364px; y: 400px; width: 80px; height: 24px; border-radius: 5px;
            background: sftp-close-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-close-hit := TouchArea { clicked => { root.sftp-open = false; root.sftp-close(); } }
            Text {
                text: "Close";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        // 传输进行中：挡住面板内所有旧操作，只留下面的 Cancel。
        // （取消/关闭由 Rust 侧再次校验，这里只是 UI 层防误触。）
        if root.sftp-transfer-active : Rectangle {
            width: 100%;
            height: 100%;
            background: #00000018;
            TouchArea {
                pointer-event(event) => { EventResult.accept }
            }
        }

        // 传输进度：当前文件 + 百分比/不确定进度 + Cancel。
        if root.sftp-transfer-active : Rectangle {
            x: 16px; y: 430px; width: 428px; height: 44px;

            Text {
                x: 0; y: 0; width: 240px; height: 24px;
                text: root.sftp-transfer-name;
                color: Palette.colors.text;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                x: 244px; y: 0; width: 104px; height: 24px;
                text: root.sftp-transfer-detail;
                color: Palette.colors.muted;
                font-size: 10px;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }

            Rectangle {
                x: 356px; y: 0; width: 72px; height: 24px; border-radius: 5px;
                background: sftp-cancel-hit.has-hover ? Palette.colors.danger : Palette.colors.raise;
                border-width: 1px;
                border-color: Palette.colors.border;
                sftp-cancel-hit := TouchArea { clicked => { root.sftp-cancel(); } }
                Text {
                    text: "Cancel";
                    color: sftp-cancel-hit.has-hover ? Palette.colors.bg : Palette.colors.danger;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }

            Rectangle {
                x: 0; y: 30px; width: 428px; height: 8px;
                background: Palette.colors.bg;
                border-radius: 4px;
                border-width: 1px;
                border-color: Palette.colors.border;

                Rectangle {
                    x: 1px; y: 1px;
                    height: parent.height - 2px;
                    width: root.sftp-transfer-percent < 0
                        ? (parent.width - 2px) * 25 / 100
                        : (parent.width - 2px) * root.sftp-transfer-percent / 100;
                    background: root.sftp-transfer-percent < 0
                        ? Palette.colors.muted
                        : Palette.colors.accent;
                    border-radius: 3px;
                }
            }
        }
    }

    // fwd-open 的遮罩：点外部（左右键都行）关闭
    if root.fwd-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000040;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.fwd-open = false;
                    root.fwd-close();
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }
    }

    if root.fwd-open : Rectangle {
        x: (root.width - 460px) / 2;
        y: (root.height - 400px) / 2;
        width: 460px;
        height: 400px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        // 吃掉面板内空白处的点击，避免穿透到遮罩把面板关掉；
        // 右键直接关闭面板（面板内没有右键菜单）。
        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.right) {
                    root.fwd-open = false; root.fwd-close();
                }
                EventResult.accept
            }
        }

        Text {
            x: 16px; y: 10px;
            text: "Port Forwards";
            color: Palette.colors.text;
            font-size: 15px;
            font-weight: 600;
        }

        HorizontalLayout {
            x: 16px; y: 38px;
            width: 428px; height: 24px;
            spacing: 8px;
            for p[i] in root.fwd-profiles : ChoiceBtn {
                width: 120px; height: 24px; font-size: 11px;
                label: p;
                active: root.fwd-profile == i;
                clicked => { root.fwd-profile = i; root.fwd-select(i); }
            }
        }

        Text {
            x: 16px; y: 70px;
            width: 428px;
            text: "规则写入 Profile，下次建立 SSH 连接时生效（当前会话需重连）";
            color: Palette.colors.muted;
            font-size: 10px;
            wrap: word-wrap;
        }

        Rectangle {
            x: 16px; y: 94px; width: 428px; height: 196px;
            background: Palette.colors.bg;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.colors.border;

            VerticalLayout {
                x: 2px; y: 2px; width: 424px; height: 192px;
                spacing: 0px;

                for item[i] in root.fwd-items : Rectangle {
                    height: 24px;
                    background: transparent;

                    Text {
                        x: 8px;
                        width: parent.width - 40px;
                        text: item;
                        color: Palette.colors.text;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Rectangle {
                        x: parent.width - 26px;
                        y: 2px;
                        width: 22px;
                        height: 20px;
                        border-radius: 4px;
                        background: fwd-del-hit.has-hover ? Palette.colors.danger : transparent;

                        Text {
                            text: "×";
                            color: fwd-del-hit.has-hover ? Palette.colors.bg : Palette.colors.muted;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        fwd-del-hit := TouchArea {
                            clicked => { root.fwd-delete(i); }
                        }
                    }

                }
            }
        }

        FormRow {
            x: 16px; y: 300px; width: 428px; height: 26px;
            label: "New"; text <=> root.fwd-new;
        }

        Rectangle {
            x: 16px; y: 334px; width: 90px; height: 26px; border-radius: 5px;
            background: fwd-add-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            fwd-add-hit := TouchArea { clicked => { root.fwd-add(); } }
            Text {
                text: "Add rule";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Text {
            x: 116px; y: 340px;
            width: 236px;
            text: root.fwd-status;
            color: Palette.colors.muted;
            font-size: 10px;
            overflow: elide;
        }

        Rectangle {
            x: 364px; y: 334px; width: 80px; height: 26px; border-radius: 5px;
            background: fwd-close-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            fwd-close-hit := TouchArea { clicked => { root.fwd-open = false; root.fwd-close(); } }
            Text {
                text: "Close";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
    }

    // bg-open 的遮罩：点外部（左右键都行）关闭
    if root.bg-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000040;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.bg-open = false;
                    root.bg-close();
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }
    }

    if root.bg-open : Rectangle {
        x: (root.width - 380px) / 2;
        y: (root.height - 300px) / 2;
        width: 380px;
        height: 300px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        // 吃掉面板内空白处的点击，避免穿透到遮罩把面板关掉；
        // 右键直接关闭面板（面板内没有右键菜单）。
        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.right) {
                    root.bg-open = false; root.bg-close();
                }
                EventResult.accept
            }
        }

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            Text {
                text: "Background Sessions";
                color: Palette.colors.text;
                font-size: 15px;
                font-weight: 600;
            }

            Rectangle {
                height: 1px;
                horizontal-stretch: 1;
                background: Palette.colors.border;
            }

            for item[i] in root.background-items : Rectangle {
                height: 30px;
                border-radius: 4px;
                background: bg-hit.has-hover ? Palette.colors.hover : transparent;

                Text {
                    x: 8px;
                    width: parent.width - 16px;
                    text: item;
                    color: Palette.colors.text;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                bg-hit := TouchArea {
                    clicked => { root.bg-reattach(i); }
                }
            }

            Text {
                text: root.background-items.length == 0
                    ? "No background sessions"
                    : "Click a session to reattach it in a new tab";
                color: Palette.colors.muted;
                font-size: 11px;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: end;
                Rectangle {
                    width: 80px; height: 28px; border-radius: 6px;
                    background: bg-close-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
                    border-width: 1px;
                    border-color: Palette.colors.border;
                    bg-close-hit := TouchArea {
                        clicked => { root.bg-open = false; root.bg-close(); }
                    }
                    Text {
                        text: "Close";
                        color: Palette.colors.text;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }
    }

    // Tab 搜索浮层：点外部关闭；输入过滤，↑↓选择，Enter 跳转，Esc 关闭。
    if root.tabsearch-open : Rectangle {
        width: 100%;
        height: 100%;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.tabsearch-open = false;
                    root.tabsearch-cancel();
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }
    }

    if root.tabsearch-open : Rectangle {
        x: 4px;
        y: root.tabbar-bottom
            ? root.height - root.tabbar-height - self.height - 4px
            : root.tabbar-height + 4px;
        width: 340px;
        height: Math.min(324px, 52px + root.tabsearch-items.length * 28px + 8px);
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;
        clip: true;

        VerticalLayout {
            padding: 8px;
            spacing: 3px;

            TextInput {
                height: 30px;
                text <=> root.tabsearch-query;
                single-line: true;
                color: Palette.colors.text;
                font-size: 13px;
                init => { self.focus(); }
                edited => { root.tabsearch-query-changed(self.text); }
                key-pressed(event) => {
                    if (event.text == "\u{1b}") { root.tabsearch-cancel(); return EventResult.accept; }
                    if (event.text == "\u{F700}") { root.tabsearch-move(-1); return EventResult.accept; }
                    if (event.text == "\u{F701}") { root.tabsearch-move(1); return EventResult.accept; }
                    if (event.text == "\u{a}" || event.text == "\u{d}") { root.tabsearch-accept(); return EventResult.accept; }
                    EventResult.reject
                }
            }

            for item[i] in root.tabsearch-items : Rectangle {
                height: 26px;
                border-radius: 4px;
                background: i == root.tabsearch-selected ? Palette.colors.accent : transparent;

                Text {
                    x: 8px;
                    text: item;
                    color: i == root.tabsearch-selected ? Palette.colors.accent-text : Palette.colors.text;
                    font-size: 12px;
                    vertical-alignment: center;
                    width: parent.width - 16px;
                    overflow: elide;
                }

                TouchArea {
                    clicked => { root.tabsearch-selected = i; root.tabsearch-pick(i); }
                }
            }

            Text {
                visible: root.tabsearch-items.length == 0;
                text: "没有匹配的标签页";
                color: Palette.colors.muted;
                font-size: 11px;
                height: 26px;
                vertical-alignment: center;
            }
        }
    }

    if root.palette-open : Rectangle {
        x: (root.width - 420px) / 2;
        y: 56px;
        width: 420px;
        height: 348px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        VerticalLayout {
            padding: 10px;
            spacing: 6px;

            TextInput {
                height: 30px;
                text <=> root.palette-query;
                single-line: true;
                color: Palette.colors.text;
                font-size: 14px;
                init => { self.focus(); }
                edited => { root.palette-query-changed(self.text); }
                key-pressed(event) => {
                    if (event.text == "\u{1b}") { root.palette-cancel(); return EventResult.accept; }
                    if (event.text == "\u{F700}") { root.palette-move(-1); return EventResult.accept; }
                    if (event.text == "\u{F701}") { root.palette-move(1); return EventResult.accept; }
                    if (event.text == "\u{a}" || event.text == "\u{d}") { root.palette-accept(); return EventResult.accept; }
                    EventResult.reject
                }
            }

            for item[i] in root.palette-items : Rectangle {
                height: 26px;
                border-radius: 4px;
                background: i == root.palette-selected ? Palette.colors.accent : transparent;

                Text {
                    x: 8px;
                    text: item;
                    color: i == root.palette-selected ? Palette.colors.accent-text : Palette.colors.text;
                    font-size: 13px;
                    vertical-alignment: center;
                    width: parent.width - 16px;
                    overflow: elide;
                }

                TouchArea {
                    clicked => { root.palette-selected = i; root.palette-pick(i); }
                }
            }
        }
    }

    if root.paste-open : Rectangle {
        x: (root.width - 420px) / 2;
        y: (root.height - 200px) / 2;
        width: 420px;
        height: 200px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            Text {
                text: "Paste \{root.paste-lines} lines?";
                color: Palette.colors.text;
                font-size: 15px;
                font-weight: 600;
            }
            Text {
                text: root.paste-preview;
                color: Palette.colors.subtext;
                font-size: 12px;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                Rectangle {
                    width: 84px; height: 28px; border-radius: 6px;
                    background: paste-cancel-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
                    border-width: 1px;
                    border-color: Palette.colors.border;
                    paste-cancel-hit := TouchArea {
                        clicked => { root.paste-open = false; root.paste-cancel(); }
                    }
                    Text {
                        text: "Cancel";
                        color: Palette.colors.text;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                Rectangle {
                    width: 110px; height: 28px; border-radius: 6px;
                    background: paste-always-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
                    border-width: 1px;
                    border-color: Palette.colors.border;
                    paste-always-hit := TouchArea {
                        clicked => { root.paste-open = false; root.paste-always(); }
                    }
                    Text {
                        text: "Always Allow";
                        color: Palette.colors.text;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                Rectangle {
                    width: 84px; height: 28px; border-radius: 6px;
                    background: paste-ok-hit.has-hover ? Palette.colors.danger : Palette.colors.accent;
                    paste-ok-hit := TouchArea {
                        clicked => { root.paste-open = false; root.paste-accept(); }
                    }
                    Text {
                        text: "Paste";
                        color: Palette.colors.accent-text;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }
    }

    if root.confirm-open : Rectangle {
        x: (root.width - 340px) / 2;
        y: (root.height - 150px) / 2;
        width: 340px;
        height: 150px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            Text {
                text: "Close Tervo?";
                color: Palette.colors.text;
                font-size: 15px;
                font-weight: 600;
            }
            Text {
                text: root.confirm-text;
                color: Palette.colors.subtext;
                font-size: 12px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                Rectangle {
                    width: 88px; height: 28px; border-radius: 6px;
                    background: cancel-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
                    border-width: 1px;
                    border-color: Palette.colors.border;
                    cancel-hit := TouchArea {
                        clicked => { root.confirm-open = false; root.confirm-cancel(); }
                    }
                    Text {
                        text: "Cancel";
                        color: Palette.colors.text;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
                Rectangle {
                    width: 88px; height: 28px; border-radius: 6px;
                    background: ok-hit.has-hover ? Palette.colors.danger : Palette.colors.accent;
                    ok-hit := TouchArea {
                        clicked => { root.confirm-open = false; root.confirm-accept(); }
                    }
                    Text {
                        text: "Close";
                        color: Palette.colors.accent-text;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }
    }

    if root.rename-open : Rectangle {
        x: 32px;
        y: root.tabbar-height + 8px;
        width: 260px;
        height: 40px;
        background: Palette.colors.raise;
        border-radius: 6px;
        border-width: 1px;
        border-color: Palette.colors.accent;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #000000a8;

        Text {
            x: 10px; y: 4px;
            text: "Rename tab";
            color: Palette.colors.muted;
            font-size: 10px;
        }

        rename-input := TextInput {
            x: 8px;
            y: 16px;
            width: parent.width - 16px;
            height: parent.height - 20px;
            text <=> root.rename-text;
            single-line: true;
            color: Palette.colors.text;
            font-size: 13px;
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == "\u{a}" || event.text == "\u{d}") {
                    root.rename-committed(root.rename-index, self.text);
                    root.rename-open = false;
                    return EventResult.accept;
                }
                if (event.text == "\u{1b}") {
                    root.rename-cancelled();
                    root.rename-open = false;
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }
    }

    if root.search-open : Rectangle {
        x: root.width - 328px;
        y: root.tabbar-height + 8px;
        width: 300px;
        height: 34px;
        background: Palette.colors.raise;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.colors.accent;
        drop-shadow-blur: 14px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000090;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 8px;

            Text {
                text: "🔍";
                color: Palette.colors.subtext;
                font-size: 12px;
                vertical-alignment: center;
            }
            Text {
                text: root.search-query == "" ? "Search…" : root.search-query;
                color: root.search-query == "" ? Palette.colors.muted : Palette.colors.text;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.search-status;
                color: Palette.colors.danger;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
    }

    if root.settings-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000080;

        backdrop := TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.settings-open = false;
                    root.settings-toggled(false);
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }

        // Tabby 式布局：左侧分类导航 + 右侧内容；顶部一条搜索栏。
        Rectangle {
            width: Math.min(520px, root.width - 12px);
            // 居中在 TabBar 下方的内容区，避免盖住 TabBar/窗口按钮。
            height: Math.min(440px, root.height - root.tabbar-height - 12px);
            x: (root.width - self.width) / 2;
            y: root.tabbar-height + (root.height - root.tabbar-height - self.height) / 2;
            background: @linear-gradient(180deg, Palette.colors.raise 0%, Palette.colors.surface 100%);
            border-radius: 12px;
            border-width: 1px;
            border-color: Palette.colors.border;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: 10px;
            drop-shadow-color: #000000b8;

            // 吃掉面板内部的空白点击，否则会穿透到 backdrop 把设置关掉；
            // 右键直接关闭设置（设置页没有右键菜单）。
            TouchArea {
                width: 100%;
                height: 100%;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down
                        && event.button == PointerEventButton.right) {
                        root.settings-open = false;
                        root.settings-toggled(false);
                    }
                    EventResult.accept
                }
            }

            // ---------------- 顶栏 ----------------
            HorizontalLayout {
                x: 18px; y: 12px;
                width: parent.width - 36px;
                height: 26px;
                spacing: 10px;

                Image {
                    width: 22px;
                    height: 22px;
                    source: @image-url("../../../assets/icon-small.png");
                    image-fit: contain;
                }
                Text {
                    text: "Settings";
                    color: Palette.colors.text;
                    font-size: 16px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Rectangle {
                    height: 24px;
                    horizontal-stretch: 1;
                    border-radius: 4px;
                    background: Palette.colors.bg;
                    border-width: 1px;
                    border-color: Palette.colors.border;

                    Text {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        text: "Search settings…";
                        color: Palette.colors.muted;
                        font-size: 11px;
                        vertical-alignment: center;
                        visible: root.settings-query == "";
                    }

                    TextInput {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        text <=> root.settings-query;
                        single-line: true;
                        color: Palette.colors.text;
                        font-size: 11px;
                        vertical-alignment: center;
                        edited => { root.settings-filter(self.text); }
                    }
                }
            }

            Rectangle {
                x: 18px; y: 50px;
                width: parent.width - 36px;
                height: 1px;
                background: Palette.colors.border;
            }

            // ---------------- 左导航 ----------------
            NavItem {
                x: 18px; y: 64px; width: 118px;
                label: "Appearance";
                active: root.settings-category == 0;
                clicked => { root.settings-category = 0; root.settings-category-changed(0); }
            }
            NavItem {
                x: 18px; y: 98px; width: 118px;
                label: "Terminal";
                active: root.settings-category == 1;
                clicked => { root.settings-category = 1; root.settings-category-changed(1); }
            }
            NavItem {
                x: 18px; y: 132px; width: 118px;
                label: "Window";
                active: root.settings-category == 2;
                clicked => { root.settings-category = 2; root.settings-category-changed(2); }
            }
            NavItem {
                x: 18px; y: 166px; width: 118px;
                label: "Config";
                active: root.settings-category == 3;
                clicked => { root.settings-category = 3; root.settings-category-changed(3); }
            }
            NavItem {
                x: 18px; y: 200px; width: 118px;
                label: "Hotkeys";
                active: root.settings-category == 4;
                clicked => { root.settings-category = 4; root.settings-category-changed(4); }
            }
            NavItem {
                x: 18px; y: 234px; width: 118px;
                label: "Plugins";
                active: root.settings-category == 5;
                clicked => { root.settings-category = 5; root.settings-category-changed(5); }
            }
            NavItem {
                x: 18px; y: 268px; width: 118px;
                label: "Vault";
                active: root.settings-category == 6;
                clicked => { root.settings-category = 6; root.settings-category-changed(6); }
            }

            Text {
                x: 18px;
                y: parent.height - 28px;
                width: 118px;
                text: "Tervo";
                color: Palette.colors.muted;
                font-size: 10px;
                vertical-alignment: center;
            }

            // ---------------- 右侧内容 ----------------
            Rectangle {
                x: 146px; y: 64px;
                width: parent.width - 164px;
                height: parent.height - 80px;
                clip: true;

                if root.settings-category == 0 : VerticalLayout {
                    width: 100%;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Theme";
                            color: Palette.colors.subtext;
                            width: 52px;
                            font-size: 12px;
                            vertical-alignment: top;
                        }
                        VerticalLayout {
                            spacing: 6px;
                            horizontal-stretch: 1;

                            HorizontalLayout {
                                spacing: 6px;
                                ChoiceBtn {
                                    width: 136px;
                                    height: 24px;
                                    font-size: 10px;
                                    label: "Auto（跟随系统）";
                                    active: root.theme-name == "auto";
                                    clicked => { root.set-theme("auto"); }
                                }
                                Text {
                                    text: root.auto-resolved == "" ? "" : "→ \{root.auto-resolved}";
                                    color: Palette.colors.subtext;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }

                            Flickable {
                                width: 100%;
                                // 缩短主题网格，为下方背景图/透明度控件留出空间；
                                // 主题多时仍可滚动。
                                height: 128px;
                                content-width: self.width;
                                content-height: Math.ceil(root.theme-choices.length / 4) * 30px - 6px;
                                interactive: true;

                                GridLayout {
                                    width: 100%;
                                    spacing: 6px;
                                    for choice[i] in root.theme-choices : ChoiceBtn {
                                        row: Math.floor(i / 4);
                                        col: Math.mod(i, 4);
                                        width: 66px;
                                        height: 24px;
                                        font-size: 10px;
                                        label: choice.label;
                                        active: root.theme-name == choice.id;
                                        clicked => { root.set-theme(choice.id); }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        horizontal-stretch: 1;
                        background: Palette.colors.border;
                    }

                    Text {
                        text: "Background image";
                        color: Palette.colors.subtext;
                        font-size: 12px;
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            height: 26px;
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: Palette.colors.bg;
                            border-width: 1px;
                            border-color: root.background-image-error == ""
                                ? Palette.colors.border
                                : Palette.colors.danger;

                            Text {
                                x: 7px;
                                width: parent.width - 14px;
                                height: parent.height;
                                text: "PNG / JPEG / SVG 路径，空 = 关闭";
                                color: Palette.colors.muted;
                                font-size: 11px;
                                vertical-alignment: center;
                                visible: root.background-image-path == "";
                            }

                            TextInput {
                                x: 7px;
                                width: parent.width - 14px;
                                height: parent.height;
                                text <=> root.background-image-path;
                                single-line: true;
                                color: Palette.colors.text;
                                font-size: 11px;
                                vertical-alignment: center;
                                edited => { root.background-image-changed(self.text); }
                            }
                        }
                        MiniBtn {
                            label: "×";
                            clicked => {
                                root.background-image-path = "";
                                root.background-image-changed("");
                            }
                        }
                    }

                    Text {
                        visible: root.background-image-error != "";
                        text: root.background-image-error;
                        color: Palette.colors.danger;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                    Text {
                        visible: root.background-image-error == "";
                        text: "支持 ~ 展开；只接受存在的普通文件；铺满窗口并保持比例裁切。";
                        color: Palette.colors.muted;
                        font-size: 10px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Opacity";
                            color: Palette.colors.subtext;
                            width: 52px;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        OpacitySlider {
                            height: 22px;
                            horizontal-stretch: 1;
                            value: root.background-opacity;
                            preview(v) => {
                                root.background-opacity = v;
                                root.background-opacity-preview(v);
                            }
                            changed(v) => {
                                root.background-opacity = v;
                                root.background-opacity-changed(v);
                            }
                        }
                        Text {
                            text: "\{Math.round(root.background-opacity * 100)}%";
                            color: Palette.colors.text;
                            width: 42px;
                            font-size: 12px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: "终端默认背景透明度 20%–100%；文字、光标与彩色 cell 背景保持不透明。";
                        color: Palette.colors.muted;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                }

                if root.settings-category == 1 : VerticalLayout {
                    width: 100%;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Font size";
                            color: Palette.colors.subtext;
                            width: 76px;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        MiniBtn {
                            label: "−";
                            clicked => { root.bump-font-size(-1); }
                        }
                        Text {
                            text: "\{root.font-size}px";
                            color: Palette.colors.text;
                            width: 52px;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        MiniBtn {
                            label: "+";
                            clicked => { root.bump-font-size(1); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Scrollback";
                            color: Palette.colors.subtext;
                            width: 76px;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        MiniBtn {
                            label: "−";
                            clicked => { root.bump-scrollback(-500); }
                        }
                        Text {
                            text: "\{root.scrollback}";
                            color: Palette.colors.text;
                            width: 52px;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        MiniBtn {
                            label: "+";
                            clicked => { root.bump-scrollback(500); }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        horizontal-stretch: 1;
                        background: Palette.colors.border;
                    }

                    ToggleRow {
                        label: "Copy on select（拖选自动复制）";
                        on: root.cfg-copy-on-select;
                        toggled => { root.toggle-copy-on-select(); }
                    }

                    ToggleRow {
                        label: "Confirm before closing multiple sessions";
                        on: root.cfg-confirm-close;
                        toggled => { root.toggle-confirm-close(); }
                    }

                    ToggleRow {
                        label: "Confirm multi-line paste";
                        on: root.cfg-confirm-paste;
                        toggled => { root.toggle-confirm-paste(); }
                    }

                    Text {
                        text: "Right click";
                        color: Palette.colors.subtext;
                        font-size: 12px;
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        ChoiceBtn {
                            width: 72px; height: 24px; font-size: 10px;
                            label: "Menu";
                            active: root.cfg-right-click == "menu";
                            clicked => { root.set-right-click("menu"); }
                        }
                        ChoiceBtn {
                            width: 72px; height: 24px; font-size: 10px;
                            label: "Paste";
                            active: root.cfg-right-click == "paste";
                            clicked => { root.set-right-click("paste"); }
                        }
                        ChoiceBtn {
                            width: 82px; height: 24px; font-size: 10px;
                            label: "Clipboard";
                            active: root.cfg-right-click == "clipboard";
                            clicked => { root.set-right-click("clipboard"); }
                        }
                        ChoiceBtn {
                            width: 60px; height: 24px; font-size: 10px;
                            label: "Off";
                            active: root.cfg-right-click == "off";
                            clicked => { root.set-right-click("off"); }
                        }
                    }

                    Text {
                        text: "Paste / Clipboard 短按立即执行，长按 250ms 出菜单；Clipboard 有选区时复制并清除，否则粘贴。";
                        color: Palette.colors.muted;
                        font-size: 10px;
                        wrap: word-wrap;
                    }

                    ToggleRow {
                        label: "Paste on middle-click";
                        on: root.cfg-paste-middle;
                        toggled => { root.toggle-paste-middle(); }
                    }

                    ToggleRow {
                        label: "Desktop notifications for inactive tabs";
                        on: root.cfg-desktop-notifications;
                        toggled => { root.toggle-desktop-notifications(); }
                    }

                    Text {
                        text: "OSC 9 / 777 / BEL 到达且 Tab 非活动时调用 notify-send；未安装则静默跳过。";
                        color: Palette.colors.muted;
                        font-size: 10px;
                        wrap: word-wrap;
                    }

                }

                if root.settings-category == 2 : VerticalLayout {
                    width: 100%;
                    spacing: 14px;

                    ToggleRow {
                        label: "Tab Bar at bottom";
                        on: root.tabbar-bottom;
                        toggled => { root.tabbar-menu-action(6); }
                    }

                    ToggleRow {
                        label: "Quake mode (F12)";
                        on: root.cfg-quake;
                        toggled => { root.toggle-quake(); }
                    }

                    Text {
                        text: "Quake：F12 全局呼出顶部下拉终端（屏宽 70% / 屏高 50%，X11；Wayland 无全局热键）。";
                        color: Palette.colors.muted;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "Tab Bar 位置即时生效并写入配置；关闭多个会话前的确认在 Terminal 分类里。";
                        color: Palette.colors.muted;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                }

                if root.settings-category == 3 : VerticalLayout {
                    width: 100%;
                    spacing: 10px;

                    Text {
                        text: "Config file";
                        color: Palette.colors.subtext;
                        font-size: 12px;
                    }
                    Text {
                        text: root.settings-path;
                        color: Palette.colors.text;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 4px;
                        Rectangle {
                            width: 96px; height: 26px; border-radius: 6px;
                            background: open-path-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
                            border-width: 1px;
                            border-color: Palette.colors.border;
                            open-path-hit := TouchArea {
                                clicked => { root.settings-open-path(); }
                            }
                            Text {
                                text: "Open Folder";
                                color: Palette.colors.text;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                        Rectangle {
                            width: 108px; height: 26px; border-radius: 6px;
                            background: cfg-import-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
                            border-width: 1px;
                            border-color: Palette.colors.border;
                            cfg-import-hit := TouchArea {
                                clicked => { root.config-import-tabby(); }
                            }
                            Text {
                                text: "Import Tabby";
                                color: Palette.colors.text;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                        Rectangle {
                            width: 112px; height: 26px; border-radius: 6px;
                            background: cfg-export-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
                            border-width: 1px;
                            border-color: Palette.colors.border;
                            cfg-export-hit := TouchArea {
                                clicked => { root.config-export-tabby(); }
                            }
                            Text {
                                text: "Export Profiles";
                                color: Palette.colors.text;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                    }
                    Text {
                        text: root.config-status;
                        color: Palette.colors.muted;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "普通配置里不会出现密码或私钥；SSH 密码保存在本地加密 Vault（Settings → Vault）。";
                        color: Palette.colors.muted;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                }

                if root.settings-category == 4 : VerticalLayout {
                    width: 100%;
                    spacing: 6px;

                    // 右上角：冲突数汇总 + 全部重置
                    HorizontalLayout {
                        height: 20px;
                        spacing: 8px;

                        Text {
                            text: root.hotkey-summary;
                            color: Palette.colors.subtext;
                            font-size: 10px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }

                        Text {
                            text: root.hotkey-conflict-count > 0
                                ? "⚠ \{root.hotkey-conflict-count} conflict(s)"
                                : "✓ no conflicts";
                            color: root.hotkey-conflict-count > 0
                                ? Palette.colors.danger
                                : Palette.colors.muted;
                            font-size: 10px;
                            vertical-alignment: center;
                        }

                        ChoiceBtn {
                            width: 72px;
                            height: 20px;
                            font-size: 9px;
                            label: "Reset All";
                            clicked => { root.hotkey-reset-all(); }
                        }
                    }

                    Text {
                        text: root.hotkey-recording-row >= 0
                            ? "Recording: press Ctrl/Alt/Shift + key · Esc cancel · Backspace reset"
                            : "Click Edit, then press a key combination. Esc cancels; Backspace restores the default.";
                        color: root.hotkey-recording-row >= 0
                            ? Palette.colors.accent
                            : Palette.colors.muted;
                        font-size: 10px;
                        wrap: word-wrap;
                    }

                    Flickable {
                        width: 100%;
                        height: 220px;
                        interactive: true;
                        content-height: root.hotkey-rows.length * 28px;

                        VerticalLayout {
                            width: parent.width;
                            spacing: 2px;

                            for row[i] in root.hotkey-rows : Rectangle {
                                height: 26px;
                                border-radius: 4px;
                                background: i == root.hotkey-recording-row
                                    ? Palette.colors.hover
                                    : transparent;

                                Text {
                                    x: 2px;
                                    y: 2px;
                                    width: parent.width - 206px;
                                    height: parent.height - 4px;
                                    text: row.title;
                                    color: Palette.colors.text;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                Text {
                                    x: parent.width - 202px;
                                    y: 1px;
                                    width: 102px;
                                    height: 13px;
                                    text: i == root.hotkey-recording-row ? "Press keys…" : row.chord;
                                    color: i == root.hotkey-recording-row
                                        ? Palette.colors.accent
                                        : (row.conflict ? Palette.colors.danger : Palette.colors.subtext);
                                    font-size: 10px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                Text {
                                    x: parent.width - 202px;
                                    y: 15px;
                                    width: 102px;
                                    height: 10px;
                                    text: row.conflict ? "CONFLICT" : (row.custom ? "CUSTOM" : "");
                                    color: row.conflict ? Palette.colors.danger : Palette.colors.accent;
                                    font-size: 7px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                ChoiceBtn {
                                    x: parent.width - 94px;
                                    y: 4px;
                                    width: 42px;
                                    height: 18px;
                                    font-size: 9px;
                                    label: i == root.hotkey-recording-row ? "Cancel" : "Edit";
                                    active: i == root.hotkey-recording-row;
                                    clicked => {
                                        if (i == root.hotkey-recording-row) {
                                            root.hotkey-cancel-edit();
                                        } else {
                                            root.hotkey-start-edit(i);
                                        }
                                    }
                                }

                                ChoiceBtn {
                                    x: parent.width - 48px;
                                    y: 4px;
                                    width: 46px;
                                    height: 18px;
                                    font-size: 9px;
                                    label: "Reset";
                                    clicked => { root.hotkey-reset(i); }
                                }
                            }
                        }
                    }

                    if root.hotkey-error != "" : Text {
                        text: root.hotkey-error;
                        color: Palette.colors.danger;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                    if root.hotkey-error == "" && root.hotkey-status != "" : Text {
                        text: root.hotkey-status;
                        color: Palette.colors.muted;
                        font-size: 10px;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "单段组合键：Ctrl/Alt/Meta + 键，或 F1–F24。冲突的组合拒绝保存；多段键（Ctrl+K Ctrl+T）暂不支持。";
                        color: Palette.colors.muted;
                        font-size: 9px;
                        wrap: word-wrap;
                    }
                }

                if root.settings-category == 5 : VerticalLayout {
                    width: 100%;
                    spacing: 5px;

                    Text {
                        text: root.plugin-summary;
                        color: Palette.colors.subtext;
                        font-size: 10px;
                    }

                    Text {
                        text: "Installed";
                        color: Palette.colors.muted;
                        font-size: 10px;
                        font-weight: 600;
                    }

                    Flickable {
                        width: 100%;
                        height: 80px;
                        interactive: true;
                        content-height: Math.max(root.plugin-items.length * 20px, 80px);

                        VerticalLayout {
                            width: parent.width;
                            for item[i] in root.plugin-items : Text {
                                height: 20px;
                                text: item;
                                color: Palette.colors.text;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    Text {
                        text: "Recent plugin activity";
                        color: Palette.colors.muted;
                        font-size: 10px;
                        font-weight: 600;
                    }

                    if root.plugin-activity-items.length == 0 : Text {
                        height: 18px;
                        text: "No plugin activity yet — run a plugin command or open a tab with an event plugin installed.";
                        color: Palette.colors.muted;
                        font-size: 9px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Flickable {
                        width: 100%;
                        height: 108px;
                        interactive: true;
                        content-height: Math.max(root.plugin-activity-items.length * 18px, 108px);

                        VerticalLayout {
                            width: parent.width;
                            for item[i] in root.plugin-activity-items : Text {
                                height: 18px;
                                text: item;
                                color: Palette.colors.text;
                                font-size: 10px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    Text {
                        text: root.plugin-dir;
                        color: Palette.colors.muted;
                        font-size: 9px;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "v1 插件 <name>/plugin.toml：命令进 Palette；events 声明 startup/tab-open/tab-close 后于对应时机后台执行。命令与事件都是外部进程（10s 超时），完整输出只写日志，最近 8 条摘要见上方列表。旧 *.toml 仅展示。修改 enabled 后需重启。插件拥有当前用户全部权限，无沙箱。";
                        color: Palette.colors.muted;
                        font-size: 9px;
                        wrap: word-wrap;
                    }
                }

                if root.settings-category == 6 : VerticalLayout {
                    width: 100%;
                    spacing: 7px;

                    Text {
                        text: "状态：\{root.vault-status}";
                        color: Palette.colors.text;
                        font-size: 12px;
                    }
                    Text {
                        text: root.vault-path;
                        color: Palette.colors.muted;
                        font-size: 10px;
                        wrap: word-wrap;
                    }

                    FormRow {
                        label: "Master";
                        text <=> root.vault-password;
                        masked: true;
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        ActionBtn {
                            width: 86px;
                            label: "Set/Change";
                            clicked => { root.vault-set-master(); }
                        }
                        ActionBtn {
                            width: 66px;
                            label: "Unlock";
                            clicked => { root.vault-unlock(); }
                        }
                        ActionBtn {
                            width: 56px;
                            label: "Lock";
                            clicked => { root.vault-lock(); }
                        }
                        ActionBtn {
                            width: 60px;
                            label: "Clear";
                            danger: true;
                            clicked => { root.vault-clear(); }
                        }
                    }

                    Text {
                        visible: root.vault-error != "";
                        text: root.vault-error;
                        color: Palette.colors.danger;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                    Text {
                        visible: root.vault-notice != "";
                        text: root.vault-notice;
                        color: Palette.colors.muted;
                        font-size: 10px;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "主密码只用于 Argon2id 派生，不落盘/不写日志；vault.enc 为 0600、原子写。未初始化时点 Set/Change 创建；已解锁才能改主密码。Clear 需点两次。";
                        color: Palette.colors.subtext;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "SSH 密码认证：勾选保存的 Profile 解锁后用 askpass 自动登录；未勾选则 ssh 在终端里询问。MVP 限制：askpass 密码经子进程环境变量传递，同用户可经 /proc 观察，详见 docs/VAULT.md。";
                        color: Palette.colors.muted;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                }
            }

            // 搜索结果：覆盖右内容区
            if root.settings-query != "" : Rectangle {
                x: 146px;
                y: 64px;
                width: parent.width - 164px;
                height: parent.height - 80px;
                background: Palette.colors.raise;
                border-radius: 8px;
                border-width: 1px;
                border-color: Palette.colors.border;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 6px;
                drop-shadow-color: #000000b0;

                VerticalLayout {
                    padding: 8px;
                    spacing: 2px;

                    Text {
                        height: 22px;
                        text: "\{root.settings-results.length} matches — click to open";
                        color: Palette.colors.muted;
                        font-size: 10px;
                    }

                    for item[i] in root.settings-results : Rectangle {
                        height: 24px;
                        border-radius: 4px;
                        background: res-hit.has-hover ? Palette.colors.hover : transparent;

                        Text {
                            x: 6px;
                            width: parent.width - 12px;
                            text: item;
                            color: Palette.colors.text;
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        res-hit := TouchArea {
                            clicked => { root.settings-open-result(i); }
                        }
                    }
                }
            }

        }
    }

    // ---------------- 无边框窗口拖边/拖角缩放 ----------------
    // 自绘命中区：直接改窗口 size/position，不依赖 WM 的 moveresize。
    ResizeHandle {
        x: 0px; y: 6px; width: 5px; height: root.height - 12px;
        direction: 7;
        mouse-cursor: ew-resize;
        begin(d) => { root.start-window-resize(d); }
        drag => { root.window-resize-drag(); }
        stop => { root.end-window-resize(); }
    }
    ResizeHandle {
        x: root.width - 5px; y: 6px; width: 5px; height: root.height - 12px;
        direction: 3;
        mouse-cursor: ew-resize;
        begin(d) => { root.start-window-resize(d); }
        drag => { root.window-resize-drag(); }
        stop => { root.end-window-resize(); }
    }
    ResizeHandle {
        x: 6px; y: 0px; width: root.width - 12px; height: 5px;
        direction: 1;
        mouse-cursor: ns-resize;
        begin(d) => { root.start-window-resize(d); }
        drag => { root.window-resize-drag(); }
        stop => { root.end-window-resize(); }
    }
    ResizeHandle {
        x: 6px; y: root.height - 5px; width: root.width - 12px; height: 5px;
        direction: 5;
        mouse-cursor: ns-resize;
        begin(d) => { root.start-window-resize(d); }
        drag => { root.window-resize-drag(); }
        stop => { root.end-window-resize(); }
    }
    ResizeHandle {
        x: 0px; y: 0px; width: 8px; height: 8px;
        direction: 0;
        mouse-cursor: nwse-resize;
        begin(d) => { root.start-window-resize(d); }
        drag => { root.window-resize-drag(); }
        stop => { root.end-window-resize(); }
    }
    ResizeHandle {
        x: root.width - 8px; y: 0px; width: 8px; height: 8px;
        direction: 2;
        mouse-cursor: nesw-resize;
        begin(d) => { root.start-window-resize(d); }
        drag => { root.window-resize-drag(); }
        stop => { root.end-window-resize(); }
    }
    ResizeHandle {
        x: 0px; y: root.height - 8px; width: 8px; height: 8px;
        direction: 6;
        mouse-cursor: nesw-resize;
        begin(d) => { root.start-window-resize(d); }
        drag => { root.window-resize-drag(); }
        stop => { root.end-window-resize(); }
    }
    ResizeHandle {
        x: root.width - 8px; y: root.height - 8px; width: 8px; height: 8px;
        direction: 4;
        mouse-cursor: nwse-resize;
        begin(d) => { root.start-window-resize(d); }
        drag => { root.window-resize-drag(); }
        stop => { root.end-window-resize(); }
    }
}
