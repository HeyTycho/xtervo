    // 单个 Tab 的右键菜单（窗口坐标）
    in-out property <bool> tabctx-open: false;
    in-out property <length> tabctx-x: 0px;
    /// 竖排 Tab 的右键锚点 y（窗口坐标）；上/下模式不用它。
    in-out property <length> tabctx-y: 0px;
    in-out property <int> tabctx-index: -1;
    property <bool> tabctx-pinned: root.tabctx-index >= 0 && root.tabctx-index < root.tabs.length
