// SPDX-License-Identifier: GPL-3.0-only
// 界面 chrome 配色：由 Rust 侧按当前主题写入。
export struct ThemeColors {
    bg: color,
    surface: color,
    raise: color,
    hover: color,
    border: color,
    text: color,
    subtext: color,
    muted: color,
    accent: color,
    accent-text: color,
    danger: color,
}


/// 全局语言：Rust 设置 `code`（"en" / "zh"）；静态文案统一通过 `Lang.t(en, zh)`
/// 绑定，属性变化时所有文字自动重算，无需重建组件。
export global Lang {
    in-out property <string> code: "en";
    pure public function t(en: string, zh: string) -> string {
        if (code == "zh") {
            return zh;
        }
        return en;
    }
}

// 默认值 = Tokyo Night（与 core::Theme 的默认主题保持一致）。
export global Palette {
    in-out property <ThemeColors> colors: {
        bg: #1a1b26,
        surface: #16161e,
        raise: #24283b,
        hover: #292e42,
        border: #3b4261,
        text: #c0caf5,
        subtext: #a9b1d6,
        muted: #565f89,
        accent: #7aa2f7,
        accent-text: #1a1b26,
        danger: #f7768e,
    };
}

export struct ThemeChoice {
    id: string,
    label: string,
}

/// 设置 → Hotkeys 的一行：命令标题 + 当前生效 chord + 状态。
export struct HotkeyRow {
    command: string,
    title: string,
    chord: string,
    /// 有用户 override（不再是默认绑定）
    custom: bool,
    /// 当前生效 chord 与其他命令冲突
    conflict: bool,
}

/// 终端右键菜单的一行（UI-TERM-013：表驱动，Rust 按 config + 插件注册生成）。
export struct MenuEntry {
    label: string,
    shortcut: string,
    danger: bool,
    active: bool,
    separator: bool,
    /// 点击时回调给 Rust 的命令 ID（内置命令 / 插件完整 ID / link.* 特殊 ID）。
    command: string,
}

/// Settings → Plugins 的一行：v3 行带操作按钮；v1/v2 行 supported=false。
export struct PluginRowView {
    key: string,
    name: string,
    version: string,
    api: string,
    runtime: string,
    status: string,
    error: string,
    permissions: string,
    restart-count: int,
    enabled: bool,
    needs-approval: bool,
    supported: bool,
    has-panel: bool,
    has-settings: bool,
    assistant: bool,
    surface-ready: bool,
    /// 本地安装来源（安装器写入；手放为 manual）
    source: string,
    /// verified / unsigned / invalid / unverifiable（实时校验）
    signature: string,
    has-backup: bool,
    backup-version: string,
}

/// 插件只能提供这些固定声明式元素；布局/样式/控件全部由宿主决定。
export struct PluginUiElement {
    kind: string,
    id: string,
    label: string,
    text: string,
    value: string,
    placeholder: string,
    progress: float,
}

export struct DividerView {
    index: int,
    x: length,
    y: length,
    w: length,
    h: length,
    /// true = 左右分屏（竖线，拖 x）；false = 上下分屏（横线，拖 y）
    vertical: bool,
}

/// 终端 pane 上的一张内联图片（Sixel）：pane 内像素坐标，独立 Image overlay。
export struct PaneImage {
    id: int,
    x: length,
    y: length,
    w: length,
    h: length,
}

export struct PaneView {
    id: int,
    image: image,
    x: length,
    y: length,
    w: length,
    h: length,
    focused: bool,
    iw: length,
    ih: length,
    /// 光标 overlay（cell 大小的小图）；终端帧本身不画光标。
    cursor-image: image,
    cursor-x: length,
    cursor-y: length,
    cursor-w: length,
    cursor-h: length,
    /// 闪烁相位 + 终端 SHOW_CURSOR 合并后的可见性。
    cursor-visible: bool,
    /// 终端启用了鼠标上报（1000/1002/1003）：中键/右键/滚轮要转发给 PTY。
    mouse-reporting: bool,
    /// scrollback 超出视口时显示右侧 overlay 滚动条。
    scrollbar-visible: bool,
    /// thumb 顶部相对 pane 的 y（像素）与高度；track 高度 = 终端网格像素高。
    scrollbar-thumb-y: length,
    scrollbar-thumb-h: length,
    scrollbar-track-h: length,
    /// 活动 pane 收到 BEL 时短暂闪烁边框。
    bell-flash: bool,
    /// 终端处于 Read Only：键盘/粘贴不写 PTY，pane 角标提示。
    read-only: bool,
    /// 鼠标悬停在可点击链接（URL/OSC 8/路径）上：TouchArea 用 pointer 手型。
    /// 由 Rust 按格扫描后在悬停状态变化时更新，不触发终端帧重绘。
    link-hover: bool,
    /// Sixel 图片 overlay（按创建顺序，后创建的画在上面）。图片不进终端
    /// cell 文本/选区，也不触发终端帧重绘。
    images: [PaneImage],
    /// 调试用行号（TERVO_LINE_NUMBERS=1）。正常为空。
    line-numbers: [string],
    line-h: length,
}

export struct TabView {
    title: string,
    active: bool,
    /// OSC 9;4 状态：0=清除 1=进行中 2=错误 3=不确定 4=暂停
    progress-state: int,
    /// 进度条比例 0.0..=1.0（不确定进度由 Rust 侧给固定比例）
    progress-ratio: float,
    /// 百分比文本（如 "42%"）；无合法百分比时为空
    progress-label: string,
    /// 未读通知点
    attention: bool,
    /// 刚完成（进度从有到清除）的完成标记
    completed: bool,
    /// 后台活动（非活动 Tab 收到输出/标题/进度）；切到该 Tab 时清除
    background: bool,
    /// 会话失败（非零退出 / 信号终止 / OSC 进度错误）；切到该 Tab 时清除
    failed: bool,
    /// 通用连接状态（SESS-007）：0=None 1=Connected 2=Connecting 3=Disconnected 4=Failed
    connection-state: int,
    /// 连接状态说明（含重试次数），悬停 Tab 时显示。
    connection-tooltip: string,
    /// Pin 在左侧固定区（Tab 级，不是窗口置顶）。
    pinned: bool,
}

/// Profiles 面板的一行：过滤/星标都在 Rust 侧算好，UI 只负责画。
export struct ProfileRow {
    /// Profile 稳定 ID（调试/未来扩展用；分组标题行 = -1）
    id: int,
    /// Profile 行：形如 `[local] work`；分组标题行：`▾ Work (2)`。
    label: string,
    /// 是否为“新 Tab 默认 Profile”（行首星标）
    is-default: bool,
    /// 分组标题行（点击折叠/展开，不提供打开/编辑/删除）
    is-header: bool,
    /// 该分组当前是否折叠（只对 is-header 有意义）
    collapsed: bool,
    /// 所属分组名；`""` = 未分组。标题行点击时原样回传给 Rust。
    group: string,
}

component MenuRow inherits Rectangle {
    in property <string> label;
    /// 键盘高亮行（Profile 菜单 ↑↓ 用；其它菜单保持 false）。
    in property <bool> selected: false;
    callback picked();

    height: 28px;
    border-radius: 4px;
    background: hit.has-hover
        ? Palette.colors.hover
        : (root.selected ? Palette.colors.bg : transparent);

    // 高亮行左侧 accent 标记：不依赖背景色差，键盘选择一眼可见。
    Rectangle {
        visible: root.selected;
        x: 2px;
        y: 6px;
        width: 2px;
        height: 16px;
        border-radius: 1px;
        background: Palette.colors.accent;
    }

    hit := TouchArea {
        clicked => { root.picked(); }
    }

    Text {
        x: 10px;
        text: root.label;
        color: Palette.colors.text;
        font-size: 12px;
        vertical-alignment: center;
        width: parent.width - 12px;
    }
}

/// 设置页工作区列表的一行：名字/pane 数/创建时间（全部由 Rust 算好）。
export struct WorkspaceRow {
    name: string,
    /// 布局里的 pane 数（split 树的叶子数）。
    panes: int,
    /// `YYYY-MM-DD HH:MM UTC`；旧记录没有创建时间时为 “—”。
    created: string,
}

/// 菜单分组标题：13px semi-bold 次级色；非首组顶部画一条 1px 分隔线。
component MenuGroupLabel inherits Rectangle {
    in property <string> label;
    in property <bool> first: false;

    height: 22px;
    background: transparent;

    Rectangle {
        visible: !root.first;
        x: 6px;
        y: 0px;
        width: parent.width - 12px;
        height: 1px;
        background: Palette.colors.border;
        opacity: 0.6;
    }
    Text {
        x: 10px;
        y: 2px;
        width: parent.width - 20px;
        height: parent.height - 2px;
        text: root.label;
        color: Palette.colors.subtext;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.4px;
        vertical-alignment: center;
        overflow: elide;
    }
}

/// 右键菜单分隔：只画一条低对比度横线，不占菜单项高度。
/// 终端右键菜单项：30px 行高 / 14px 标签 + 可选快捷键提示，无图标。
/// 只在终端 pane 菜单里使用，TabBar/Profile 菜单仍用紧凑的 MenuRow（行为不变）。
component ContextMenuRow inherits Rectangle {
    in property <string> label;
    in property <string> shortcut: "";
    /// 状态类菜单项（Read Only / Broadcast）开启时用 accent 淡底提示。
    in property <bool> active: false;
    /// 键盘导航当前选中行（UI-TERM-004）：与 hover 用同一高亮，鼠标移动不抢选中。
    in property <bool> selected: false;
    in property <bool> danger: false;
    callback picked();

    height: 30px;
    border-radius: 5px;
    background: hit.has-hover || root.selected ? Palette.colors.hover : transparent;

    // 状态项：轻量 accent 洗色，不压过文字对比度。
    if root.active && !hit.has-hover && !root.selected : Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 5px;
        background: Palette.colors.accent;
        opacity: 0.10;
    }

    hit := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.picked(); }
    }

    // 悬停/键盘选中左侧标记；关闭 pane 用 danger 色提示破坏性。
    Rectangle {
        x: 2px;
        y: 9px;
        width: 2px;
        height: 12px;
        border-radius: 1px;
        background: root.danger ? Palette.colors.danger : Palette.colors.accent;
        visible: hit.has-hover || root.selected;
    }

    Text {
        x: 10px;
        y: 0px;
        width: parent.width - 10px - (root.shortcut == "" ? 12px : 104px);
        height: 100%;
        text: root.label;
        color: root.danger && hit.has-hover ? Palette.colors.danger : Palette.colors.text;
        font-size: 14px;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.shortcut != "" : Text {
        x: parent.width - 106px;
        y: 0px;
        width: 96px;
        height: 100%;
        text: root.shortcut;
        color: Palette.colors.subtext;
        font-size: 11px;
        horizontal-alignment: right;
        vertical-alignment: center;
        opacity: 0.92;
    }
}

/// 菜单表的一行：普通项复用 ContextMenuRow，separator=true 时画分隔线。
/// 高度与 Rust 侧 menu-content-h 的计算保持一致（30px / 9px）。
component ContextMenuEntry inherits Rectangle {
    in property <MenuEntry> entry;
    /// 键盘导航当前选中行（UI-TERM-004）。
    in property <bool> selected: false;
    callback picked(string);

    height: entry.separator ? 9px : 30px;

    if entry.separator : Rectangle {
        x: 6px;
        y: 4px;
        width: parent.width - 12px;
        height: 1px;
        background: Palette.colors.border;
        opacity: 0.55;
    }

    if !entry.separator : ContextMenuRow {
        width: 100%;
        height: 100%;
        label: entry.label;
        shortcut: entry.shortcut;
        danger: entry.danger;
        active: entry.active;
        selected: root.selected;
        picked => { root.picked(entry.command); }
    }
}


// 设置页里的动作按钮（Vault 等）
component ActionBtn inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    in property <length> font-size: 11px;
    callback clicked();

    height: 26px;
    border-radius: 6px;
    background: hit.has-hover
        ? (root.danger ? Palette.colors.danger : Palette.colors.hover)
        : Palette.colors.raise;
    border-width: 1px;
    border-color: root.danger ? Palette.colors.danger : Palette.colors.border;

    hit := TouchArea {
        clicked => { root.clicked(); }
    }
    Text {
        text: root.label;
        color: root.danger && hit.has-hover ? Palette.colors.accent-text : Palette.colors.text;
        font-size: root.font-size;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
        overflow: elide;
    }
}

component FormRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> text;
    /// 标签列宽；紧凑的两列外观行用 64px，默认保持原设置表单样式。
    in property <length> label-width: 64px;
    /// true = 密码输入（Slint 负责 masked 显示）
    in property <bool> masked: false;
    spacing: 8px;

    Text {
        width: root.label-width;
        text: root.label;
        color: Palette.colors.subtext;
        font-size: 12px;
        vertical-alignment: center;
    }
    Rectangle {
        height: 26px;
        horizontal-stretch: 1;
        border-radius: 4px;
        background: Palette.colors.bg;
        border-width: 1px;
        border-color: Palette.colors.border;

        TextInput {
            x: 6px;
            width: parent.width - 12px;
            height: parent.height;
            text <=> root.text;
            single-line: true;
            input-type: root.masked ? InputType.password : InputType.text;
            color: Palette.colors.text;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

// 设置面板里的开关行
component ToggleRow inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback toggled();

    height: 26px;

    Text {
        x: 0px;
        width: parent.width - 56px;
        text: root.label;
        color: Palette.colors.text;
        font-size: 12px;
        vertical-alignment: center;
    }

    Rectangle {
        x: parent.width - 44px;
        y: 4px;
        width: 40px;
        height: 18px;
        border-radius: 9px;
        background: root.on ? Palette.colors.accent : Palette.colors.hover;

        Rectangle {
            x: root.on ? parent.width - 16px : 2px;
            y: 2px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: Palette.colors.bg;
        }

        TouchArea {
            clicked => { root.toggled(); }
        }
    }
}

/// 设置页的百分比滑块。拖动时 preview（不落盘），松手 changed（保存）。
/// min/max 由调用方给：终端 opacity = 0–1，背景遮罩 = 0–0.8。
component OpacitySlider inherits Rectangle {
    in-out property <float> value: 1.0;
    in property <float> min: 0.0;
    in property <float> max: 1.0;
    callback preview(float);
    callback changed(float);

    property <float> ratio: {
        let span = root.max - root.min;
        span <= 0.0 ? 0.0 : Math.max(0.0, Math.min(1.0, (root.value - root.min) / span))
    }
    height: 22px;
    background: transparent;

    // 轨道左右各留 4px，滑块圆心也限制在轨道内。
    Rectangle {
        x: 4px;
        y: (parent.height - 4px) / 2;
        width: parent.width - 8px;
        height: 4px;
        border-radius: 2px;
        background: Palette.colors.border;
    }

    Rectangle {
        x: 4px;
        y: (parent.height - 4px) / 2;
        width: (parent.width - 8px) * root.ratio;
        height: 4px;
        border-radius: 2px;
        background: Palette.colors.accent;
    }

    Rectangle {
        x: 4px + (parent.width - 8px) * root.ratio - 6px;
        y: (parent.height - 12px) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Palette.colors.text;
        border-width: 1px;
        border-color: Palette.colors.bg;
    }

    // 只有左键按下后才跟踪移动；否则鼠标悬停/划过会不断 preview，
    // 看起来像滑块“粘住鼠标”。down 允许直接点轨道跳转。
    property <bool> dragging: false;

    TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down
                && event.button == PointerEventButton.left) {
                root.dragging = true;
                // length 需除以 1px 转成普通数字再算比例。
                let track = (self.width - 8px) / 1px;
                let x = (self.mouse-x - 4px) / 1px;
                let t = track <= 0.0 ? 0.0 : Math.max(0.0, Math.min(1.0, x / track));
                // 不直接写 root.value：父级用绑定把 main.* 流回来，
                // 直接赋值会打断绑定导致外部（Rust）更新滑块时不同步。
                root.preview(root.min + t * (root.max - root.min));
                return EventResult.accept;
            }
            if (event.kind == PointerEventKind.move && root.dragging) {
                let track = (self.width - 8px) / 1px;
                let x = (self.mouse-x - 4px) / 1px;
                let t = track <= 0.0 ? 0.0 : Math.max(0.0, Math.min(1.0, x / track));
                root.preview(root.min + t * (root.max - root.min));
                return EventResult.accept;
            }
            if (event.kind == PointerEventKind.up && root.dragging) {
                root.dragging = false;
                root.changed(root.value);
                return EventResult.accept;
            }
            EventResult.reject
        }
    }
}

component ChoiceBtn inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <length> font-size: 12px;
    callback clicked();

    width: 76px;
    height: 26px;
    border-radius: 6px;
    background: root.active ? Palette.colors.accent : (hit.has-hover ? Palette.colors.hover : Palette.colors.raise);
    border-width: 1px;
    border-color: root.active ? Palette.colors.accent : Palette.colors.border;

    hit := TouchArea {
        clicked => { root.clicked(); }
    }
    Text {
        text: root.label;
        color: root.active ? Palette.colors.accent-text : Palette.colors.text;
        font-size: root.font-size;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
        overflow: elide;
    }
}

/// 设置分类图标：统一 16×16 线性图标（细描边、低对比度）。
/// 全部用 Path/Rectangle 手绘，避免依赖字体里是否有对应符号或混入 emoji。
enum SettingsIconKind {
    appearance,
    terminal,
    window,
    keys,
    profiles,
    plugins,
    vault,
    advanced,
    help,
    privacy,
    gear,
    search,
    chevron,
}

component SettingsIconView inherits Rectangle {
    in property <SettingsIconKind> kind: SettingsIconKind.appearance;
    in property <color> tint: Palette.colors.subtext;

    width: 16px;
    height: 16px;
    background: transparent;

    // Appearance / theme：中心圆 + 8 条光线。
    if root.kind == SettingsIconKind.appearance : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        Rectangle {
            x: 5px; y: 5px; width: 6px; height: 6px;
            border-radius: 3px;
            background: transparent;
            border-width: 1.3px;
            border-color: root.tint;
        }
        Path {
            width: 100%; height: 100%;
            commands: "M 8 1 L 8 3 M 8 13 L 8 15 M 1 8 L 3 8 M 13 8 L 15 8 M 3 3 L 4.5 4.5 M 11.5 11.5 L 13 13 M 13 3 L 11.5 4.5 M 4.5 11.5 L 3 13";
            stroke: root.tint;
            stroke-width: 1.3px;
            stroke-line-cap: round;
        }
    }

    // Terminal：>_ 提示符。
    if root.kind == SettingsIconKind.terminal : Path {
        width: 100%; height: 100%;
        commands: "M 2.5 3.5 L 7 8 L 2.5 12.5 M 8.5 12.5 L 13.5 12.5";
        stroke: root.tint;
        stroke-width: 1.4px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    // Window：外框 + 标题栏分隔线。
    if root.kind == SettingsIconKind.window : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        Rectangle {
            x: 2px; y: 3px; width: 12px; height: 10px;
            border-radius: 2px;
            background: transparent;
            border-width: 1.3px;
            border-color: root.tint;
        }
        Rectangle {
            x: 2px; y: 6px; width: 12px; height: 1px;
            background: root.tint;
        }
    }

    // Keys：键盘外框 + 键帽点。
    if root.kind == SettingsIconKind.keys : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        Rectangle {
            x: 1.5px; y: 4.5px; width: 13px; height: 7px;
            border-radius: 2px;
            background: transparent;
            border-width: 1.3px;
            border-color: root.tint;
        }
        Path {
            width: 100%; height: 100%;
            commands: "M 4 7 L 4.5 7 M 6.5 7 L 7 7 M 9 7 L 9.5 7 M 11.5 7 L 12 7 M 5 9.5 L 11 9.5";
            stroke: root.tint;
            stroke-width: 1.2px;
            stroke-line-cap: round;
        }
    }

    // Profiles：头像 + 肩线。
    if root.kind == SettingsIconKind.profiles : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        Rectangle {
            x: 5px; y: 1.5px; width: 6px; height: 6px;
            border-radius: 3px;
            background: transparent;
            border-width: 1.3px;
            border-color: root.tint;
        }
        Path {
            width: 100%; height: 100%;
            commands: "M 2.5 14 C 2.5 10.8 5 9.5 8 9.5 C 11 9.5 13.5 10.8 13.5 14";
            stroke: root.tint;
            stroke-width: 1.3px;
            stroke-line-cap: round;
        }
    }

    // Plugins：插头（两脚 + 本体 + 线）。
    if root.kind == SettingsIconKind.plugins : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        Rectangle {
            x: 3px; y: 5px; width: 10px; height: 6px;
            border-radius: 2px;
            background: transparent;
            border-width: 1.3px;
            border-color: root.tint;
        }
        Path {
            width: 100%; height: 100%;
            commands: "M 5.5 1.5 L 5.5 5 M 10.5 1.5 L 10.5 5 M 8 11 L 8 14";
            stroke: root.tint;
            stroke-width: 1.3px;
            stroke-line-cap: round;
        }
    }

    // Vault：锁体 + 锁梁。
    if root.kind == SettingsIconKind.vault : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        Rectangle {
            x: 3px; y: 7px; width: 10px; height: 7px;
            border-radius: 2px;
            background: transparent;
            border-width: 1.3px;
            border-color: root.tint;
        }
        Path {
            width: 100%; height: 100%;
            commands: "M 5 7 L 5 4.5 C 5 1.8 11 1.8 11 4.5 L 11 7 M 8 9.5 L 8 11.5";
            stroke: root.tint;
            stroke-width: 1.3px;
            stroke-line-cap: round;
        }
    }

    // Advanced：三条滑杆 + 旋钮。
    if root.kind == SettingsIconKind.advanced : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        Path {
            width: 100%; height: 100%;
            commands: "M 2 4 L 14 4 M 2 8 L 14 8 M 2 12 L 14 12";
            stroke: root.tint;
            stroke-width: 1.3px;
            stroke-line-cap: round;
        }
        Rectangle {
            x: 5px; y: 2.5px; width: 3px; height: 3px;
            border-radius: 1.5px;
            background: Palette.colors.surface;
            border-width: 1px;
            border-color: root.tint;
        }
        Rectangle {
            x: 9px; y: 6.5px; width: 3px; height: 3px;
            border-radius: 1.5px;
            background: Palette.colors.surface;
            border-width: 1px;
            border-color: root.tint;
        }
        Rectangle {
            x: 4px; y: 10.5px; width: 3px; height: 3px;
            border-radius: 1.5px;
            background: Palette.colors.surface;
            border-width: 1px;
            border-color: root.tint;
        }
    }

    // Privacy：盾牌轮廓 + 中心锁孔（不依赖字体/emoji）。
    if root.kind == SettingsIconKind.privacy : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        Path {
            width: 100%; height: 100%;
            commands: "M 8 1.5 L 13 3.5 L 13 8 C 13 11 10.8 12.9 8 14.5 C 5.2 12.9 3 11 3 8 L 3 3.5 Z";
            stroke: root.tint;
            stroke-width: 1.3px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }
        Rectangle {
            x: 6.2px; y: 6.2px; width: 3.6px; height: 3.6px;
            border-radius: 1.8px;
            background: transparent;
            border-width: 1px;
            border-color: root.tint;
        }
    }

    // Help：圆形问号（圆环 + 手绘问号笔画 + 点，不依赖字体/emoji）。
    if root.kind == SettingsIconKind.help : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        Rectangle {
            x: 1.6px; y: 1.6px; width: 12.8px; height: 12.8px;
            border-radius: 6.4px;
            background: transparent;
            border-width: 1.3px;
            border-color: root.tint;
        }
        Path {
            width: 100%; height: 100%;
            commands: "M 5.9 6.1 C 5.9 4.7 6.9 3.9 8.1 3.9 C 9.3 3.9 10.2 4.7 10.2 5.9 C 10.2 7.5 8.1 7.7 8.1 9.4";
            stroke: root.tint;
            stroke-width: 1.3px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }
        Rectangle {
            x: 7.3px; y: 10.5px; width: 1.6px; height: 1.6px;
            border-radius: 0.8px;
            background: root.tint;
        }
    }

    // Gear：8 齿实心轮廓 + 中心圆孔（内圈反向绕序挖空）。
    // 齿与轮体连成一体：旧版“圆环 + 8 条分离短线”在 16px 下会被读成太阳。
    if root.kind == SettingsIconKind.gear : Path {
        width: 100%;
        height: 100%;
        commands: "M 12.78 6.54 L 14.87 6.66 L 14.87 9.34 L 12.78 9.46 L 12.41 10.35 L 13.80 11.91 L 11.91 13.80 L 10.35 12.41 L 9.46 12.78 L 9.34 14.87 L 6.66 14.87 L 6.54 12.78 L 5.65 12.41 L 4.09 13.80 L 2.20 11.91 L 3.59 10.35 L 3.22 9.46 L 1.13 9.34 L 1.13 6.66 L 3.22 6.54 L 3.59 5.65 L 2.20 4.09 L 4.09 2.20 L 5.65 3.59 L 6.54 3.22 L 6.66 1.13 L 9.34 1.13 L 9.46 3.22 L 10.35 3.59 L 11.91 2.20 L 13.80 4.09 L 12.41 5.65 Z M 10.20 8.00 L 10.13 7.43 L 9.91 6.90 L 9.56 6.44 L 9.10 6.09 L 8.57 5.87 L 8.00 5.80 L 7.43 5.87 L 6.90 6.09 L 6.44 6.44 L 6.09 6.90 L 5.87 7.43 L 5.80 8.00 L 5.87 8.57 L 6.09 9.10 L 6.44 9.56 L 6.90 9.91 L 7.43 10.13 L 8.00 10.20 L 8.57 10.13 L 9.10 9.91 L 9.56 9.56 L 9.91 9.10 L 10.13 8.57 Z";
        fill: root.tint;
    }

    // Search：圆环 + 手柄。
    if root.kind == SettingsIconKind.search : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        Rectangle {
            x: 2px; y: 2px; width: 8px; height: 8px;
            border-radius: 4px;
            background: transparent;
            border-width: 1.4px;
            border-color: root.tint;
        }
        Path {
            width: 100%; height: 100%;
            commands: "M 9 9 L 14 14";
            stroke: root.tint;
            stroke-width: 1.4px;
            stroke-line-cap: round;
        }
    }

    // Chevron：下拉箭头。
    if root.kind == SettingsIconKind.chevron : Path {
        width: 100%; height: 100%;
        commands: "M 4 6 L 8 10 L 12 6";
        stroke: root.tint;
        stroke-width: 1.4px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

/// 设置项开关（右侧，整行点击也可切换）。
component SettingsSwitch inherits Rectangle {
    in property <bool> on: false;
    callback toggled();

    width: 42px;
    height: 22px;
    border-radius: 11px;
    background: root.on ? Palette.colors.accent : Palette.colors.hover;
    border-width: 1px;
    border-color: root.on ? Palette.colors.accent : Palette.colors.border;
    animate background, border-color { duration: 120ms; easing: ease-out; }

    Rectangle {
        x: root.on ? parent.width - 19px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.on ? Palette.colors.accent-text : Palette.colors.subtext;
        animate x, background { duration: 120ms; easing: ease-out; }
    }

    TouchArea {
        clicked => { root.toggled(); }
    }
}

/// 布尔设置行：左侧标题/说明，右侧 switch。
component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> description: "";
    spacing: 12px;
    cross-axis-alignment: center;

    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 2px;
        Text {
            text: root.label;
            color: Palette.colors.text;
            font-size: 12px;
            wrap: word-wrap;
        }
        if root.description != "" : Text {
            text: root.description;
            color: Palette.colors.muted;
            font-size: 10px;
            wrap: word-wrap;
        }
    }

    @children
}

/// 堆叠设置项：标题/说明在上，下拉/分段/滑杆/输入占满整行。
component SettingField inherits VerticalLayout {
    in property <string> label;
    in property <string> description: "";
    width: 100%;
    spacing: 6px;

    Text {
        text: root.label;
        color: Palette.colors.text;
        font-size: 12px;
    }
    if root.description != "" : Text {
        text: root.description;
        color: Palette.colors.muted;
        font-size: 10px;
        wrap: word-wrap;
    }

    @children
}

/// 设置分组卡片：标题 + 子项；搜索结果跳转时边框/标题用 accent 高亮。
component SettingsCard inherits Rectangle {
    in property <string> title;
    in property <string> description: "";
    in property <bool> highlighted: false;

    height: card-layout.preferred-height;
    border-radius: 10px;
    background: root.highlighted ? Palette.colors.hover : Palette.colors.surface;
    border-width: 1px;
    border-color: root.highlighted ? Palette.colors.accent : Palette.colors.border;
    animate background, border-color { duration: 160ms; easing: ease-out; }

    card-layout := VerticalLayout {
        width: 100%;
        padding: 14px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.title;
                color: root.highlighted ? Palette.colors.accent : Palette.colors.subtext;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; height: 1px; background: transparent; }
            // 高亮的小圆点：搜索跳转后明确指向当前分组。
            Rectangle {
                visible: root.highlighted;
                width: 6px; height: 6px;
                border-radius: 3px;
                background: Palette.colors.accent;
            }
        }

        if root.description != "" : Text {
            text: root.description;
            color: Palette.colors.muted;
            font-size: 10px;
            wrap: word-wrap;
        }

        @children
    }
}

/// Help 页快捷键行：左列固定 chord，右列动作文字换行，窄窗不横向溢出。
component HelpRow inherits HorizontalLayout {
    in property <string> keys;
    in property <string> action;

    spacing: 12px;
    Text {
        width: 136px;
        text: root.keys;
        color: Palette.colors.accent;
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        horizontal-stretch: 1;
        text: root.action;
        color: Palette.colors.text;
        font-size: 11px;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

/// Help 页信息行：label 固定宽，value 可换行（路径/commit 不撑破卡片）。
component HelpInfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;

    spacing: 10px;
    Text {
        width: 86px;
        text: root.label;
        color: Palette.colors.subtext;
        font-size: 11px;
        vertical-alignment: center;
    }
    Text {
        horizontal-stretch: 1;
        text: root.value;
        color: Palette.colors.text;
        font-size: 11px;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

/// 分段选择器：2–3 个互斥选项；选中态用 accent，不再铺一排 chip。
component Segmented inherits Rectangle {
    in property <[string]> options: [];
    in property <[string]> values: [];
    in property <string> value: "";
    callback picked(string);

    width: 100%;
    height: 32px;
    border-radius: 8px;
    background: Palette.colors.bg;
    border-width: 1px;
    border-color: Palette.colors.border;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;

        for opt[i] in root.options : Rectangle {
            horizontal-stretch: 1;
            height: 26px;
            border-radius: 6px;
            property <bool> selected: i < root.values.length && root.values[i] == root.value;
            background: selected
                ? Palette.colors.accent
                : (seg-hit.has-hover ? Palette.colors.hover : transparent);
            animate background { duration: 120ms; easing: ease-out; }

            seg-hit := TouchArea {
                clicked => {
                    if (i < root.values.length) {
                        root.picked(root.values[i]);
                    }
                }
            }

            Text {
                text: opt;
                color: selected ? Palette.colors.accent-text : Palette.colors.subtext;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
                overflow: elide;
            }
        }
    }
}

/// 数值步进器：− / 当前值 / +（字号、回滚行数等）。
component Stepper inherits Rectangle {
    in property <string> text: "";
    callback minus();
    callback plus();

    width: 100%;
    height: 32px;
    border-radius: 8px;
    background: Palette.colors.bg;
    border-width: 1px;
    border-color: Palette.colors.border;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;

        Rectangle {
            width: 30px;
            height: 26px;
            border-radius: 6px;
            background: step-minus.has-hover ? Palette.colors.hover : Palette.colors.raise;
            Text {
                text: "−";
                color: Palette.colors.text;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
            step-minus := TouchArea { clicked => { root.minus(); } }
        }

        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Palette.colors.text;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            width: 30px;
            height: 26px;
            border-radius: 6px;
            background: step-plus.has-hover ? Palette.colors.hover : Palette.colors.raise;
            Text {
                text: "+";
                color: Palette.colors.text;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
            step-plus := TouchArea { clicked => { root.plus(); } }
        }
    }
}

/// 设置页文本输入：支持占位符、密码掩码、红色错误描边、可选清除按钮。
component SettingsTextField inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder: "";
    in property <bool> masked: false;
    in property <bool> error: false;
    in property <bool> clearable: false;
    /// 失焦提交（仅背景图路径等需要校验的字段）：旧 modal 的 changed has-focus 行为。
    in property <bool> commit-on-blur: false;
    callback edited(string);
    callback accepted(string);
    callback cleared();
    callback blurred(string);

    width: 100%;
    height: 32px;
    border-radius: 8px;
    background: Palette.colors.bg;
    border-width: 1px;
    border-color: root.error ? Palette.colors.danger : Palette.colors.border;

    Text {
        x: 10px;
        width: parent.width - (root.clearable && root.text != "" ? 42px : 20px);
        height: parent.height;
        text: root.placeholder;
        color: Palette.colors.muted;
        font-size: 11px;
        vertical-alignment: center;
        visible: root.text == "";
        overflow: elide;
    }

    TextInput {
        x: 10px;
        width: parent.width - (root.clearable && root.text != "" ? 42px : 20px);
        height: parent.height;
        text <=> root.text;
        single-line: true;
        input-type: root.masked ? InputType.password : InputType.text;
        color: Palette.colors.text;
        font-size: 11px;
        vertical-alignment: center;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
        changed has-focus => {
            if (!self.has-focus && root.commit-on-blur) {
                root.blurred(self.text);
            }
        }
    }

    if root.clearable && root.text != "" : Rectangle {
        x: parent.width - 30px;
        y: 6px;
        width: 20px;
        height: 20px;
        border-radius: 4px;
        background: field-clear.has-hover ? Palette.colors.hover : transparent;
        Text {
            text: "×";
            color: Palette.colors.muted;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }
        field-clear := TouchArea {
            clicked => {
                root.text = "";
                root.cleared();
            }
        }
    }
}

/// 左侧分类项：线性图标 + 标签；选中态用 accent 边条/文字，而不是整块高饱和底。
component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <SettingsIconKind> icon: SettingsIconKind.appearance;
    callback clicked();

    height: 34px;
    border-radius: 7px;
    background: root.active
        ? Palette.colors.hover
        : (hit.has-hover ? Palette.colors.surface : transparent);
    animate background { duration: 120ms; easing: ease-out; }

    Rectangle {
        visible: root.active;
        x: 0px;
        y: 7px;
        width: 2px;
        height: 20px;
        border-radius: 1px;
        background: Palette.colors.accent;
    }

    SettingsIconView {
        x: 11px;
        y: 9px;
        kind: root.icon;
        tint: root.active ? Palette.colors.accent : Palette.colors.subtext;
    }

    Text {
        x: 37px;
        width: parent.width - 47px;
        height: parent.height;
        text: root.label;
        color: root.active ? Palette.colors.accent : Palette.colors.text;
        font-size: 12px;
        font-weight: root.active ? 600 : 400;
        vertical-alignment: center;
        overflow: elide;
    }

    hit := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ResizeHandle inherits TouchArea {
    in property <int> direction: 0;
    callback begin(int);
    callback drag();
    callback stop();

    pointer-event(event) => {
        if (event.kind == PointerEventKind.down) {
            // 只允许左键发起窗口缩放；右键在窗口边缘不做任何事。
            if (event.button != PointerEventButton.left) {
                return EventResult.reject;
            }
            root.begin(root.direction);
            return EventResult.accept;
        }
        if (event.kind == PointerEventKind.move && self.pressed) {
            root.drag();
            return EventResult.accept;
        }
        if (event.kind == PointerEventKind.up) {
            root.stop();
            return EventResult.accept;
        }
        EventResult.reject
    }
}

/// 查找栏开关：Match case / Match regex。
component FindToggle inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback toggled();

    width: 86px;
    height: 20px;
    border-radius: 4px;
    background: active ? Palette.colors.accent : Palette.colors.hover;
    border-width: 1px;
    border-color: active ? Palette.colors.accent : Palette.colors.border;

    hit := TouchArea {
        clicked => { root.toggled(); }
    }
    Text {
        text: root.label;
        color: root.active ? Palette.colors.accent-text : Palette.colors.text;
        font-size: 10px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

/// Tab 级 Pin 角标：图钉轮廓（不依赖 emoji 字体）。
component PinIcon inherits Rectangle {
    in property <color> tint: Palette.colors.muted;
    width: 10px;
    height: 10px;
    background: transparent;

    Path {
        width: 100%;
        height: 100%;
        commands: "M 2.5 1 L 7.5 1 L 6.5 3.8 L 8.5 6 L 8.5 7 L 5.7 7 L 5.7 9.5 L 4.3 9.5 L 4.3 7 L 1.5 7 L 1.5 6 L 3.5 3.8 Z";
        fill: root.tint;
    }
}

export component MainWindow inherits Window {
    /// 当前 UI 语言："en" | "zh"。Rust 在启动/切换/热更新时写入；
    /// Settings 页与右键菜单的静态文案都绑定到 `Lang.t(...)`。
    in-out property <string> language: "en";
    init => { Lang.code = root.language; }
    changed language => { Lang.code = root.language; }

    in property <[PaneView]> panes;
    in property <[DividerView]> dividers;
    /// 原生文件拖放 hover 的目标 pane（-1 = 没有拖放）。
    /// Slint 1.18 的 winit 后端不投递外部拖放的 DataTransfer，Rust 侧用
    /// winit 的 HoveredFile/DroppedFile 桥接并写这个属性做高亮。
    in-out property <int> drop-hover-pane: -1;
    in property <[TabView]> tabs;
    /// Tab 状态 tooltip：悬停 Tab 时在标签栏旁说明 ●/✕/▸/✓/进度 的含义。
    in-out property <bool> tab-status-tip-visible: false;
    in-out property <string> tab-status-tip-text: "";
    in-out property <length> tab-status-tip-x: 0px;
    in property <length> tabbar-height: 32px;
    /// 工作区侧栏（ACT-046）：默认关闭；关闭时内容区与 0.5.0 逐像素一致。
    in property <bool> sidebar-visible: false;
    in property <length> sidebar-width: 0px;
    in-out property <bool> sidebar-drag-active: false;
    /// 侧栏 Profiles 列表（与 "+" 下拉共用同一份模型）
    in property <[string]> sidebar-items: [];
    callback sidebar-item-clicked(int);
    /// 侧栏顶部工具按钮：参数是命令 ID（profiles.open 由 Rust 特殊处理）
    callback sidebar-command(string);
    /// 窗口最大化状态（由 Rust 同步，避免按钮直接读异步 WM 状态）。
    in-out property <bool> window-maximized: false;
    in-out property <bool> menu-open: false;
    in property <length> menu-x: 0px;
    in property <length> menu-y: 0px;
    /// 菜单作用的目标 pane（回调时原样带回 Rust）。
    in property <int> menu-pane: -1;
    /// 表驱动菜单项：Rust 每次打开菜单时按 config + 插件装饰点重建。
    in property <[MenuEntry]> menu-items: [];
    /// 键盘导航当前选中行（含分隔线的数组下标；-1 = 无）。
    in property <int> menu-selected: -1;
    /// 被选中行的内容 y（Rust 按 30px/项、9px/分隔线算好），用于窄窗口自动滚动。
    in property <length> menu-reveal-y: 0px;
    /// 每次键盘移动选中行自增，Flickable 的 changed 处理器据此滚到可见区。
    in-out property <int> menu-reveal-token: 0;
    // 链接打开失败等短暂提示（底部浮层，Rust 侧 4 秒后清空）。
    in-out property <string> link-status: "";
    // 插件状态提供者的最小状态栏（底部一行文本；空 = 隐藏，不占布局）。
    /// TERVO_RENDER_HUD=1 时显示的渲染调试 HUD；空 = 不显示。
    in-out property <string> render-hud: "";
    in-out property <bool> doctor-open: false;
    in-out property <string> doctor-text: "";
    in-out property <string> doctor-status: "";
    callback run-doctor();
    callback close-doctor();
    /// 屏内缩放 HUD：放大/缩小/重置时显示百分比，Rust 侧短暂延时后清空。
    in-out property <string> zoom-hud: "";
    in-out property <string> plugin-status: "";
    /// 通用状态条目（连接/进度/异常恢复提示等）；空 = 不占布局。
    in property <[string]> status-items: [];
    /// 活动 Tab 的连接状态 pill（SESS-007）：0=None 1=Connected 2=Connecting
    /// 3=Disconnected 4=Failed；label 为空时整块隐藏。
    in-out property <int> connection-state: 0;
    in-out property <string> connection-label: "";
    in-out property <string> connection-tooltip: "";
    in-out property <string> plugin-status-tooltip: "";
    // 终端右键菜单：宽度按最长标签 + 快捷键提示留足，窄窗口自动收窄；
    // 内容高度由 Rust 按菜单表计算（30px/项 + 9px/分隔线 + 12px padding），
    // 超过内容区时菜单内滚动，不做整块溢出到窗口外。
    property <length> menu-width: Math.max(180px, Math.min(280px, root.width - 16px));
    in property <length> menu-content-h: 438px;
    property <length> menu-view-h: Math.max(80px,
        Math.min(root.menu-content-h,
            root.height - root.chrome-top - root.chrome-bottom - 12px));
    // 锚点同原生菜单：优先右/下，放不下翻到左/上，再放不下才夹进窗口。
    property <length> menu-left: root.menu-x + root.menu-width + 8px <= root.width
        ? root.menu-x
        : (root.menu-x - root.menu-width >= 8px
            ? root.menu-x - root.menu-width
            : Math.max(8px, Math.min(root.menu-x, root.width - root.menu-width - 8px)));
    property <length> menu-top: root.menu-y + root.menu-view-h + 8px
        <= root.height - root.chrome-top - root.chrome-bottom
        ? root.menu-y
        : (root.menu-y - root.menu-view-h >= 0px
            ? root.menu-y - root.menu-view-h
            : Math.max(6px,
                Math.min(root.menu-y,
                    root.height - root.chrome-top - root.chrome-bottom - root.menu-view-h - 6px)));

    callback key-input(string, bool, bool, bool, bool, bool);
    // press/release 配对：只有 kitty REPORT_EVENT_TYPES 且 press 进过 PTY 才回放。
    callback key-release(string, bool, bool, bool, bool);
    // 右键事件到达 UI 层的追踪（日志排查用）
    callback input-trace(string, int, length, length);
    /// 拖动分屏分隔条：index + 内容区坐标
    callback divider-dragged(int, length, length);
    /// 侧栏右边缘拖宽：参数是窗口内绝对 x（逻辑像素），Rust 侧夹 200–360
    callback sidebar-dragged(length);
    callback sidebar-drag-finished();
    /// 无边框窗口拖边缩放：0=左上 1=上 2=右上 3=右 4=右下 5=下 6=左下 7=左
    callback start-window-resize(int);
    callback window-resize-drag();
    callback end-window-resize();
    /// IME 上屏（无修饰键语义），与物理按键分开，避免中文触发 Ctrl 快捷键。
    callback ime-commit(string);
    callback pane-clicked(int);
    callback pane-right-clicked(int, length, length);
    callback pane-right-up(int, length, length);
    callback pane-middle-click(int);
    /// 菜单被点外部关闭（便于自动化验证）
    callback menu-dismissed();
    /// 由分隔线/边缘等非 pane 控件发起：按内容区坐标找最近的 pane 开菜单
    callback pane-right-clicked-at(length, length);
    /// 表驱动菜单点击：pane 目标 + 命令 ID（内置/插件/link.*）。
    callback menu-command(int, string);
    callback pane-mouse-down(int, length, length, int, int);
    callback pane-mouse-move(int, length, length, int, int);
    callback pane-mouse-up(int, length, length, int, int);
    /// 无按键悬停：只有换格时 Rust 侧才扫描链接并切手型指针。
    callback pane-hover(int, length, length);
    /// 指针离开 pane 的 TouchArea：清掉 hover 手型，避免残留在其它控件上。
    callback pane-unhover(int);
    callback pane-scrolled(int, length, length, length, int);
    /// 滚动条交互：pane id + track 归一化位置（0=顶部/最旧，1=底部/最新）。
    callback pane-scrollbar(int, float);
    /// Pane 拖拽重排（UI-PANE-008）：start 带源 pane + 内容区坐标，
    /// move/end 由 Rust 做落点命中；cancelled = Esc/窗口失焦。
    callback pane-drag-start(int, length, length);
    callback pane-drag-move(length, length);
    callback pane-drag-end();
    callback pane-drag-cancelled();
    /// 广播危险命令二次确认（UI-PANE-011）。
    callback bcast-danger-send();
    callback bcast-danger-focused();
    callback bcast-danger-cancel();
    /// 拖入文件/目录：Slint 把平台 DataTransfer 原样交给 Rust 解路径。
    pure callback can-drop-files(data-transfer) -> bool;
    callback files-dropped(int, data-transfer);
    callback tab-clicked(int);
    callback tab-closed(int);
    callback new-tab();
    // `>_` 打开 Profile 选择菜单（纯列表；`+` 不再复用这个下拉）。
    in-out property <bool> profilemenu-open: false;
    in-out property <length> profilemenu-x: 0px;
    in property <[string]> profilemenu-items: [];
    /// 键盘高亮行（可见行下标，-1 = 未选择/空列表）。
    in-out property <int> profilemenu-selected: -1;
    callback profilemenu-menu();
    callback profilemenu-pick(int);
    callback profilemenu-manage();
    callback profilemenu-move(int);
    callback profilemenu-accept();
    callback profilemenu-cancel();
    callback resized(length, length);
    callback close-window();
    callback minimize-window();
    callback toggle-maximize();
    callback max-pointer-down();
    callback set-theme(string);
    callback language-changed(string);
    callback tabbar-context(length, length);
    callback tabbar-menu-action(int);
    /// 设置页四向按钮：参数是 "top" | "bottom" | "left" | "right"。
    callback tabbar-position-set(string);
    /// 点击插件状态栏：Rust 执行状态项声明的命令（无 command 时忽略）。
    callback plugin-status-clicked();
    in-out property <bool> tabmenu-open: false;
    in-out property <length> tabmenu-x: 0px;
    in-out property <length> tabmenu-y: 32px;
    // 关闭确认弹窗
    in-out property <bool> confirm-open: false;
    in-out property <string> confirm-text: "";
    /// 将受影响的会话名（每个 Tab 一行，多窗格标注数量）；由 Rust 侧填充。
    in-out property <[string]> confirm-sessions: [];
    callback confirm-accept();
    callback confirm-cancel();
    // Tab 重命名：内联输入框（Enter 提交 / Esc 取消）
    in-out property <bool> rename-open: false;
    in-out property <string> rename-text: "";
    in-out property <int> rename-index: -1;
    callback tab-rename(int);
    callback rename-committed(int, string);
    callback rename-cancelled();
    // 设置项开关状态（由 Rust 侧从 Config 下发）
    in-out property <bool> cfg-copy-on-select: true;
    in-out property <bool> cfg-confirm-close: true;
    /// 关闭 Tab/Pane 时会话处理："end"（结束进程）| "background"（保留可重连）。
    in-out property <string> cfg-close-action: "end";
    /// 启动时自动恢复上次退出快照（默认关 = 保持旧行为）。
    in-out property <bool> cfg-restore-session: false;
    /// SESS-006：恢复边界文案（布局/cwd/本地 Profile 会恢复；进程/历史/远端连接不会）。
    in-out property <string> restore-note: "";
    in-out property <bool> cfg-sidebar-visible: false;
    callback toggle-sidebar-visible();
    in-out property <bool> cfg-confirm-paste: true;
    in-out property <string> cfg-right-click: "menu";
    in-out property <bool> cfg-paste-middle: true;
    in-out property <bool> cfg-desktop-notifications: true;
    in-out property <bool> cfg-visual-bell: true;
    in-out property <bool> cfg-audible-bell: false;
    in-out property <bool> cfg-scroll-output: false;
    in-out property <bool> cfg-scroll-keystroke: true;
    /// Sixel 内联图片（默认开）；关闭后 DA1 不再宣告、已有图片清除。
    in-out property <bool> cfg-sixel: true;
    /// Sixel 图片是否随滚动历史移动（默认开）。
    in-out property <bool> cfg-sixel-scrolling: true;
    /// iTerm2 IIP（OSC 1337 File）内联图片（默认开）；关闭后已有 IIP 图片清除。
    in-out property <bool> cfg-iip: true;
    /// 渲染 HUD（FPS/renderer/GPU 计数）；设置页可开关，默认关。
    in-out property <bool> cfg-render-hud: false;
    in-out property <bool> cfg-scrollback-unlimited: false;
    /// "always" | "auto" | "never"
    in-out property <string> cfg-scrollbar-policy: "auto";
    /// "ascii-delete" | "control-h"
    in-out property <string> cfg-backspace-binding: "ascii-delete";
    /// "delete-sequence" | "ascii-del" | "control-h"
    in-out property <string> cfg-delete-binding: "delete-sequence";
    in-out property <bool> cfg-quake: false;
    // GNOME Terminal 外观：光标（形状/闪烁/颜色）+ 粗体
    in-out property <string> cfg-cursor-shape: "block";
    in-out property <string> cfg-cursor-blink: "system";
    in-out property <string> cfg-cursor-color: "";
    in-out property <string> cfg-cursor-text-color: "";
    in-out property <bool> cfg-bold-is-bright: true;
    in-out property <string> cfg-bold-color: "";
    in-out property <bool> cfg-bold-color-same-as-fg: true;
    callback set-cursor-shape(string);
    callback set-cursor-blink(string);
    callback cursor-color-changed(string);
    callback cursor-text-color-changed(string);
    callback toggle-bold-is-bright();
    callback bold-color-changed(string);
    callback toggle-bold-color-same-as-fg();
    in-out property <bool> broadcast: false;
    /// UI-PANE-007：当前聚焦 pane 是否最大化（纯视图状态，不写会话快照）。
    in-out property <bool> pane-zoomed: false;
    // Pane 拖拽重排（UI-PANE-008）：pane id；-1 = 无。落点由 Rust 命中/高亮。
    in-out property <int> pane-drag-from: -1;
    in-out property <int> pane-drag-target: -1;
    /// 拖拽 ghost 的内容区坐标（Rust 每次 move 更新）。
    in-out property <length> pane-drag-x: 0px;
    in-out property <length> pane-drag-y: 0px;
    /// 是否还有可撤销的 pane 交换（Ctrl+Alt+Z / 右键菜单）。
    in-out property <bool> pane-undo-available: false;
    // 广播危险命令（UI-PANE-011）：输入侧实时警示 + Enter/粘贴前二次确认。
    in-out property <bool> bcast-danger-open: false;
    in-out property <string> bcast-danger-command: "";
    in-out property <string> bcast-danger-reason: "";
    in-out property <int> bcast-danger-panes: 0;
    /// 非空时顶部显示红色警示条（正在输入破坏性命令）。
    in-out property <string> broadcast-warning: "";
    callback toggle-copy-on-select();
    callback toggle-confirm-close();
    callback set-close-action(string);
    callback toggle-restore-session();
    callback toggle-confirm-paste();
    callback set-right-click(string);
    callback toggle-paste-middle();
    callback toggle-desktop-notifications();
    callback toggle-visual-bell();
    callback toggle-audible-bell();
    callback toggle-scroll-output();
    callback toggle-scroll-keystroke();
    callback toggle-sixel();
    callback toggle-sixel-scrolling();
    callback toggle-iip();
    callback toggle-render-hud();
    callback toggle-scrollback-unlimited();
    callback set-scrollbar-policy(string);
    callback set-backspace-binding(string);
    callback set-delete-binding(string);
    callback toggle-quake();
    // 多行粘贴确认
    in-out property <bool> paste-open: false;
    in-out property <string> paste-preview: "";
    in-out property <int> paste-lines: 0;
    callback paste-accept();
    callback paste-always();
    callback paste-cancel();
    callback settings-toggled(bool);
    // Profiles（连接配置）
    in-out property <bool> profiles-open: false;
    in property <[ProfileRow]> profile-items: [];
    /// 搜索框内容：输入即按 name/host/kind 过滤；清空恢复全部。
    in-out property <string> profile-query: "";
    /// 面板底部提示：新 Tab 默认使用的 Profile（或系统 shell）。
    in property <string> profile-default-info: "";
    /// 自有格式导入/导出状态行（成功/失败原因 + 路径）。
    in property <string> profile-io-status: "";
    callback profile-open(int);
    callback profile-new();
    callback profile-delete(int);
    callback profile-set-default(int);
    callback profile-duplicate(int);
    callback profile-filter(string);
    /// 点击分组标题：折叠/展开该组（参数为分组名，`""` = 未分组）。
    callback profile-toggle-group(string);
    /// 导出自有格式（不含密码，Vault 引用单独标注）。
    callback profile-export();
    /// 导入自有格式（重名自动改名，坏条目跳过并报告）。
    callback profile-import();
    callback profiles-close();
    // Profile 表单（新建）
    in-out property <bool> profile-form-open: false;
    in-out property <string> form-name: "";
    /// LOCAL-003：自定义 Tab 标题（空 = 用名称）。
    in-out property <string> form-title: "";
    /// SESS-001：设置页分组名（空 = 未分组）。
    in-out property <string> form-group: "";
    /// LOCAL-003：「测试起始目录」的即时结果（不参与保存）。
    in-out property <string> form-cwd-hint: "";
    /// 0=local 1=ssh 2=serial 3=telnet
    in-out property <int> form-kind: 0;
    in-out property <string> form-shell: "";
    in-out property <string> form-args: "";
    in-out property <string> form-cwd: "";
    /// 每行一个 `KEY=VALUE`（仅 local；空 = 不追加环境变量）。
    in-out property <string> form-env: "";
    in-out property <string> form-host: "";
    in-out property <string> form-port: "";
    in-out property <string> form-user: "";
    in-out property <string> form-auth: "";
    in-out property <string> form-key: "";
    /// 仅 auth=password 时使用；不回填已有密码，空 = 保留 Vault 原值。
    in-out property <string> form-password: "";
    in-out property <bool> form-save-password: false;
    in-out property <string> form-extra: "";
    /// 本地转发（-L），空格分隔。
    in-out property <string> form-forwards: "";
    /// 远程转发（-R），空格分隔。
    in-out property <string> form-remote-forwards: "";
    /// 动态转发（-D），空格分隔。
    in-out property <string> form-dynamic-forwards: "";
    /// ProxyJump（-J）；空 = 直连。
    in-out property <string> form-proxy-jump: "";
    in-out property <bool> form-agent-forward: false;
    /// -1 = 新建；>0 = 正在编辑的 Profile ID
    in-out property <int> form-edit-id: -1;
    callback profile-edit(int);
    in-out property <string> form-serial-port: "";
    in-out property <string> form-baud: "";
    // 外观（可选；空 = 继承全局）：字号 / 主题 / 光标形状 / 闪烁 / 滚动历史。
    in-out property <string> form-font-size: "";
    /// 绑定到该 Profile 的快捷键（单段，如 ctrl+alt+p）；空 = 不绑定。
    in-out property <string> form-hotkey: "";
    in-out property <string> form-theme: "";
    in-out property <string> form-cursor-shape: "";
    in-out property <string> form-cursor-blink: "";
    in-out property <string> form-scrollback: "";
    in-out property <string> form-error: "";
    callback profile-test-cwd(string);
    callback profile-form-save();
    callback profile-form-cancel();
    // known_hosts 主机密钥预检（首次/变更时弹出，绝不静默信任）
    in-out property <bool> hostkey-open: false;
    /// checking | unknown | changed | unverifiable
    in-out property <string> hostkey-mode: "checking";
    in-out property <string> hostkey-title: "";
    in-out property <string> hostkey-detail: "";
    in-out property <string> hostkey-error: "";
    callback hostkey-trust();
    callback hostkey-once();
    callback hostkey-cancel();
    // 会话结束 / 启动失败提示 + 重启（不自动改写用户默认行为；LOCAL-005）
    in-out property <bool> ssh-exit-open: false;
    /// 横幅标题：“SSH session ended” / “Session ended” / “Launch failed”。
    in-out property <string> ssh-exit-title: "SSH session ended";
    in-out property <string> ssh-exit-text: "";
    /// Restart/Retry 按钮文案（空 = 不可重试，不显示按钮）。
    in-out property <string> ssh-exit-action-label: "Reconnect";
    in-out property <bool> ssh-exit-reconnectable: false;
    callback ssh-exit-reconnect();
    callback ssh-exit-dismiss();
    // SFTP 面板
    in-out property <bool> sftp-open: false;
    in property <[string]> sftp-profiles: [];
    in property <[string]> sftp-items: [];
    in-out property <int> sftp-profile: 0;
    in-out property <string> sftp-remote: "/";
    in-out property <string> sftp-local: "/tmp/tervo-sftp";
    in-out property <string> sftp-target: "";
    /// 选中条目的 chmod 权限（八进制，如 644）。
    in-out property <string> sftp-mode: "644";
    in-out property <int> sftp-selected: -1;
