    callback settings-help-open(string);
    callback settings-help-copy-diagnostics();
    /// 录制结束/关闭设置后把键盘焦点还给终端 IME 宿主，否则按键会丢失。
    public function focus-terminal() {
        ime.focus();
    }

    /// Esc / 窗口失焦：取消拖拽，隐藏 ghost/插入线并让让位动画复位。
    public function cancel-drag() {
        if (root.drag-tab >= 0 || root.drag-active) {
            root.drag-tab = -1;
            root.drag-active = false;
            root.drop-index = -1;
            root.drop-gap = -1;
            root.drop-valid = false;
            root.tab-drag-cancelled();
        }
        // Pane 拖拽重排：Esc/失焦时清掉源/落点，Rust 丢弃未提交的交换。
        if (root.pane-drag-from >= 0) {
            root.pane-drag-from = -1;
            root.pane-drag-target = -1;
            root.pane-drag-cancelled();
        }
    }

    /// 切到终端：设置 Tab 留在标签栏，只隐藏内容，不销毁状态。
    public function suspend-settings() {
        if (root.settings-open) {
            root.settings-open = false;
            root.settings-theme-open = false;
            root.settings-toggled(false);
        }
    }

    /// 从标签栏点回 Settings Tab。
    public function resume-settings() {
        if (root.settings-tab-open && !root.settings-open) {
            root.settings-open = true;
            root.settings-theme-open = false;
            root.settings-toggled(true);
        }
    }

    /// 真正关闭（✕ / Settings Tab × / Esc）。只有这里销毁 Tab。
    public function close-settings() {
        if (root.settings-open || root.settings-tab-open) {
            root.settings-open = false;
            root.settings-tab-open = false;
            root.settings-query = "";
            root.settings-theme-open = false;
            root.settings-focus = "";
            root.settings-toggled(false);
        }
    }

    changed settings-open => {
        if (root.settings-open) {
            root.settings-tab-open = true;
        }
    }

    /// 让设置 Tab 在 TabBar 横向滚动时保持可见（Tab 多时贴最右端）。
    public function reveal-settings-tab() {
        if (root.settings-tab-open && tab-flick.content-width > tab-flick.width) {
            tab-flick.content-x = Math.min(0px, tab-flick.width - tab-flick.content-width);
        }
    }

    /// 记录活动 Tab 在滚动内容里的位置；切换/增删/宽度动画时调用。
    public function note-active-tab(left: length, width: length, last: bool) {
        root.active-tab-left = left;
        root.active-tab-width = width;
        root.active-tab-last = last;
        root.reveal-active-tab();
    }

    /// 把活动 Tab 滚进视口；只写 content-x，不建立绑定，
    /// 用户仍可拖拽/滚轮自由滚动。
    public function reveal-active-tab() {
        if (root.active-tab-width > 0px) {
            let view = tab-flick.width;
            let margin = 8px;
            let left = root.active-tab-left;
            let right = left + root.active-tab-width + (root.active-tab-last ? 58px : 0px);
            let visible-left = -tab-flick.content-x;
            if (left - margin < visible-left) {
                tab-flick.content-x = -(left - margin);
            } else if (right + margin > visible-left + view) {
                tab-flick.content-x = -(right + margin - view);
            }
            let min-x = Math.min(0px, view - tab-flick.content-width);
            tab-flick.content-x = Math.max(min-x, Math.min(0px, tab-flick.content-x));
        }
    }

    /// 搜索浮层结果列表：让 ↑↓ 选中的行保持在视口内。
    public function tabsearch-reveal() {
        if (root.tabsearch-open) {
            let h = root.tabsearch-list-height;
            let top = root.tabsearch-selected * 26px;
            let visible-top = -root.tabsearch-scroll-y;
            if (top < visible-top) {
                root.tabsearch-scroll-y = -top;
            } else if (top + 26px > visible-top + h) {
                root.tabsearch-scroll-y = h - top - 26px;
            }
            let content-h = Math.max(26px, root.tabsearch-items.length * 26px);
            let min-y = Math.min(0px, h - content-h);
            root.tabsearch-scroll-y = Math.max(min-y, Math.min(0px, root.tabsearch-scroll-y));
        }
    }
    in property <int> font-size: 15;
    in property <int> scrollback: 2000;
    in-out property <bool> search-open: false;
    in-out property <string> search-query: "";
    in property <string> search-status: "";
    in property <bool> search-match-case: false;
    in property <bool> search-regex: false;
    /// 非法 regex：搜索框描边变红，状态文字显示 invalid regex。
    in property <bool> search-error: false;
    callback search-toggle-case();
    callback search-toggle-regex();
    /// TextInput 编辑（键入/退格/粘贴/鼠标插入）后同步文本并重新搜索。
    callback search-edited();
    /// Enter / Shift+Enter：向前 / 向后继续搜索。
    callback search-next(bool);
    /// Esc：关闭搜索条并把焦点还给终端。
    callback search-close();

    // Save Contents：Slint 1.18 没有原生文件对话框，这里用显式路径输入 + 错误提示。
    in-out property <bool> save-open: false;
    /// 弹窗标题：Save Contents（文本快照）/ Export Recording（TERM-015 原始字节）。
    in-out property <string> save-title: "Save Contents";
    in-out property <string> save-path: "";
    in-out property <string> save-status: "";
    callback save-commit(string);
    callback save-cancel();

    // 保存布局为命名 Workspace（SESS-003）：预填 Tab 标题、重名提示、Esc 取消。
    // 同一个弹窗复用为“重命名工作区”（SESS-003/UI-PANE-010）：标题/描述/按钮
    // 文案由 Rust 下发，提交回调按 mode 分派。
    in-out property <bool> workspace-save-open: false;
    in-out property <string> workspace-save-mode: "save";
    in-out property <string> workspace-save-title: "Save layout as workspace";
    in-out property <string> workspace-save-description: "Stores this tab's split layout, each pane's cwd and profile (no running processes).";
    in-out property <string> workspace-save-action: "Save";
    in-out property <string> workspace-save-name: "";
    /// 重名/空名提示（由 Rust 在输入变化时更新）。
    in-out property <string> workspace-save-hint: "";
    in-out property <string> workspace-save-status: "";
    callback workspace-save-check(string);
    callback workspace-save-commit(string);
    callback workspace-save-cancel();

    // 工作区管理列表（UI-PANE-010）：名字 / pane 数 / 创建时间 + 打开/重命名/删除/导出。
    in-out property <[WorkspaceRow]> workspace-items: [];
    /// 列表下方操作结果（保存/重命名/删除/导出后短暂显示）。
    in-out property <string> workspace-status: "";
    callback workspace-save-current();
    callback workspace-open-row(int);
    callback workspace-rename-row(int);
    callback workspace-delete-row(int);
    callback workspace-export-row(int);
    /// 删除确认弹窗：只删 workspaces.toml 里的记录，不动已经打开的 Tab。
    in-out property <bool> workspace-delete-open: false;
    in-out property <string> workspace-delete-name: "";
    callback workspace-delete-confirm();
    callback workspace-delete-cancel();
    /// IME 候选窗锚点：聚焦 pane 光标的像素位置（内容区坐标，由 Rust 侧更新）。
    in-out property <length> ime-x: 0px;
    in-out property <length> ime-y: 0px;

    /// 窗口标题：CLI --title 覆盖；默认保持原品牌名。
    in-out property <string> window-title: "Tervo";

    title: root.window-title;
    // 不让内容（长 Tab 标题/很多 Tab）决定窗口最小宽度：否则加 Tab 会把窗口撑大。
    min-width: 240px;
    min-height: 160px;
    // Slint 1.18 的 Linux 后端只在建窗时决定 visual。按启动时的实际需要
    // 选择 transparent：无图且 opacity=100% 时保持 opaque，避免透明 surface
    // 在部分合成器上出现文字残影；有图/半透明启动才开透明。
    // 运行中把 opacity 从 100 降到 50 需要重启 Tervo 才切到透明窗口。
    background: root.terminal-transparent ? transparent : Palette.colors.surface;
    no-frame: true;
    always-on-top: root.pinned;
    icon: @image-url("../../../assets/icon.png");

    changed width => { root.resized(root.width, root.height); }
    changed height => { root.resized(root.width, root.height); }

    // TabBar 位置（UI-WIN-007）：上/下/左/右，四向与上游 Tabby
    // `appearance.tabsLocation` 一致。左/右改为竖排整列，内容区横向让位。
    // 用绝对定位而不是 VerticalLayout，否则元素顺序没法在运行时反转。
    in-out property <string> tabbar-position: "top";
    property <bool> tabbar-top: root.tabbar-position == "top";
    property <bool> tabbar-bottom: root.tabbar-position == "bottom";
    property <bool> tabbar-left: root.tabbar-position == "left";
    property <bool> tabbar-right: root.tabbar-position == "right";
    property <bool> tabbar-vertical: root.tabbar-left || root.tabbar-right;
    // 竖排 TabBar 宽度；必须与 Rust `TABBAR_W` 保持一致。
    in property <length> tabbar-width: 200px;
    // 四向 chrome（窗口内被 TabBar 占用的边）与内容区矩形。
    // 侧栏在竖排模式下紧贴 TabBar 内侧，所以内容区 x 要把两者都算进去。
    property <length> chrome-left: root.tabbar-left ? root.tabbar-width : 0px;
    property <length> chrome-right: root.tabbar-right ? root.tabbar-width : 0px;
    property <length> chrome-top: root.tabbar-top ? root.tabbar-height : 0px;
    property <length> chrome-bottom: root.tabbar-bottom ? root.tabbar-height : 0px;
    property <length> content-x: root.chrome-left
        + (root.sidebar-visible ? root.sidebar-width : 0px);
    property <length> content-y: root.chrome-top;
    property <length> content-w: Math.max(1px,
        root.width - root.chrome-left - root.chrome-right
            - (root.sidebar-visible ? root.sidebar-width : 0px));
    property <length> content-h: Math.max(1px,
        root.height - root.chrome-top - root.chrome-bottom);
    // 最近一次活动 Tab 在滚动内容中的位置（由 Tab 自己上报）。
    property <length> active-tab-left: 0px;
    property <length> active-tab-width: 0px;
    property <bool> active-tab-last: false;
    // Tab 自动收缩：把扣除左侧搜索/品牌、固定 +/Profile、窗口按钮后的宽度均分给 Tab。
    // 52px 是可读下限（标题至少保留几个字符）；再窄就横向滚动，并把活动 Tab 滚进视口。
    property <length> tab-width-cap: Math.max(52px, Math.min(180px,
        (root.width - 266px - 4px * root.tabs.length) / Math.max(1, root.tabs.length)));

    Rectangle {
        width: 100%;
        height: 100%;

        // 窗口最底层：背景图铺满并保持比例裁切（cover）。TabBar/设置面板
        // 仍是不透明的，终端默认背景的不透明度由 Rust 写进帧 alpha。
        Image {
            visible: root.has-background-image && !root.background-suspended;
            width: 100%;
            height: 100%;
            source: root.background-image;
            image-fit: cover;
        }

        // 背景图之上的暗化遮罩：压在图片上、所有内容之下。纯黑半透明，
        // 白块也会被压暗，浅色终端文字才有稳定可读的对比度。
        Rectangle {
            visible: root.has-background-image && !root.background-suspended;
            width: 100%;
            height: 100%;
            background: #000000;
            opacity: root.background-dim;
        }

        // ---------------- 标签栏 ----------------
        Rectangle {
            x: root.tabbar-left ? 0px
                : (root.tabbar-right ? root.width - root.tabbar-width : 0px);
            y: root.tabbar-bottom ? root.height - root.tabbar-height : 0px;
            width: root.tabbar-vertical ? root.tabbar-width : parent.width;
            height: root.tabbar-vertical ? parent.height : root.tabbar-height;
            clip: true;
            // 极轻的渐变 + 高光，避免整条纯色的“塑料感”。
            // 竖排时渐变方向跟着转 90°。
            background: root.tabbar-vertical
                ? @linear-gradient(90deg, Palette.colors.surface 0%, Palette.colors.bg 100%)
                : @linear-gradient(180deg, Palette.colors.surface 0%, Palette.colors.bg 100%);
            horizontal-stretch: 0;

            Rectangle {
                y: 0px;
                width: 100%;
                height: 1px;
                background: #ffffff0d;
            }

            // 底部分隔线（上/下模式）
            Rectangle {
                visible: !root.tabbar-vertical;
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Palette.colors.border;
            }

            // 竖排分隔线：TabBar 与内容区之间
            Rectangle {
                visible: root.tabbar-vertical;
                x: root.tabbar-left ? parent.width - 1px : 0px;
                width: 1px;
                height: 100%;
                background: Palette.colors.border;
            }

            // 品牌图标（上/下模式；竖排模式有独立表头）
            Image {
                visible: !root.tabbar-vertical;
                x: 32px;
                y: 6px;
                width: 18px;
                height: 18px;
                source: @image-url("../../../assets/icon-small.png");
                image-fit: contain;
            }

            // 没有原生标题栏：整条标签栏空白处可拖动窗口（上/下模式）
            WindowMoveArea {
                visible: !root.tabbar-vertical;
                width: 100%;
                height: 100%;

                // 双击标题栏 = 最大化 / 还原；右键 = 标签栏菜单（置顶等）
                title-hit := TouchArea {
                    width: 100%;
                    height: 100%;
                    double-clicked => { root.toggle-maximize(); }
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                            root.tabbar-context(
                                title-hit.mouse-x,
                                // 菜单贴在 TabBar 所在的那一侧
                                root.tabbar-bottom ? root.height - root.tabbar-height - 366px : root.tabbar-height,
                            );
                            return EventResult.accept;
                        }
                        EventResult.reject
                    }
                }
            }

            // Tab 条放进 Flickable：视口固定，内容再宽也不会把窗口的 preferred/min 宽度撑大。
            // 支持拖拽和滚轮横向滚动；活动 Tab 变化/窗口变化时自动滚进视口。
            tab-flick := Flickable {
                visible: !root.tabbar-vertical;
                // 左侧 58px 留给固定的搜索/品牌图标；滚动内容从图标右侧开始，
                // 不会钻到图标下面（活动 Tab 自动 reveal 时也安全）。
                x: 58px;
                y: 0px;
                width: parent.width - 198px;
                height: parent.height;
                interactive: true;
                content-width: tab-strip.preferred-width;
                content-height: parent.height;
                changed width => { root.reveal-active-tab(); }
                // 设置 Tab 追加到末尾：打开时滚到最右，保证齿轮 Tab 可见。
                property <bool> settings-tab-open: root.settings-tab-open;
                changed content-width => { root.reveal-settings-tab(); }
                changed settings-tab-open => { root.reveal-settings-tab(); }

                tab-strip := HorizontalLayout {
                padding-left: 0px;
                padding-right: 8px;
                padding-top: 4px;
                spacing: 4px;
                alignment: start;

                for tab[i] in root.tabs : Rectangle {
                    // 外层槽位：拖拽落点在本槽时加 8px 间隙，后面的 Tab 由 layout
                    // 平滑让位；内层 tab-box 用 animate x 跟着间隙移动。
                    property <length> insert-gap: (root.drag-active && root.drop-valid
                        && root.drop-gap == i) ? 8px : 0px;
                    animate insert-gap { duration: 120ms; easing: ease-out; }
                    width: tab-box.width + insert-gap;
                    height: 22px;
                    background: transparent;

                    // 插入线：画在 8px 间隙里；2px accent，只在合法落点显示。
                    Rectangle {
                        visible: root.drag-active && root.drop-valid && root.drop-gap == i;
                        x: 3px;
                        y: 3px;
                        width: 2px;
                        height: parent.height - 6px;
                        border-radius: 1px;
                        background: Palette.colors.accent;
                    }

                    // pinned 区与 unpinned 区之间的细分隔线。
                    if tab.pinned && i == root.pinned-count - 1
                        && root.pinned-count > 0 && root.pinned-count < root.tabs.length : Rectangle {
                        x: parent.width + 2px;
                        y: 5px;
                        width: 1px;
                        height: 12px;
                        background: Palette.colors.border;
                    }

                    tab-box := Rectangle {
                        x: parent.insert-gap;
                        height: parent.height;
                        // 自动收缩：少量 Tab 按标题宽度，多 Tab 均分可用宽度；
                        // 52px 下限后横向滚动（活动 Tab 会被滚进视口）。
                        width: Math.max(52px, Math.min(root.tab-width-cap, tab-area.preferred-width + 36px));
                        animate width { duration: 140ms; easing: ease-out; }
                        border-radius: 6px;
                        background: is-active
                            ? Palette.colors.bg
                            : (tab-hit.has-hover ? Palette.colors.raise : transparent);
                        animate background, border-color { duration: 140ms; easing: ease-out; }
                        border-width: 1px;
                        border-color: is-active ? Palette.colors.border : transparent;

                        property <bool> is-active: tab.active
                            && !(root.settings-open && !root.settings-legacy);
                        property <bool> show-status: tab.attention || tab.completed
                            || tab.failed || tab.background
                            || tab.connection-state >= 2
                            || tab.progress-state == 2 || tab.progress-label != "";
                        // 窄 Tab 不预留整块状态区：状态压成右侧小字形，标题优先占满。
                        property <bool> show-status-text: show-status && parent.width >= 64px;
                        property <bool> show-close: tab-hit.has-hover || parent.width >= 84px;
                        // 非纯颜色状态标记：字形本身就能区分状态，颜色只是辅助。
                        // 连接状态优先：✕ 失败 / ○ 断开 / … 连接中；Connected 不占位。
                        property <string> status-glyph: tab.connection-state == 4
                            ? "✕"
                            : (tab.connection-state == 3
                                ? "○"
                                : (tab.connection-state == 2
                                    ? "…"
                                    : (tab.attention ? "●"
                                    : (tab.failed || tab.progress-state == 2 ? "✕"
                                    : (tab.background ? "▸"
                                    : (tab.completed && tab.progress-state == 0 ? "✓" : ""))))));
                        property <string> status-tooltip: tab.connection-state >= 2
                            ? tab.connection-tooltip
                            : (tab.attention
                            ? Lang.t("Unread notification", "未读通知")
                            : (tab.failed || tab.progress-state == 2
                                ? Lang.t("Session failed", "会话失败")
                                : (tab.background
                                    ? Lang.t("Background activity", "后台活动")
                                    : (tab.completed && tab.progress-state == 0
                                        ? Lang.t("Completed in background", "后台完成")
                                        : (tab.progress-label != ""
                                            ? Lang.t("Progress reported by the terminal", "终端报告了进度")
                                            : "")))));
                        property <bool> status-hover: tab-hit.has-hover;
                        // 悬停 Tab 时把当前状态解释写到标签栏下方（状态字形不是纯颜色，
                        // tooltip 说明具体含义；离开即隐藏）。
                        changed status-hover => {
                            root.tab-status-tip-visible = self.status-hover && status-glyph != "";
                            if (self.status-hover && status-glyph != "") {
                                root.tab-status-tip-text = status-tooltip;
                                root.tab-status-tip-x = tab-hit.absolute-position.x + tab-hit.width / 2;
                            }
                        }

                        changed is-active => {
                            if (is-active) {
                                root.note-active-tab(parent.x + self.x, self.width, i == root.tabs.length - 1);
                            }
                        }
                        changed x => {
                            if (is-active) {
                                root.note-active-tab(parent.x + self.x, self.width, i == root.tabs.length - 1);
                            }
                        }
                        changed width => {
                            if (is-active) {
                                root.note-active-tab(parent.x + self.x, self.width, i == root.tabs.length - 1);
                            }
                        }

                        // 激活态底部的强调线（Yaru 橙 / 主题 accent）
                        Rectangle {
                            visible: is-active;
                            x: 8px;
                            y: parent.height - 2px;
                            width: parent.width - 16px;
                            height: 2px;
                            border-radius: 1px;
                            background: Palette.colors.accent;
                        }

                        // 进度条：盖在强调线上；错误红、暂停灰、进行中/不确定用 accent。
                        Rectangle {
                            visible: tab.progress-state == 1 || tab.progress-state == 2
                                || tab.progress-state == 3 || tab.progress-state == 4;
                            x: 8px;
                            y: parent.height - 2px;
                            width: parent.width - 16px;
                            height: 2px;
                            border-radius: 1px;
                            background: transparent;

                            Rectangle {
                                width: parent.width * tab.progress-ratio;
                                height: 100%;
                                border-radius: 1px;
                                background: tab.progress-state == 2
                                    ? Palette.colors.danger
                                    : (tab.progress-state == 4 ? Palette.colors.muted : Palette.colors.accent);
                            }
                        }

                        // 状态字形：● 未读 / ✕ 失败 / ▸ 后台活动 / ✓ 后台完成。
                        Text {
                            visible: show-status-text && status-glyph != "";
                            x: parent.width - 46px;
                            y: 0px;
                            width: 20px;
                            height: 22px;
                            text: status-glyph;
                            color: (tab.connection-state == 4 || tab.failed || tab.progress-state == 2)
                                ? Palette.colors.danger
                                : (tab.connection-state == 3
                                    ? Palette.colors.muted
                                    : (tab.connection-state == 2
                                        ? Palette.colors.accent
                                        : (tab.background
                                            ? Palette.colors.text
                                            : (tab.attention || tab.completed
                                                ? Palette.colors.accent : Palette.colors.muted))));
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        // 百分比文本（有合法 percent 时；状态字形优先）
                        Text {
                            visible: !tab.attention && !tab.failed && !tab.background
                                && !tab.completed && tab.progress-label != ""
                                && show-status-text;
                            x: parent.width - 48px;
                            y: 0px;
                            width: 24px;
                            height: 22px;
                            text: tab.progress-label;
                            color: Palette.colors.muted;
                            font-size: 9px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }

                        // 窄 Tab 的状态也保留字形（不是纯颜色小点），只是缩小字号。
                        Text {
                            visible: show-status && !show-status-text && status-glyph != "";
                            x: parent.width - 11px;
                            y: 0px;
                            width: 10px;
                            height: 22px;
                            text: status-glyph;
                            color: (tab.connection-state == 4 || tab.failed || tab.progress-state == 2)
                                ? Palette.colors.danger
                                : (tab.connection-state == 3
                                    ? Palette.colors.muted
                                    : (tab.connection-state == 2
                                        ? Palette.colors.accent
                                        : (tab.background ? Palette.colors.text : Palette.colors.accent)));
                            font-size: 8px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        // Tab 级 Pin 角标：pinned Tab 才有；标题相应右移。
                        if tab.pinned : PinIcon {
                            x: 6px;
                            y: 6px;
                            tint: is-active ? Palette.colors.accent : Palette.colors.muted;
                        }

                        tab-area := Text {
                            x: parent.width < 60px
                                ? (tab.pinned ? 17px : 5px)
                                : (tab.pinned ? 20px : 8px);
                            // 窄 Tab 的 close 只在 hover 时覆盖显示，不因 hover 重排标题。
                            width: parent.width - self.x
                                - (show-close && parent.width >= 84px ? 26px : 6px)
                                - (show-status-text ? 22px : 0px);
                            text: tab.title;
                            color: is-active ? Palette.colors.text : Palette.colors.muted;
                            font-size: root.tab-width-cap < 60px ? 10px : 12px;
                            font-weight: is-active ? 600 : 400;
                            overflow: elide;
                            vertical-alignment: center;
                            animate color { duration: 140ms; }
                        }

                        // 拖到最右端（插入边界 == Tab 数）时的尾部插入线。
                        if i == root.tabs.length - 1 : Rectangle {
                            visible: root.drag-active && root.drop-valid
                                && root.drop-gap == root.tabs.length;
                            x: parent.width + 1px;
                            y: 3px;
                            width: 2px;
                            height: parent.height - 6px;
                            border-radius: 1px;
                            background: Palette.colors.accent;
                        }

                        tab-hit := TouchArea {
                            clicked => {
                                root.tabctx-open = false;
                                // 切到终端时设置只 suspend，Settings Tab 保留在标签栏。
                                if (root.settings-open) {
                                    root.suspend-settings();
                                }
                                root.tab-clicked(i);
                            }
                            double-clicked => {
                                root.tab-rename(i);
                            }
                            pointer-event(event) => {
                                // 右键在按下时直接开菜单（与终端 pane 一致）：
                                // Flickable 在 headless/WM 下可能吞掉 right-up，按下处理最稳。
                                if (event.kind == PointerEventKind.down
                                    && event.button == PointerEventButton.right) {
                                    root.tab-context(i, self.absolute-position.x + self.mouse-x);
                                    return EventResult.accept;
                                }
                                // 左键拖动：按下只记起点；超过阈值才进入拖拽态。
                                // 坐标用 absolute-position 换算，兼容 Flickable 横向滚动。
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                    root.drag-tab = i;
                                    root.drag-win-x = self.absolute-position.x + self.mouse-x;
                                    root.drag-win-y = self.absolute-position.y + self.mouse-y;
                                    root.drag-x = root.drag-win-x - tab-flick.absolute-position.x
                                        - tab-flick.content-x;
                                    root.drag-start = root.drag-x;
                                    root.drag-start-y = root.drag-win-y;
                                    root.drag-w = tab-box.width;
                                    // 用实际 Tab 宽 + spacing 估槽宽：content-width 在标题动画后可能短暂偏大。
                                    root.drag-strip-w = (tab-box.width + 4px) * root.tabs.length;
                                    root.drag-title = tab.title;
                                    root.drag-pinned = tab.pinned;
                                    root.drag-active = false;
                                    root.drop-index = -1;
                                    root.drop-gap = -1;
                                    root.drop-valid = false;
                                    return EventResult.reject;   // 不抢按下，否则 clicked/双击会被吞
                                }
                                if (event.kind == PointerEventKind.move && root.drag-tab == i) {
                                    root.drag-win-x = self.absolute-position.x + self.mouse-x;
                                    root.drag-win-y = self.absolute-position.y + self.mouse-y;
                                    root.drag-x = root.drag-win-x - tab-flick.absolute-position.x
                                        - tab-flick.content-x;
                                    if (!root.drag-active
                                        && (Math.abs(root.drag-x - root.drag-start) > 6px
                                            || Math.abs(root.drag-win-y - root.drag-start-y) > 6px)) {
                                        root.drag-active = true;
                                    }
                                    if (root.drag-active) {
                                        // Rust 只算落点并写 3 个标量属性，不重建 Tab 模型。
                                        root.tab-drag-move(i, root.drag-x, root.drag-strip-w);
                                        return EventResult.accept;
                                    }
                                    return EventResult.accept;
                                }
                                if (event.kind == PointerEventKind.up && root.drag-tab == i) {
                                    let was-drag = root.drag-active;
                                    let final-x = root.drag-x;
                                    let moved = Math.abs(root.drag-x - root.drag-start) > 6px;
                                    root.drag-tab = -1;
                                    root.drag-active = false;
                                    root.drop-index = -1;
                                    root.drop-gap = -1;
                                    root.drop-valid = false;
                                    // 只有真的拖动过才接管；否则放行给 clicked / double-clicked
                                    if (was-drag || moved) {
                                        root.tab-reorder(i, final-x, root.drag-strip-w);
                                        return EventResult.accept;
                                    }
                                    return EventResult.reject;
                                }
                                EventResult.reject
                            }
                        }

                        close-hit := TouchArea {
                            visible: show-close;
                            x: parent.width - 22px;
                            y: 1px;
                            width: 20px;
                            height: 20px;
                            clicked => { root.tab-closed(i); }

                            Rectangle {
                                x: 1px;
                                y: 1px;
                                width: 18px;
                                height: 18px;
                                border-radius: 9px;
                                background: close-hit.has-hover ? Palette.colors.hover : transparent;
                                animate background { duration: 120ms; }
                            }

                            Text {
                                text: "×";
                                color: close-hit.has-hover ? Palette.colors.danger : Palette.colors.muted;
                                font-size: 14px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                width: 100%;
                                height: 100%;
                                animate color { duration: 120ms; }
                            }
                        }
                    }
                }

                // Settings Tab：不是 PTY Tab，不进入 workspace；只在打开时出现。
                // 用齿轮图标 + 可关闭 ×，按 Esc/✕/点终端 Tab 都退出。
                if root.settings-tab-open && !root.settings-legacy : Rectangle {
                    height: 22px;
                    width: 112px;
                    border-radius: 6px;
                    background: root.settings-open ? Palette.colors.bg : Palette.colors.raise;
                    border-width: 1px;
                    border-color: root.settings-open ? Palette.colors.border : transparent;

                    Rectangle {
                        x: 8px;
                        y: parent.height - 2px;
                        width: parent.width - 16px;
                        height: 2px;
                        border-radius: 1px;
                        background: root.settings-open ? Palette.colors.accent : transparent;
                    }

                    SettingsIconView {
                        x: 8px;
                        y: 3px;
                        kind: SettingsIconKind.gear;
                        tint: root.settings-open ? Palette.colors.accent : Palette.colors.muted;
                    }

                    Text {
                        x: 28px;
                        width: parent.width - 52px;
                        height: parent.height;
                        text: Lang.t("Settings", "设置");
                        color: root.settings-open ? Palette.colors.text : Palette.colors.muted;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    // 点 Tab 本体从终端返回设置（suspend 后不销毁）。
                    TouchArea {
                        x: 0px;
                        y: 0px;
                        width: parent.width - 22px;
                        height: parent.height;
                        clicked => { root.resume-settings(); }
                    }

                    settings-tab-close := TouchArea {
                        x: parent.width - 22px;
                        y: 1px;
                        width: 20px;
                        height: 20px;
                        clicked => { root.close-settings(); }
                        Rectangle {
                            x: 1px; y: 1px; width: 18px; height: 18px;
                            border-radius: 9px;
                            background: settings-tab-close.has-hover ? Palette.colors.hover : transparent;
                        }
                        Text {
                            text: "×";
                            color: settings-tab-close.has-hover ? Palette.colors.danger : Palette.colors.muted;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }

                Rectangle {
                    height: 22px;
                    width: 24px;
                    border-radius: 5px;
                    background: new-hit.has-hover ? Palette.colors.raise : transparent;
                    animate background { duration: 120ms; }

                    new-hit := TouchArea {
                        clicked => {
                            if (root.settings-open) {
                                root.suspend-settings();
                            }
                            // 旧行为：`+` 直接新建默认 Tab；Profile 选择走右侧 >_。
                            root.new-tab();
                        }
                    }

                    Text {
                        text: "+";
                        color: Palette.colors.text;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                // Profile 选择器：独立图标（Tabby 风格），不在 + 的下拉里。
                Rectangle {
                    height: 22px;
                    width: 26px;
                    border-radius: 5px;
                    background: profile-menu-hit.has-hover ? Palette.colors.raise : transparent;
                    animate background { duration: 120ms; }

                    profile-menu-hit := TouchArea {
                        clicked => {
                            if (root.settings-open) {
                                root.suspend-settings();
                            }
                            root.profilemenu-x = self.absolute-position.x;
                            root.profilemenu-open = true;
                            root.profilemenu-menu();
                        }
                    }

                    Text {
                        text: ">_";
                        color: Palette.colors.subtext;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

            }
            }

            // 横向滚动条：仅在 Tab + 按钮溢出时出现，提示可拖拽/滚轮滚动。
            Rectangle {
                property <length> bar-w: Math.min(tab-flick.width - 4px,
                    Math.max(18px,
                        tab-flick.width * tab-flick.width / Math.max(1px, tab-flick.content-width)));
                visible: !root.tabbar-vertical
                    && tab-flick.content-width > tab-flick.width + 1px;
                x: 59px + (-tab-flick.content-x)
                    / Math.max(1px, tab-flick.content-width - tab-flick.width)
                    * Math.max(0px, tab-flick.width - self.bar-w - 2px);
                y: parent.height - 3px;
                width: self.bar-w;
                height: 2px;
                border-radius: 1px;
                background: Palette.colors.muted;
            }

        // 最左侧 Tab 搜索按钮（Chrome 风格）：搜索当前窗口所有 Tab
        Rectangle {
            visible: !root.tabbar-vertical;
            x: 4px;
            y: 4px;
            width: 24px;
            height: 24px;
            border-radius: 5px;
            background: tabsearch-btn.has-hover ? Palette.colors.hover : Palette.colors.raise;
            animate background { duration: 120ms; }

            tabsearch-btn := TouchArea {
                clicked => {
                    root.tabsearch-query = "";
                    root.tabsearch-open = true;
                    root.tabsearch-open-requested();
                }
            }

            // 手绘放大镜：圆环 + 45° 手柄，避免依赖字体里是否有 "⌕"。
            Rectangle {
                x: 6px;
                y: 5px;
                width: 10px;
                height: 10px;
                border-radius: 5px;
                border-width: 1.5px;
                border-color: Palette.colors.text;
                background: transparent;
            }
            Rectangle {
                x: 15px;
                y: 14px;
                width: 7px;
                height: 7px;
                background: transparent;

                Path {
                    width: 100%;
                    height: 100%;
                    commands: "M 0 0 L 5 5";
                    stroke: Palette.colors.text;
                    stroke-width: 1.5px;
                    stroke-line-cap: round;
                }
            }
        }

        // 设置
        win-gear := TouchArea {
            visible: !root.tabbar-vertical;
            x: parent.width - 132px;
            y: 4px;
            width: 28px;
            height: 24px;
            clicked => {
                if (root.settings-open) {
                    root.close-settings();
                } else if (root.settings-tab-open) {
                    root.resume-settings();
                } else {
                    root.settings-open = true;
                    root.settings-tab-open = true;
                    root.settings-toggled(true);
                }
            }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 5px;
                background: root.settings-open
                    ? Palette.colors.hover
                    : (win-gear.has-hover ? Palette.colors.hover : Palette.colors.raise);
                SettingsIconView {
                    x: 6px;
                    y: 4px;
                    kind: SettingsIconKind.gear;
                    tint: root.settings-open ? Palette.colors.accent : Palette.colors.text;
                }
            }
        }

        // 窗口按钮（无边框后必须自带）
        win-min := TouchArea {
            visible: !root.tabbar-vertical;
            x: parent.width - 100px;
            y: 4px;
            width: 28px;
            height: 24px;
            clicked => { root.minimize-window(); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 5px;
                background: win-min.has-hover ? Palette.colors.hover : Palette.colors.raise;
                Text {
                    text: "─";
                    color: Palette.colors.text;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }

        win-max := TouchArea {
            visible: !root.tabbar-vertical;
            x: parent.width - 68px;
            y: 4px;
            width: 28px;
            height: 24px;
            clicked => { root.toggle-maximize(); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 5px;
                background: win-max.has-hover ? Palette.colors.hover : Palette.colors.raise;
                Text {
                    text: root.window-maximized ? "❐" : "□";
                    color: Palette.colors.text;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }

        win-close := TouchArea {
            visible: !root.tabbar-vertical;
            x: parent.width - 36px;
            y: 4px;
            width: 28px;
            height: 24px;
            clicked => { root.close-window(); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 5px;
                background: win-close.has-hover ? Palette.colors.danger : Palette.colors.raise;

                Text {
                    text: "✕";
                    color: win-close.has-hover ? Palette.colors.bg : Palette.colors.text;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }

            // ---------------- 竖排 TabBar（左/右，UI-WIN-007） ----------------
            // 布局：顶部品牌/搜索固定 → 中间 Tab 列 Flickable 纵向滚动 →
            // 底部 +/Profile/设置/窗口按钮固定。上/下模式的控件全部隐藏，
            // 两套布局互斥，所以不会同时抢鼠标事件。
            if root.tabbar-vertical : Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                background: transparent;

                // 顶部空白处可拖动窗口；右键打开标签栏菜单（置顶/新窗口等）。
                WindowMoveArea {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 42px;
                }
                vtab-header-hit := TouchArea {
                    x: 30px;
                    y: 0px;
                    width: parent.width - 60px;
                    height: 42px;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.up
                            && event.button == PointerEventButton.right) {
                            root.tabbar-context(
                                root.tabbar-left
                                    ? root.tabbar-width + 8px
                                    : root.width - root.tabbar-width + 8px,
                                Math.max(8px, Math.min(
                                    self.absolute-position.y + self.mouse-y,
                                    root.height - 404px)));
                            return EventResult.accept;
                        }
                        EventResult.reject
                    }
                }

                // 品牌图标
                Image {
                    x: 14px;
                    y: 12px;
                    width: 18px;
                    height: 18px;
                    source: @image-url("../../../assets/icon-small.png");
                    image-fit: contain;
                }

                // 竖排模式也保留 Tab 搜索（Chrome 风格放大镜）
                Rectangle {
                    x: parent.width - 34px;
                    y: 9px;
                    width: 24px;
                    height: 24px;
                    border-radius: 5px;
                    background: vtabsearch-btn.has-hover
                        ? Palette.colors.hover : Palette.colors.raise;

                    vtabsearch-btn := TouchArea {
                        clicked => {
                            root.tabsearch-query = "";
                            root.tabsearch-open = true;
                            root.tabsearch-open-requested();
                        }
                    }
                    Rectangle {
                        x: 6px;
                        y: 5px;
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        border-width: 1.5px;
                        border-color: Palette.colors.text;
                        background: transparent;
                    }
                    Path {
                        x: 15px;
                        y: 14px;
                        width: 7px;
                        height: 7px;
                        commands: "M 0 0 L 5 5";
                        stroke: Palette.colors.text;
                        stroke-width: 1.5px;
                        stroke-line-cap: round;
                    }
                }

                // 中间 Tab 列：只滚动 Tab，不滚动固定按钮。
                vtab-scroll := Rectangle {
                    x: 6px;
                    y: 44px;
                    width: parent.width - 12px;
                    height: parent.height - 90px;
                    clip: true;
                    background: transparent;

                    vtab-flick := Flickable {
                        width: 100%;
                        height: 100%;
                        interactive: true;
                        content-width: parent.width;
                        content-height: vtab-strip.preferred-height;

                        vtab-strip := VerticalLayout {
                            width: parent.width;
                            spacing: 2px;
                            alignment: start;

                            for tab[i] in root.tabs : Rectangle {
                                height: 30px;
                                width: vtab-strip.width;
                                border-radius: 5px;
                                background: vtab-active
                                    ? Palette.colors.bg
                                    : (vtab-hit.has-hover
                                        ? Palette.colors.raise : transparent);
                                border-width: 1px;
                                border-color: vtab-active
                                    ? Palette.colors.border : transparent;

                                property <bool> vtab-active: tab.active
                                    && !(root.settings-open && !root.settings-legacy);
                                property <bool> vtab-status: tab.attention || tab.completed
                                    || tab.failed || tab.background
                                    || tab.progress-state == 2 || tab.progress-label != "";
                                property <string> vtab-glyph: tab.attention ? "●"
                                    : (tab.failed || tab.progress-state == 2 ? "✕"
                                    : (tab.background ? "▸"
                                    : (tab.completed && tab.progress-state == 0 ? "✓" : "")));

                                // 活动 Tab 自动滚进视口（新建/切换后不必手动滚）。
                                // active 变化和布局 y 变化都要扶正：新建 Tab 时
                                // active 先于 VerticalLayout 算出行位置触发。
                                changed vtab-active => {
                                    if (vtab-active) {
                                        let top = -vtab-flick.content-y;
                                        // 注意用 self.y（行在内容里的位置），
                                        // parent 是 VerticalLayout，不是本行。
                                        if (self.y < top) {
                                            vtab-flick.content-y = -self.y;
                                        } else if (self.y + self.height
                                            > top + vtab-flick.height) {
                                            vtab-flick.content-y = -(self.y
                                                + self.height - vtab-flick.height);
                                        }
                                    }
                                }
                                changed y => {
                                    if (vtab-active) {
                                        let top = -vtab-flick.content-y;
                                        if (self.y < top) {
                                            vtab-flick.content-y = -self.y;
                                        } else if (self.y + self.height
                                            > top + vtab-flick.height) {
                                            vtab-flick.content-y = -(self.y
                                                + self.height - vtab-flick.height);
                                        }
                                    }
                                }

                                // 激活态左侧强调线
                                Rectangle {
                                    visible: vtab-active;
                                    x: 0px;
                                    y: 5px;
                                    width: 2px;
                                    height: parent.height - 10px;
                                    border-radius: 1px;
                                    background: Palette.colors.accent;
                                }

                                if tab.pinned : PinIcon {
                                    x: 8px;
                                    y: 10px;
                                    tint: vtab-active
                                        ? Palette.colors.accent : Palette.colors.muted;
                                }

                                // 状态字形（●/✕/▸/✓）；标题相应右移。
                                Text {
                                    visible: vtab-status && vtab-glyph != "";
                                    x: tab.pinned ? 24px : 8px;
                                    y: 0px;
                                    width: 12px;
                                    height: 30px;
                                    text: vtab-glyph;
                                    color: (tab.failed || tab.progress-state == 2)
                                        ? Palette.colors.danger
                                        : (tab.background
                                            ? Palette.colors.text : Palette.colors.accent);
                                    font-size: 9px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                vtab-label := Text {
                                    x: (tab.pinned ? 24px : 8px)
                                        + (vtab-status ? 14px : 0px);
                                    width: parent.width - self.x - 28px;
                                    height: parent.height;
                                    text: tab.title;
                                    color: vtab-active
                                        ? Palette.colors.text : Palette.colors.muted;
                                    font-size: 12px;
                                    font-weight: vtab-active ? 600 : 400;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }

                                // 关闭按钮：悬停或激活时显示，固定在行尾。
                                vtab-close := TouchArea {
                                    visible: vtab-hit.has-hover || vtab-active;
                                    x: parent.width - 24px;
                                    y: 3px;
                                    width: 20px;
                                    height: 24px;
                                    clicked => { root.tab-closed(i); }

                                    Rectangle {
                                        x: 1px;
                                        y: 3px;
                                        width: 18px;
                                        height: 18px;
                                        border-radius: 9px;
                                        background: vtab-close.has-hover
                                            ? Palette.colors.hover : transparent;
                                    }
                                    Text {
                                        text: "×";
                                        color: vtab-close.has-hover
                                            ? Palette.colors.danger : Palette.colors.muted;
                                        font-size: 14px;
                                        width: 100%;
                                        height: 100%;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                vtab-hit := TouchArea {
                                    clicked => {
                                        root.tabctx-open = false;
                                        if (root.settings-open) {
                                            root.suspend-settings();
                                        }
                                        root.tab-clicked(i);
                                    }
                                    double-clicked => { root.tab-rename(i); }
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down
                                            && event.button == PointerEventButton.right) {
                                            root.tabctx-y = self.absolute-position.y + self.mouse-y;
                                            root.tab-context(i,
                                                root.tabbar-left
                                                    ? root.tabbar-width + 6px
                                                    : root.width - root.tabbar-width - 196px);
                                            return EventResult.accept;
                                        }
                                        EventResult.reject
                                    }
                                }
                            }

                            // Settings Tab：与上/下模式一致，是可关闭的固定入口。
                            if root.settings-tab-open && !root.settings-legacy : Rectangle {
                                height: 30px;
                                width: vtab-strip.width;
                                border-radius: 5px;
                                background: root.settings-open
                                    ? Palette.colors.bg : Palette.colors.raise;
                                border-width: 1px;
                                border-color: root.settings-open
                                    ? Palette.colors.border : transparent;

                                Rectangle {
                                    visible: root.settings-open;
                                    x: 0px;
                                    y: 5px;
                                    width: 2px;
                                    height: parent.height - 10px;
                                    border-radius: 1px;
                                    background: Palette.colors.accent;
                                }
                                SettingsIconView {
                                    x: 8px;
                                    y: 7px;
                                    kind: SettingsIconKind.gear;
                                    tint: root.settings-open
                                        ? Palette.colors.accent : Palette.colors.muted;
                                }
                                Text {
                                    x: 28px;
                                    width: parent.width - 52px;
                                    height: parent.height;
                                    text: Lang.t("Settings", "设置");
                                    color: root.settings-open
                                        ? Palette.colors.text : Palette.colors.muted;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                TouchArea {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width - 24px;
                                    height: parent.height;
                                    clicked => { root.resume-settings(); }
                                }
                                vtab-settings-close := TouchArea {
                                    x: parent.width - 24px;
                                    y: 3px;
                                    width: 20px;
                                    height: 24px;
                                    clicked => { root.close-settings(); }
                                    Text {
                                        text: "×";
                                        color: vtab-settings-close.has-hover
                                            ? Palette.colors.danger : Palette.colors.muted;
                                        font-size: 14px;
                                        width: 100%;
                                        height: 100%;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // 底部固定控制区：+ / Profile / 设置 / 最小化 / 最大化 / 关闭。
                Rectangle {
                    y: parent.height - 44px;
                    width: 100%;
                    height: 1px;
                    background: Palette.colors.border;
                }

                Rectangle {
                    x: 6px;
                    y: parent.height - 38px;
                    width: 28px;
                    height: 28px;
                    border-radius: 5px;
                    background: vtab-new-hit.has-hover
                        ? Palette.colors.raise : transparent;
                    vtab-new-hit := TouchArea {
                        clicked => {
                            if (root.settings-open) {
                                root.suspend-settings();
                            }
                            root.new-tab();
                        }
                    }
                    Text {
                        text: "+";
                        color: Palette.colors.text;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                Rectangle {
                    x: 36px;
                    y: parent.height - 38px;
                    width: 28px;
                    height: 28px;
                    border-radius: 5px;
                    background: vtab-profile-hit.has-hover
                        ? Palette.colors.raise : transparent;
                    vtab-profile-hit := TouchArea {
                        clicked => {
                            if (root.settings-open) {
                                root.suspend-settings();
                            }
                            root.profilemenu-x = self.absolute-position.x;
                            root.profilemenu-open = true;
                            root.profilemenu-menu();
                        }
                    }
                    Text {
                        text: ">_";
                        color: Palette.colors.subtext;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                Rectangle {
                    x: 66px;
                    y: parent.height - 38px;
                    width: 28px;
                    height: 28px;
                    border-radius: 5px;
                    background: vtab-gear-hit.has-hover
                        ? Palette.colors.hover : Palette.colors.raise;
                    vtab-gear-hit := TouchArea {
                        clicked => {
                            if (root.settings-open) {
                                root.close-settings();
                            } else if (root.settings-tab-open) {
                                root.resume-settings();
                            } else {
                                root.settings-open = true;
                                root.settings-tab-open = true;
                                root.settings-toggled(true);
                            }
                        }
                    }
                    SettingsIconView {
                        x: 6px;
                        y: 6px;
                        kind: SettingsIconKind.gear;
                        tint: root.settings-open
                            ? Palette.colors.accent : Palette.colors.text;
                    }
                }

                Rectangle {
                    x: 102px;
                    y: parent.height - 38px;
                    width: 28px;
                    height: 28px;
                    border-radius: 5px;
                    background: vtab-min-hit.has-hover
                        ? Palette.colors.hover : Palette.colors.raise;
                    vtab-min-hit := TouchArea {
                        clicked => { root.minimize-window(); }
                    }
                    Text {
                        text: "─";
                        color: Palette.colors.text;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                Rectangle {
                    x: 130px;
                    y: parent.height - 38px;
                    width: 28px;
                    height: 28px;
                    border-radius: 5px;
                    background: vtab-max-hit.has-hover
                        ? Palette.colors.hover : Palette.colors.raise;
                    vtab-max-hit := TouchArea {
                        clicked => { root.toggle-maximize(); }
                    }
                    Text {
                        text: root.window-maximized ? "❐" : "□";
                        color: Palette.colors.text;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                Rectangle {
                    x: 158px;
                    y: parent.height - 38px;
                    width: 28px;
                    height: 28px;
                    border-radius: 5px;
                    background: vtab-close-hit.has-hover
                        ? Palette.colors.danger : Palette.colors.raise;
                    vtab-close-hit := TouchArea {
                        clicked => { root.close-window(); }
                    }
                    Text {
                        text: "✕";
                        color: vtab-close-hit.has-hover
                            ? Palette.colors.bg : Palette.colors.text;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }

        // Tab 状态 tooltip：悬停 Tab 时说明状态字形含义；离开 Tab 即隐藏。
        // 放在标签栏外层（未 clip），不会被 32px 的标签栏裁掉。
        if root.tab-status-tip-visible && root.tab-status-tip-text != "" : Rectangle {
            x: Math.max(6px, Math.min(root.width - tab-status-tip.width - 10px,
                root.tab-status-tip-x - tab-status-tip.width / 2));
            y: root.tabbar-vertical
                ? root.height - root.chrome-bottom - 70px
                : (root.tabbar-bottom
                    ? root.height - root.tabbar-height - 26px
                    : root.tabbar-height + 4px);
            width: Math.min(root.width - 20px, tab-status-tip.preferred-width + 16px);
            height: 22px;
            border-radius: 5px;
            background: Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;

            tab-status-tip := Text {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: root.tab-status-tip-text;
                color: Palette.colors.text;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // ---------------- 工作区侧栏 ----------------
        Rectangle {
            visible: root.sidebar-visible;
            // 竖排 TabBar 在外侧；侧栏紧贴其内侧，纵向占满可用内容区。
            x: root.chrome-left;
            y: root.chrome-top;
            width: root.sidebar-width;
            height: root.content-h;
            background: Palette.colors.bg;
            border-color: Palette.colors.border;
            border-width: root.sidebar-width > 0px ? 1px : 0px;

            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 10px;
                spacing: 8px;

                // 工具行：全部走命令 ID（未实现项必须 disabled + 原因，不留假按钮）
                HorizontalLayout {
                    height: 24px;
                    spacing: 4px;
                    for cmd in [{ id: "tab.new", label: Lang.t("+ Tab", "+ 标签") },
                                { id: "profiles.open", label: Lang.t("Profiles", "配置") },
                                { id: "pane.split-right", label: Lang.t("Split", "分屏") },
                                { id: "settings.open", label: Lang.t("Settings", "设置") }] : Rectangle {
                        height: 24px;
                        width: tip.preferred-width + 16px;
                        background: btn.has-hover ? Palette.colors.hover : Palette.colors.raise;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: Palette.colors.border;
                        btn := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.sidebar-command(cmd.id); }
                        }
                        tip := Text {
                            x: 8px;
                            text: cmd.label;
                            color: Palette.colors.subtext;
                            font-size: 11px;
                            vertical-alignment: center;
                            height: parent.height;
                        }
                    }
                }
                Text {
                    text: Lang.t("Workspace", "工作区");
                    color: Palette.colors.subtext;
                    font-size: 13px;
                    font-weight: 600;
                }
                Text {
                    text: Lang.t("Profiles", "配置");
                    color: Palette.colors.muted;
                    font-size: 11px;
                }
                for item[i] in root.sidebar-items : Rectangle {
                    height: 26px;
                    background: sidebar-row.has-hover ? Palette.colors.hover : transparent;
                    border-radius: 4px;
                    sidebar-row := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.sidebar-item-clicked(i); }
                    }
                    Text {
                        x: 8px;
                        text: item;
                        color: Palette.colors.subtext;
                        font-size: 12px;
                        vertical-alignment: center;
                        width: parent.width - 16px;
                        overflow: elide;
                    }
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
            }

            // 右边缘拖宽条（4px）：悬停显示左右拉伸光标，按下进入拖拽态
            Rectangle {
                x: parent.width - 4px;
                width: 4px;
                height: 100%;
                background: sidebar-drag-active ? Palette.colors.accent : transparent;
                TouchArea {
                    mouse-cursor: ew-resize;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down
                            && event.button == PointerEventButton.left) {
                            root.sidebar-drag-active = true;
                            return EventResult.accept;
                        }
                        if (event.kind == PointerEventKind.up) {
                            root.sidebar-drag-active = false;
                            root.sidebar-drag-finished();
                            return EventResult.accept;
                        }
                        if (event.kind == PointerEventKind.move && self.pressed) {
                            root.sidebar-dragged(self.absolute-position.x);
                            return EventResult.accept;
                        }
                        return EventResult.reject;
                    }
                }
            }
        }

        // ---------------- 分屏内容区 ----------------
        Rectangle {
            x: root.content-x;
            width: root.content-w;
            y: root.content-y;
            height: root.content-h;
            // 有背景图时让终端帧的透明背景直接透出图片；否则保持主题底色。
            background: root.has-background-image ? transparent : Palette.colors.bg;

            // focus-on-click 必须关掉：否则点击 pane 时 FocusScope 会把焦点
            // 从下面的 TextInput 抢走，输入法（以及所有按键）立刻失效。
            fs := FocusScope {
                width: 100%;
                height: 100%;
                focus-on-click: false;

                // 隐藏的 IME 宿主。Slint 里只有 TextInput 会向 winit 申请输入法
                // 上下文（XIM/fcitx/ibus），中文上屏经由 edited 转发给 PTY。
                // 放在 pane 之前，保证鼠标事件仍由 pane 的 TouchArea 接收。
                ime := TextInput {
                    x: root.ime-x;
                    y: root.ime-y;
                    width: 2px;
                    height: 2px;
                    text: "";
                    single-line: true;
                    color: transparent;
                    selection-foreground-color: transparent;
                    selection-background-color: transparent;
                    text-cursor-width: 0px;
                    init => { self.focus(); }

                    key-pressed(event) => {
                        // 拼音组合中：回车=上屏候选、退格=删拼音、Esc=取消，
                        // 这些键归输入法，一个字节都不能写进 PTY
                        //（这正是之前“回车没用 / 键盘像失灵”的根源）。
                        if (self.preedit-text != "") {
                            return EventResult.reject;
                        }
                        if (event.text == "\u{1b}" && root.image-preview-open) {
                            root.image-preview-open = false;
                            return EventResult.accept;
                        }
                        if (event.text == "\u{1b}" && (root.drag-tab >= 0 || root.drag-active || root.pane-drag-from >= 0)) {
                            root.cancel-drag();
                            return EventResult.accept;
                        }
                        if (event.text == "\u{1b}" && (root.menu-open || root.tabmenu-open || root.tabctx-open || root.profilemenu-open)) {
                            root.menu-open = false;
                            root.tabmenu-open = false;
                            root.tabctx-open = false;
                            root.profilemenu-open = false;
                            root.menu-dismissed();
                            return EventResult.accept;
                        }
                        root.key-input(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta, event.repeat);
                        EventResult.accept
                    }

                    // 只有应用请求了 kitty REPORT_EVENT_TYPES 才会真正写 PTY；
                    // Rust 侧用 press 登记表过滤快捷键/搜索框，普通 shell 零变化。
                    key-released(event) => {
                        if (self.preedit-text != "") {
                            return EventResult.reject;
                        }
                        root.key-release(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                        EventResult.accept
                    }

                    // 输入法提交（中文、emoji 等）；TextInput 的 text 只当提交缓冲区用。
                    edited => {
                        if (self.text != "") {
                            root.ime-commit(self.text);
                            self.text = "";
                        }
                    }
                }

                for p in root.panes : Rectangle {
                    x: p.x;
                    y: p.y;
                    width: p.w;
                    height: p.h;
                    background: (root.has-background-image || root.terminal-transparent)
                        ? transparent
                        : Palette.colors.bg;
                    clip: true;
                    // 多分屏时用 1px accent 边框标出输入焦点；单 pane 不画，避免常驻边框。
                    border-width: (p.focused && root.panes.length > 1) ? 1px : 0px;
                    border-color: Palette.colors.accent;

                    // 网格像素宽高是 cell 的整数倍，pane 右侧/底部可能余下不到一格。
                    // 这里用“主题底色 + 同样的 opacity”补齐，和终端默认背景的混合结果一致；
                    // 不能给整块 pane 铺这个半透明色，否则帧图下会二次叠 alpha。
                    if root.has-background-image || root.terminal-transparent : Rectangle {
                        x: p.iw;
                        width: p.w - p.iw;
                        height: p.ih;
                        background: Palette.colors.bg.with-alpha(root.background-opacity);
                    }
                    if root.has-background-image || root.terminal-transparent : Rectangle {
                        y: p.ih;
                        width: p.w;
                        height: p.h - p.ih;
                        background: Palette.colors.bg.with-alpha(root.background-opacity);
                    }

                    Image {
                        source: p.image;
                        // 必须显式钉在左上角：Slint 对未写 x/y 且小于父级的元素会居中，
                        // 窗口尺寸除不尽 cell 时会露出左侧/顶部一条未混合的原图。
                        x: 0px;
                        y: 0px;
                        // 始终 1:1；拖动时由 16ms 节流的实时重排保证字符清晰，不拉伸。
                        width: p.iw;
                        height: p.ih;
                    }

                    // Read Only 角标：不拦截鼠标事件，选区/滚动照常工作。
                    if p.read-only : Rectangle {
                        // 多 pane 时右上角留给拖拽手柄，角标整体左移 24px。
                        x: Math.max(6px, p.w - (root.panes.length > 1 ? 110px : 76px));
                        y: 6px;
                        width: 68px;
                        height: 18px;
                        border-radius: 4px;
                        background: Palette.colors.raise.with-alpha(0.92);
                        border-width: 1px;
                        border-color: Palette.colors.accent;

                        Text {
                            text: "READ ONLY";
                            color: Palette.colors.accent;
                            font-size: 9px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }

                    // 光标单独成层：闪烁只切 visible，不重绘/重传整屏终端帧。
                    if p.cursor-visible && p.focused
                        && !root.settings-open && !root.search-open
                        && !root.rename-open && !root.save-open
                        && !root.tabsearch-open
                        && !root.image-preview-open : Image {
                        source: p.cursor-image;
                        x: p.cursor-x;
                        y: p.cursor-y;
                        width: p.cursor-w;
                        height: p.cursor-h;
                    }

                    pane-hit := TouchArea {
                        // 链接 hover：Rust 按格识别后写 p.link-hover；只在悬停状态变化时
                        // 切换系统指针，不重绘终端帧。离开 TouchArea 时由 changed 清理。
                        mouse-cursor: p.link-hover ? pointer : default;
                        changed has-hover => {
                            if (!pane-hit.has-hover) {
                                root.pane-unhover(p.id);
                            }
                        }
                        // 修饰键位：1=Shift 2=Alt 4=Ctrl，由 Rust 侧解码成 xterm 位掩码。
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                if (event.button == PointerEventButton.right) {
                                    root.input-trace(
                                        event.modifiers.shift ? "pane-down-right-shift" : "pane-down-right",
                                        p.id, pane-hit.mouse-x, pane-hit.mouse-y);
                                }
                                if (event.button == PointerEventButton.left) {
                                    ime.focus();
                                    root.pane-clicked(p.id);
                                    root.pane-mouse-down(p.id, pane-hit.mouse-x, pane-hit.mouse-y, 0,
                                        (event.modifiers.shift ? 1 : 0) + (event.modifiers.alt ? 2 : 0) + (event.modifiers.control ? 4 : 0));
                                    return EventResult.accept;
                                }
                                // 中键：Tabby 语义，始终由 Tervo 处理（配置开启时粘贴），不转发给 TUI。
                                if (event.button == PointerEventButton.middle) {
                                    ime.focus();
                                    root.pane-clicked(p.id);
                                    root.pane-middle-click(p.id);
                                    return EventResult.accept;
                                }
                                // mouse-reporting TUI 只在 right_click="off" 时接管右键；
                                // menu/paste/clipboard 是用户显式选择的本地行为，必须优先。
                                // 否则 dsh-tui 开启鼠标上报后，右键永远进 TUI，Tervo 菜单失效。
                                if (p.mouse-reporting
                                    && event.button == PointerEventButton.right
                                    && !event.modifiers.shift
                                    && root.cfg-right-click == "off") {
                                    root.input-trace("pane-right-forward", p.id,
                                        pane-hit.mouse-x, pane-hit.mouse-y);
                                    ime.focus();
                                    root.pane-clicked(p.id);
                                    root.pane-mouse-down(p.id, pane-hit.mouse-x, pane-hit.mouse-y, 2,
                                        (event.modifiers.shift ? 1 : 0) + (event.modifiers.alt ? 2 : 0) + (event.modifiers.control ? 4 : 0));
                                    return EventResult.accept;
                                }
                                // Shift+右键（或非上报模式）打开 Tervo 菜单。
                                // 非上报模式：右键在“按下”时开菜单并 accept。
                                // 之前只在 up 开：down 被 reject 时 Slint 不保证把 up 再送给本 TouchArea，
                                // 鼠标轻微移动/经过分隔线就会丢事件，表现为“有时候右键唤不出菜单”。
                                if (event.button == PointerEventButton.right) {
                                    ime.focus();
                                    root.pane-clicked(p.id);
                                    root.pane-right-clicked(p.id, p.x + pane-hit.mouse-x, p.y + pane-hit.mouse-y);
                                    return EventResult.accept;
                                }
                            }
                            if (event.kind == PointerEventKind.move) {
                                // 按键拖动/1003 上报之前先做无按键 hover 识别；Rust 按格去重，
                                // 同一格内移动不会重复扫描。悬停状态变化只更新指针，不重绘终端。
                                root.pane-hover(p.id, pane-hit.mouse-x, pane-hit.mouse-y);
                                // 按住拖动 + 1003 悬停都走这里；是否真的上报由 Rust 按模式位过滤。
                                if (pane-hit.pressed || p.mouse-reporting) {
                                    root.pane-mouse-move(p.id, pane-hit.mouse-x, pane-hit.mouse-y, 0,
                                        (event.modifiers.shift ? 1 : 0) + (event.modifiers.alt ? 2 : 0) + (event.modifiers.control ? 4 : 0));
                                    return EventResult.accept;
                                }
                            }
                            if (event.kind == PointerEventKind.up) {
                                if (event.button == PointerEventButton.right) {
                                    root.input-trace("pane-up-right", p.id,
                                        pane-hit.mouse-x, pane-hit.mouse-y);
                                }
                                if (event.button == PointerEventButton.left) {
                                    root.pane-mouse-up(p.id, pane-hit.mouse-x, pane-hit.mouse-y, 0,
                                        (event.modifiers.shift ? 1 : 0) + (event.modifiers.alt ? 2 : 0) + (event.modifiers.control ? 4 : 0));
                                    return EventResult.accept;
                                }
                                if (event.button == PointerEventButton.middle) {
                                    return EventResult.accept;
                                }
                                if (p.mouse-reporting
                                    && event.button == PointerEventButton.right
                                    && !event.modifiers.shift) {
                                    root.pane-mouse-up(p.id, pane-hit.mouse-x, pane-hit.mouse-y, 2,
                                        (event.modifiers.shift ? 1 : 0) + (event.modifiers.alt ? 2 : 0) + (event.modifiers.control ? 4 : 0));
                                    return EventResult.accept;
                                }
                                if (event.button == PointerEventButton.right) {
                                    // 抬起交给 Rust：menu 模式在按下已弹菜单；paste/clipboard
                                    // 用抬起时间判断短按/长按（<250ms 粘贴，否则弹菜单）。
                                    root.pane-right-up(p.id, p.x + pane-hit.mouse-x, p.y + pane-hit.mouse-y);
                                    return EventResult.accept;
                                }
                            }
                            EventResult.reject
                        }
                        scroll-event(event) => {
                            // 1000/1002/1003 下滚轮要上交给应用（tmux/vim 翻页），否则本地回滚。
                            root.pane-scrolled(p.id, event.delta-y, pane-hit.mouse-x, pane-hit.mouse-y,
                                (event.modifiers.shift ? 1 : 0) + (event.modifiers.alt ? 2 : 0) + (event.modifiers.control ? 4 : 0));
                            EventResult.accept
                        }
                    }

                    // ---------------- Pane 拖拽重排（UI-PANE-008） ----------------
                    // 右上角小拖拽手柄：只在多 pane 时出现，不挡终端点击（独立 TouchArea）。
                    // 命中/落点仍在 Rust 侧做，与 divider 拖拽共用“内容区坐标 → 最近 pane”。
                    if root.panes.length > 1 : Rectangle {
                        x: p.w - 34px;
                        y: 4px;
                        width: 16px;
                        height: 16px;
                        border-radius: 4px;
                        background: (handle-hit.has-hover || root.pane-drag-from == p.id)
                            ? Palette.colors.accent
                            : Palette.colors.raise.with-alpha(0.72);
                        border-width: 1px;
                        border-color: root.pane-drag-from == p.id
                            ? Palette.colors.accent
                            : Palette.colors.border;

                        Text {
                            text: "⠿";
                            color: (handle-hit.has-hover || root.pane-drag-from == p.id)
                                ? Palette.colors.accent-text
                                : Palette.colors.subtext;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        handle-hit := TouchArea {
                            mouse-cursor: move;
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down) {
                                    if (event.button == PointerEventButton.left) {
                                        root.pane-drag-x = p.x + p.w - 34px + self.mouse-x;
                                        root.pane-drag-y = p.y + 4px + self.mouse-y;
                                        root.pane-drag-start(p.id, root.pane-drag-x, root.pane-drag-y);
                                        return EventResult.accept;
                                    }
                                    return EventResult.reject;
                                }
                                if (event.kind == PointerEventKind.move) {
                                    if (root.pane-drag-from == p.id) {
                                        root.pane-drag-x = p.x + p.w - 34px + self.mouse-x;
                                        root.pane-drag-y = p.y + 4px + self.mouse-y;
                                        root.pane-drag-move(root.pane-drag-x, root.pane-drag-y);
                                        return EventResult.accept;
                                    }
                                }
                                if (event.kind == PointerEventKind.up) {
                                    if (root.pane-drag-from == p.id) {
                                        root.pane-drag-end();
                                        return EventResult.accept;
                                    }
                                }
                                EventResult.reject
                            }
                        }
                    }

                    // 源 pane 压暗、目标 pane 高亮；松手才真正交换，Esc/失焦 = 取消。
                    if root.pane-drag-from == p.id : Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        background: #00000040;
                    }
                    if root.pane-drag-from >= 0 && root.pane-drag-target == p.id : Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        background: Palette.colors.accent.with-alpha(0.16);
                        border-width: 2px;
                        border-color: Palette.colors.accent;

                        Text {
                            text: Lang.t("Swap panes", "交换窗格");
                            color: Palette.colors.accent;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }

                    // 图片是 pane 的独立 overlay；TouchArea 必须放在 pane-hit 之后，
                    // 否则点击会被终端命中区吃掉。图片本身仍由上面的 Image 绘制。
                    for pic in p.images : TouchArea {
                        x: pic.x;
                        y: pic.y;
                        width: pic.w;
                        height: pic.h;
                        mouse-cursor: pointer;
                        clicked => {
                            root.image-open(p.id, pic.id);
                        }
                    }

                    // ---------------- 视觉铃（只画边框，不遮挡终端） ----------------
                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        background: transparent;
                        border-width: p.bell-flash ? 2px : 0px;
                        border-color: Palette.colors.accent;
                        opacity: p.bell-flash ? 1.0 : 0.0;
                        animate opacity { duration: 160ms; easing: ease-out; }
                        animate border-width { duration: 140ms; easing: ease-out; }
                    }

                    // ---------------- 拖放：文件/目录到 pane ----------------
                    drop := DropArea {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        can-drop(event) => {
                            root.can-drop-files(event.data) ? DragAction.copy : DragAction.none
                        }
                        dropped(event) => {
                            root.files-dropped(p.id, event.data);
                            return event.proposed-action;
                        }
                    }

                    // 拖放 hover 提示：半透明 accent 覆盖 + 边框，不改变命中层。
                    // DropArea 的 has-drag 是 Slint 官方路径；winit 后端下由
                    // drop-hover-pane（原生桥接）承担同样的提示。
                    if drop.has-drag || root.drop-hover-pane == p.id : Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        background: Palette.colors.accent.with-alpha(0.08);
                        border-width: 2px;
                        border-color: Palette.colors.accent;
                    }

                    // ---------------- 滚动条 overlay ----------------
                    // 只有 scrollback 超出视口时出现；track 与终端网格等高，
                    // 不吃掉右侧字符区域的布局（overlay，不改变 pane 尺寸）。
                    if p.scrollbar-visible : Rectangle {
                        // UI-TERM-009：窗口右侧最外 5px 是 resize 命中带，overlay
                        // 必须整体让开它（此前只留 3px，最右 2px 点滚动条会变 resize）。
                        x: p.w - 14px;
                        y: 0px;
                        width: 9px;
                        height: p.scrollbar-track-h;
                        background: transparent;

                        sb-hit := TouchArea {
                            property <bool> dragging: false;
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            height: 100%;

                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down
                                    && event.button == PointerEventButton.left) {
                                    self.dragging = true;
                                    root.pane-scrollbar(p.id, Math.max(0.0,
                                        Math.min(1.0, self.mouse-y / p.scrollbar-track-h)));
                                    return EventResult.accept;
                                }
                                if (event.kind == PointerEventKind.move && self.dragging) {
                                    root.pane-scrollbar(p.id, Math.max(0.0,
                                        Math.min(1.0, self.mouse-y / p.scrollbar-track-h)));
                                    return EventResult.accept;
                                }
                                if (event.kind == PointerEventKind.up) {
                                    self.dragging = false;
                                    return EventResult.accept;
                                }
                                EventResult.reject
                            }
                        }

                        Rectangle {
                            x: 2px;
                            width: 5px;
                            y: p.scrollbar-thumb-y;
                            height: p.scrollbar-thumb-h;
                            border-radius: 3px;
                            background: (sb-hit.has-hover || sb-hit.pressed)
                                ? Palette.colors.accent
                                : Palette.colors.muted.with-alpha(0.8);
                        }
                    }
                }

                // ---------------- 分屏分隔线（可拖拽调整比例） ----------------
                for d in root.dividers : Rectangle {
                    x: d.x;
                    y: d.y;
                    width: d.w;
                    height: d.h;

                    Rectangle {
                        x: d.vertical ? (parent.width - 1px) / 2 : 0px;
                        y: d.vertical ? 0px : (parent.height - 1px) / 2;
                        width: d.vertical ? 1px : parent.width;
                        height: d.vertical ? parent.height : 1px;
                        background: Palette.colors.border;
                    }

                    TouchArea {
                        // 命中区比 1px 线宽 4px，方便抓取
                        x: d.vertical ? -2px : 0px;
                        y: d.vertical ? 0px : -2px;
                        width: d.vertical ? d.w + 4px : d.w;
                        height: d.vertical ? d.h : d.h + 4px;
                        mouse-cursor: d.vertical ? ew-resize : ns-resize;
                        // 只接管左键拖拽。Slint 的 TouchArea 按下会无条件 grab，
                        // 以前这里对任何按键都 accept，右键落在 4px 命中带里就被吞掉，
                        // 表现为「有时候右键呼叫不出菜单」。
                        property <bool> dragging: false;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                if (event.button == PointerEventButton.left) {
                                    self.dragging = true;
                                    return EventResult.accept;
                                }
                                // 右键：占住这次按下，等 up 再开菜单（否则事件不会回落给 pane）
                                return event.button == PointerEventButton.right
                                    ? EventResult.accept
                                    : EventResult.reject;
                            }
                            if (event.kind == PointerEventKind.move && self.dragging) {
                                root.divider-dragged(
                                    d.index,
                                    d.vertical ? d.x - 2px + self.mouse-x : d.x + self.mouse-x,
                                    d.vertical ? d.y + self.mouse-y : d.y - 2px + self.mouse-y,
                                );
                                return EventResult.accept;
                            }
                            if (event.kind == PointerEventKind.up) {
                                self.dragging = false;
                                if (event.button == PointerEventButton.right) {
                                    root.pane-right-clicked-at(
                                        d.vertical ? d.x - 2px + self.mouse-x : d.x + self.mouse-x,
                                        d.vertical ? d.y + self.mouse-y : d.y - 2px + self.mouse-y,
                                    );
                                }
                                return EventResult.accept;
                            }
                            EventResult.reject
                        }
                    }
                }

                // 菜单打开时，点菜单以外的任何地方都先关掉菜单（否则残留菜单会挡住后续右键）。
                // 这层在 pane 之上、菜单之下：菜单项仍然可点。
                if root.menu-open : TouchArea {
                    width: 100%;
                    height: 100%;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            // 左键：关菜单。右键：关掉后在新的位置重新打开，
                            // 避免连续右键时「第二次只是把菜单关掉」看起来像唤不出菜单。
                            let reopen = event.button == PointerEventButton.right;
                            root.menu-open = false;
                            root.menu-dismissed();
                            if (reopen) {
                                root.pane-right-clicked-at(self.mouse-x, self.mouse-y);
                            }
                            return EventResult.accept;
                        }
                        EventResult.reject
                    }
                }

                // ---------------- 右键菜单 ----------------
                // 扁平菜单：不再显示 Link/Clipboard/Pane/View/Session 分组标题，
                // 只保留菜单项与快捷键提示。动作 ID 与回调保持原样。
                if root.menu-open : Rectangle {
                    x: root.menu-left;
                    y: root.menu-top;
                    width: root.menu-width;
                    height: root.menu-view-h;
                    background: Palette.colors.raise;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Palette.colors.border;
                    drop-shadow-blur: 22px;
                    drop-shadow-offset-y: 7px;
                    drop-shadow-color: #00000088;
                    clip: true;

                    // interactive=false：滚轮仍可滚动（Slint Flickable 语义），
                    // 但按下/抬起会立即交给菜单行，避免拖拽延迟/吞点击。
                    menu-flick := Flickable {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        interactive: false;
                        mouse-drag-pan-enabled: false;
                        content-width: parent.width;
                        content-height: menu-list.preferred-height;

                        // UI-TERM-004：键盘上下移动选中行时把它滚进视口。
                        // 只有 token 变化才改 viewport-y，滚轮仍由 Flickable 处理。
                        property <int> nav-reveal-token: root.menu-reveal-token;
                        changed nav-reveal-token => {
                            if (root.menu-reveal-y < self.viewport-y) {
                                self.viewport-y = root.menu-reveal-y;
                            } else if (root.menu-reveal-y + 30px > self.viewport-y + self.height) {
                                self.viewport-y = root.menu-reveal-y + 30px - self.height;
                            }
                        }

                        menu-list := VerticalLayout {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            padding: 6px;
                            spacing: 0px;

                            // UI-TERM-013：菜单项来自 Rust 的 MenuEntry 模型
                            //（内置默认表 / config `[[terminal_menu]]` / 插件装饰点）。
                            for item[i] in root.menu-items : ContextMenuEntry {
                                entry: item;
                                selected: i == root.menu-selected;
                                picked(command) => {
                                    root.menu-open = false;
                                    root.menu-command(root.menu-pane, command);
                                }
                            }
                        }
                    }

                    // 窄窗口：菜单内容高于可用视口时显示细滚动条（提示还有分组/项）。
                    if menu-flick.content-height > menu-flick.height : Rectangle {
                        x: parent.width - 5px;
                        y: 6px + (-menu-flick.content-y)
                            / Math.max(1px, menu-flick.content-height - menu-flick.height)
                            * Math.max(0px, parent.height - self.height - 12px);
                        width: 3px;
                        height: Math.max(24px,
                            parent.height * parent.height / Math.max(1px, menu-flick.content-height));
                        border-radius: 1.5px;
                        background: Palette.colors.subtext;
                        opacity: 0.55;
                    }
                }
            }
        }
    }

    // Profile 选择器菜单：点外部关闭
    if root.profilemenu-open : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.profilemenu-open = false;
                    root.focus-terminal();
                    root.menu-dismissed();
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }
    }

    if root.profilemenu-open : Rectangle {
        // n 个 Profile 行 + 分隔线 + Manage 行 + 内边距；超出窗口高度才滚。
        x: Math.max(0px, Math.min(root.profilemenu-x, root.width - 240px));
        y: root.tabbar-vertical
            ? root.height - self.height - 8px
            : (root.tabbar-bottom
                ? root.height - root.tabbar-height - self.height
                : root.tabbar-height);
        width: 240px;
        height: Math.min(Math.max(28px, root.profilemenu-items.length * 28px + 29px) + 8px,
            root.height - root.chrome-top - root.chrome-bottom - 8px);
        background: Palette.colors.raise;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 20px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #000000b0;
        clip: true;

        // 纯列表：↑↓ 移动高亮、Enter 打开、Esc 关闭；没有搜索框。
        // 键盘由 Rust `handle_input` 处理：菜单不抢 FocusScope，终端始终能收到键。
        VerticalLayout {
            padding: 4px;
            spacing: 0px;

            // Profile 多时列表内部滚动；键盘高亮行始终自动滚进视口。
            Flickable {
                height: Math.max(28px,
                    Math.min(root.profilemenu-items.length * 28px + 29px,
                        root.height - root.chrome-top - root.chrome-bottom - 45px));
                content-width: self.width;
                content-height: Math.max(28px, root.profilemenu-items.length * 28px + 29px);
                interactive: true;
                // 键盘 ↑↓ 移动高亮时把该行滚进视口。用双向绑定保证
                // root.profilemenu-selected（Rust 侧 set）变化时这里立刻收到，
                // 普通单向绑定是惰性的，changed 可能不触发。
                in-out property <int> selected-row <=> root.profilemenu-selected;
                changed selected-row => {
                    if (self.selected-row >= 0) {
                        let row-y = self.selected-row * 28px;
                        // Flickable 的 content-y 是负的滚动偏移，可视区顶部 =
                        // -content-y（与 tab search/settings 的符号约定一致）。
                        let visible-top = -self.content-y;
                        if (row-y < visible-top) {
                            self.content-y = -row-y;
                        } else if (row-y + 28px > visible-top + self.height) {
                            self.content-y = -(row-y + 28px - self.height);
                        }
                    }
                }

                VerticalLayout {
                    padding: 0px;
                    spacing: 0px;

                    for item[i] in root.profilemenu-items : MenuRow {
                        label: item;
                        selected: i == root.profilemenu-selected;
                        picked => { root.profilemenu-open = false; root.profilemenu-pick(i); }
                    }

                    // 没有 Profile 时的空态（不占额外行高、不能点）。
                    if root.profilemenu-items.length == 0 : Rectangle {
                        height: 40px;
                        Text {
                            x: 10px;
                            text: Lang.t("No profiles yet", "还没有配置");
                            color: Palette.colors.muted;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Palette.colors.border;
                    }

                    MenuRow {
                        label: Lang.t("Manage Profiles…", "管理配置…");
                        picked => { root.profilemenu-open = false; root.profilemenu-manage(); }
                    }
                }
            }
        }
    }

    // 点菜单外的任意位置关闭 TabBar / Tab 菜单（此前只能点菜单项，菜单会一直留着）。
    // 这层放在两个菜单之前（下面），菜单项仍在最上层可点。
    if root.tabmenu-open || root.tabctx-open : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.tabmenu-open = false;
                    root.tabctx-open = false;
                    root.menu-dismissed();
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }
    }

    if root.tabmenu-open : Rectangle {
        x: Math.min(root.tabmenu-x, root.width - 180px);
        y: root.tabmenu-y;
        width: 170px;
        // 13 行：13×28 + 12×2 + 上下 padding 8 = 396（新增 New Window 行后正好占满）
        height: 396px;
        background: Palette.colors.raise;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.colors.hover;
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #000000a8;

        VerticalLayout {
            padding: 4px;
            spacing: 2px;

            MenuRow {
                label: root.pinned ? Lang.t("Always on Top  ✓", "总在最前  ✓") : Lang.t("Always on Top", "总在最前");
                picked => { root.tabmenu-open = false; root.pinned = !root.pinned; }
            }
            MenuRow {
                label: Lang.t("New Tab", "新建标签");
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(1); }
            }
            MenuRow {
                label: Lang.t("New Window", "新建窗口");
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(13); }
            }
            MenuRow {
                label: Lang.t("Settings", "设置");
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(2); }
            }
            MenuRow {
                // 存布局 + cwd，重启进程后按快照恢复（不丢分屏）
                label: Lang.t("Restart Session", "重启会话");
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(4); }
            }
            MenuRow {
                label: Lang.t("Command Palette", "命令面板");
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(5); }
            }
            MenuRow {
                // 点一次循环：top → bottom → left → right → top；label 显示当前值。
                label: root.tabbar-position == "bottom"
                    ? Lang.t("Tab Bar: Bottom", "标签栏：底部")
                    : (root.tabbar-position == "left"
                        ? Lang.t("Tab Bar: Left", "标签栏：左侧")
                        : (root.tabbar-position == "right"
                            ? Lang.t("Tab Bar: Right", "标签栏：右侧")
                            : Lang.t("Tab Bar: Top", "标签栏：顶部")));
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(6); }
            }
            MenuRow {
                label: Lang.t("Background Sessions", "后台会话");
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(8); }
            }
            MenuRow {
                label: Lang.t("Profiles", "配置");
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(9); }
            }
            MenuRow {
                label: "SFTP";
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(10); }
            }
            MenuRow {
                label: Lang.t("Port Forwards", "端口转发");
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(11); }
            }
            MenuRow {
                label: Lang.t("Reopen Closed Tab", "重新打开已关闭标签");
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(12); }
            }
            MenuRow {
                label: Lang.t("Close Window", "关闭窗口");
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(3); }
            }
        }
    }

    if root.tabctx-open : Rectangle {
        x: Math.max(0px, Math.min(root.tabctx-x, root.width - 180px));
        // 7 行 × 28px + 6×2px spacing + 上下 padding 8 = 216px。
        y: root.tabbar-vertical
            ? Math.max(8px, Math.min(root.tabctx-y, root.height - 224px))
            : (root.tabbar-bottom
                ? root.height - root.tabbar-height - 216px
                : root.tabbar-height);
        width: 190px;
        height: 216px;
        background: Palette.colors.raise;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.colors.hover;
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #000000a8;

        VerticalLayout {
            padding: 4px;
            spacing: 2px;

            MenuRow {
                label: Lang.t("Close", "关闭");
                picked => { root.tabctx-open = false; root.tab-menu-action(root.tabctx-index, 0); }
            }
            MenuRow {
                label: Lang.t("Close Others", "关闭其他");
                picked => { root.tabctx-open = false; root.tab-menu-action(root.tabctx-index, 1); }
            }
            MenuRow {
                label: Lang.t("Close Left", "关闭左侧");
                picked => { root.tabctx-open = false; root.tab-menu-action(root.tabctx-index, 4); }
            }
            MenuRow {
                label: Lang.t("Close Right", "关闭右侧");
                picked => { root.tabctx-open = false; root.tab-menu-action(root.tabctx-index, 5); }
            }
            MenuRow {
                label: Lang.t("Duplicate", "复制标签");
                picked => { root.tabctx-open = false; root.tab-menu-action(root.tabctx-index, 2); }
            }
            MenuRow {
                label: Lang.t("Rename", "重命名");
                picked => { root.tabctx-open = false; root.tab-menu-action(root.tabctx-index, 3); }
            }
            // action 6：additive，label 按当前 Tab 的 pinned 状态切换。
            MenuRow {
                label: root.tabctx-pinned ? Lang.t("Unpin Tab", "取消固定") : Lang.t("Pin Tab", "固定标签页");
                picked => { root.tabctx-open = false; root.tab-menu-action(root.tabctx-index, 6); }
            }
        }
    }

    // ================= Settings =================
    // 默认：窗口内的 Settings Tab（占满 TabBar 下方内容区，不创建 PTY、不进 workspace）。
    // TERVO_SETTINGS_LEGACY=1：同一套控件退回居中 modal（顶部有 LEGACY 标记）。
    if root.settings-open : Rectangle {
        x: root.chrome-left;
        y: root.chrome-top;
        width: root.width - root.chrome-left - root.chrome-right;
        height: root.content-h;
        background: root.settings-legacy ? #00000080 : Palette.colors.bg;

        // legacy 模式点遮罩关闭；Tab 模式下没有遮罩。
        if root.settings-legacy : TouchArea {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            clicked => { root.close-settings(); }
        }

        settings-panel := Rectangle {
            x: root.settings-legacy ? (parent.width - self.width) / 2 : 0px;
            y: root.settings-legacy ? (parent.height - self.height) / 2 : 0px;
            width: root.settings-legacy ? Math.min(820px, parent.width - 32px) : parent.width;
            height: root.settings-legacy ? Math.min(620px, parent.height - 32px) : parent.height;
            background: Palette.colors.bg;
            border-radius: root.settings-legacy ? 12px : 0px;
            border-width: root.settings-legacy ? 1px : 0px;
            border-color: Palette.colors.border;
            drop-shadow-blur: root.settings-legacy ? 30px : 0px;
            drop-shadow-offset-y: root.settings-legacy ? 10px : 0px;
            drop-shadow-color: #000000b8;
            clip: true;

            settings-body := FocusScope {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                focus-on-click: false;
                init => { self.focus(); }

                // Esc：先收起主题下拉，再关闭设置；其它键不写入终端。
                key-pressed(event) => {
                    if (event.text == "\u{1b}") {
                        if (root.settings-theme-open) {
                            root.settings-theme-open = false;
                        } else {
                            root.close-settings();
                        }
                        return EventResult.accept;
                    }
                    EventResult.reject
                }

                // 模态（Profiles/Profile 表单）关闭后重新拿回键盘焦点。
                property <int> refocus-token: root.settings-refocus-token;
                changed refocus-token => { self.focus(); }

                property <length> sidebar-w: self.width < 900px
                    ? Math.min(164px, Math.max(156px, self.width * 0.32))
                    : 220px;
                // 不设固定上限：设置页必须跟整个窗口一起放大；只保留最小宽度。
                property <length> content-w: Math.max(80px,
                    self.width - self.sidebar-w - 40px);
                property <length> content-x: self.sidebar-w + 20px
                    + Math.max(0px, (self.width - self.sidebar-w - 40px - self.content-w) / 2);
                property <length> content-y: 64px;
                property <length> content-h: self.height - 76px;
                property <length> search-w: Math.max(80px, Math.min(260px, self.width - 210px));
                property <length> search-x: self.width - self.search-w - 56px;

                // 吃掉面板空白处的点击，避免穿透到下面的终端 pane（误选中/误点击）。
                TouchArea {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 100%;
                    pointer-event(event) => { EventResult.accept; }
                }

                // ---------------- 顶栏 ----------------
                Text {
                    x: 24px;
                    y: 0px;
                    width: Math.max(60px, Math.min(180px, settings-body.width - 200px));
                    height: 52px;
                    text: Lang.t("Settings", "设置");
                    color: Palette.colors.text;
                    font-size: 17px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.settings-legacy : Text {
                    x: 120px;
                    y: 0px;
                    width: 130px;
                    height: 52px;
                    text: Lang.t("LEGACY MODAL", "传统模态窗口");
                    color: Palette.colors.accent;
                    font-size: 9px;
                    font-weight: 600;
                    vertical-alignment: center;
                    visible: settings-body.width > 560px;
                }

                Rectangle {
                    x: settings-body.search-x;
                    y: 12px;
                    width: settings-body.search-w;
                    height: 28px;
                    border-radius: 8px;
                    background: Palette.colors.surface;
                    border-width: 1px;
                    border-color: root.settings-query != ""
                        ? Palette.colors.accent
                        : Palette.colors.border;

                    SettingsIconView {
                        x: 8px;
                        y: 6px;
                        kind: SettingsIconKind.search;
                        tint: Palette.colors.muted;
                    }

                    Text {
                        x: 30px;
                        width: parent.width - 40px;
                        height: parent.height;
                        text: Lang.t("Search settings…", "搜索设置…");
                        color: Palette.colors.muted;
                        font-size: 11px;
                        vertical-alignment: center;
                        visible: root.settings-query == "";
                        overflow: elide;
                    }

                    TextInput {
                        x: 30px;
                        width: parent.width - (root.settings-query == "" ? 40px : 64px);
                        height: parent.height;
                        text <=> root.settings-query;
                        single-line: true;
                        color: Palette.colors.text;
                        font-size: 11px;
                        vertical-alignment: center;
                        edited => {
                            root.settings-theme-open = false;
                            root.settings-filter(self.text);
                        }
                        accepted => {
                            if (root.settings-results.length > 0) {
                                root.settings-open-result(0);
                            }
                        }
                        key-pressed(event) => {
                            if (event.text == "\u{1b}") {
                                if (root.settings-query != "") {
                                    root.settings-query = "";
                                    root.settings-filter("");
                                } else {
                                    root.close-settings();
                                }
                                return EventResult.accept;
                            }
                            EventResult.reject
                        }
                    }

                    if root.settings-query != "" : Rectangle {
                        x: parent.width - 28px;
                        y: 4px;
                        width: 20px;
                        height: 20px;
                        border-radius: 5px;
                        background: settings-search-clear.has-hover ? Palette.colors.hover : transparent;
                        Text {
                            text: "×";
                            color: Palette.colors.muted;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                        settings-search-clear := TouchArea {
                            clicked => {
                                root.settings-query = "";
                                root.settings-filter("");
                            }
                        }
                    }
                }

                Rectangle {
                    x: settings-body.width - 42px;
                    y: 10px;
                    width: 30px;
                    height: 30px;
                    border-radius: 7px;
                    background: settings-close-hit.has-hover ? Palette.colors.danger : Palette.colors.hover;
                    Text {
                        text: "✕";
                        color: settings-close-hit.has-hover
                            ? Palette.colors.accent-text
                            : Palette.colors.subtext;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                    settings-close-hit := TouchArea {
                        clicked => { root.close-settings(); }
                    }
                }

                Rectangle {
                    x: 0px;
                    y: 51px;
                    width: 100%;
                    height: 1px;
                    background: Palette.colors.border;
                }

                // ---------------- 左导航 ----------------
                Rectangle {
                    x: 0px;
                    y: 52px;
                    width: settings-body.sidebar-w;
                    height: parent.height - 52px;
                    background: Palette.colors.surface;
                }
                Rectangle {
                    x: settings-body.sidebar-w;
                    y: 52px;
                    width: 1px;
                    height: parent.height - 52px;
                    background: Palette.colors.border;
                }

                settings-nav := Flickable {
                    x: 0px;
                    y: 52px;
                    width: settings-body.sidebar-w;
                    height: parent.height - 52px;
                    interactive: true;
                    content-width: self.width;
                    content-height: nav-layout.preferred-height + 24px;

                    nav-layout := VerticalLayout {
                        x: 10px;
                        y: 12px;
                        width: parent.width - 20px;
                        spacing: 2px;

                        Text {
                            height: 24px;
                            text: Lang.t("PERSONALIZE", "个性化");
                            color: Palette.colors.muted;
                            font-size: 9px;
                            font-weight: 600;
                            letter-spacing: 0.8px;
                            vertical-alignment: bottom;
                        }
                        NavItem {
                            label: Lang.t("Appearance", "外观");
                            icon: SettingsIconKind.appearance;
                            active: root.settings-category == 0;
                            clicked => {
                                root.settings-focus = "";
                                root.settings-theme-open = false;
                                root.settings-category = 0;
                                root.settings-category-changed(0);
                            }
                        }
                        NavItem {
                            label: Lang.t("Terminal", "终端");
                            icon: SettingsIconKind.terminal;
                            active: root.settings-category == 1;
                            clicked => {
                                root.settings-focus = "";
                                root.settings-theme-open = false;
                                root.settings-category = 1;
                                root.settings-category-changed(1);
                            }
                        }
                        NavItem {
                            label: Lang.t("Window", "窗口");
                            icon: SettingsIconKind.window;
                            active: root.settings-category == 2;
                            clicked => {
                                root.settings-focus = "";
                                root.settings-theme-open = false;
                                root.settings-category = 2;
                                root.settings-category-changed(2);
                            }
                        }

                        Rectangle { height: 10px; background: transparent; }

                        Text {
                            height: 24px;
                            text: Lang.t("WORKSPACE", "工作区");
                            color: Palette.colors.muted;
                            font-size: 9px;
                            font-weight: 600;
                            letter-spacing: 0.8px;
                            vertical-alignment: bottom;
                        }
                        NavItem {
                            label: Lang.t("Keys", "快捷键");
                            icon: SettingsIconKind.keys;
                            active: root.settings-category == 4;
                            clicked => {
                                root.settings-focus = "";
                                root.settings-theme-open = false;
                                root.settings-category = 4;
                                root.settings-category-changed(4);
                            }
                        }
                        NavItem {
                            label: Lang.t("Profiles", "配置");
                            icon: SettingsIconKind.profiles;
                            active: root.settings-category == 7;
                            clicked => {
                                root.settings-focus = "";
                                root.settings-theme-open = false;
                                root.settings-category = 7;
                                root.settings-category-changed(7);
                            }
                        }
                        NavItem {
                            label: Lang.t("Plugins", "插件");
                            icon: SettingsIconKind.plugins;
                            active: root.settings-category == 5;
                            clicked => {
                                root.settings-focus = "";
                                root.settings-theme-open = false;
                                root.settings-category = 5;
                                root.settings-category-changed(5);
                            }
                        }

                        Rectangle { height: 10px; background: transparent; }

                        Text {
                            height: 24px;
                            text: Lang.t("SYSTEM", "系统");
                            color: Palette.colors.muted;
                            font-size: 9px;
                            font-weight: 600;
                            letter-spacing: 0.8px;
                            vertical-alignment: bottom;
                        }
                        NavItem {
                            label: Lang.t("Vault", "保险库");
                            icon: SettingsIconKind.vault;
                            active: root.settings-category == 6;
                            clicked => {
                                root.settings-focus = "";
                                root.settings-theme-open = false;
                                root.settings-category = 6;
                                root.settings-category-changed(6);
                            }
                        }
                        NavItem {
                            label: Lang.t("Advanced", "高级");
                            icon: SettingsIconKind.advanced;
                            active: root.settings-category == 3;
                            clicked => {
                                root.settings-focus = "";
                                root.settings-theme-open = false;
                                root.settings-category = 3;
                                root.settings-category-changed(3);
                            }
                        }
                        NavItem {
                            label: Lang.t("Help", "帮助");
                            icon: SettingsIconKind.help;
                            active: root.settings-category == 8;
                            clicked => {
                                root.settings-focus = "";
                                root.settings-theme-open = false;
                                root.settings-category = 8;
                                root.settings-category-changed(8);
                            }
                        }
                        NavItem {
                            label: Lang.t("Privacy", "隐私");
                            icon: SettingsIconKind.privacy;
                            active: root.settings-category == 9;
                            clicked => {
                                root.settings-focus = "";
                                root.settings-theme-open = false;
                                root.settings-category = 9;
                                root.settings-category-changed(9);
                            }
                        }

                        Text {
                            height: 40px;
                            text: Lang.t("Tervo · changes apply instantly", "Tervo · 更改立即生效");
                            color: Palette.colors.muted;
                            font-size: 9px;
                            vertical-alignment: bottom;
                            wrap: word-wrap;
                        }
                    }
                }

                // ---------------- Appearance ----------------
                if root.settings-category == 0 : Flickable {
                    x: settings-body.content-x;
                    y: settings-body.content-y;
                    width: settings-body.content-w;
                    height: settings-body.content-h;
                    property <int> jump-token: root.settings-jump-token;
                    interactive: true;
                    content-width: self.width;
                    content-height: appearance-layout.preferred-height + 10px;

                    changed jump-token => {
                        let min-y = -Math.max(0px, self.content-height - self.height);
                        if (root.settings-focus == "theme") {
                            self.content-y = Math.max(min-y, Math.min(0px, -theme-card.y + 8px));
                        } else if (root.settings-focus == "background") {
                            self.content-y = Math.max(min-y, Math.min(0px, -background-card.y + 8px));
                        } else if (root.settings-focus == "cursor") {
                            self.content-y = Math.max(min-y, Math.min(0px, -cursor-card.y + 8px));
                        } else if (root.settings-focus == "bold") {
                            self.content-y = Math.max(min-y, Math.min(0px, -bold-card.y + 8px));
                        }
                    }

                    appearance-layout := VerticalLayout {
                        width: 100%;
                        spacing: 10px;

                        language-card := SettingsCard {
                            title: Lang.t("Language", "语言");
                            description: Lang.t("Applies immediately to Settings and context menus.", "立即应用到设置页与右键菜单。");

                            SettingField {
                                label: Lang.t("Interface language", "界面语言");
                                Segmented {
                                    options: ["English", "中文"];
                                    values: ["en", "zh"];
                                    value: root.language;
                                    picked(v) => {
                                        root.language = v;
                                        root.language-changed(v);
                                    }
                                }
                            }
                        }

                        theme-card := SettingsCard {
                            title: Lang.t("Theme", "主题");
                            description: Lang.t("Color scheme applies immediately to every pane and UI chrome.", "配色立即应用到所有窗格与界面。");
                            highlighted: root.settings-focus == "theme";

                            SettingField {
                                label: Lang.t("Color scheme", "配色方案");
                                Rectangle {
                                    width: 100%;
                                    height: 32px;
                                    border-radius: 8px;
                                    background: Palette.colors.bg;
                                    border-width: 1px;
                                    border-color: root.settings-theme-open
                                        ? Palette.colors.accent
                                        : Palette.colors.border;

                                    Text {
                                        x: 12px;
                                        width: parent.width - 46px;
                                        height: parent.height;
                                        text: root.theme-display;
                                        color: Palette.colors.text;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    SettingsIconView {
                                        x: parent.width - 30px;
                                        y: 8px;
                                        kind: SettingsIconKind.chevron;
                                        tint: root.settings-theme-open
                                            ? Palette.colors.accent
                                            : Palette.colors.muted;
                                    }
                                    TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        clicked => {
                                            root.settings-theme-open = !root.settings-theme-open;
                                        }
                                    }
                                }
                            }

                            SettingRow {
                                label: Lang.t("Auto follows system", "自动跟随系统");
                                description: Lang.t("Uses the desktop dark/light preference when available.", "可用时跟随桌面深色/浅色偏好。");
                                SettingsSwitch {
                                    on: root.theme-name == "auto";
                                    toggled => { root.set-theme("auto"); }
                                }
                            }
                        }

                        background-card := SettingsCard {
                            title: Lang.t("Background", "背景");
                            description: Lang.t("Optional wallpaper behind the terminal; text and colors stay readable.", "可选终端壁纸；文字与配色保持可读。");
                            highlighted: root.settings-focus == "background";

                            SettingField {
                                label: Lang.t("Image", "图片");
                                description: Lang.t("PNG / JPEG / SVG path · ~ is expanded · empty = off", "PNG / JPEG / SVG 路径 · 自动展开 ~ · 留空 = 关闭");
                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 32px;
                                        background: transparent;
                                        SettingsTextField {
                                            width: 100%;
                                            text <=> root.background-image-path;
                                            placeholder: "/home/you/Pictures/wallpaper.png";
                                            error: root.background-image-error != "";
                                            clearable: true;
                                            commit-on-blur: true;
                                            edited(t) => { root.background-image-changed(t); }
                                            accepted(t) => { root.background-image-commit(t); }
                                            cleared => { root.background-image-changed(""); }
                                            blurred(t) => { root.background-image-commit(t); }
                                        }
                                    }
                                    ActionBtn {
                                        label: Lang.t("Browse…", "浏览…");
                                        width: 76px;
                                        clicked => { root.background-image-browse(); }
                                    }
                                }
                            }

                            if root.background-image-error != "" : Text {
                                text: root.background-image-error;
                                color: Palette.colors.danger;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            if root.background-image-error == "" : Text {
                                text: Lang.t("Images are cropped to fill the window; only existing regular files are accepted.", "图片会被裁剪以填满窗口；只接受存在的普通文件。");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }

                            SettingField {
                                label: Lang.t("Dim", "暗化");
                                description: Lang.t("Darkens only the image (default 60%).", "仅压暗图片（默认 60%）。");
                                HorizontalLayout {
                                    spacing: 8px;
                                    OpacitySlider {
                                        height: 22px;
                                        horizontal-stretch: 1;
                                        value: root.background-dim;
                                        min: 0.0;
                                        max: 0.8;
                                        preview(v) => {
                                            root.background-dim = v;
                                            root.background-dim-preview(v);
                                        }
                                        changed(v) => {
                                            root.background-dim = v;
                                            root.background-dim-changed(v);
                                        }
                                    }
                                    Text {
                                        text: "\{Math.round(root.background-dim * 100)}%";
                                        color: Palette.colors.text;
                                        width: 42px;
                                        font-size: 12px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            SettingField {
                                label: Lang.t("Terminal opacity", "终端不透明度");
                                description: !root.has-background-image
                                    ? Lang.t("0% makes the terminal background transparent; 100% keeps the theme color.", "0% 让终端背景透明；100% 保持主题色。")
                                    : Lang.t("0% reveals the wallpaper completely; 100% keeps the theme color.", "0% 完全透出壁纸；100% 保持主题色。");
                                HorizontalLayout {
                                    spacing: 8px;
                                    OpacitySlider {
                                        height: 22px;
                                        horizontal-stretch: 1;
                                        value: root.background-opacity;
                                        min: 0.0;
                                        max: 1.0;
                                        preview(v) => {
                                            root.background-opacity = v;
                                            root.background-opacity-preview(v);
                                        }
                                        changed(v) => {
                                            root.background-opacity = v;
                                            root.background-opacity-changed(v);
                                        }
                                    }
                                    Text {
                                        text: "\{Math.round(root.background-opacity * 100)}%";
                                        color: Palette.colors.text;
                                        width: 42px;
                                        font-size: 12px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        cursor-card := SettingsCard {
                            title: Lang.t("Cursor", "光标");
                            description: Lang.t("Shape and colors update the overlay without repainting the terminal grid.", "形状与颜色只更新叠加层，不重绘终端网格。");
                            highlighted: root.settings-focus == "cursor";

                            SettingField {
                                label: Lang.t("Shape", "形状");
                                Segmented {
                                    options: [Lang.t("Block", "块状"), Lang.t("Underline", "下划线"), Lang.t("I-beam", "竖线")];
                                    values: ["block", "underline", "ibeam"];
                                    value: root.cfg-cursor-shape;
                                    picked(v) => { root.set-cursor-shape(v); }
                                }
                            }
                            SettingField {
                                label: Lang.t("Blink", "闪烁");
                                Segmented {
                                    options: [Lang.t("Follow system", "跟随系统"), Lang.t("On", "开"), Lang.t("Off", "关")];
                                    values: ["system", "on", "off"];
                                    value: root.cfg-cursor-blink;
                                    picked(v) => { root.set-cursor-blink(v); }
                                }
                            }
                            SettingField {
                                label: Lang.t("Cursor color", "光标颜色");
                                description: Lang.t("Empty = theme cursor color (#rrggbb).", "留空 = 主题光标色（#rrggbb）。");
                                SettingsTextField {
                                    text <=> root.cfg-cursor-color;
                                    placeholder: Lang.t("theme default", "主题默认");
                                    clearable: true;
                                    edited(t) => { root.cursor-color-changed(t); }
                                    cleared => { root.cursor-color-changed(""); }
                                }
                            }
                            SettingField {
                                label: Lang.t("Cursor text color", "光标下文字颜色");
                                description: Lang.t("Empty = theme background (inverse block cursor).", "留空 = 主题背景色（块状光标反色）。");
                                SettingsTextField {
                                    text <=> root.cfg-cursor-text-color;
                                    placeholder: Lang.t("theme background", "主题背景");
                                    clearable: true;
                                    edited(t) => { root.cursor-text-color-changed(t); }
                                    cleared => { root.cursor-text-color-changed(""); }
                                }
                            }
                        }

                        bold-card := SettingsCard {
                            title: Lang.t("Bold", "粗体");
                            highlighted: root.settings-focus == "bold";

                            SettingRow {
                                label: Lang.t("Bold is bright", "粗体使用亮色");
                                description: Lang.t("ANSI 0–7 bold text uses the bright palette.", "ANSI 0–7 的粗体使用亮色调色板。");
                                SettingsSwitch {
                                    on: root.cfg-bold-is-bright;
                                    toggled => { root.toggle-bold-is-bright(); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Bold color same as foreground", "粗体颜色同前景色");
                                description: Lang.t("Disable to use a dedicated bold color below.", "关闭后使用下方单独的粗体颜色。");
                                SettingsSwitch {
                                    on: root.cfg-bold-color-same-as-fg;
                                    toggled => { root.toggle-bold-color-same-as-fg(); }
                                }
                            }
                            SettingField {
                                label: Lang.t("Bold color", "粗体颜色");
                                description: Lang.t("Empty = normal foreground; explicit ANSI colors are unaffected.", "留空 = 普通前景色；显式 ANSI 颜色不受影响。");
                                SettingsTextField {
                                    text <=> root.cfg-bold-color;
                                    placeholder: Lang.t("use foreground", "使用前景色");
                                    clearable: true;
                                    edited(t) => { root.bold-color-changed(t); }
                                    cleared => { root.bold-color-changed(""); }
                                }
                            }
                        }
                    }
                }

                // ---------------- Terminal ----------------
                if root.settings-category == 1 : Flickable {
                    x: settings-body.content-x;
                    y: settings-body.content-y;
                    width: settings-body.content-w;
                    height: settings-body.content-h;
                    property <int> jump-token: root.settings-jump-token;
                    interactive: true;
                    content-width: self.width;
                    content-height: terminal-layout.preferred-height + 10px;

                    changed jump-token => {
                        let min-y = -Math.max(0px, self.content-height - self.height);
                        if (root.settings-focus == "text") {
                            self.content-y = Math.max(min-y, Math.min(0px, -text-card.y + 8px));
                        } else if (root.settings-focus == "scrollback") {
                            self.content-y = Math.max(min-y, Math.min(0px, -scrollback-card.y + 8px));
                        } else if (root.settings-focus == "behavior") {
                            self.content-y = Math.max(min-y, Math.min(0px, -behavior-card.y + 8px));
                        } else if (root.settings-focus == "bell") {
                            self.content-y = Math.max(min-y, Math.min(0px, -bell-card.y + 8px));
                        } else if (root.settings-focus == "scroll") {
                            self.content-y = Math.max(min-y, Math.min(0px, -scrollback-card.y + 8px));
                        } else if (root.settings-focus == "scrollbar") {
                            self.content-y = Math.max(min-y, Math.min(0px, -scrollback-card.y + 8px));
                        } else if (root.settings-focus == "images") {
                            self.content-y = Math.max(min-y, Math.min(0px, -images-card.y + 8px));
                        } else if (root.settings-focus == "keys") {
                            self.content-y = Math.max(min-y, Math.min(0px, -keybind-card.y + 8px));
                        }
                    }

                    terminal-layout := VerticalLayout {
                        width: 100%;
                        spacing: 10px;

                        text-card := SettingsCard {
                            title: Lang.t("Text & history", "文本与历史");
                            highlighted: root.settings-focus == "text"
                                || root.settings-focus == "scrollback";

                            SettingField {
                                label: Lang.t("Font size", "字号");
                                description: Lang.t("Applies immediately to existing panes.", "立即应用到已有窗格。");
                                Stepper {
                                    text: "\{root.font-size} px";
                                    minus => { root.bump-font-size(-1); }
                                    plus => { root.bump-font-size(1); }
                                }
                            }
                            SettingField {
                                label: Lang.t("Font family", "字体族");
                                description: Lang.t("Family name or font file path. Empty = built-in JetBrains Mono / DejaVu Sans Mono. Enter to apply.", "族名或字体文件路径。留空 = 内置 JetBrains Mono / DejaVu Sans Mono；回车应用。");
                                SettingsTextField {
                                    text <=> root.cfg-font-family;
                                    placeholder: Lang.t("built-in monospace", "内置等宽字体");
                                    clearable: true;
                                    commit-on-blur: true;
                                    accepted(t) => { root.set-font-family(t); }
                                    blurred(t) => { root.set-font-family(t); }
                                    cleared => { root.set-font-family(""); }
                                }
                            }
                            SettingField {
                                label: Lang.t("Font weight", "字重");
                                description: Lang.t("100–900; 600+ also renders default text bold.", "100–900；≥600 时普通文本也用粗体。");
                                Stepper {
                                    text: "\{root.cfg-font-weight}";
                                    minus => { root.bump-font-weight(-100); }
                                    plus => { root.bump-font-weight(100); }
                                }
                            }
                            SettingField {
                                label: Lang.t("Line height", "行距");
                                description: Lang.t("Multiplier of the font's natural line height (0.8–2.5).", "字体自然行高的倍数（0.8–2.5）。");
                                Stepper {
                                    text: "\{Math.round(root.cfg-line-height * 100) / 100}×";
                                    minus => { root.bump-line-height(-0.1); }
                                    plus => { root.bump-line-height(0.1); }
                                }
                            }
                            SettingField {
                                label: Lang.t("Letter spacing", "字间距");
                                description: Lang.t("Extra pixels added to every cell (-4–16).", "每格额外像素（-4–16）。");
                                Stepper {
                                    text: "\{Math.round(root.cfg-letter-spacing * 100) / 100} px";
                                    minus => { root.bump-letter-spacing(-0.5); }
                                    plus => { root.bump-letter-spacing(0.5); }
                                }
                            }
                            SettingField {
                                label: Lang.t("Render scale", "渲染缩放");
                                description: Lang.t("Scales glyph rasterization only; logical font size stays the same (0.5–3).", "只缩放字形光栅化，逻辑字号不变（0.5–3）。");
                                Stepper {
                                    text: "\{Math.round(root.cfg-render-scale * 100) / 100}×";
                                    minus => { root.bump-render-scale(-0.05); }
                                    plus => { root.bump-render-scale(0.05); }
                                }
                            }
                            SettingField {
                                label: Lang.t("Scrollback", "回滚缓冲");
                                description: root.cfg-scrollback-unlimited
                                    ? Lang.t("Unlimited mode (safe cap 100,000 lines; new panes only).", "无限模式（安全上限 100,000 行；仅新窗格）。")
                                    : Lang.t("Lines kept per pane (new panes only).", "每个窗格保留的行数（仅新窗格）。");
                                Stepper {
                                    text: root.cfg-scrollback-unlimited
                                        ? Lang.t("Unlimited", "无限")
                                        : Lang.t("\{root.scrollback} lines", "\{root.scrollback} 行");
                                    minus => { root.bump-scrollback(-500); }
                                    plus => { root.bump-scrollback(500); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Unlimited scrollback", "无限回滚");
                                description: Lang.t("Safe cap 100,000 lines; preallocated memory per new pane.", "安全上限 100,000 行；每个新窗格预分配内存。");
                                SettingsSwitch {
                                    on: root.cfg-scrollback-unlimited;
                                    toggled => { root.toggle-scrollback-unlimited(); }
                                }
                            }
                        }

                        scrollback-card := SettingsCard {
                            title: Lang.t("Scrolling", "滚动");
                            description: Lang.t("How the viewport follows output and keyboard input.", "视口如何跟随输出与键盘输入。");
                            highlighted: root.settings-focus == "scroll"
                                || root.settings-focus == "scrollbar";

                            SettingRow {
                                label: Lang.t("Scroll on output", "输出时滚动");
                                description: Lang.t("Any output pulls the viewport back to the newest line.", "任何输出都把视口拉回最新行。");
                                SettingsSwitch {
                                    on: root.cfg-scroll-output;
                                    toggled => { root.toggle-scroll-output(); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Scroll on keystroke", "按键时滚动");
                                description: Lang.t("Jump to the bottom before sending a key (GNOME default).", "发送按键前先跳到最底部（GNOME 默认）。");
                                SettingsSwitch {
                                    on: root.cfg-scroll-keystroke;
                                    toggled => { root.toggle-scroll-keystroke(); }
                                }
                            }
                            SettingField {
                                label: Lang.t("Scrollbar", "滚动条");
                                description: Lang.t("Right-edge overlay scrollbar policy.", "右侧叠加滚动条策略。");
                                Segmented {
                                    options: [Lang.t("Always", "始终"), Lang.t("Auto", "自动"), Lang.t("Never", "从不")];
                                    values: ["always", "auto", "never"];
                                    value: root.cfg-scrollbar-policy;
                                    picked(v) => { root.set-scrollbar-policy(v); }
                                }
                            }
                        }

                        behavior-card := SettingsCard {
                            title: Lang.t("Behavior", "行为");
                            highlighted: root.settings-focus == "behavior";

                            SettingRow {
                                label: Lang.t("Copy on select", "选中即复制");
                                description: Lang.t("Copy the selection to the clipboard automatically.", "自动把选区复制到剪贴板。");
                                SettingsSwitch {
                                    on: root.cfg-copy-on-select;
                                    toggled => { root.toggle-copy-on-select(); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Confirm closing multiple sessions", "关闭多个会话前确认");
                                description: Lang.t("Ask before closing a window with several tabs/panes.", "关闭含多个标签/窗格的窗口前询问。");
                                SettingsSwitch {
                                    on: root.cfg-confirm-close;
                                    toggled => { root.toggle-confirm-close(); }
                                }
                            }
                            SettingField {
                                label: Lang.t("When closing a tab", "关闭标签时会话");
                                description: Lang.t("End the shell, or keep it in Background Sessions for reattach.", "结束 shell，或保留到后台会话列表等待重连。");
                                Segmented {
                                    options: [Lang.t("End session", "结束会话"), Lang.t("Keep in background", "后台保留")];
                                    values: ["end", "background"];
                                    value: root.cfg-close-action;
                                    picked(v) => { root.set-close-action(v); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Restore session on startup", "启动时恢复会话");
                                description: Lang.t("Reopen tabs, splits and cwd from the last clean exit (off by default).", "按上次正常退出重新打开标签、分屏与工作目录（默认关闭）。");
                                SettingsSwitch {
                                    on: root.cfg-restore-session;
                                    toggled => { root.toggle-restore-session(); }
                                }
                            }
                            Text {
                                text: root.restore-note;
                                color: Palette.colors.subtext;
                                font-size: 10px;
                                wrap: word-wrap;
                                visible: root.restore-note != "";
                            }
                            SettingRow {
                                label: Lang.t("Sidebar", "侧栏");
                                description: Lang.t("Show the workspace sidebar with profiles (off by default).",
                                                    "显示工作区侧栏（Profile 列表），默认关闭。");
                                SettingsSwitch {
                                    on: root.cfg-sidebar-visible;
                                    toggled => { root.toggle-sidebar-visible(); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Confirm multi-line paste", "多行粘贴前确认");
                                description: Lang.t("Show a preview before pasting text with newlines.", "粘贴含换行文本前显示预览。");
                                SettingsSwitch {
                                    on: root.cfg-confirm-paste;
                                    toggled => { root.toggle-confirm-paste(); }
                                }
                            }
                            SettingField {
                                label: Lang.t("Right click", "右键");
                                description: Lang.t("Short press acts immediately; long press (250ms) opens the menu.", "短按立即执行；长按（250ms）打开菜单。");
                                Segmented {
                                    options: [Lang.t("Menu", "菜单"), Lang.t("Paste", "粘贴"), Lang.t("Clipboard", "剪贴板"), Lang.t("Off", "关")];
                                    values: ["menu", "paste", "clipboard", "off"];
                                    value: root.cfg-right-click;
                                    picked(v) => { root.set-right-click(v); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Paste on middle-click", "中键粘贴");
                                SettingsSwitch {
                                    on: root.cfg-paste-middle;
                                    toggled => { root.toggle-paste-middle(); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Desktop notifications", "桌面通知");
                                description: Lang.t("notify-send when an inactive tab emits OSC 9 / 777 / BEL.", "非活动标签收到 OSC 9 / 777 / BEL 时调用 notify-send。");
                                SettingsSwitch {
                                    on: root.cfg-desktop-notifications;
                                    toggled => { root.toggle-desktop-notifications(); }
                                }
                            }
                        }

                        bell-card := SettingsCard {
                            title: Lang.t("Bell", "响铃");
                            highlighted: root.settings-focus == "bell";
                            SettingRow {
                                label: Lang.t("Visual bell", "视觉铃");
                                description: Lang.t("Flash a 1–2px accent border when the active pane receives BEL.", "活动窗格收到 BEL 时闪烁 1–2px 强调边框。");
                                SettingsSwitch {
                                    on: root.cfg-visual-bell;
                                    toggled => { root.toggle-visual-bell(); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Audible bell", "声音铃");
                                description: Lang.t("Ring the system bell via X11 (falls back to the terminal BEL).", "通过 X11 响系统铃（失败时回退终端 BEL）。");
                                SettingsSwitch {
                                    on: root.cfg-audible-bell;
                                    toggled => { root.toggle-audible-bell(); }
                                }
                            }
                        }

                        images-card := SettingsCard {
                            title: Lang.t("Images", "图片");
                            highlighted: root.settings-focus == "images";
                            SettingRow {
                                label: Lang.t("Sixel inline images", "Sixel 内联图片");
                                description: Lang.t("Primary DA advertises parameter 4; 25 MB per image, 16 MP cap.", "主 DA 宣告参数 4；单图上限 25 MB、16 MP。");
                                SettingsSwitch {
                                    on: root.cfg-sixel;
                                    toggled => { root.toggle-sixel(); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("iTerm2 IIP images", "iTerm2 IIP 图片");
                                description: Lang.t("OSC 1337 File (PNG/JPEG); 20 MB per file, 16 MP cap. Independent of Sixel.", "OSC 1337 File（PNG/JPEG）；单文件上限 20 MB、16 MP。与 Sixel 独立。");
                                SettingsSwitch {
                                    on: root.cfg-iip;
                                    toggled => { root.toggle-iip(); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Images scroll with history", "图片随历史滚动");
                                description: Lang.t("Off pins images to the viewport; on moves them with the text.", "关闭时图片固定在视口；开启时随文本移动。");
                                SettingsSwitch {
                                    on: root.cfg-sixel-scrolling;
                                    toggled => { root.toggle-sixel-scrolling(); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Render HUD", "渲染 HUD");
                                description: Lang.t("Show FPS, frame time, renderer, GPU-native frames/draw calls, atlas and stage-0 uploads.", "显示 FPS、帧耗时、renderer、GPU-native 帧数/draw calls、atlas 和 stage0 上传量。");
                                SettingsSwitch {
                                    on: root.cfg-render-hud;
                                    toggled => { root.toggle-render-hud(); }
                                }
                            }
                        }

                        keybind-card := SettingsCard {
                            title: Lang.t("Key encoding", "按键编码");
                            highlighted: root.settings-focus == "keys";
                            SettingField {
                                label: Lang.t("Backspace", "退格键");
                                Segmented {
                                    options: [Lang.t("ASCII DEL (0x7F)", "ASCII DEL（0x7F）"), Lang.t("Control-H (0x08)", "Control-H（0x08）")];
                                    values: ["ascii-delete", "control-h"];
                                    value: root.cfg-backspace-binding;
                                    picked(v) => { root.set-backspace-binding(v); }
                                }
                            }
                            SettingField {
                                label: Lang.t("Delete", "删除键");
                                Segmented {
                                    options: ["ESC [3~", "ASCII DEL", "Control-H"];
                                    values: ["delete-sequence", "ascii-del", "control-h"];
                                    value: root.cfg-delete-binding;
                                    picked(v) => { root.set-delete-binding(v); }
                                }
                            }
                            Text {
                                text: Lang.t("Only the bytes sent to the PTY change; defaults match GNOME (Backspace=0x7F, Delete=ESC [3~).", "只有发送给 PTY 的字节会变；默认与 GNOME 一致（退格=0x7F，删除=ESC [3~）。");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // ---------------- Window ----------------
                if root.settings-category == 2 : Flickable {
                    x: settings-body.content-x;
                    y: settings-body.content-y;
                    width: settings-body.content-w;
                    height: settings-body.content-h;
                    property <int> jump-token: root.settings-jump-token;
                    interactive: true;
                    content-width: self.width;
                    content-height: window-layout.preferred-height + 10px;

                    changed jump-token => {
                        if (root.settings-focus == "window") {
                            self.content-y = 0px;
                        }
                    }

                    window-layout := VerticalLayout {
                        width: 100%;
                        spacing: 10px;

                        window-card := SettingsCard {
                            title: Lang.t("Window & Tab bar", "窗口与标签栏");
                            highlighted: root.settings-focus == "window";
                            SettingRow {
                                label: Lang.t("Tab bar position", "标签栏位置");
                                description: Lang.t("Top, bottom, or a vertical strip on the left/right (matches Tabby's Tabs location).", "上、下，或左右竖排（与 Tabby 的 Tabs location 一致）。");
                                HorizontalLayout {
                                    spacing: 4px;
                                    ActionBtn {
                                        width: 48px;
                                        label: Lang.t("Top", "顶部");
                                        clicked => { root.tabbar-position-set("top"); }
                                    }
                                    ActionBtn {
                                        width: 48px;
                                        label: Lang.t("Bottom", "底部");
                                        clicked => { root.tabbar-position-set("bottom"); }
                                    }
                                    ActionBtn {
                                        width: 48px;
                                        label: Lang.t("Left", "左侧");
                                        clicked => { root.tabbar-position-set("left"); }
                                    }
                                    ActionBtn {
                                        width: 48px;
                                        label: Lang.t("Right", "右侧");
                                        clicked => { root.tabbar-position-set("right"); }
                                    }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Quake mode (F12)", "Quake 模式（F12）");
                                description: Lang.t("Global drop-down terminal: 70% screen width, 50% height (X11).", "全局下拉终端：屏宽 70%、高 50%（X11）。");
                                SettingsSwitch {
                                    on: root.cfg-quake;
                                    toggled => { root.toggle-quake(); }
                                }
                            }
                            Text {
                                text: Lang.t("Tab bar position is written to config immediately. Close confirmation lives in Terminal → Behavior.", "标签栏位置立即写入配置。关闭确认在 终端 → 行为。");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }

                        SettingsCard {
                            title: Lang.t("Settings window", "设置窗口");
                            description: root.settings-legacy
                                ? Lang.t("Legacy modal mode is active (TERVO_SETTINGS_LEGACY=1).", "传统模态模式已启用（TERVO_SETTINGS_LEGACY=1）。")
                                : Lang.t("Settings is a tab inside the main window: close it with ✕, Esc, or by clicking a terminal tab.", "设置是主窗口内的标签页：用 ✕、Esc 或点击终端标签关闭。");
                            Text {
                                text: Lang.t("Start with TERVO_SETTINGS_LEGACY=1 to use the centered modal fallback.", "启动时设置 TERVO_SETTINGS_LEGACY=1 可使用居中模态回退。");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // ---------------- Advanced ----------------
                if root.settings-category == 3 : Flickable {
                    x: settings-body.content-x;
                    y: settings-body.content-y;
                    width: settings-body.content-w;
                    height: settings-body.content-h;
                    property <int> jump-token: root.settings-jump-token;
                    interactive: true;
                    content-width: self.width;
                    content-height: advanced-layout.preferred-height + 10px;

                    changed jump-token => {
                        if (root.settings-focus == "config") {
                            self.content-y = 0px;
                        }
                    }

                    advanced-layout := VerticalLayout {
                        width: 100%;
                        spacing: 10px;

                        config-card := SettingsCard {
                            title: Lang.t("Config file", "配置文件");
                            highlighted: root.settings-focus == "config";
                            SettingField {
                                label: Lang.t("Path", "路径");
                                Text {
                                    text: root.settings-path;
                                    color: Palette.colors.text;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Open Folder", "打开目录");
                                    font-size: 10px;
                                    clicked => { root.settings-open-path(); }
                                }
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Import Tabby", "导入 Tabby");
                                    font-size: 10px;
                                    clicked => { root.config-import-tabby(); }
                                }
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Export Profiles", "导出配置");
                                    font-size: 10px;
                                    clicked => { root.config-export-tabby(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Export Config", "导出配置");
                                    font-size: 10px;
                                    clicked => { root.config-export(); }
                                }
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Import Config", "导入配置");
                                    font-size: 10px;
                                    clicked => { root.config-import(); }
                                }
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Restore Backup", "恢复备份");
                                    font-size: 10px;
                                    clicked => { root.config-restore-backup(); }
                                }
                            }
                            Text {
                                text: root.config-report;
                                color: Palette.colors.subtext;
                                font-size: 10px;
                                wrap: word-wrap;
                                visible: root.config-report != "";
                            }
                            Text {
                                text: root.config-status;
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                                visible: root.config-status != "";
                            }
                            Text {
                                text: Lang.t("Import/export use config-export.toml next to config.toml and only touch files; restart Tervo to apply. Migrations always keep a config.toml.v<from>.bak.", "导入/导出使用 config.toml 同目录的 config-export.toml，只改文件；重启 Tervo 后生效。迁移始终保留 config.toml.v<旧版本>.bak。");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: Lang.t("Passwords and private keys never live in the plain config; SSH passwords go to the encrypted Vault.", "密码与私钥绝不写入明文配置；SSH 密码保存在加密保险库。");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }

                        SettingsCard {
                            title: Lang.t("Interface", "界面");
                            description: Lang.t("Settings presentation is selected at startup for safety.", "为安全起见，设置页呈现方式在启动时选定。");
                            Text {
                                text: root.settings-legacy
                                    ? Lang.t("Current: legacy centered modal. Remove TERVO_SETTINGS_LEGACY to return to the Settings Tab.", "当前：传统居中模态。移除 TERVO_SETTINGS_LEGACY 可回到设置标签页。")
                                    : Lang.t("Current: in-window Settings Tab. Set TERVO_SETTINGS_LEGACY=1 before launch to fall back to the centered modal.", "当前：窗口内设置标签页。启动前设置 TERVO_SETTINGS_LEGACY=1 可回退到居中模态。");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // ---------------- Keys ----------------
                if root.settings-category == 4 : Flickable {
                    x: settings-body.content-x;
                    y: settings-body.content-y;
                    width: settings-body.content-w;
                    height: settings-body.content-h;
                    property <int> jump-token: root.settings-jump-token;
                    interactive: true;
                    content-width: self.width;
                    content-height: hotkeys-layout.preferred-height + 10px;

                    changed jump-token => {
                        if (root.settings-focus == "hotkeys") {
                            self.content-y = 0px;
                        }
                    }

                    hotkeys-layout := VerticalLayout {
                        width: 100%;
                        spacing: 10px;

                        SettingsCard {
                            title: Lang.t("Keyboard shortcuts", "键盘快捷键");
                            description: Lang.t("Click Edit, then press a chord. Turn on 2-chord to record two chords (Enter saves one). Esc cancels; Backspace restores the default.", "点击“编辑”后按组合键。开启“两段”可录两段（Enter 保存单段）。Esc 取消；退格键恢复默认。");

                            HorizontalLayout {
                                height: 22px;
                                spacing: 8px;
                                Text {
                                    text: root.hotkey-summary;
                                    color: Palette.colors.subtext;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.hotkey-conflict-count > 0
                                        ? Lang.t("⚠ \{root.hotkey-conflict-count} conflict(s)", "⚠ \{root.hotkey-conflict-count} 个冲突")
                                        : Lang.t("✓ no conflicts", "✓ 无冲突");
                                    color: root.hotkey-conflict-count > 0
                                        ? Palette.colors.danger
                                        : Palette.colors.muted;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: Lang.t("2-chord", "两段");
                                    color: Palette.colors.muted;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                SettingsSwitch {
                                    on: root.hotkey-record-two;
                                    toggled => { root.hotkey-record-two = !root.hotkey-record-two; }
                                }
                                ChoiceBtn {
                                    width: 72px;
                                    height: 22px;
                                    font-size: 9px;
                                    label: Lang.t("Reset All", "全部重置");
                                    clicked => { root.hotkey-reset-all(); }
                                }
                            }

                            if root.hotkey-recording-row >= 0 : Text {
                                text: Lang.t("Recording: press Ctrl/Alt/Shift/Meta + key · Esc cancel · Backspace reset", "录制中：按 Ctrl/Alt/Shift/Meta + 键 · Esc 取消 · 退格键恢复");
                                color: Palette.colors.accent;
                                font-size: 10px;
                                wrap: word-wrap;
                            }

                            VerticalLayout {
                                width: 100%;
                                spacing: 1px;

                                for row[i] in root.hotkey-rows : Rectangle {
                                    height: 30px;
                                    border-radius: 5px;
                                    background: i == root.hotkey-recording-row
                                        ? Palette.colors.hover
                                        : (hotkey-row-hit.has-hover ? Palette.colors.surface : transparent);

                                    hotkey-row-hit := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        pointer-event(event) => { EventResult.reject; }
                                    }

                                    Text {
                                        x: 6px;
                                        width: parent.width - 158px;
                                        height: parent.height;
                                        text: row.title;
                                        color: Palette.colors.text;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    Text {
                                        x: parent.width - 152px;
                                        width: 88px;
                                        height: 15px;
                                        text: i == root.hotkey-recording-row ? Lang.t("Press keys…", "请按键…") : row.chord;
                                        color: i == root.hotkey-recording-row
                                            ? Palette.colors.accent
                                            : (row.conflict ? Palette.colors.danger : Palette.colors.subtext);
                                        font-size: 10px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    Text {
                                        x: parent.width - 152px;
                                        y: 15px;
                                        width: 88px;
                                        height: 12px;
                                        text: row.conflict ? Lang.t("CONFLICT", "冲突") : (row.custom ? Lang.t("CUSTOM", "自定义") : "");
                                        color: row.conflict ? Palette.colors.danger : Palette.colors.accent;
                                        font-size: 7px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }

                                    ChoiceBtn {
                                        x: parent.width - 60px;
                                        y: 4px;
                                        width: 52px;
                                        height: 22px;
                                        font-size: 9px;
                                        label: i == root.hotkey-recording-row ? Lang.t("Cancel", "取消") : Lang.t("Edit", "编辑");
                                        active: i == root.hotkey-recording-row;
                                        clicked => {
                                            if (i == root.hotkey-recording-row) {
                                                root.hotkey-cancel-edit();
                                            } else {
                                                root.hotkey-start-edit(i);
                                            }
                                        }
                                    }
                                }
                            }

                            if root.hotkey-error != "" : Text {
                                text: root.hotkey-error;
                                color: Palette.colors.danger;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            if root.hotkey-error == "" && root.hotkey-status != "" : Text {
                                text: root.hotkey-status;
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: Lang.t("Chord: Ctrl/Alt/Meta + key, or F1–F24. 2-chord sequences (Ctrl+K Ctrl+T) are supported. Conflicting chords (including prefix) are rejected.", "组合键：Ctrl/Alt/Meta + 键，或 F1–F24。支持两段序列（Ctrl+K Ctrl+T）；相同或前缀冲突会被拒绝。");
                                color: Palette.colors.muted;
                                font-size: 9px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // ---------------- Profiles ----------------
                if root.settings-category == 7 : Flickable {
                    x: settings-body.content-x;
                    y: settings-body.content-y;
                    width: settings-body.content-w;
                    height: settings-body.content-h;
                    property <int> jump-token: root.settings-jump-token;
                    interactive: true;
                    content-width: self.width;
                    content-height: profiles-layout.preferred-height + 10px;

                    changed jump-token => {
                        if (root.settings-focus == "profiles") {
                            self.content-y = 0px;
                        }
                    }

                    profiles-layout := VerticalLayout {
                        width: 100%;
                        spacing: 10px;

                        profiles-card := SettingsCard {
                            title: Lang.t("Profiles", "配置");
                            description: Lang.t("Saved local / SSH / serial / telnet connections. Click a row to open it in a new tab.", "已保存的本地 / SSH / 串口 / Telnet 连接。点击一行在新标签中打开。");
                            highlighted: root.settings-focus == "profiles";

                            VerticalLayout {
                                width: 100%;
                                spacing: 2px;

                                if root.profile-items.length == 0 : Text {
                                    height: 28px;
                                    text: Lang.t("No profiles yet — create one below.", "还没有配置 — 在下方创建一个。");
                                    color: Palette.colors.muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }

                                for item[i] in root.profile-items : Rectangle {
                                    height: 34px;
                                    border-radius: 6px;
                                    background: !item.is-header && profile-row-hit.has-hover
                                        ? Palette.colors.hover
                                        : transparent;

                                    profile-row-hit := TouchArea {
                                        x: 0px;
                                        y: 0px;
                                        width: item.is-header ? parent.width : parent.width - 108px;
                                        height: parent.height;
                                        clicked => {
                                            if item.is-header {
                                                root.profile-toggle-group(item.group);
                                            } else {
                                                root.profile-open(i);
                                            }
                                        }
                                    }

                                    Text {
                                        x: item.is-header ? 4px : 8px;
                                        width: item.is-header ? parent.width - 8px : parent.width - 122px;
                                        height: parent.height;
                                        text: item.label;
                                        color: item.is-header ? Palette.colors.subtext : Palette.colors.text;
                                        font-size: item.is-header ? 11px : 12px;
                                        font-weight: item.is-header ? 600 : 400;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    if !item.is-header : Rectangle {
                                        x: parent.width - 104px;
                                        y: 5px;
                                        width: 26px;
                                        height: 24px;
                                        border-radius: 5px;
                                        background: profile-star.has-hover ? Palette.colors.hover : transparent;
                                        Text {
                                            text: item.is-default ? "★" : "☆";
                                            color: item.is-default ? Palette.colors.accent : Palette.colors.muted;
                                            font-size: 13px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%;
                                            height: 100%;
                                        }
                                        profile-star := TouchArea {
                                            clicked => { root.profile-set-default(i); }
                                        }
                                    }

                                    if !item.is-header : ChoiceBtn {
                                        x: parent.width - 76px;
                                        y: 6px;
                                        width: 42px;
                                        height: 22px;
                                        font-size: 9px;
                                        label: Lang.t("Edit", "编辑");
                                        clicked => { root.profile-edit(i); }
                                    }

                                    if !item.is-header : Rectangle {
                                        x: parent.width - 30px;
                                        y: 5px;
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 5px;
                                        background: profile-del.has-hover ? Palette.colors.danger : transparent;
                                        Text {
                                            text: "×";
                                            color: profile-del.has-hover
                                                ? Palette.colors.accent-text
                                                : Palette.colors.muted;
                                            font-size: 14px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%;
                                            height: 100%;
                                        }
                                        profile-del := TouchArea {
                                            clicked => { root.profile-delete(i); }
                                        }
                                    }
                                }
                            }

                            Text {
                                text: root.profile-default-info;
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("New Profile", "新建配置");
                                    font-size: 10px;
                                    clicked => { root.profile-new(); }
                                }
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Manage Profiles…", "管理配置…");
                                    font-size: 10px;
                                    clicked => { root.settings-manage-profiles(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Export profiles…", "导出配置…");
                                    font-size: 10px;
                                    clicked => { root.profile-export(); }
                                }
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Import profiles…", "导入配置…");
                                    font-size: 10px;
                                    clicked => { root.profile-import(); }
                                }
                            }
                            if root.profile-io-status != "" : Text {
                                text: root.profile-io-status;
                                color: Palette.colors.subtext;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: Lang.t("Export/import uses Tervo's own versioned format (profiles-export.toml). Files never contain passwords: vault-backed credentials are only marked as references and must be re-entered after import.", "导出/导入使用 Tervo 自有版本化格式（profiles-export.toml）。文件绝不含密码：Vault 凭据只标注为引用，导入后需重新输入。");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: Lang.t("The full Profiles panel adds search, group folding and duplicate; it opens above this page.", "完整配置面板还提供搜索、分组折叠与复制；它会在此页之上打开。");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // ---------------- Workspaces（UI-PANE-010 / SESS-003） ----------------
                    SettingsCard {
                        title: Lang.t("Workspaces", "工作区");
                        description: Lang.t("Named split layouts. Open restores a new tab; rename/delete only touch the saved record, never running tabs.", "已保存的命名分屏布局。打开会恢复成新标签；重命名/删除只改保存记录，不动正在运行的标签。");
                        highlighted: root.settings-focus == "workspaces";

                        if root.workspace-items.length == 0 : Text {
                            height: 28px;
                            text: Lang.t("No saved workspaces yet — save the current tab layout below.", "还没有保存的工作区 — 在下方保存当前标签布局。");
                            color: Palette.colors.muted;
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        for ws[i] in root.workspace-items : Rectangle {
                            height: 46px;
                            border-radius: 6px;
                            background: ws-row-hit.has-hover ? Palette.colors.hover : transparent;

                            ws-row-hit := TouchArea {
                                x: 0px;
                                y: 0px;
                                width: parent.width - 264px;
                                height: parent.height;
                                clicked => { root.workspace-open-row(i); }
                            }

                            Text {
                                x: 8px;
                                y: 4px;
                                width: parent.width - 272px;
                                height: 19px;
                                text: ws.name;
                                color: Palette.colors.text;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                x: 8px;
                                y: 23px;
                                width: parent.width - 272px;
                                height: 17px;
                                text: ws.panes == 1
                                    ? Lang.t("1 pane · created \{ws.created}", "1 个 pane · 创建于 \{ws.created}")
                                    : Lang.t("\{ws.panes} panes · created \{ws.created}", "\{ws.panes} 个 pane · 创建于 \{ws.created}");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            ChoiceBtn {
                                x: parent.width - 252px;
                                y: 12px;
                                width: 54px;
                                height: 22px;
                                font-size: 9px;
                                label: Lang.t("Open", "打开");
                                clicked => { root.workspace-open-row(i); }
                            }
                            ChoiceBtn {
                                x: parent.width - 194px;
                                y: 12px;
                                width: 58px;
                                height: 22px;
                                font-size: 9px;
                                label: Lang.t("Rename", "重命名");
                                clicked => { root.workspace-rename-row(i); }
                            }
                            ChoiceBtn {
                                x: parent.width - 132px;
                                y: 12px;
                                width: 58px;
                                height: 22px;
                                font-size: 9px;
                                label: Lang.t("Export", "导出");
                                clicked => { root.workspace-export-row(i); }
                            }
                            Rectangle {
                                x: parent.width - 66px;
                                y: 12px;
                                width: 58px;
                                height: 22px;
                                border-radius: 5px;
                                background: ws-del.has-hover ? Palette.colors.danger : Palette.colors.raise;
                                border-width: 1px;
                                border-color: Palette.colors.border;
                                Text {
                                    text: Lang.t("Delete", "删除");
                                    color: ws-del.has-hover ? Palette.colors.accent-text : Palette.colors.muted;
                                    font-size: 9px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                                ws-del := TouchArea {
                                    clicked => { root.workspace-delete-row(i); }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            ActionBtn {
                                horizontal-stretch: 1;
                                label: Lang.t("Save current layout as workspace…", "保存当前布局为工作区…");
                                font-size: 10px;
                                clicked => { root.workspace-save-current(); }
                            }
                        }
                        if root.workspace-status != "" : Text {
                            text: root.workspace-status;
                            color: Palette.colors.subtext;
                            font-size: 10px;
                            wrap: word-wrap;
                        }
                    }
                }

                // ---------------- Plugins (API v3) ----------------
                if root.settings-category == 5 : Flickable {
                    x: settings-body.content-x;
                    y: settings-body.content-y;
                    width: settings-body.content-w;
                    height: settings-body.content-h;
                    property <int> jump-token: root.settings-jump-token;
                    interactive: true;
                    content-width: self.width;
                    content-height: plugins-layout.preferred-height + 10px;

                    changed jump-token => {
                        if (root.settings-focus == "plugins") {
                            self.content-y = 0px;
                        }
                    }

                    plugins-layout := VerticalLayout {
                        width: 100%;
                        spacing: 10px;

                        SettingsCard {
                            title: Lang.t("Plugins — API v3", "插件 — API v3");
                            highlighted: root.settings-focus == "plugins";

                            Text {
                                text: root.plugin-summary;
                                color: Palette.colors.subtext;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: Lang.t("Plugins are separate processes. They run as your user with your full system permissions. Permissions below are capability gates for host-mediated APIs (terminal.read/write, clipboard) plus a one-time user confirmation — this is NOT an OS sandbox. MCP is built into Tervo and is not a plugin capability. Only api = 3 / host_abi = 3 is loaded; v1/v2 manifests are unsupported and never executed.", "插件是独立进程，以你的用户身份运行并拥有你的全部系统权限。下面的权限是宿主代理 API（terminal.read/write、clipboard）的 capability gate 加首次启用确认——它不是 OS 沙箱。MCP 是 Tervo 内嵌功能，不是插件能力。宿主只加载 api = 3 / host_abi = 3；v1/v2 清单不受支持，永不执行。");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: Lang.t("Enable/Disable/Reload/Restart never restart Tervo. First enable always shows the declared permissions and asks for confirmation; changing permissions invalidates that confirmation.", "启用/禁用/重载/重启都不会重启 Tervo。首次启用一定展示声明的权限并请求确认；权限变化会使旧确认失效。");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: root.plugin-dir;
                                color: Palette.colors.muted;
                                font-size: 9px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: Lang.t("process: JSON-RPC 2.0 line-delimited stdio. wasm: terminal.output_filter only. Docs: docs/PLUGIN_V3.md. Examples: docs/examples/plugin-v3-echo/, docs/examples/plugin-wasm-filter/.", "process：JSON-RPC 2.0 行分隔 stdio。wasm：只允许 terminal.output_filter。文档：docs/PLUGIN_V3.md。示例：docs/examples/plugin-v3-echo/、docs/examples/plugin-wasm-filter/。");
                                color: Palette.colors.muted;
                                font-size: 9px;
                                wrap: word-wrap;
                            }

                            SettingRow {
                                label: Lang.t("Require Ed25519 signature", "要求 Ed25519 签名");
                                description: Lang.t("Reject unsigned packages on Install/Update. Bad signatures are always rejected. Without a configured public key, unsigned remains allowed. See docs/PLUGIN_INSTALL.md.", "安装/更新时拒绝未签名包。坏签名始终拒绝；未配置公钥时仍允许未签名包。见 docs/PLUGIN_INSTALL.md。");
                                SettingsSwitch {
                                    on: root.cfg-plugin-require-signature;
                                    toggled => { root.toggle-plugin-require-signature(); }
                                }
                            }
                        }

                        SettingsCard {
                            title: Lang.t("Install from folder or package", "从目录或安装包安装");
                            description: Lang.t("Local only: folder with plugin.toml, or .zip/.tar/.tar.gz. Nothing is executed during install; enable/permissions still go through the v3 host.", "仅本地：含 plugin.toml 的目录，或 .zip/.tar/.tar.gz。安装时不执行任何插件代码；启用/权限仍由 v3 host 负责。");
                            SettingsTextField {
                                text <=> root.plugin-install-path;
                                placeholder: "/path/to/plugin-dir or plugin.zip";
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Choose file…", "选择文件…");
                                    clicked => { root.plugin-pick-install("file"); }
                                }
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Choose folder…", "选择目录…");
                                    clicked => { root.plugin-pick-install("folder"); }
                                }
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Install", "安装");
                                    clicked => { root.plugin-install-apply("install", "", root.plugin-install-path); }
                                }
                            }
                            Text {
                                text: Lang.t("Install writes a staging copy, validates manifest/signature/limits, then atomically swaps directories. The previous version is kept for Rollback (default 3 backups).", "安装先写 staging，校验清单/签名/大小限制，再原子替换目录。旧版本保留用于回滚（默认 3 个备份）。");
                                color: Palette.colors.muted;
                                font-size: 9px;
                                wrap: word-wrap;
                            }
                        }

                        SettingsCard {
                            title: Lang.t("Installed plugins", "已安装插件");

                            if root.plugin-rows.length == 0 : Text {
                                height: 24px;
                                text: Lang.t("No plugins installed.", "未安装插件。");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                vertical-alignment: center;
                            }

                            for row[i] in root.plugin-rows : Rectangle {
                                height: plugin-row-layout.preferred-height + 20px;
                                border-radius: 8px;
                                background: Palette.colors.raise;
                                border-width: 1px;
                                border-color: row.enabled ? Palette.colors.accent : Palette.colors.border;

                                plugin-row-layout := VerticalLayout {
                                    width: 100%;
                                    padding: 10px;
                                    spacing: 6px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: row.name;
                                            color: Palette.colors.text;
                                            font-size: 12px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: row.version;
                                            color: Palette.colors.muted;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: row.api;
                                            color: Palette.colors.muted;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: row.runtime;
                                            color: row.runtime == "wasm" ? Palette.colors.accent : Palette.colors.muted;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { horizontal-stretch: 1; height: 1px; background: transparent; }
                                        Text {
                                            text: row.status;
                                            color: row.enabled ? Palette.colors.accent : (row.supported ? Palette.colors.subtext : Palette.colors.danger);
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    if row.error != "" : Text {
                                        text: row.error;
                                        color: Palette.colors.danger;
                                        font-size: 10px;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: Lang.t("Permissions:", "权限:");
                                            color: Palette.colors.muted;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: row.permissions;
                                            color: Palette.colors.subtext;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                            wrap: word-wrap;
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: Lang.t("Restart count:", "重启次数:");
                                            color: Palette.colors.muted;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "\{row.restart-count}";
                                            color: Palette.colors.subtext;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                        if row.assistant : Text {
                                            text: Lang.t("assistant placeholder (no provider in v3)", "assistant 占位（v3 不实现 provider）");
                                            color: Palette.colors.muted;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: Lang.t("Source:", "来源:");
                                            color: Palette.colors.muted;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: row.source;
                                            color: Palette.colors.subtext;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                            wrap: word-wrap;
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: Lang.t("Signature:", "签名:");
                                            color: Palette.colors.muted;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: row.signature;
                                            color: Palette.colors.subtext;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                            wrap: word-wrap;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        if row.supported && (!row.enabled || row.needs-approval) : ActionBtn {
                                            horizontal-stretch: 1;
                                            label: row.needs-approval
                                                ? Lang.t("Confirm permissions", "确认权限")
                                                : Lang.t("Enable", "启用");
                                            clicked => { root.plugin-action("enable", row.key); }
                                        }
                                        if row.supported && row.enabled : ActionBtn {
                                            horizontal-stretch: 1;
                                            label: Lang.t("Disable", "禁用");
                                            clicked => { root.plugin-action("disable", row.key); }
                                        }
                                        if row.supported : ActionBtn {
                                            horizontal-stretch: 1;
                                            label: Lang.t("Reload", "重载");
                                            clicked => { root.plugin-action("reload", row.key); }
                                        }
                                        if row.supported : ActionBtn {
                                            horizontal-stretch: 1;
                                            label: Lang.t("Restart", "重启");
                                            clicked => { root.plugin-action("restart", row.key); }
                                        }
                                        if row.supported : ActionBtn {
                                            horizontal-stretch: 1;
                                            label: Lang.t("Update…", "更新…");
                                            clicked => { root.plugin-install-apply("update", row.key, root.plugin-install-path); }
                                        }
                                        if row.has-backup : ActionBtn {
                                            horizontal-stretch: 1;
                                            label: row.backup-version == ""
                                                ? Lang.t("Rollback", "回滚")
                                                : Lang.t("Rollback to \{row.backup-version}", "回滚到 \{row.backup-version}");
                                            clicked => { root.plugin-install-apply("rollback", row.key, ""); }
                                        }
                                        ActionBtn {
                                            horizontal-stretch: 1;
                                            label: Lang.t("Open folder", "打开目录");
                                            clicked => { root.plugin-action("folder", row.key); }
                                        }
                                        if row.surface-ready && row.has-panel : ActionBtn {
                                            horizontal-stretch: 1;
                                            label: Lang.t("Panel…", "面板…");
                                            clicked => { root.plugin-open-surface(row.key, "panel"); }
                                        }
                                        if row.surface-ready && row.has-settings : ActionBtn {
                                            horizontal-stretch: 1;
                                            label: Lang.t("Settings…", "设置…");
                                            clicked => { root.plugin-open-surface(row.key, "settings"); }
                                        }
                                    }
                                }
                            }
                        }

                        if root.plugin-confirm-visible : SettingsCard {
                            title: Lang.t("Confirm plugin permissions", "确认插件权限");
                            Text {
                                text: root.plugin-confirm-name;
                                color: Palette.colors.text;
                                font-size: 12px;
                                font-weight: 600;
                            }
                            Text {
                                text: Lang.t("This plugin is asking for the capabilities below. The host will gate its mediated APIs, but the plugin process still runs as your user with your full system permissions. Only enable plugins you trust.", "该插件请求以下能力。宿主会 gate 它代理的 API，但插件进程仍以你的用户身份运行并拥有你的全部系统权限。只启用你信任的插件。");
                                color: Palette.colors.danger;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: root.plugin-confirm-permissions;
                                color: Palette.colors.accent;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Allow and enable", "允许并启用");
                                    clicked => { root.plugin-confirm-enable(); }
                                }
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Cancel", "取消");
                                    clicked => { root.plugin-confirm-cancel(); }
                                }
                            }
                        }

                        if root.plugin-surface-open : SettingsCard {
                            title: root.plugin-surface-title;
                            if root.plugin-surface-loading : Text {
                                text: Lang.t("Requesting declarative UI from plugin…", "正在向插件请求声明式 UI…");
                                color: Palette.colors.muted;
                                font-size: 10px;
                            }
                            if root.plugin-surface-error != "" : Text {
                                text: root.plugin-surface-error;
                                color: Palette.colors.danger;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            for element in root.plugin-surface-elements : VerticalLayout {
                                width: 100%;
                                spacing: 4px;
                                if element.kind == "text" || element.kind == "markdown" : Text {
                                    width: 100%;
                                    text: element.text;
                                    color: Palette.colors.text;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                if element.kind == "list" : Text {
                                    width: 100%;
                                    text: element.text;
                                    color: Palette.colors.text;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                if element.kind == "input" : VerticalLayout {
                                    width: 100%;
                                    spacing: 2px;
                                    Text {
                                        text: element.label;
                                        color: Palette.colors.subtext;
                                        font-size: 10px;
                                    }
                                    Rectangle {
                                        height: 28px;
                                        border-radius: 5px;
                                        background: Palette.colors.bg;
                                        border-width: 1px;
                                        border-color: Palette.colors.border;
                                        TextInput {
                                            x: 6px;
                                            width: parent.width - 12px;
                                            height: parent.height;
                                            text: element.value;
                                            single-line: true;
                                            color: Palette.colors.text;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            edited => {
                                                root.plugin-element-input(element.id, self.text);
                                            }
                                        }
                                    }
                                }
                                if element.kind == "button" : ActionBtn {
                                    width: 100%;
                                    label: element.label;
                                    clicked => { root.plugin-element-action(element.id); }
                                }
                                if element.kind == "select" : HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        width: 160px;
                                        text: element.label;
                                        color: Palette.colors.subtext;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: element.value;
                                        color: Palette.colors.text;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                    ActionBtn {
                                        width: 96px;
                                        label: Lang.t("Change", "切换");
                                        clicked => { root.plugin-element-action(element.id); }
                                    }
                                }
                                if element.kind == "progress" : VerticalLayout {
                                    width: 100%;
                                    spacing: 2px;
                                    Text {
                                        text: element.label;
                                        color: Palette.colors.subtext;
                                        font-size: 10px;
                                    }
                                    Rectangle {
                                        width: 100%;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: Palette.colors.hover;
                                        Rectangle {
                                            width: Math.max(2px, parent.width * element.progress);
                                            height: 100%;
                                            border-radius: 3px;
                                            background: Palette.colors.accent;
                                        }
                                    }
                                }
                            }
                            ActionBtn {
                                width: 100px;
                                label: Lang.t("Close", "关闭");
                                clicked => { root.plugin-surface-close(); }
                            }
                        }

                        SettingsCard {
                            title: Lang.t("Recent plugin activity", "最近插件活动");
                            if root.plugin-activity-items.length == 0 : Text {
                                height: 22px;
                                text: Lang.t("No plugin activity yet — run a plugin command or open a tab with an event plugin installed.", "还没有插件活动 — 运行插件命令或打开安装了事件插件的标签。");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            for item[i] in root.plugin-activity-items : Text {
                                height: 20px;
                                text: item;
                                color: Palette.colors.text;
                                font-size: 10px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }

                // ---------------- Vault ----------------
                if root.settings-category == 6 : Flickable {
                    x: settings-body.content-x;
                    y: settings-body.content-y;
                    width: settings-body.content-w;
                    height: settings-body.content-h;
                    property <int> jump-token: root.settings-jump-token;
                    interactive: true;
                    content-width: self.width;
                    content-height: vault-layout.preferred-height + 10px;

                    changed jump-token => {
                        if (root.settings-focus == "vault") {
                            self.content-y = 0px;
                        }
                    }

                    vault-layout := VerticalLayout {
                        width: 100%;
                        spacing: 10px;

                        vault-card := SettingsCard {
                            title: Lang.t("Vault", "保险库");
                            description: Lang.t("Local encrypted credential store for SSH passwords.", "SSH 密码的本地加密凭据存储。");
                            highlighted: root.settings-focus == "vault";

                            Text {
                                text: Lang.t("Status: \{root.vault-status}", "状态：\{root.vault-status}");
                                color: Palette.colors.text;
                                font-size: 12px;
                            }
                            if root.vault-busy : Text {
                                text: Lang.t("Argon2id KDF runs on a background thread — this page stays responsive.", "Argon2id 密钥派生在后台线程运行 — 本页保持响应。");
                                color: Palette.colors.accent;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: root.vault-path;
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            SettingField {
                                label: Lang.t("Master password", "主密码");
                                SettingsTextField {
                                    text <=> root.vault-password;
                                    placeholder: Lang.t("Master password", "主密码");
                                    masked: true;
                                    accepted(t) => { root.vault-unlock(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Set / Change", "设置 / 更改");
                                    font-size: 10px;
                                    clicked => { root.vault-set-master(); }
                                }
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Unlock", "解锁");
                                    font-size: 10px;
                                    clicked => { root.vault-unlock(); }
                                }
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Lock", "锁定");
                                    font-size: 10px;
                                    clicked => { root.vault-lock(); }
                                }
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Clear", "清除");
                                    font-size: 10px;
                                    danger: true;
                                    clicked => { root.vault-clear(); }
                                }
                            }
                            if root.vault-error != "" : Text {
                                text: root.vault-error;
                                color: Palette.colors.danger;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            if root.vault-notice != "" : Text {
                                text: root.vault-notice;
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: Lang.t("The master password is only used for Argon2id key derivation; it never touches disk or logs. vault.enc is 0600 and written atomically. Clear must be clicked twice.", "主密码只用于 Argon2id 密钥派生；绝不写入磁盘或日志。vault.enc 权限为 0600 并以原子方式写入。清除需要点击两次。");
                                color: Palette.colors.subtext;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: Lang.t("SSH password auth: saved passwords are injected through askpass after unlock. MVP caveat: askpass passes the secret via environment, observable by the same user in /proc — see docs/VAULT.md.", "SSH 密码认证：解锁后保存的密码通过 askpass 注入。MVP 限制：askpass 通过环境变量传递密钥，同一用户可在 /proc 中看到 — 见 docs/VAULT.md。");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // ---------------- Help ----------------
                if root.settings-category == 8 : Flickable {
                    x: settings-body.content-x;
                    y: settings-body.content-y;
                    width: settings-body.content-w;
                    height: settings-body.content-h;
                    property <int> jump-token: root.settings-jump-token;
                    interactive: true;
                    content-width: self.width;
                    content-height: help-layout.preferred-height + 10px;

                    changed jump-token => {
                        let min-y = -Math.max(0px, self.content-height - self.height);
                        if (root.settings-focus == "quickstart") {
                            self.content-y = 0px;
                        } else if (root.settings-focus == "paths") {
                            self.content-y = Math.max(min-y, Math.min(0px, -help-paths-card.y + 8px));
                        } else if (root.settings-focus == "version") {
                            self.content-y = Math.max(min-y, Math.min(0px, -help-version-card.y + 8px));
                        } else if (root.settings-focus == "limits") {
                            self.content-y = Math.max(min-y, Math.min(0px, -help-limits-card.y + 8px));
                        }
                    }

                    help-layout := VerticalLayout {
                        width: 100%;
                        spacing: 10px;

                        help-quickstart-card := SettingsCard {
                            title: Lang.t("Quick start / Keyboard shortcuts", "快速开始 / 快捷键");
                            description: Lang.t("Default bindings; edit them in Keys. Settings lives in the tab bar gear.", "默认绑定；可在“快捷键”分类中修改。设置入口在标签栏齿轮。");
                            highlighted: root.settings-focus == "quickstart";

                            HelpRow { keys: "Ctrl+T"; action: Lang.t("New tab", "新建标签页"); }
                            HelpRow { keys: "Ctrl+W"; action: Lang.t("Close current tab", "关闭当前标签页"); }
                            HelpRow { keys: "Ctrl+F"; action: Lang.t("Find in terminal", "在终端中查找"); }
                            HelpRow { keys: "Ctrl+Shift+C"; action: Lang.t("Copy selection", "复制选中内容"); }
                            HelpRow { keys: "Ctrl+Shift+V"; action: Lang.t("Paste clipboard", "粘贴剪贴板"); }
                            HelpRow { keys: "Ctrl+Shift+E"; action: Lang.t("Split right", "向右分屏"); }
                            HelpRow { keys: "Ctrl+Shift+D"; action: Lang.t("Split down", "向下分屏"); }
                            HelpRow { keys: "F11"; action: Lang.t("Toggle fullscreen", "切换全屏"); }
                            HelpRow { keys: Lang.t("Settings", "设置"); action: Lang.t("Tab bar gear, or the Settings tab; Esc closes it", "标签栏齿轮或设置标签页；Esc 关闭"); }
                        }

                        help-paths-card := SettingsCard {
                            title: Lang.t("Config file & logs", "配置文件与日志");
                            description: Lang.t("Local paths only. Nothing on this page is uploaded.", "仅本地路径；本页不会上传任何内容。");
                            highlighted: root.settings-focus == "paths";

                            HelpInfoRow { label: Lang.t("Config dir", "配置目录"); value: root.help-config-path; }
                            HelpInfoRow { label: Lang.t("Logs dir", "日志目录"); value: root.help-log-path; }

                            HorizontalLayout {
                                spacing: 6px;
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Open Config Folder", "打开配置目录");
                                    font-size: 10px;
                                    clicked => { root.settings-help-open("config"); }
                                }
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Open Logs Folder", "打开日志目录");
                                    font-size: 10px;
                                    clicked => { root.settings-help-open("logs"); }
                                }
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Copy Diagnostics", "复制诊断信息");
                                    font-size: 10px;
                                    clicked => { root.settings-help-copy-diagnostics(); }
                                }
                            }
                            if root.help-status != "" : Text {
                                text: root.help-status;
                                color: Palette.colors.subtext;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: Lang.t("Opening a folder uses xdg-open and never builds a shell command. If xdg-open is missing, the error appears here.", "打开目录使用 xdg-open；绝不拼接 shell 命令。缺少 xdg-open 时错误会显示在这里。");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }

                        feedback-card := SettingsCard {
                            title: Lang.t("Feedback", "问题反馈");
                            description: Lang.t("Create a redacted local bundle and open the configured issue page. Never uploads terminal contents, environment values, Vault data, or keys.", "生成本地脱敏 bundle 并打开配置的 issue 页面；绝不上传终端内容、环境变量值、Vault 数据或密钥。");
                            SettingField {
                                label: Lang.t("Describe the problem", "问题描述");
                                SettingsTextField {
                                    text <=> root.feedback-text;
                                    placeholder: Lang.t("What happened? Steps to reproduce…", "发生了什么？复现步骤…");
                                    edited(t) => { root.feedback-text = t; }
                                }
                            }
                            ActionBtn {
                                label: Lang.t("Create bundle & open issue", "生成 bundle 并打开 issue");
                                clicked => { root.create-feedback(); }
                            }
                            if root.feedback-status != "" : Text {
                                text: root.feedback-status;
                                color: Palette.colors.subtext;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }

                        help-version-card := SettingsCard {
                            title: Lang.t("Version information", "版本信息");
                            description: Lang.t("Injected at build time from Cargo and git.", "构建时从 Cargo 与 git 注入。");
                            highlighted: root.settings-focus == "version";

                            HelpInfoRow { label: Lang.t("Version", "版本"); value: root.help-version; }
                            HelpInfoRow { label: Lang.t("Commit", "提交"); value: root.help-commit; }
                            HelpInfoRow { label: Lang.t("Built", "构建时间"); value: root.help-built; }
                            HelpInfoRow { label: Lang.t("Target", "目标平台"); value: root.help-target; }
                            ActionBtn {
                                label: Lang.t("Run Doctor", "运行 Doctor");
                                clicked => { root.run-doctor(); }
                            }
                            if root.doctor-status != "" : Text {
                                text: root.doctor-status;
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }

                        help-limits-card := SettingsCard {
                            title: Lang.t("Known limitations / Documentation", "已知限制 / 更多文档");
                            description: Lang.t("Short list of current boundaries; details live in the repository docs.", "当前边界摘要；细节见仓库文档。");
                            highlighted: root.settings-focus == "limits";

                            Text {
                                text: Lang.t("• IME: X11 XIM only; Wayland IME is not implemented.", "• 输入法：仅 X11 XIM；Wayland IME 尚未实现。");
                                color: Palette.colors.text;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: Lang.t("• Wayland: native path is not verified; global hotkeys and PRIMARY are blocked.", "• Wayland：原生路径未验收；全局热键与 PRIMARY 不可用。");
                                color: Palette.colors.text;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: Lang.t("• Plugins: API v3 only (api = 3); separate processes with capability gates + per-enable confirmation, not an OS sandbox. v1/v2 are unsupported. MCP is built in, not a plugin.", "• 插件：仅 API v3（api = 3）；独立进程，权限是 capability gate + 启用确认，不是 OS 沙箱。v1/v2 不受支持。MCP 是内嵌功能，不是插件。");
                                color: Palette.colors.text;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: Lang.t("• Soak: the 24h soak has not run yet; the 30m memory gate passed.", "• 稳定性：24 小时 soak 尚未执行；30 分钟内存门禁已通过。");
                                color: Palette.colors.text;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: Lang.t("Repository docs (offline, no telemetry):", "仓库文档（离线，无遥测）：");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: root.help-docs;
                                color: Palette.colors.subtext;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // ---------------- Privacy / MCP ----------------
                if root.settings-category == 9 : Flickable {
                    x: settings-body.content-x;
                    y: settings-body.content-y;
                    width: settings-body.content-w;
                    height: settings-body.content-h;
                    property <int> jump-token: root.settings-jump-token;
                    interactive: true;
                    content-width: self.width;
                    content-height: privacy-layout.preferred-height + 10px;

                    changed jump-token => {
                        if (root.settings-focus == "mcp") {
                            self.content-y = 0px;
                        }
                    }

                    privacy-layout := VerticalLayout {
                        width: 100%;
                        spacing: 10px;

                        mcp-card := SettingsCard {
                            title: Lang.t("MCP live control", "MCP 实时控制");
                            description: Lang.t("MCP is built into Tervo, not a plugin. The live socket is local-only (Unix socket 0600) and needs a state token. Default: enabled, read-only.", "MCP 内嵌于 Tervo，不是插件。live socket 仅限本机（Unix socket 0600）且需要 state token。默认：开启、只读。");
                            highlighted: root.settings-focus == "mcp";

                            SettingRow {
                                label: Lang.t("Enable MCP", "启用 MCP");
                                description: Lang.t("Off = no live socket is created and no live tools are exposed. Offline diag tools still work.", "关闭 = 不创建 live socket，也不暴露 live 工具；离线诊断工具仍可用。");
                                SettingsSwitch {
                                    on: root.cfg-mcp-enabled;
                                    toggled => { root.toggle-mcp-enabled(); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Read", "读取");
                                description: Lang.t("Read live_capabilities, live_snapshot, live_list and live_output.", "读取 live_capabilities、live_snapshot、live_list、live_output。");
                                SettingsSwitch {
                                    on: root.cfg-mcp-read;
                                    toggled => { root.toggle-mcp-read(); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Input", "输入");
                                description: Lang.t("Send text, keys or a command line: live_send_text, live_send_key, live_run.", "写入文本、按键或命令行：live_send_text、live_send_key、live_run。");
                                SettingsSwitch {
                                    on: root.cfg-mcp-input;
                                    toggled => { root.toggle-mcp-input(); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Tabs & focus", "标签与焦点");
                                description: Lang.t("Create/split/focus/scroll panes: live_new_tab, live_split, live_focus, live_scroll.", "新建、分屏、聚焦、滚动：live_new_tab、live_split、live_focus、live_scroll。");
                                SettingsSwitch {
                                    on: root.cfg-mcp-tabs;
                                    toggled => { root.toggle-mcp-tabs(); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Destructive", "破坏性操作");
                                description: Lang.t("close_pane / close_tab / kill. Also requires Tabs (close) or Input (kill).", "close_pane / close_tab / kill；还需要标签分组（关闭）或输入分组（终止）。");
                                SettingsSwitch {
                                    on: root.cfg-mcp-destructive;
                                    toggled => { root.toggle-mcp-destructive(); }
                                }
                            }

                            SettingField {
                                label: Lang.t("Live socket", "Live socket 路径");
                                Text {
                                    text: root.mcp-socket-path;
                                    color: Palette.colors.text;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                            }
                            SettingField {
                                label: Lang.t("State token", "State token 文件");
                                Text {
                                    text: root.mcp-token-path;
                                    color: Palette.colors.text;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: Lang.t("Generated automatically with mode 0600 when MCP is enabled. The token value is never written to config, logs or feedback bundles.", "启用 MCP 时自动生成，权限 0600。token 值绝不写入配置、日志或反馈包。");
                                    color: Palette.colors.muted;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                            }

                            Text {
                                text: root.mcp-status;
                                color: root.mcp-active ? Palette.colors.accent : Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: Lang.t("Changes apply instantly. MCP clients must re-run tools/list after a permission change; tools/call is checked again by the app.", "修改立即生效。权限变化后 MCP 客户端需重新 tools/list；tools/call 仍由 app 端二次校验。");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // ---------------- 搜索结果浮层 ----------------
                if root.settings-query != "" : Rectangle {
                    x: settings-body.content-x;
                    y: settings-body.content-y;
                    width: settings-body.content-w;
                    height: Math.min(settings-body.content-h,
                        58px + root.settings-results.length * 30px);
                    background: Palette.colors.raise;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Palette.colors.accent;
                    drop-shadow-blur: 18px;
                    drop-shadow-offset-y: 6px;
                    drop-shadow-color: #000000b0;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 2px;

                        Text {
                            height: 28px;
                            text: root.settings-results.length == 0
                                ? Lang.t("No matches", "无匹配")
                                : (root.settings-results.length == 1
                                    ? Lang.t("1 match — click to jump", "1 个结果 — 点击跳转")
                                    : Lang.t("\{root.settings-results.length} matches — click to jump", "\{root.settings-results.length} 个结果 — 点击跳转"));
                            color: Palette.colors.muted;
                            font-size: 10px;
                            vertical-alignment: center;
                        }

                        Flickable {
                            width: 100%;
                            height: parent.height - 34px;
                            interactive: true;
                            content-width: self.width;
                            content-height: root.settings-results.length * 30px;

                            VerticalLayout {
                                width: 100%;
                                spacing: 0px;
                                for item[i] in root.settings-results : Rectangle {
                                    height: 30px;
                                    border-radius: 5px;
                                    background: search-result-hit.has-hover
                                        ? Palette.colors.hover
                                        : transparent;
                                    Text {
                                        x: 8px;
                                        width: parent.width - 16px;
                                        height: parent.height;
                                        text: item;
                                        color: Palette.colors.text;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    search-result-hit := TouchArea {
                                        clicked => { root.settings-open-result(i); }
                                    }
                                }
                            }
                        }
                    }
                }

                // 主题下拉的点击外部关闭层（只覆盖内容区；sidebar 仍可切分类）。
                if root.settings-theme-open && root.settings-category == 0 : Rectangle {
                    x: settings-body.content-x;
                    y: settings-body.content-y;
                    width: settings-body.content-w;
                    height: settings-body.content-h;
                    background: transparent;
                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.settings-theme-open = false; }
                    }
                }

                // 主题下拉：面板级浮层，避免被 Flickable 裁剪；不依赖 PopupWindow。
                if root.settings-theme-open && root.settings-category == 0 : Rectangle {
                    x: settings-body.content-x + 14px;
                    y: settings-body.content-y + 256px;
                    width: Math.min(320px, settings-body.content-w - 28px);
                    height: Math.min(260px, root.theme-choices.length * 30px + 10px);
                    background: Palette.colors.raise;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: Palette.colors.accent;
                    drop-shadow-blur: 18px;
                    drop-shadow-offset-y: 6px;
                    drop-shadow-color: #000000b0;

                    Flickable {
                        width: 100%;
                        height: 100%;
                        interactive: true;
                        content-width: self.width;
                        content-height: root.theme-choices.length * 30px + 8px;

                        VerticalLayout {
                            x: 4px;
                            y: 4px;
                            width: parent.width - 8px;
                            spacing: 1px;

                            for choice[i] in root.theme-choices : Rectangle {
                                height: 28px;
                                border-radius: 5px;
                                background: choice.id == root.theme-name
                                    ? Palette.colors.accent
                                    : (theme-pick.has-hover ? Palette.colors.hover : transparent);
                                theme-pick := TouchArea {
                                    clicked => {
                                        root.set-theme(choice.id);
                                        root.settings-theme-open = false;
                                    }
                                }
                                Text {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: parent.height;
                                    text: choice.label;
                                    color: choice.id == root.theme-name
                                        ? Palette.colors.accent-text
                                        : Palette.colors.text;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }
    }


    // profiles-open 的遮罩：点外部（左右键都行）关闭
    if root.profiles-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000040;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.profiles-open = false;
                    root.profiles-close();
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }
    }

    if root.profiles-open : Rectangle {
        x: (root.width - 420px) / 2;
        y: (root.height - 404px) / 2;
        width: 420px;
        height: 404px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        // 吃掉面板内空白处的点击，避免穿透到遮罩把面板关掉；
        // 右键直接关闭面板（面板内没有右键菜单）。
        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.right) {
                    root.profiles-open = false; root.profiles-close();
                }
                EventResult.accept
            }
        }

        Text {
            x: 16px; y: 10px;
            text: Lang.t("Profiles", "配置");
            color: Palette.colors.text;
            font-size: 15px;
            font-weight: 600;
        }

        // 搜索框：输入即过滤，× 或 Esc 清空后恢复完整列表。
        Rectangle {
            x: 16px; y: 38px;
            width: 388px; height: 28px;
            border-radius: 5px;
            background: Palette.colors.bg;
            border-width: 1px;
            border-color: Palette.colors.border;

            TextInput {
                x: 8px;
                width: parent.width - 40px;
                height: parent.height;
                text <=> root.profile-query;
                single-line: true;
                color: Palette.colors.text;
                font-size: 11px;
                vertical-alignment: center;
                init => { self.focus(); }
                edited => { root.profile-filter(self.text); }
                key-pressed(event) => {
                    if (event.text == "\u{1b}") {
                        if (root.profile-query != "") {
                            root.profile-query = "";
                            root.profile-filter("");
                        } else {
                            root.profiles-open = false;
                            root.profiles-close();
                        }
                        return EventResult.accept;
                    }
                    EventResult.reject
                }
            }

            // 占位提示放在 TextInput 之后（上层），空查询时可见。
            Text {
                x: 8px;
                width: parent.width - 40px;
                height: parent.height;
                text: Lang.t("Search name / host / kind…", "搜索名称 / 主机 / 类型…");
                color: Palette.colors.muted;
                font-size: 11px;
                vertical-alignment: center;
                visible: root.profile-query == "";
            }

            if root.profile-query != "" : Rectangle {
                x: parent.width - 26px;
                y: 4px;
                width: 20px; height: 20px;
                border-radius: 4px;
                background: prof-search-clear.has-hover ? Palette.colors.hover : transparent;

                Text {
                    text: "×";
                    color: Palette.colors.muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }

                prof-search-clear := TouchArea {
                    clicked => {
                        root.profile-query = "";
                        root.profile-filter("");
                    }
                }
            }
        }

        Rectangle {
            x: 16px; y: 74px;
            width: 388px; height: 1px;
            background: Palette.colors.border;
        }

        // 列表放进 Flickable：过滤后仍可能超过一屏，滚动而不是撑破面板。
        Flickable {
            x: 16px; y: 84px;
            width: 388px; height: 208px;
            interactive: true;
            content-width: self.width;
            content-height: root.profile-items.length * 34px;

            VerticalLayout {
                width: parent.width;
                spacing: 4px;

                for item[i] in root.profile-items : Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    background: !item.is-header && profile-pick-hit.has-hover
                        ? Palette.colors.hover
                        : transparent;

                    Text {
                        x: item.is-header ? 4px : 30px;
                        width: item.is-header ? parent.width - 8px : parent.width - 114px;
                        text: item.label;
                        color: item.is-header ? Palette.colors.subtext : Palette.colors.text;
                        font-size: item.is-header ? 11px : 12px;
                        font-weight: item.is-header ? 600 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    profile-pick-hit := TouchArea {
                        clicked => {
                            if item.is-header {
                                root.profile-toggle-group(item.group);
                            } else {
                                root.profile-open(i);
                            }
                        }
                    }

                    // 星标：★ = 新 Tab 默认 Profile；点击切换/取消。
                    if !item.is-header : Rectangle {
                        x: 2px; y: 3px;
                        width: 24px; height: 24px;
                        border-radius: 4px;
                        background: prof-star-hit.has-hover ? Palette.colors.hover : transparent;

                        Text {
                            text: item.is-default ? "★" : "☆";
                            color: item.is-default ? Palette.colors.accent : Palette.colors.muted;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        prof-star-hit := TouchArea {
                            clicked => { root.profile-set-default(i); }
                        }
                    }

                    // Duplicate：复制该行 Profile（名字自动 `(copy N)` 去重）。
                    if !item.is-header : Rectangle {
                        x: parent.width - 82px; y: 3px;
                        width: 30px; height: 24px;
                        border-radius: 4px;
                        background: prof-dup-hit.has-hover ? Palette.colors.hover : transparent;

                        Text {
                            text: Lang.t("Dup", "复制");
                            color: Palette.colors.muted;
                            font-size: 9px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        prof-dup-hit := TouchArea {
                            clicked => { root.profile-duplicate(i); }
                        }
                    }

                    if !item.is-header : Rectangle {
                        x: parent.width - 52px;
                        y: 3px;
                        width: 22px;
                        height: 24px;
                        border-radius: 4px;
                        background: prof-edit-hit.has-hover ? Palette.colors.hover : transparent;

                        Text {
                            text: "✎";
                            color: Palette.colors.muted;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        prof-edit-hit := TouchArea {
                            clicked => { root.profile-edit(i); }
                        }
                    }

                    if !item.is-header : Rectangle {
                        x: parent.width - 26px;
                        y: 3px;
                        width: 22px;
                        height: 24px;
                        border-radius: 4px;
                        background: prof-del-hit.has-hover ? Palette.colors.danger : transparent;

                        Text {
                            text: "×";
                            color: prof-del-hit.has-hover ? Palette.colors.bg : Palette.colors.muted;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        prof-del-hit := TouchArea {
                            clicked => { root.profile-delete(i); }
                        }
                    }
                }
            }
        }

        // 空列表提示区分「没有 Profile」与「搜索无命中」。
        Text {
            x: 16px; y: 150px;
            width: 388px;
            text: Lang.t("No profiles yet — click New Profile to create one", "还没有配置 — 点击“新建配置”创建一个");
            color: Palette.colors.muted;
            font-size: 11px;
            horizontal-alignment: center;
            wrap: word-wrap;
            visible: root.profile-items.length == 0 && root.profile-query == "";
        }

        Text {
            x: 16px; y: 150px;
            width: 388px;
            text: Lang.t("No profiles match the search", "没有匹配的配置");
            color: Palette.colors.muted;
            font-size: 11px;
            horizontal-alignment: center;
            wrap: word-wrap;
            visible: root.profile-items.length == 0 && root.profile-query != "";
        }

        Text {
            x: 16px; y: 297px;
            width: 388px;
            text: Lang.t("Click to open · ★ default for new tabs · Dup = duplicate", "点击打开 · ★ 新标签默认 · 复制=复制");
            color: Palette.colors.muted;
            font-size: 10px;
            horizontal-alignment: center;
        }

        Rectangle {
            x: 16px; y: 320px; width: 120px; height: 28px; border-radius: 6px;
            background: prof-save-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            prof-save-hit := TouchArea {
                clicked => { root.profile-new(); }
            }
            Text {
                text: Lang.t("New Profile", "新建配置");
                color: Palette.colors.text;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Rectangle {
            x: 324px; y: 320px; width: 80px; height: 28px; border-radius: 6px;
            background: prof-close-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            prof-close-hit := TouchArea {
                clicked => { root.profiles-open = false; root.profiles-close(); }
            }
            Text {
                text: Lang.t("Close", "关闭");
                color: Palette.colors.text;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        // 新 Tab 默认行为提示（由 Rust 按 config.default_profile_id 解析后下发）。
        Text {
            x: 16px; y: 368px;
            width: 388px;
            text: root.profile-default-info;
            color: Palette.colors.subtext;
            font-size: 11px;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    if root.profile-form-open : Rectangle {
        x: (root.width - 440px) / 2;
        // local/serial/telnet 用紧凑高度；SSH 展开 password/转发/跳板时需要更高。
        property <length> form-h: root.form-kind == 1 ? 700px : (root.form-kind == 0 ? 490px : 440px);
        y: (root.height - form-h) / 2 < 8px ? 8px : (root.height - form-h) / 2;
        width: 440px;
        height: form-h;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        // 绝对定位：切换类型时字段数量变化，布局不会整体位移（否则自动化/点击都不稳）
        Text {
            x: 16px;
            y: 14px;
            text: root.form-edit-id < 0 ? Lang.t("New Profile", "新建配置") : Lang.t("Edit Profile", "编辑配置");
            color: Palette.colors.text;
            font-size: 15px;
            font-weight: 600;
        }

        HorizontalLayout {
            x: 16px;
            y: 44px;
            width: 408px;
            height: 24px;
            spacing: 8px;

            ChoiceBtn {
                width: 92px; height: 24px; font-size: 11px;
                label: Lang.t("Local", "本地"); active: root.form-kind == 0;
                clicked => { root.form-kind = 0; root.form-error = ""; }
            }
            ChoiceBtn {
                width: 92px; height: 24px; font-size: 11px;
                label: "SSH"; active: root.form-kind == 1;
                clicked => { root.form-kind = 1; root.form-error = ""; }
            }
            ChoiceBtn {
                width: 92px; height: 24px; font-size: 11px;
                label: Lang.t("Serial", "串口"); active: root.form-kind == 2;
                clicked => { root.form-kind = 2; root.form-error = ""; }
            }
            ChoiceBtn {
                width: 92px; height: 24px; font-size: 11px;
                label: "Telnet"; active: root.form-kind == 3;
                clicked => { root.form-kind = 3; root.form-error = ""; }
            }
        }

        HorizontalLayout {
            x: 16px; y: 80px; width: 408px; height: 26px;
            spacing: 8px;
            FormRow {
                width: 150px;
                label-width: 42px;
                label: Lang.t("Name", "名称"); text <=> root.form-name;
            }
            FormRow {
                width: 130px;
                label-width: 42px;
                label: Lang.t("Group", "分组"); text <=> root.form-group;
            }
            FormRow {
                width: 112px;
                label-width: 34px;
                label: Lang.t("Title", "标题"); text <=> root.form-title;
            }
        }

        if root.form-kind == 0 : VerticalLayout {
            x: 16px; y: 116px; width: 408px; height: 168px;
            spacing: 12px;
            FormRow { label: "Shell"; text <=> root.form-shell; }
            FormRow { label: Lang.t("Args", "参数"); text <=> root.form-args; }
            HorizontalLayout {
                height: 26px;
                spacing: 8px;
                FormRow {
                    width: 324px;
                    label: Lang.t("Cwd", "工作目录"); text <=> root.form-cwd;
                }
                ActionBtn {
                    width: 76px;
                    font-size: 10px;
                    label: Lang.t("Test", "测试");
                    clicked => { root.profile-test-cwd(root.form-cwd); }
                }
            }
            // LOCAL-004：每个 Profile 自带环境变量（KEY=VALUE，每行一个）。
            FormRow { label: Lang.t("Env", "环境变量"); text <=> root.form-env; }
        }

        if root.form-kind == 0 : Text {
            x: 16px; y: 258px; width: 408px; height: 22px;
            text: root.form-cwd-hint;
            color: root.form-cwd-hint.starts-with("✓") ? Palette.colors.accent : Palette.colors.danger;
            font-size: 10px;
            vertical-alignment: center;
            overflow: elide;
            visible: root.form-cwd-hint != "";
        }

        if root.form-kind == 1 : VerticalLayout {
            x: 16px; y: 116px; width: 408px; height: 380px;
            spacing: 5px;
            FormRow { label: Lang.t("Host", "主机"); text <=> root.form-host; }
            FormRow { label: Lang.t("Port", "端口"); text <=> root.form-port; }
            FormRow { label: Lang.t("User", "用户名"); text <=> root.form-user; }
            FormRow { label: Lang.t("Auth", "认证"); text <=> root.form-auth; }
            FormRow { label: Lang.t("Key", "密钥"); text <=> root.form-key; }
            if root.form-auth == "password" : VerticalLayout {
                spacing: 5px;
                FormRow {
                    label: Lang.t("Password", "密码");
                    text <=> root.form-password;
                    masked: true;
                }
                ToggleRow {
                    label: Lang.t("Save password to Vault", "保存密码到保险库");
                    on: root.form-save-password;
                    toggled => { root.form-save-password = !root.form-save-password; }
                }
            }
            FormRow { label: Lang.t("Jump", "跳板"); text <=> root.form-proxy-jump; }
            FormRow { label: Lang.t("R-Forwards", "远程转发"); text <=> root.form-remote-forwards; }
            FormRow { label: Lang.t("D-Forwards", "动态转发"); text <=> root.form-dynamic-forwards; }
            ToggleRow {
                label: Lang.t("Agent forwarding (-A)", "代理转发（-A）");
                on: root.form-agent-forward;
                toggled => { root.form-agent-forward = !root.form-agent-forward; }
            }
            FormRow { label: Lang.t("Extra", "额外参数"); text <=> root.form-extra; }
            FormRow { label: Lang.t("L-Forwards", "本地转发"); text <=> root.form-forwards; }
        }

        if root.form-kind == 2 : VerticalLayout {
            x: 16px; y: 116px; width: 408px; height: 80px;
            spacing: 12px;
            FormRow { label: Lang.t("Serial", "串口"); text <=> root.form-serial-port; }
            FormRow { label: Lang.t("Baud", "波特率"); text <=> root.form-baud; }
        }

        if root.form-kind == 3 : VerticalLayout {
            x: 16px; y: 116px; width: 408px; height: 80px;
            spacing: 12px;
            FormRow { label: Lang.t("Host", "主机"); text <=> root.form-host; }
            FormRow { label: Lang.t("Port", "端口"); text <=> root.form-port; }
        }

        // 外观覆盖（所有类型共用；空 = 继承全局 Config）。
        // 绝对定位在不同类型间固定：local 在字段下方，SSH 留出 password 展开空间。
        VerticalLayout {
            x: 16px;
            y: root.form-kind == 0 ? 290px : (root.form-kind == 1 ? 510px : 196px);
            width: 408px;
            height: 110px;
            spacing: 6px;

            Text {
                height: 14px;
                text: Lang.t("Appearance · empty = inherit global", "外观 · 留空 = 继承全局");
                color: Palette.colors.subtext;
                font-size: 11px;
                vertical-alignment: center;
            }
            HorizontalLayout {
                height: 26px;
                spacing: 12px;
                FormRow {
                    width: 198px;
                    label-width: 64px;
                    label: Lang.t("Font", "字号"); text <=> root.form-font-size;
                }
                FormRow {
                    width: 198px;
                    label-width: 64px;
                    label: Lang.t("History", "历史"); text <=> root.form-scrollback;
                }
            }
            HorizontalLayout {
                height: 26px;
                spacing: 12px;
                FormRow {
                    width: 198px;
                    label-width: 64px;
                    label: Lang.t("Cursor", "光标"); text <=> root.form-cursor-shape;
                }
                FormRow {
                    width: 198px;
                    label-width: 64px;
                    label: Lang.t("Blink", "闪烁"); text <=> root.form-cursor-blink;
                }
            }
            FormRow {
                height: 26px;
                label: Lang.t("Theme", "主题"); text <=> root.form-theme;
            }
            FormRow {
                height: 26px;
                label: Lang.t("Hotkey", "热键"); text <=> root.form-hotkey;
            }
        }

        Text {
            x: 16px;
            y: form-h - 82px;
            width: 408px;
            text: root.form-error;
            color: Palette.colors.danger;
            font-size: 11px;
            wrap: word-wrap;
        }

        Rectangle {
            x: 252px; y: form-h - 50px; width: 80px; height: 28px; border-radius: 6px;
            background: form-cancel-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            form-cancel-hit := TouchArea {
                clicked => { root.profile-form-open = false; root.profile-form-cancel(); }
            }
            Text {
                text: Lang.t("Cancel", "取消");
                color: Palette.colors.text;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Rectangle {
            x: 340px; y: form-h - 50px; width: 80px; height: 28px; border-radius: 6px;
            background: form-save-hit.has-hover ? Palette.colors.danger : Palette.colors.accent;
            form-save-hit := TouchArea {
                clicked => { root.profile-form-save(); }
            }
            Text {
                text: Lang.t("Save", "保存");
                color: Palette.colors.accent-text;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
    }

    // known_hosts 主机密钥预检：首次连接 / 密钥变更时明确提示，绝不静默信任。
    if root.hostkey-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000040;
    }

    if root.hostkey-open : Rectangle {
        x: (root.width - 520px) / 2;
        y: (root.height - 470px) / 2 < 8px ? 8px : (root.height - 470px) / 2;
        width: 520px;
        height: 470px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        Text {
            x: 18px; y: 14px; width: 484px; height: 24px;
            text: root.hostkey-title;
            color: root.hostkey-mode == "changed" ? Palette.colors.danger : Palette.colors.text;
            font-size: 15px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            x: 16px; y: 46px; width: 488px; height: 300px;
            background: Palette.colors.bg;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.colors.border;

            Text {
                x: 10px; y: 8px; width: 468px; height: 284px;
                text: root.hostkey-detail;
                color: Palette.colors.subtext;
                font-size: 11px;
                wrap: word-wrap;
                overflow: elide;
            }
        }

        if root.hostkey-error != "" : Text {
            x: 18px; y: 352px; width: 484px; height: 30px;
            text: root.hostkey-error;
            color: Palette.colors.danger;
            font-size: 11px;
            wrap: word-wrap;
            overflow: elide;
        }

        if root.hostkey-mode != "checking" : Rectangle {
            x: 18px; y: 410px; width: 150px; height: 28px; border-radius: 6px;
            background: hk-cancel-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            hk-cancel-hit := TouchArea {
                clicked => { root.hostkey-cancel(); }
            }
            Text {
                text: root.hostkey-mode == "unverifiable" ? Lang.t("Cancel", "取消") : Lang.t("Cancel", "取消");
                color: Palette.colors.text;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        if root.hostkey-mode == "unknown" || root.hostkey-mode == "changed" : Rectangle {
            x: 180px; y: 410px; width: 140px; height: 28px; border-radius: 6px;
            background: hk-once-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            hk-once-hit := TouchArea {
                clicked => { root.hostkey-once(); }
            }
            Text {
                text: "Once in terminal";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        if root.hostkey-mode == "unverifiable" : Rectangle {
            x: 180px; y: 410px; width: 160px; height: 28px; border-radius: 6px;
            background: hk-continue-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            hk-continue-hit := TouchArea {
                clicked => { root.hostkey-once(); }
            }
            Text {
                text: "Continue (terminal)";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        if root.hostkey-mode == "unknown" || root.hostkey-mode == "changed" : Rectangle {
            x: 330px; y: 410px; width: 172px; height: 28px; border-radius: 6px;
            background: hk-trust-hit.has-hover ? Palette.colors.danger : Palette.colors.accent;
            hk-trust-hit := TouchArea {
                clicked => { root.hostkey-trust(); }
            }
            Text {
                text: root.hostkey-mode == "changed" ? "Update key & connect" : "Trust & connect";
                color: Palette.colors.accent-text;
                font-size: 11px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        if root.hostkey-mode == "checking" : Rectangle {
            x: 340px; y: 410px; width: 162px; height: 28px; border-radius: 6px;
            background: hk-checking-cancel.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            hk-checking-cancel := TouchArea {
                clicked => { root.hostkey-cancel(); }
            }
            Text {
                text: Lang.t("Cancel", "取消");
                color: Palette.colors.text;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
    }

    // SSH 会话结束：小横幅（不遮终端内容，可重连/关闭）。
    if root.ssh-exit-open : Rectangle {
        x: root.width - 500px;
        y: 52px;
        width: 484px;
        height: 92px;
        background: Palette.colors.raise;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.colors.danger;
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #00000080;

        Text {
            x: 14px; y: 8px; width: 456px; height: 20px;
            text: root.ssh-exit-title;
            color: Palette.colors.danger;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            x: 14px; y: 30px; width: 456px; height: 26px;
            text: root.ssh-exit-text;
            color: Palette.colors.text;
            font-size: 11px;
            wrap: word-wrap;
            overflow: elide;
        }
        Rectangle {
            x: 270px; y: 58px; width: 92px; height: 24px; border-radius: 5px;
            background: ssh-exit-dismiss-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            ssh-exit-dismiss-hit := TouchArea { clicked => { root.ssh-exit-dismiss(); } }
            Text {
                text: "Dismiss";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
        if root.ssh-exit-reconnectable : Rectangle {
            x: 372px; y: 58px; width: 98px; height: 24px; border-radius: 5px;
            background: ssh-exit-reconnect-hit.has-hover ? Palette.colors.danger : Palette.colors.accent;
            ssh-exit-reconnect-hit := TouchArea { clicked => { root.ssh-exit-reconnect(); } }
            Text {
                text: root.ssh-exit-action-label;
                color: Palette.colors.accent-text;
                font-size: 11px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
    }

    // sftp-open 的遮罩：点外部（左右键都行）关闭
    if root.sftp-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000040;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    if (!root.sftp-transfer-active) {
                        root.sftp-open = false;
                        root.sftp-close();
                    }
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }
    }

    if root.sftp-open : Rectangle {
        x: (root.width - 480px) / 2;
        y: (root.height - 610px) / 2 < 8px ? 8px : (root.height - 610px) / 2;
        width: 480px;
        height: 610px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        // 吃掉面板内空白处的点击，避免穿透到遮罩把面板关掉；
        // 右键直接关闭面板（面板内没有右键菜单）。
        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.right) {
                    root.sftp-open = false; root.sftp-close();
                }
                EventResult.accept
            }
        }

        Text {
            x: 16px; y: 10px;
            text: "SFTP";
            color: Palette.colors.text;
            font-size: 15px;
            font-weight: 600;
        }

        // SSH Profile 选择（只列 SSH 类型）
        HorizontalLayout {
            x: 16px; y: 38px;
            width: 448px; height: 24px;
            spacing: 8px;
            for p[i] in root.sftp-profiles : ChoiceBtn {
                width: 120px; height: 24px; font-size: 11px;
                label: p;
                active: root.sftp-profile == i;
                clicked => { root.sftp-profile = i; }
            }
        }

        FormRow {
            x: 16px; y: 72px; width: 448px; height: 26px;
            label: "Remote"; text <=> root.sftp-remote;
        }

        Rectangle {
            x: 16px; y: 108px; width: 80px; height: 26px; border-radius: 5px;
            background: sftp-list-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-list-hit := TouchArea { clicked => { root.sftp-list(); } }
            Text {
                text: "List";
                color: Palette.colors.text;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Text {
            x: 104px; y: 114px;
            width: 360px;
            text: root.sftp-status;
            color: Palette.colors.muted;
            font-size: 11px;
            overflow: elide;
        }

        // 远端条目列表（固定行高 24px）
        Rectangle {
            x: 16px; y: 142px; width: 448px; height: 150px;
            background: Palette.colors.bg;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.colors.border;

            VerticalLayout {
                x: 2px; y: 2px; width: 444px; height: 146px;
                spacing: 0px;

                for item[i] in root.sftp-items : Rectangle {
                    height: 24px;
                    background: root.sftp-selected == i
                        ? Palette.colors.hover
                        : (row-hit.has-hover ? Palette.colors.surface : transparent);

                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        text: item;
                        color: Palette.colors.text;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    row-hit := TouchArea {
                        clicked => { root.sftp-pick(i); }
                    }
                }
            }
        }

        FormRow {
            x: 16px; y: 300px; width: 448px; height: 26px;
            label: "Target"; text <=> root.sftp-target;
        }

        FormRow {
            x: 16px; y: 332px; width: 448px; height: 26px;
            label: Lang.t("Local", "本地"); text <=> root.sftp-local;
        }

        FormRow {
            x: 16px; y: 364px; width: 200px; height: 26px;
            label: "Mode"; text <=> root.sftp-mode;
        }

        Rectangle {
            x: 240px; y: 364px; width: 90px; height: 24px; border-radius: 5px;
            background: sftp-chmod-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-chmod-hit := TouchArea { clicked => { root.sftp-chmod(); } }
            Text {
                text: "Chmod";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        // 第一行操作：传输类（允许在传输中继续入队）。
        Rectangle {
            x: 16px; y: 398px; width: 148px; height: 24px; border-radius: 5px;
            background: sftp-get-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-get-hit := TouchArea { clicked => { root.sftp-download(); } }
            Text {
                text: "Download selected";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Rectangle {
            x: 172px; y: 398px; width: 80px; height: 24px; border-radius: 5px;
            background: sftp-put-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-put-hit := TouchArea { clicked => { root.sftp-upload(); } }
            Text {
                text: "Upload";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        if root.sftp-retry-available : Rectangle {
            x: 260px; y: 398px; width: 70px; height: 24px; border-radius: 5px;
            background: sftp-retry-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-retry-hit := TouchArea { clicked => { root.sftp-retry(); } }
            Text {
                text: "Retry";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Rectangle {
            x: 384px; y: 398px; width: 80px; height: 24px; border-radius: 5px;
            background: sftp-del-hit.has-hover ? Palette.colors.danger : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-del-hit := TouchArea { clicked => { root.sftp-delete(); } }
            Text {
                text: Lang.t("Delete", "删除");
                color: sftp-del-hit.has-hover ? Palette.colors.bg : Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        // 第二行操作：元数据（远端操作进行中由 Rust 侧拒绝并发）。
        Rectangle {
            x: 16px; y: 430px; width: 80px; height: 24px; border-radius: 5px;
            background: sftp-mkdir-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-mkdir-hit := TouchArea { clicked => { root.sftp-mkdir(); } }
            Text {
                text: "New Dir";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Rectangle {
            x: 104px; y: 430px; width: 80px; height: 24px; border-radius: 5px;
            background: sftp-rename-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-rename-hit := TouchArea { clicked => { root.sftp-rename(); } }
            Text {
                text: Lang.t("Rename", "重命名");
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Rectangle {
            x: 192px; y: 430px; width: 96px; height: 24px; border-radius: 5px;
            background: sftp-clearq-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-clearq-hit := TouchArea { clicked => { root.sftp-clear-queue(); } }
            Text {
                text: "Clear queue";
                color: root.sftp-queue-count > 0 ? Palette.colors.text : Palette.colors.muted;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Rectangle {
            x: 384px; y: 430px; width: 80px; height: 24px; border-radius: 5px;
            background: sftp-close-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-close-hit := TouchArea { clicked => { root.sftp-open = false; root.sftp-close(); } }
            Text {
                text: Lang.t("Close", "关闭");
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        // 上传/下载队列（最多 3 行 + 失败重试行；完整计数在标题里）。
        Rectangle {
            x: 16px; y: 464px; width: 448px; height: 68px;
            background: Palette.colors.bg;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.colors.border;

            VerticalLayout {
                x: 8px; y: 4px; width: 432px; height: 60px;
                spacing: 1px;
                Text {
                    height: 15px;
                    text: "Queue (\{root.sftp-queue-count}) · completed transfers leave this list";
                    color: Palette.colors.subtext;
                    font-size: 10px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                for q[i] in root.sftp-queue : Text {
                    height: 14px;
                    text: q;
                    color: Palette.colors.muted;
                    font-size: 10px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // 传输/远端操作进度 + Cancel（取消当前的传输或元数据操作）。
        if root.sftp-transfer-active || root.sftp-op-active : Rectangle {
            x: 16px; y: 540px; width: 448px; height: 54px;

            Text {
                x: 0; y: 0; width: 250px; height: 24px;
                text: root.sftp-transfer-active ? root.sftp-transfer-name : "Remote operation";
                color: Palette.colors.text;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                x: 250px; y: 0; width: 118px; height: 24px;
                text: root.sftp-transfer-active ? root.sftp-transfer-detail : "10s timeout";
                color: Palette.colors.muted;
                font-size: 10px;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }

            Rectangle {
                x: 376px; y: 0; width: 72px; height: 24px; border-radius: 5px;
                background: sftp-cancel-hit.has-hover ? Palette.colors.danger : Palette.colors.raise;
                border-width: 1px;
                border-color: Palette.colors.border;
                sftp-cancel-hit := TouchArea { clicked => { root.sftp-cancel(); } }
                Text {
                    text: Lang.t("Cancel", "取消");
                    color: sftp-cancel-hit.has-hover ? Palette.colors.bg : Palette.colors.danger;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }

            if root.sftp-transfer-active : Rectangle {
                x: 0; y: 30px; width: 448px; height: 8px;
                background: Palette.colors.bg;
                border-radius: 4px;
                border-width: 1px;
                border-color: Palette.colors.border;

                Rectangle {
                    x: 1px; y: 1px;
                    height: parent.height - 2px;
                    width: root.sftp-transfer-percent < 0
                        ? (parent.width - 2px) * 25 / 100
                        : (parent.width - 2px) * root.sftp-transfer-percent / 100;
                    background: root.sftp-transfer-percent < 0
                        ? Palette.colors.muted
                        : Palette.colors.accent;
                    border-radius: 3px;
                }
            }
        }
    }

    // fwd-open 的遮罩：点外部（左右键都行）关闭
    if root.fwd-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000040;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.fwd-open = false;
                    root.fwd-close();
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }
    }

    if root.fwd-open : Rectangle {
        x: (root.width - 460px) / 2;
        y: (root.height - 400px) / 2;
        width: 460px;
        height: 400px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        // 吃掉面板内空白处的点击，避免穿透到遮罩把面板关掉；
        // 右键直接关闭面板（面板内没有右键菜单）。
        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.right) {
                    root.fwd-open = false; root.fwd-close();
                }
                EventResult.accept
            }
        }

        Text {
            x: 16px; y: 10px;
            text: Lang.t("Port Forwards", "端口转发");
            color: Palette.colors.text;
            font-size: 15px;
            font-weight: 600;
        }

        HorizontalLayout {
            x: 16px; y: 38px;
            width: 428px; height: 24px;
            spacing: 8px;
            for p[i] in root.fwd-profiles : ChoiceBtn {
                width: 120px; height: 24px; font-size: 11px;
                label: p;
                active: root.fwd-profile == i;
                clicked => { root.fwd-profile = i; root.fwd-select(i); }
            }
        }

        Text {
            x: 16px; y: 70px;
            width: 428px;
            text: "规则写入 Profile，下次建立 SSH 连接时生效（当前会话需重连）";
            color: Palette.colors.muted;
            font-size: 10px;
            wrap: word-wrap;
        }

        Rectangle {
            x: 16px; y: 94px; width: 428px; height: 196px;
            background: Palette.colors.bg;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.colors.border;

            VerticalLayout {
                x: 2px; y: 2px; width: 424px; height: 192px;
                spacing: 0px;

                for item[i] in root.fwd-items : Rectangle {
                    height: 24px;
                    background: transparent;

                    Text {
                        x: 8px;
                        width: parent.width - 40px;
                        text: item;
                        color: Palette.colors.text;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Rectangle {
                        x: parent.width - 26px;
                        y: 2px;
                        width: 22px;
                        height: 20px;
                        border-radius: 4px;
                        background: fwd-del-hit.has-hover ? Palette.colors.danger : transparent;

                        Text {
                            text: "×";
                            color: fwd-del-hit.has-hover ? Palette.colors.bg : Palette.colors.muted;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        fwd-del-hit := TouchArea {
                            clicked => { root.fwd-delete(i); }
                        }
                    }

                }
            }
        }

        FormRow {
            x: 16px; y: 300px; width: 428px; height: 26px;
            label: "New"; text <=> root.fwd-new;
        }

        Rectangle {
            x: 16px; y: 334px; width: 90px; height: 26px; border-radius: 5px;
            background: fwd-add-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            fwd-add-hit := TouchArea { clicked => { root.fwd-add(); } }
            Text {
                text: "Add rule";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Text {
            x: 116px; y: 340px;
            width: 236px;
            text: root.fwd-status;
            color: Palette.colors.muted;
            font-size: 10px;
            overflow: elide;
        }

        Rectangle {
            x: 364px; y: 334px; width: 80px; height: 26px; border-radius: 5px;
            background: fwd-close-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            fwd-close-hit := TouchArea { clicked => { root.fwd-open = false; root.fwd-close(); } }
            Text {
                text: Lang.t("Close", "关闭");
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
    }

    // bg-open 的遮罩：点外部（左右键都行）关闭
    if root.bg-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000040;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.bg-open = false;
                    root.bg-close();
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }
    }

    if root.bg-open : Rectangle {
        x: (root.width - 380px) / 2;
        y: (root.height - 300px) / 2;
        width: 380px;
        height: 300px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        // 吃掉面板内空白处的点击，避免穿透到遮罩把面板关掉；
        // 右键直接关闭面板（面板内没有右键菜单）。
        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.right) {
                    root.bg-open = false; root.bg-close();
                }
                EventResult.accept
            }
        }

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            Text {
                text: Lang.t("Background Sessions", "后台会话");
                color: Palette.colors.text;
                font-size: 15px;
                font-weight: 600;
            }

            Rectangle {
                height: 1px;
                horizontal-stretch: 1;
                background: Palette.colors.border;
            }

            for item[i] in root.background-items : Rectangle {
                height: 30px;
                border-radius: 4px;
                background: bg-hit.has-hover ? Palette.colors.hover : transparent;

                Text {
                    x: 8px;
                    width: parent.width - 16px;
                    text: item;
                    color: Palette.colors.text;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                bg-hit := TouchArea {
                    clicked => { root.bg-reattach(i); }
                }
            }

            Text {
                text: root.background-items.length == 0
                    ? "No background sessions"
                    : "Click a session to reattach it in a new tab";
                color: Palette.colors.muted;
                font-size: 11px;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: end;
                Rectangle {
                    width: 80px; height: 28px; border-radius: 6px;
                    background: bg-close-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
                    border-width: 1px;
                    border-color: Palette.colors.border;
                    bg-close-hit := TouchArea {
                        clicked => { root.bg-open = false; root.bg-close(); }
                    }
                    Text {
                        text: Lang.t("Close", "关闭");
                        color: Palette.colors.text;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }
    }

    // Tab 搜索浮层：点外部关闭；输入过滤，↑↓选择，Enter 跳转，Esc 关闭。
    if root.tabsearch-open : Rectangle {
        width: 100%;
        height: 100%;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.tabsearch-open = false;
                    root.tabsearch-cancel();
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }
    }

    if root.tabsearch-open : Rectangle {
        x: root.tabbar-left ? root.tabbar-width + 8px : 4px;
        y: root.tabbar-vertical
            ? root.chrome-top + 4px
            : (root.tabbar-bottom
                ? root.height - root.tabbar-height - self.height - 4px
                : root.tabbar-height + 4px);
        width: Math.min(340px, root.width - 8px);
        height: 49px + root.tabsearch-list-height;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;
        clip: true;

        VerticalLayout {
            padding: 8px;
            spacing: 3px;

            TextInput {
                height: 30px;
                text <=> root.tabsearch-query;
                single-line: true;
                color: Palette.colors.text;
                font-size: 13px;
                init => {
                    self.focus();
                    root.tabsearch-scroll-y = 0px;
                }
                edited => {
                    root.tabsearch-query-changed(self.text);
                    // 过滤条件变了，列表回到顶部；选中项由 Rust 重置为 0。
                    root.tabsearch-scroll-y = 0px;
                }
                key-pressed(event) => {
                    if (event.text == "\u{1b}") { root.tabsearch-cancel(); return EventResult.accept; }
                    if (event.text == "\u{F700}") { root.tabsearch-move(-1); return EventResult.accept; }
                    if (event.text == "\u{F701}") { root.tabsearch-move(1); return EventResult.accept; }
                    if (event.text == "\u{a}" || event.text == "\u{d}") { root.tabsearch-accept(); return EventResult.accept; }
                    EventResult.reject
                }
            }

            // 结果多时在面板内部滚动；↑↓ 选中项会自动滚进视口。
            tabsearch-flick := Flickable {
                height: root.tabsearch-list-height;
                content-height: Math.max(26px, root.tabsearch-items.length * 26px);
                content-width: self.width;
                interactive: true;
                property <length> scroll-request: root.tabsearch-scroll-y;
                changed scroll-request => { self.content-y = self.scroll-request; }
                flicked => { root.tabsearch-scroll-y = self.content-y; }

                VerticalLayout {
                    width: tabsearch-flick.width;
                    spacing: 0px;

                    for item[i] in root.tabsearch-items : Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: i == root.tabsearch-selected ? Palette.colors.accent : transparent;
                        animate background { duration: 100ms; }

                        Text {
                            x: 8px;
                            text: item;
                            color: i == root.tabsearch-selected ? Palette.colors.accent-text : Palette.colors.text;
                            font-size: 12px;
                            vertical-alignment: center;
                            width: parent.width - 16px;
                            overflow: elide;
                        }

                        TouchArea {
                            clicked => { root.tabsearch-selected = i; root.tabsearch-pick(i); }
                        }
                    }

                    Rectangle {
                        visible: root.tabsearch-items.length == 0;
                        height: 26px;

                        Text {
                            x: 8px;
                            text: "No matching tabs";
                            color: Palette.colors.muted;
                            font-size: 11px;
                            vertical-alignment: center;
                            width: parent.width - 16px;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        // 空输入时的占位提示；不拦截点击，焦点仍在下面的 TextInput。
        Text {
            x: 12px;
            y: 8px;
            width: parent.width - 24px;
            height: 30px;
            text: "Search tabs";
            color: Palette.colors.muted;
            font-size: 13px;
            vertical-alignment: center;
            visible: root.tabsearch-query == "";
        }
    }

    if root.palette-open : Rectangle {
        x: (root.width - 420px) / 2;
        y: 56px;
        width: 420px;
        height: 348px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        VerticalLayout {
            padding: 10px;
            spacing: 6px;

            TextInput {
                height: 30px;
                text <=> root.palette-query;
                single-line: true;
                color: Palette.colors.text;
                font-size: 14px;
                init => { self.focus(); }
                edited => { root.palette-query-changed(self.text); }
                key-pressed(event) => {
                    if (event.text == "\u{1b}") { root.palette-cancel(); return EventResult.accept; }
                    if (event.text == "\u{F700}") { root.palette-move(-1); return EventResult.accept; }
                    if (event.text == "\u{F701}") { root.palette-move(1); return EventResult.accept; }
                    if (event.text == "\u{a}" || event.text == "\u{d}") { root.palette-accept(); return EventResult.accept; }
                    EventResult.reject
                }
            }

            for item[i] in root.palette-items : Rectangle {
                height: 26px;
                border-radius: 4px;
                background: i == root.palette-selected ? Palette.colors.accent : transparent;

                Text {
                    x: 8px;
                    text: item;
                    color: i == root.palette-selected ? Palette.colors.accent-text : Palette.colors.text;
                    font-size: 13px;
                    vertical-alignment: center;
                    width: parent.width - 16px;
                    overflow: elide;
                }

                TouchArea {
                    clicked => { root.palette-selected = i; root.palette-pick(i); }
                }
            }
        }
    }

    if root.paste-open : Rectangle {
        x: (root.width - 420px) / 2;
        y: (root.height - 200px) / 2;
        width: 420px;
        height: 200px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            Text {
                text: "Paste \{root.paste-lines} lines?";
                color: Palette.colors.text;
                font-size: 15px;
                font-weight: 600;
            }
            Text {
                text: root.paste-preview;
                color: Palette.colors.subtext;
                font-size: 12px;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                Rectangle {
                    width: 84px; height: 28px; border-radius: 6px;
                    background: paste-cancel-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
                    border-width: 1px;
                    border-color: Palette.colors.border;
                    paste-cancel-hit := TouchArea {
                        clicked => { root.paste-open = false; root.paste-cancel(); }
                    }
                    Text {
                        text: Lang.t("Cancel", "取消");
                        color: Palette.colors.text;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                Rectangle {
                    width: 110px; height: 28px; border-radius: 6px;
                    background: paste-always-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
                    border-width: 1px;
                    border-color: Palette.colors.border;
                    paste-always-hit := TouchArea {
                        clicked => { root.paste-open = false; root.paste-always(); }
                    }
                    Text {
                        text: "Always Allow";
                        color: Palette.colors.text;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                Rectangle {
                    width: 84px; height: 28px; border-radius: 6px;
                    background: paste-ok-hit.has-hover ? Palette.colors.danger : Palette.colors.accent;
                    paste-ok-hit := TouchArea {
                        clicked => { root.paste-open = false; root.paste-accept(); }
                    }
                    Text {
                        text: Lang.t("Paste", "粘贴");
                        color: Palette.colors.accent-text;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }
    }

    if root.confirm-open : Rectangle {
        // 会话名最多列 6 行（Rust 侧同样截断），弹窗随行数增高。
        property <length> sessions-h: Math.min(root.confirm-sessions.length, 6) * 17px;
        x: (root.width - 340px) / 2;
        y: Math.max(8px, (root.height - (150px + self.sessions-h)) / 2);
        width: 340px;
        height: 150px + self.sessions-h;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            Text {
                text: "Close Tervo?";
                color: Palette.colors.text;
                font-size: 15px;
                font-weight: 600;
            }
            Text {
                text: root.confirm-text;
                color: Palette.colors.subtext;
                font-size: 12px;
                wrap: word-wrap;
            }
            for session[i] in root.confirm-sessions : Text {
                text: session;
                color: Palette.colors.text;
                font-size: 11px;
                overflow: elide;
                // 第一行加一点与说明文字的间距，后续行紧贴。
                height: 15px;
                vertical-alignment: center;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                Rectangle {
                    width: 88px; height: 28px; border-radius: 6px;
                    background: cancel-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
                    border-width: 1px;
                    border-color: Palette.colors.border;
                    cancel-hit := TouchArea {
                        clicked => { root.confirm-open = false; root.confirm-cancel(); }
                    }
                    Text {
                        text: Lang.t("Cancel", "取消");
                        color: Palette.colors.text;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
                Rectangle {
                    width: 88px; height: 28px; border-radius: 6px;
                    background: ok-hit.has-hover ? Palette.colors.danger : Palette.colors.accent;
                    ok-hit := TouchArea {
                        clicked => { root.confirm-open = false; root.confirm-accept(); }
                    }
                    Text {
                        text: Lang.t("Close", "关闭");
                        color: Palette.colors.accent-text;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }
    }

    if root.rename-open : Rectangle {
        x: root.chrome-left + 32px;
        y: root.chrome-top + 8px;
        width: 260px;
        height: 40px;
        background: Palette.colors.raise;
        border-radius: 6px;
        border-width: 1px;
        border-color: Palette.colors.accent;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #000000a8;

        Text {
            x: 10px; y: 4px;
            text: "Rename tab";
            color: Palette.colors.muted;
            font-size: 10px;
        }

        rename-input := TextInput {
            x: 8px;
            y: 16px;
            width: parent.width - 16px;
            height: parent.height - 20px;
            text <=> root.rename-text;
            single-line: true;
            color: Palette.colors.text;
            font-size: 13px;
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == "\u{a}" || event.text == "\u{d}") {
                    root.rename-committed(root.rename-index, self.text);
                    root.rename-open = false;
                    root.focus-terminal();
                    return EventResult.accept;
                }
                if (event.text == "\u{1b}") {
                    root.rename-cancelled();
                    root.rename-open = false;
                    root.focus-terminal();
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }
    }

    if root.search-open : Rectangle {
        x: root.width - 388px - root.chrome-right;
        y: root.chrome-top + 8px;
        width: 360px;
        height: 62px;
        background: Palette.colors.raise;
        border-radius: 8px;
        border-width: 1px;
        border-color: root.search-error ? Palette.colors.danger : Palette.colors.accent;
        drop-shadow-blur: 14px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000090;

        // 吃掉查找条内部的空白点击，避免穿透到后面的终端切换焦点/触发选区；
        // 输入框与 FindToggle 是后置子元素，会先拿到各自的鼠标事件。
        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => EventResult.accept;
        }

        VerticalLayout {
            padding: 7px;
            spacing: 4px;

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: "🔍";
                    color: Palette.colors.subtext;
                    font-size: 12px;
                    height: 20px;
                    vertical-alignment: center;
                }
                Rectangle {
                    height: 20px;
                    horizontal-stretch: 1;
                    clip: true;
                    background: transparent;

                    // 空查询占位符画在下面：Text 不接收鼠标事件，点击仍落到输入框。
                    Text {
                        visible: root.search-query == "";
                        text: "Search…";
                        color: Palette.colors.muted;
                        font-size: 13px;
                        height: 100%;
                        vertical-alignment: center;
                    }
                    search-input := TextInput {
                        width: 100%;
                        height: 100%;
                        text <=> root.search-query;
                        single-line: true;
                        color: Palette.colors.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        selection-background-color: Palette.colors.accent;
                        selection-foreground-color: Palette.colors.accent-text;
                        init => { self.focus(); }
                        edited => { root.search-edited(); }
                        key-pressed(event) => {
                            // 拼音/IME 组合中：Enter=上屏候选、Esc=取消，键归输入法，
                            // 不能被搜索下一个/关闭截走（与终端 IME 宿主同策略）。
                            if (self.preedit-text != "") {
                                return EventResult.reject;
                            }
                            if (event.text == "\u{1b}") {
                                root.search-close();
                                return EventResult.accept;
                            }
                            if (event.text == "\u{a}" || event.text == "\u{d}") {
                                root.search-next(!event.modifiers.shift);
                                return EventResult.accept;
                            }
                            // Ctrl+F 在搜索框内全选，仍符合“打开并聚焦”的直觉。
                            if (event.modifiers.control && !event.modifiers.alt
                                && !event.modifiers.shift
                                && (event.text == "f" || event.text == "F"
                                    || event.text == "\u{6}")) {
                                self.select-all();
                                return EventResult.accept;
                            }
                            // 保留 GNOME Terminal 风格的 Alt+C / Alt+R 开关快捷键。
                            if (event.modifiers.alt && !event.modifiers.control
                                && !event.modifiers.shift) {
                                if (event.text == "c" || event.text == "C") {
                                    root.search-toggle-case();
                                    return EventResult.accept;
                                }
                                if (event.text == "r" || event.text == "R") {
                                    root.search-toggle-regex();
                                    return EventResult.accept;
                                }
                            }
                            // 其余按键（字符、方向键、Ctrl+A/C/V、鼠标选区扩展）交给
                            // Slint TextInput 内置编辑逻辑；不会进入终端输入路径。
                            EventResult.reject
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 6px;

                FindToggle {
                    label: "Match case";
                    active: root.search-match-case;
                    toggled => { root.search-toggle-case(); }
                }
                FindToggle {
                    label: "Match regex";
                    active: root.search-regex;
                    toggled => { root.search-toggle-regex(); }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 1px;
                    background: transparent;
                }
                Text {
                    text: root.search-status;
                    color: root.search-error ? Palette.colors.danger : Palette.colors.muted;
                    font-size: 10px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    // Save Contents：没有原生文件对话框，显式路径 + 错误提示的最小实现。
    // 删除工作区确认：只删 workspaces.toml 记录；已经打开的 Tab 不受影响。
    if root.workspace-delete-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000080;

        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => { EventResult.accept; }
        }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: Math.min(430px, root.width - 24px);
            height: 190px;
            background: Palette.colors.raise;
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.colors.border;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #000000c0;

            VerticalLayout {
                padding: 16px;
                spacing: 9px;

                Text {
                    text: Lang.t("Delete workspace?", "删除工作区？");
                    color: Palette.colors.text;
                    font-size: 15px;
                    font-weight: 600;
                }
                Text {
                    text: Lang.t("Delete \"\{root.workspace-delete-name}\" from the saved workspace list?", "从工作区列表删除「\{root.workspace-delete-name}」？");
                    color: Palette.colors.subtext;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Text {
                    text: Lang.t("Only the saved layout is removed. Tabs already opened from it keep running; nothing is killed.", "只删除保存的布局记录；已经由它打开的 Tab 继续运行，不会关闭任何会话。");
                    color: Palette.colors.muted;
                    font-size: 10px;
                    wrap: word-wrap;
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 1px;
                    background: transparent;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    Rectangle {
                        width: 88px; height: 28px; border-radius: 6px;
                        background: ws-del-cancel-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
                        border-width: 1px;
                        border-color: Palette.colors.border;
                        ws-del-cancel-hit := TouchArea {
                            clicked => {
                                root.workspace-delete-open = false;
                                root.workspace-delete-cancel();
                            }
                        }
                        Text {
                            text: Lang.t("Cancel", "取消");
                            color: Palette.colors.text;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                    Rectangle {
                        width: 88px; height: 28px; border-radius: 6px;
                        background: ws-del-ok-hit.has-hover ? Palette.colors.muted : Palette.colors.danger;
                        ws-del-ok-hit := TouchArea {
                            clicked => {
                                root.workspace-delete-open = false;
                                root.workspace-delete-confirm();
                            }
                        }
                        Text {
                            text: Lang.t("Delete", "删除");
                            color: Palette.colors.accent-text;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }
            }
        }
    }

    // 活动 Tab 的连接状态 pill（SESS-007）：右下角，非纯颜色字形 + 文案。
    // Connected 用 ●，Connecting 用 …，Disconnected 用 ○，Failed 用 ✕。
    if root.connection-label != "" : Rectangle {
        x: root.width - self.width - 8px;
        y: (root.tabbar-bottom ? root.height - root.tabbar-height - 24px : root.height - 24px)
           - 26px;
        height: 22px;
        width: Math.min(260px, connection-pill-text.preferred-width + 20px);
        background: Palette.colors.surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: root.connection-state == 4
            ? Palette.colors.danger
            : Palette.colors.border;
        opacity: 0.94;

        connection-pill-text := Text {
            x: 9px;
            height: parent.height;
            text: (root.connection-state == 4 ? "✕ "
                : (root.connection-state == 3 ? "○ "
                : (root.connection-state == 2 ? "… " : "● "))) + root.connection-label;
            color: root.connection-state == 4
                ? Palette.colors.danger
                : (root.connection-state == 3 ? Palette.colors.muted : Palette.colors.subtext);
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    if root.save-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000080;

        // 吃掉点击，避免穿透到终端误触；不点外部关闭（防误丢已输入路径）。
        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => { EventResult.accept; }
        }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: Math.min(560px, root.width - 24px);
            height: 264px;
            background: Palette.colors.raise;
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.colors.border;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #000000c0;

            VerticalLayout {
                padding: 16px;
                spacing: 9px;

                Text {
                    text: root.save-title;
                    color: Palette.colors.text;
                    font-size: 15px;
                    font-weight: 600;
                }
                Text {
                    text: "No native file dialog: enter an explicit path (~ is expanded).";
                    color: Palette.colors.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                TextInput {
                    height: 30px;
                    text <=> root.save-path;
                    single-line: true;
                    color: Palette.colors.text;
                    font-size: 13px;
                    init => { self.focus(); }
                    key-pressed(event) => {
                        if (event.text == "\u{a}" || event.text == "\u{d}") {
                            root.save-commit(self.text);
                            return EventResult.accept;
                        }
                        if (event.text == "\u{1b}") {
                            root.save-open = false;
                            root.save-cancel();
                            return EventResult.accept;
                        }
                        EventResult.reject
                    }
                }
                Text {
                    text: root.save-path;
                    color: Palette.colors.subtext;
                    font-size: 10px;
                    wrap: word-wrap;
                }
                Text {
                    text: root.save-status;
                    color: Palette.colors.danger;
                    font-size: 11px;
                    wrap: word-wrap;
                    visible: root.save-status != "";
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 1px;
                    background: transparent;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    Rectangle {
                        width: 88px; height: 28px; border-radius: 6px;
                        background: save-cancel-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
                        border-width: 1px;
                        border-color: Palette.colors.border;
                        save-cancel-hit := TouchArea {
                            clicked => {
                                root.save-open = false;
                                root.save-cancel();
                            }
                        }
                        Text {
                            text: Lang.t("Cancel", "取消");
                            color: Palette.colors.text;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                    Rectangle {
                        width: 88px; height: 28px; border-radius: 6px;
                        background: Palette.colors.accent;
                        save-ok-hit := TouchArea {
                            clicked => { root.save-commit(root.save-path); }
                        }
                        Text {
                            text: Lang.t("Save", "保存");
                            color: Palette.colors.accent-text;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }
            }
        }
    }

    // 保存布局为命名 Workspace：与 Save Contents 同款弹窗，输入即名字。
    if root.workspace-save-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000080;

        // 吃掉点击，避免穿透到终端误触；不点外部关闭（防误丢输入）。
        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => { EventResult.accept; }
        }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: Math.min(460px, root.width - 24px);
            height: 258px;
            background: Palette.colors.raise;
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.colors.border;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #000000c0;

            VerticalLayout {
                padding: 16px;
                spacing: 9px;

                Text {
                    text: root.workspace-save-title;
                    color: Palette.colors.text;
                    font-size: 15px;
                    font-weight: 600;
                }
                Text {
                    text: root.workspace-save-description;
                    color: Palette.colors.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                TextInput {
                    height: 30px;
                    text <=> root.workspace-save-name;
                    single-line: true;
                    color: Palette.colors.text;
                    font-size: 13px;
                    // 预填 Tab 标题并全选：直接键入 = 替换，Enter 保存，Esc 取消。
                    init => { self.focus(); self.select-all(); }
                    changed text => { root.workspace-save-check(self.text); }
                    key-pressed(event) => {
                        if (event.text == "\u{a}" || event.text == "\u{d}") {
                            root.workspace-save-commit(self.text);
                            return EventResult.accept;
                        }
                        if (event.text == "\u{1b}") {
                            root.workspace-save-open = false;
                            root.workspace-save-cancel();
                            return EventResult.accept;
                        }
                        EventResult.reject
                    }
                }
                Text {
                    text: root.workspace-save-hint;
                    color: Palette.colors.danger;
                    font-size: 11px;
                    wrap: word-wrap;
                    visible: root.workspace-save-hint != "";
                }
                Text {
                    text: root.workspace-save-status;
                    color: Palette.colors.danger;
                    font-size: 11px;
                    wrap: word-wrap;
                    visible: root.workspace-save-status != "";
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 1px;
                    background: transparent;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    Rectangle {
                        width: 88px; height: 28px; border-radius: 6px;
                        background: ws-save-cancel-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
                        border-width: 1px;
                        border-color: Palette.colors.border;
                        ws-save-cancel-hit := TouchArea {
                            clicked => {
                                root.workspace-save-open = false;
                                root.workspace-save-cancel();
                            }
                        }
                        Text {
                            text: Lang.t("Cancel", "取消");
                            color: Palette.colors.text;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                    Rectangle {
                        width: 88px; height: 28px; border-radius: 6px;
                        background: ws-save-commit-hit.has-hover ? Palette.colors.muted : Palette.colors.accent;
                        ws-save-commit-hit := TouchArea {
                            clicked => { root.workspace-save-commit(root.workspace-save-name); }
                        }
                        Text {
                            text: root.workspace-save-action;
                            color: Palette.colors.accent-text;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }
            }
        }
    }

        // 通用状态条目：在插件状态栏之上叠一行 pill（只读文本，不改变终端布局）。
    if root.status-items.length > 0 : HorizontalLayout {
        x: root.tabbar-vertical ? root.chrome-left + 8px : 8px;
        y: root.height - root.chrome-bottom - 24px - 26px
            - (root.tabbar-vertical ? 44px : 0px);
        height: 22px;
        spacing: 6px;
        alignment: start;
        for item[i] in root.status-items : Rectangle {
            height: 22px;
            width: Math.min(360px, item-text.preferred-width + 18px);
            background: Palette.colors.surface;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.colors.border;
            opacity: 0.94;
            item-text := Text {
                x: 9px;
                height: parent.height;
                text: item;
                color: Palette.colors.subtext;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    // 插件状态栏：只显示文本（tooltip/command 由 Rust 保存），不改变终端布局。
    if root.plugin-status != "" : Rectangle {
        x: root.tabbar-vertical ? root.chrome-left + 8px : 8px;
        y: root.height - root.chrome-bottom - 24px
            - (root.tabbar-vertical ? 44px : 0px);
        height: 20px;
        width: Math.min(560px, root.width - 16px);
        background: Palette.colors.surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: Palette.colors.border;
        opacity: 0.94;

        Text {
            x: 8px;
            width: parent.width - 16px;
            height: parent.height;
            text: root.plugin-status;
            color: Palette.colors.subtext;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }
        TouchArea {
            clicked => { root.plugin-status-clicked(); }
        }
    }

    // Plugin API v3 ask：terminal/clipboard 等敏感宿主请求的全局 Allow/Deny。
    // 只有用户点 Allow 才执行；按 Esc/关闭不会被当作允许。
    if root.plugin-approval-visible : Rectangle {
        x: Math.max(8px, root.width - 472px);
        y: 12px;
        width: Math.min(460px, root.width - 16px);
        height: plugin-approval-layout.preferred-height + 24px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.danger;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #000000a0;
        z: 40;

        TouchArea { width: 100%; height: 100%; }

        plugin-approval-layout := VerticalLayout {
            width: 100%;
            padding: 12px;
            spacing: 8px;
            Text {
                text: Lang.t("Plugin permission request", "插件请求授权");
                color: Palette.colors.danger;
                font-size: 12px;
                font-weight: 600;
            }
            Text {
                text: root.plugin-approval-plugin;
                color: Palette.colors.text;
                font-size: 11px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.plugin-approval-summary;
                color: Palette.colors.text;
                font-size: 11px;
                wrap: word-wrap;
            }
            Text {
                text: root.plugin-approval-details;
                color: Palette.colors.subtext;
                font-size: 10px;
                wrap: word-wrap;
            }
            Text {
                text: Lang.t("Capability gate + explicit user confirmation, not an OS sandbox. This request expires in \{root.plugin-approval-seconds}s.", "这是 capability gate + 用户显式确认，不是 OS 沙箱。请求将在 \{root.plugin-approval-seconds} 秒后过期。");
                color: Palette.colors.muted;
                font-size: 9px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                ActionBtn {
                    horizontal-stretch: 1;
                    label: Lang.t("Allow once", "允许一次");
                    clicked => { root.plugin-approval-allow(); }
                }
                ActionBtn {
                    horizontal-stretch: 1;
                    danger: true;
                    label: Lang.t("Deny", "拒绝");
                    clicked => { root.plugin-approval-deny(); }
                }
            }
        }
    }

    // 链接打开失败等短暂提示：不拦截鼠标事件，4 秒后由 Rust 清空。
    if root.link-status != "" : Rectangle {
        x: root.tabbar-vertical ? root.chrome-left + 12px : 12px;
        // 插件状态栏可见时浮层上移，避免盖住状态文本。
        y: root.plugin-status != ""
            ? root.height - 84px - (root.tabbar-vertical ? 44px : 0px)
            : root.height - 54px - (root.tabbar-vertical ? 44px : 0px);
        width: root.width - 24px;
        height: 36px;
        background: Palette.colors.raise;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.colors.danger;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #000000a8;

        Text {
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            text: root.link-status;
            color: Palette.colors.text;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // ---------------- Pane 最大化提示（UI-PANE-007） ----------------
    // 最大化/还原不弹确认：常驻小提示告诉用户当前处于最大化与还原键。
    if root.pane-zoomed : Rectangle {
        x: 12px;
        y: root.chrome-top + 8px;
        width: 236px;
        height: 26px;
        background: Palette.colors.raise;
        border-radius: 6px;
        border-width: 1px;
        border-color: Palette.colors.accent;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 3px;
        drop-shadow-color: #000000a8;

        Text {
            x: 10px;
            width: parent.width - 20px;
            height: parent.height;
            text: Lang.t("⛶ Pane maximized · Ctrl+Shift+M to restore", "⛶ 窗格已最大化 · Ctrl+Shift+M 还原");
            color: Palette.colors.text;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // 屏内缩放 HUD（UI-TERM-012）：放大/缩小/重置后短暂显示百分比，
    // 不占布局、不抢焦点；1.2s 后由 Rust 清空。位置在终端区顶部居中。
    if root.zoom-hud != "" : Rectangle {
        x: (root.width - self.width) / 2;
        // 广播危险命令红条占顶部时下移，避免 HUD 被盖住。
        y: root.chrome-top
            + (root.broadcast-warning != "" ? 44px : 10px);
        width: 84px;
        height: 30px;
        background: Palette.colors.raise.with-alpha(0.94);
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.colors.accent.with-alpha(0.55);
        drop-shadow-blur: 10px;
        drop-shadow-offset-y: 3px;
        drop-shadow-color: #000000a8;

        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: root.zoom-hud;
            color: Palette.colors.text;
            font-size: 15px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ---------------- 广播危险命令警示（UI-PANE-011） ----------------
    // 广播多 pane 时正在输入破坏性命令：顶部常驻红条，回车前还会弹二次确认。
    if root.broadcast-warning != "" : Rectangle {
        x: 12px;
        y: root.chrome-top + 8px;
        width: root.width - 24px;
        height: 30px;
        background: Palette.colors.raise;
        border-radius: 6px;
        border-width: 1px;
        border-color: Palette.colors.danger;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 3px;
        drop-shadow-color: #000000a8;

        Text {
            x: 10px;
            width: parent.width - 20px;
            height: parent.height;
            text: "⚠ " + root.broadcast-warning;
            color: Palette.colors.danger;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // ---------------- Pane 拖拽 ghost（UI-PANE-008） ----------------
    // 半透明小牌跟随指针；不挂 TouchArea，不抢事件。
    if root.pane-drag-from >= 0 : Rectangle {
        x: Math.max(4px, Math.min(root.pane-drag-x
            + root.content-x + 10px, root.width - 120px));
        y: Math.max(4px, Math.min(root.pane-drag-y
            + root.chrome-top + 10px, root.height - 34px));
        width: 106px;
        height: 26px;
        opacity: 0.9;
        border-radius: 6px;
        border-width: 1px;
        border-color: Palette.colors.accent;
        background: Palette.colors.raise;
        drop-shadow-blur: 10px;
        drop-shadow-offset-y: 3px;
        drop-shadow-color: #00000088;

        Text {
            width: 100%;
            height: 100%;
            text: root.pane-drag-target >= 0
                ? Lang.t("Release to swap", "松开交换")
                : Lang.t("Drop on a pane", "拖到目标窗格");
            color: Palette.colors.accent;
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // 广播危险命令二次确认：确认前那一次 Enter/粘贴不写任何 PTY。
    if root.bcast-danger-open : Rectangle {
        x: (root.width - 460px) / 2;
        y: (root.height - 230px) / 2;
        width: 460px;
        height: 230px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.danger;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            Text {
                text: Lang.t("Broadcast: destructive command?", "广播：危险命令？");
                color: Palette.colors.danger;
                font-size: 15px;
                font-weight: 600;
            }
            Text {
                text: Lang.t("This will be sent to ALL \{root.bcast-danger-panes} panes in this tab.", "这条输入会发给当前 Tab 的全部 \{root.bcast-danger-panes} 个窗格。");
                color: Palette.colors.text;
                font-size: 12px;
                wrap: word-wrap;
            }
            Text {
                text: root.bcast-danger-reason;
                color: Palette.colors.danger;
                font-size: 11px;
                wrap: word-wrap;
            }
            Text {
                text: root.bcast-danger-command;
                color: Palette.colors.subtext;
                font-size: 12px;
                wrap: word-wrap;
                overflow: elide;
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                Rectangle {
                    width: 78px; height: 28px; border-radius: 6px;
                    background: bcast-cancel-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
                    border-width: 1px;
                    border-color: Palette.colors.border;
                    bcast-cancel-hit := TouchArea {
                        clicked => { root.bcast-danger-open = false; root.bcast-danger-cancel(); }
                    }
                    Text {
                        text: Lang.t("Cancel", "取消");
                        color: Palette.colors.text;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
                Rectangle {
                    width: 112px; height: 28px; border-radius: 6px;
                    background: bcast-focused-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
                    border-width: 1px;
                    border-color: Palette.colors.border;
                    bcast-focused-hit := TouchArea {
                        clicked => { root.bcast-danger-open = false; root.bcast-danger-focused(); }
                    }
                    Text {
                        text: Lang.t("This pane only", "只发当前窗格");
                        color: Palette.colors.text;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
                Rectangle {
                    width: 112px; height: 28px; border-radius: 6px;
                    background: bcast-send-hit.has-hover ? Palette.colors.danger : Palette.colors.accent;
                    bcast-send-hit := TouchArea {
                        clicked => { root.bcast-danger-open = false; root.bcast-danger-send(); }
                    }
                    Text {
                        text: Lang.t("Send to all", "全部发送");
                        color: Palette.colors.accent-text;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }
    }

    // ---------------- Tab 拖拽 ghost ----------------
    // 半透明 Tab 副本跟随鼠标；只是普通 Rectangle 覆盖层，不挂 TouchArea，
    // 不抢指针事件，也不改动 Tab 模型/布局。
    if root.drag-active : Rectangle {
        width: Math.max(52px, root.drag-w);
        height: 22px;
        x: Math.max(4px, Math.min(root.drag-win-x - self.width / 2, root.width - self.width - 4px));
        y: Math.max(4px, Math.min(root.drag-win-y + 10px, root.height - self.height - 4px));
        opacity: 0.88;
        border-radius: 6px;
        border-width: 1px;
        border-color: Palette.colors.accent;
        background: Palette.colors.raise;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000088;

        if root.drag-pinned : PinIcon {
            x: 6px;
            y: 6px;
            tint: Palette.colors.accent;
        }

        Text {
            x: root.drag-pinned ? 20px : 8px;
            width: parent.width - self.x - 8px;
            height: parent.height;
            text: root.drag-title;
            color: Palette.colors.text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // ---------------- 无边框窗口拖边/拖角缩放 ----------------
    // 自绘命中区：直接改窗口 size/position，不依赖 WM 的 moveresize。
    ResizeHandle {
        x: 0px; y: 6px; width: 5px; height: root.height - 12px;
        direction: 7;
        mouse-cursor: ew-resize;
        begin(d) => { root.start-window-resize(d); }
        drag => { root.window-resize-drag(); }
        stop => { root.end-window-resize(); }
    }
    ResizeHandle {
        x: root.width - 5px; y: 6px; width: 5px; height: root.height - 12px;
        direction: 3;
        mouse-cursor: ew-resize;
        begin(d) => { root.start-window-resize(d); }
        drag => { root.window-resize-drag(); }
        stop => { root.end-window-resize(); }
    }
    ResizeHandle {
        x: 6px; y: 0px; width: root.width - 12px; height: 5px;
        direction: 1;
        mouse-cursor: ns-resize;
        begin(d) => { root.start-window-resize(d); }
        drag => { root.window-resize-drag(); }
        stop => { root.end-window-resize(); }
    }
    ResizeHandle {
        x: 6px; y: root.height - 5px; width: root.width - 12px; height: 5px;
        direction: 5;
        mouse-cursor: ns-resize;
        begin(d) => { root.start-window-resize(d); }
        drag => { root.window-resize-drag(); }
        stop => { root.end-window-resize(); }
    }
    ResizeHandle {
        x: 0px; y: 0px; width: 8px; height: 8px;
        direction: 0;
        mouse-cursor: nwse-resize;
        begin(d) => { root.start-window-resize(d); }
        drag => { root.window-resize-drag(); }
        stop => { root.end-window-resize(); }
    }
    ResizeHandle {
        x: root.width - 8px; y: 0px; width: 8px; height: 8px;
        direction: 2;
        mouse-cursor: nesw-resize;
        begin(d) => { root.start-window-resize(d); }
        drag => { root.window-resize-drag(); }
        stop => { root.end-window-resize(); }
    }
    ResizeHandle {
        x: 0px; y: root.height - 8px; width: 8px; height: 8px;
        direction: 6;
        mouse-cursor: nesw-resize;
        begin(d) => { root.start-window-resize(d); }
        drag => { root.window-resize-drag(); }
        stop => { root.end-window-resize(); }
    }
    ResizeHandle {
        x: root.width - 8px; y: root.height - 8px; width: 8px; height: 8px;
        direction: 4;
        mouse-cursor: nwse-resize;
        begin(d) => { root.start-window-resize(d); }
        drag => { root.window-resize-drag(); }
        stop => { root.end-window-resize(); }
    }

    // ---------------- 内联图片灯箱 ----------------
    if root.image-preview-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #000000d0;

        // 点击暗色背景关闭；图片/控制条在更上层，不会穿透到这里。
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.image-preview-open = false; }
        }

        Rectangle {
            x: 12px;
            y: 12px;
            width: root.width - 24px;
            height: root.height - 68px;
            clip: true;
            background: transparent;

            Image {
                source: root.image-preview-source;
                // Fit 只缩不放；按钮 100% 回到原始像素。这样默认不会把
                // 小图放大成一坨平滑插值。
                property <float> effective-scale: root.image-preview-fit
                    ? root.image-preview-fit-scale
                    : root.image-preview-zoom;
                width: Math.max(1px, root.image-preview-source.width * 1px) * self.effective-scale;
                height: Math.max(1px, root.image-preview-source.height * 1px) * self.effective-scale;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                image-fit: contain;
                image-rendering: self.effective-scale > 1.0 ? pixelated : smooth;
            }

            // 吃掉图片区域点击，避免点到背景就关闭。
            TouchArea {
                width: 100%;
                height: 100%;
                pointer-event(event) => { EventResult.accept; }
            }
        }

        Rectangle {
            x: 12px;
            y: root.height - 48px;
            width: root.width - 24px;
            height: 36px;
            background: Palette.colors.raise;
            border-radius: 7px;
            border-width: 1px;
            border-color: Palette.colors.border;

            Text {
                x: 12px;
                y: 0px;
                width: 120px;
                height: 100%;
                text: Lang.t("Image preview", "图片预览");
                color: Palette.colors.text;
                font-size: 12px;
                vertical-alignment: center;
            }

            ActionBtn {
                x: 140px;
                y: 5px;
                width: 34px;
                height: 26px;
                label: "−";
                clicked => {
                    let base = root.image-preview-fit
                        ? root.image-preview-fit-scale
                        : root.image-preview-zoom;
                    root.image-preview-fit = false;
                    root.image-preview-zoom = Math.max(0.1, base * 0.8);
                }
            }
            Text {
                x: 180px;
                y: 0px;
                width: 58px;
                height: 100%;
                text: "\{Math.round((root.image-preview-fit
                    ? root.image-preview-fit-scale
                    : root.image-preview-zoom) * 100)}%";
                color: Palette.colors.subtext;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            ActionBtn {
                x: 244px;
                y: 5px;
                width: 34px;
                height: 26px;
                label: "+";
                clicked => {
                    let base = root.image-preview-fit
                        ? root.image-preview-fit-scale
                        : root.image-preview-zoom;
                    root.image-preview-fit = false;
                    root.image-preview-zoom = Math.min(4.0, base * 1.25);
                }
            }
            ActionBtn {
                x: 288px;
                y: 5px;
                width: 52px;
                height: 26px;
                label: Lang.t("Fit", "适应");
                clicked => { root.image-preview-fit = true; }
            }
            ActionBtn {
                x: 344px;
                y: 5px;
                width: 52px;
                height: 26px;
                label: "100%";
                clicked => {
                    root.image-preview-fit = false;
                    root.image-preview-zoom = 1.0;
                }
            }
            ActionBtn {
                x: root.width - 60px;
                y: 5px;
                width: 46px;
                height: 26px;
                label: Lang.t("Close", "关闭");
                clicked => { root.image-preview-open = false; }
            }
        }
    }

    if root.doctor-open : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #00000088;
        z: 50;
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.close-doctor(); }
        }
        Rectangle {
            x: Math.max(16px, (parent.width - 720px) / 2);
            y: Math.max(40px, (parent.height - 520px) / 2);
            width: Math.min(720px, parent.width - 32px);
            height: Math.min(520px, parent.height - 72px);
            border-radius: 10px;
            background: Palette.colors.bg;
            border-width: 1px;
            border-color: Palette.colors.border;
            clip: true;
            TouchArea { width: 100%; height: 100%; }
            Text {
                x: 18px; y: 12px; width: parent.width - 100px; height: 28px;
                text: Lang.t("Tervo Doctor · deterministic", "Tervo Doctor · 确定性诊断");
                color: Palette.colors.text; font-size: 14px; font-weight: 600;
                vertical-alignment: center;
            }
            ActionBtn {
                x: parent.width - 86px; y: 10px; width: 68px; height: 28px;
                label: Lang.t("Close", "关闭");
                clicked => { root.close-doctor(); }
            }
            Rectangle {
                x: 14px; y: 48px; width: parent.width - 28px; height: parent.height - 62px;
                border-radius: 6px; background: Palette.colors.surface;
                border-width: 1px; border-color: Palette.colors.border; clip: true;
                Flickable {
                    width: 100%; height: 100%; interactive: true;
                    content-width: self.width;
                    content-height: Math.max(self.height, doctor-body.preferred-height + 16px);
                    doctor-body := Text {
                        x: 8px; y: 8px; width: parent.width - 16px;
                        text: root.doctor-text;
                        color: Palette.colors.text; font-size: 10px; wrap: word-wrap;
                    }
                }
            }
        }
    }

    if root.render-hud != "" : Rectangle {
        x: 8px;
        y: root.height - 28px;
        width: root.width - 16px;
        height: 22px;
        border-radius: 5px;
        background: #000000cc;
        clip: true;
        Text {
            x: 8px;
            width: parent.width - 16px;
            height: 100%;
            text: root.render-hud;
            color: #d8d8d8;
            font-size: 10px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
