    in-out property <string> cfg-font-family: "";
    in-out property <int> cfg-font-weight: 400;
    in-out property <float> cfg-line-height: 1.0;
    in-out property <float> cfg-letter-spacing: 0;
    in-out property <float> cfg-render-scale: 1.0;
    callback set-font-family(string);
    callback bump-font-weight(int);
    callback bump-line-height(float);
    callback bump-letter-spacing(float);
    callback bump-render-scale(float);
