    in-out property <int> drop-index: -1;
    in-out property <int> drop-gap: -1;
    in-out property <bool> drop-valid: false;
    in property <int> pinned-count: 0;
    callback tab-reorder(int, length, length);
    callback tab-drag-move(int, length, length);
