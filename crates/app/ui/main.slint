// SPDX-License-Identifier: GPL-3.0-only
// 界面 chrome 配色：由 Rust 侧按当前主题写入。
export struct ThemeColors {
    bg: color,
    surface: color,
    raise: color,
    hover: color,
    border: color,
    text: color,
    subtext: color,
    muted: color,
    accent: color,
    accent-text: color,
    danger: color,
}


/// 全局语言：Rust 设置 `code`（"en" / "zh"）；静态文案统一通过 `Lang.t(en, zh)`
/// 绑定，属性变化时所有文字自动重算，无需重建组件。
export global Lang {
    in-out property <string> code: "en";
    pure public function t(en: string, zh: string) -> string {
        if (code == "zh") {
            return zh;
        }
        return en;
    }
}

// 默认值 = Tokyo Night（与 core::Theme 的默认主题保持一致）。
export global Palette {
    in-out property <ThemeColors> colors: {
        bg: #1a1b26,
        surface: #16161e,
        raise: #24283b,
        hover: #292e42,
        border: #3b4261,
        text: #c0caf5,
        subtext: #a9b1d6,
        muted: #565f89,
        accent: #7aa2f7,
        accent-text: #1a1b26,
        danger: #f7768e,
    };
}

export struct ThemeChoice {
    id: string,
    label: string,
}

/// 设置 → Hotkeys 的一行：命令标题 + 当前生效 chord + 状态。
export struct HotkeyRow {
    command: string,
    title: string,
    chord: string,
    /// 有用户 override（不再是默认绑定）
    custom: bool,
    /// 当前生效 chord 与其他命令冲突
    conflict: bool,
}

export struct DividerView {
    index: int,
    x: length,
    y: length,
    w: length,
    h: length,
    /// true = 左右分屏（竖线，拖 x）；false = 上下分屏（横线，拖 y）
    vertical: bool,
}

/// 终端 pane 上的一张内联图片（Sixel）：pane 内像素坐标，独立 Image overlay。
export struct PaneImage {
    image: image,
    x: length,
    y: length,
    w: length,
    h: length,
}

export struct PaneView {
    id: int,
    image: image,
    x: length,
    y: length,
    w: length,
    h: length,
    focused: bool,
    iw: length,
    ih: length,
    /// 光标 overlay（cell 大小的小图）；终端帧本身不画光标。
    cursor-image: image,
    cursor-x: length,
    cursor-y: length,
    cursor-w: length,
    cursor-h: length,
    /// 闪烁相位 + 终端 SHOW_CURSOR 合并后的可见性。
    cursor-visible: bool,
    /// 终端启用了鼠标上报（1000/1002/1003）：中键/右键/滚轮要转发给 PTY。
    mouse-reporting: bool,
    /// scrollback 超出视口时显示右侧 overlay 滚动条。
    scrollbar-visible: bool,
    /// thumb 顶部相对 pane 的 y（像素）与高度；track 高度 = 终端网格像素高。
    scrollbar-thumb-y: length,
    scrollbar-thumb-h: length,
    scrollbar-track-h: length,
    /// 活动 pane 收到 BEL 时短暂闪烁边框。
    bell-flash: bool,
    /// 终端处于 Read Only：键盘/粘贴不写 PTY，pane 角标提示。
    read-only: bool,
    /// 鼠标悬停在可点击链接（URL/OSC 8/路径）上：TouchArea 用 pointer 手型。
    /// 由 Rust 按格扫描后在悬停状态变化时更新，不触发终端帧重绘。
    link-hover: bool,
    /// Sixel 图片 overlay（按创建顺序，后创建的画在上面）。图片不进终端
    /// cell 文本/选区，也不触发终端帧重绘。
    images: [PaneImage],
}

export struct TabView {
    title: string,
    active: bool,
    /// OSC 9;4 状态：0=清除 1=进行中 2=错误 3=不确定 4=暂停
    progress-state: int,
    /// 进度条比例 0.0..=1.0（不确定进度由 Rust 侧给固定比例）
    progress-ratio: float,
    /// 百分比文本（如 "42%"）；无合法百分比时为空
    progress-label: string,
    /// 未读通知点
    attention: bool,
    /// 刚完成（进度从有到清除）的完成标记
    completed: bool,
}

/// Profiles 面板的一行：过滤/星标都在 Rust 侧算好，UI 只负责画。
export struct ProfileRow {
    /// Profile 稳定 ID（调试/未来扩展用）
    id: int,
    /// 形如 `[local] work`
    label: string,
    /// 是否为“新 Tab 默认 Profile”（行首星标）
    is-default: bool,
}

component MenuRow inherits Rectangle {
    in property <string> label;
    callback picked();

    height: 28px;
    border-radius: 4px;
    background: hit.has-hover ? Palette.colors.hover : transparent;

    hit := TouchArea {
        clicked => { root.picked(); }
    }

    Text {
        x: 10px;
        text: root.label;
        color: Palette.colors.text;
        font-size: 12px;
        vertical-alignment: center;
        width: parent.width - 12px;
    }
}

/// 菜单分组标题：13px semi-bold 次级色；非首组顶部画一条 1px 分隔线。
component MenuGroupLabel inherits Rectangle {
    in property <string> label;
    in property <bool> first: false;

    height: 22px;
    background: transparent;

    Rectangle {
        visible: !root.first;
        x: 6px;
        y: 0px;
        width: parent.width - 12px;
        height: 1px;
        background: Palette.colors.border;
        opacity: 0.6;
    }
    Text {
        x: 10px;
        y: 2px;
        width: parent.width - 20px;
        height: parent.height - 2px;
        text: root.label;
        color: Palette.colors.subtext;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.4px;
        vertical-alignment: center;
        overflow: elide;
    }
}

/// 终端右键菜单项：30px 行高 / 14px 标签 + 可选快捷键提示，无图标。
/// 只在终端 pane 菜单里使用，TabBar/Profile 菜单仍用紧凑的 MenuRow（行为不变）。
component ContextMenuRow inherits Rectangle {
    in property <string> label;
    in property <string> shortcut: "";
    /// 状态类菜单项（Read Only / Broadcast）开启时用 accent 淡底提示。
    in property <bool> active: false;
    in property <bool> danger: false;
    callback picked();

    height: 30px;
    border-radius: 5px;
    background: hit.has-hover ? Palette.colors.hover : transparent;

    // 状态项：轻量 accent 洗色，不压过文字对比度。
    if root.active && !hit.has-hover : Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 5px;
        background: Palette.colors.accent;
        opacity: 0.10;
    }

    hit := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.picked(); }
    }

    // 悬停左侧标记；关闭 pane 用 danger 色提示破坏性。
    Rectangle {
        x: 2px;
        y: 9px;
        width: 2px;
        height: 12px;
        border-radius: 1px;
        background: root.danger ? Palette.colors.danger : Palette.colors.accent;
        visible: hit.has-hover;
    }

    Text {
        x: 10px;
        y: 0px;
        width: parent.width - 10px - (root.shortcut == "" ? 12px : 104px);
        height: 100%;
        text: root.label;
        color: root.danger && hit.has-hover ? Palette.colors.danger : Palette.colors.text;
        font-size: 14px;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.shortcut != "" : Text {
        x: parent.width - 106px;
        y: 0px;
        width: 96px;
        height: 100%;
        text: root.shortcut;
        color: Palette.colors.subtext;
        font-size: 11px;
        horizontal-alignment: right;
        vertical-alignment: center;
        opacity: 0.92;
    }
}


// 设置页里的动作按钮（Vault 等）
component ActionBtn inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    in property <length> font-size: 11px;
    callback clicked();

    height: 26px;
    border-radius: 6px;
    background: hit.has-hover
        ? (root.danger ? Palette.colors.danger : Palette.colors.hover)
        : Palette.colors.raise;
    border-width: 1px;
    border-color: root.danger ? Palette.colors.danger : Palette.colors.border;

    hit := TouchArea {
        clicked => { root.clicked(); }
    }
    Text {
        text: root.label;
        color: root.danger && hit.has-hover ? Palette.colors.accent-text : Palette.colors.text;
        font-size: root.font-size;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
        overflow: elide;
    }
}

component FormRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> text;
    /// 标签列宽；紧凑的两列外观行用 64px，默认保持原设置表单样式。
    in property <length> label-width: 64px;
    /// true = 密码输入（Slint 负责 masked 显示）
    in property <bool> masked: false;
    spacing: 8px;

    Text {
        width: root.label-width;
        text: root.label;
        color: Palette.colors.subtext;
        font-size: 12px;
        vertical-alignment: center;
    }
    Rectangle {
        height: 26px;
        horizontal-stretch: 1;
        border-radius: 4px;
        background: Palette.colors.bg;
        border-width: 1px;
        border-color: Palette.colors.border;

        TextInput {
            x: 6px;
            width: parent.width - 12px;
            height: parent.height;
            text <=> root.text;
            single-line: true;
            input-type: root.masked ? InputType.password : InputType.text;
            color: Palette.colors.text;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

// 设置面板里的开关行
component ToggleRow inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback toggled();

    height: 26px;

    Text {
        x: 0px;
        width: parent.width - 56px;
        text: root.label;
        color: Palette.colors.text;
        font-size: 12px;
        vertical-alignment: center;
    }

    Rectangle {
        x: parent.width - 44px;
        y: 4px;
        width: 40px;
        height: 18px;
        border-radius: 9px;
        background: root.on ? Palette.colors.accent : Palette.colors.hover;

        Rectangle {
            x: root.on ? parent.width - 16px : 2px;
            y: 2px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: Palette.colors.bg;
        }

        TouchArea {
            clicked => { root.toggled(); }
        }
    }
}

/// 设置页的百分比滑块。拖动时 preview（不落盘），松手 changed（保存）。
/// min/max 由调用方给：终端 opacity = 0–1，背景遮罩 = 0–0.8。
component OpacitySlider inherits Rectangle {
    in-out property <float> value: 1.0;
    in property <float> min: 0.0;
    in property <float> max: 1.0;
    callback preview(float);
    callback changed(float);

    property <float> ratio: {
        let span = root.max - root.min;
        span <= 0.0 ? 0.0 : Math.max(0.0, Math.min(1.0, (root.value - root.min) / span))
    }
    height: 22px;
    background: transparent;

    // 轨道左右各留 4px，滑块圆心也限制在轨道内。
    Rectangle {
        x: 4px;
        y: (parent.height - 4px) / 2;
        width: parent.width - 8px;
        height: 4px;
        border-radius: 2px;
        background: Palette.colors.border;
    }

    Rectangle {
        x: 4px;
        y: (parent.height - 4px) / 2;
        width: (parent.width - 8px) * root.ratio;
        height: 4px;
        border-radius: 2px;
        background: Palette.colors.accent;
    }

    Rectangle {
        x: 4px + (parent.width - 8px) * root.ratio - 6px;
        y: (parent.height - 12px) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Palette.colors.text;
        border-width: 1px;
        border-color: Palette.colors.bg;
    }

    // 只有左键按下后才跟踪移动；否则鼠标悬停/划过会不断 preview，
    // 看起来像滑块“粘住鼠标”。down 允许直接点轨道跳转。
    property <bool> dragging: false;

    TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down
                && event.button == PointerEventButton.left) {
                root.dragging = true;
                // length 需除以 1px 转成普通数字再算比例。
                let track = (self.width - 8px) / 1px;
                let x = (self.mouse-x - 4px) / 1px;
                let t = track <= 0.0 ? 0.0 : Math.max(0.0, Math.min(1.0, x / track));
                // 不直接写 root.value：父级用绑定把 main.* 流回来，
                // 直接赋值会打断绑定导致外部（Rust）更新滑块时不同步。
                root.preview(root.min + t * (root.max - root.min));
                return EventResult.accept;
            }
            if (event.kind == PointerEventKind.move && root.dragging) {
                let track = (self.width - 8px) / 1px;
                let x = (self.mouse-x - 4px) / 1px;
                let t = track <= 0.0 ? 0.0 : Math.max(0.0, Math.min(1.0, x / track));
                root.preview(root.min + t * (root.max - root.min));
                return EventResult.accept;
            }
            if (event.kind == PointerEventKind.up && root.dragging) {
                root.dragging = false;
                root.changed(root.value);
                return EventResult.accept;
            }
            EventResult.reject
        }
    }
}

component ChoiceBtn inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <length> font-size: 12px;
    callback clicked();

    width: 76px;
    height: 26px;
    border-radius: 6px;
    background: root.active ? Palette.colors.accent : (hit.has-hover ? Palette.colors.hover : Palette.colors.raise);
    border-width: 1px;
    border-color: root.active ? Palette.colors.accent : Palette.colors.border;

    hit := TouchArea {
        clicked => { root.clicked(); }
    }
    Text {
        text: root.label;
        color: root.active ? Palette.colors.accent-text : Palette.colors.text;
        font-size: root.font-size;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
        overflow: elide;
    }
}

/// 设置分类图标：统一 16×16 线性图标（细描边、低对比度）。
/// 全部用 Path/Rectangle 手绘，避免依赖字体里是否有对应符号或混入 emoji。
enum SettingsIconKind {
    appearance,
    terminal,
    window,
    keys,
    profiles,
    plugins,
    vault,
    advanced,
    gear,
    search,
    chevron,
}

component SettingsIconView inherits Rectangle {
    in property <SettingsIconKind> kind: SettingsIconKind.appearance;
    in property <color> tint: Palette.colors.subtext;

    width: 16px;
    height: 16px;
    background: transparent;

    // Appearance / theme：中心圆 + 8 条光线。
    if root.kind == SettingsIconKind.appearance : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        Rectangle {
            x: 5px; y: 5px; width: 6px; height: 6px;
            border-radius: 3px;
            background: transparent;
            border-width: 1.3px;
            border-color: root.tint;
        }
        Path {
            width: 100%; height: 100%;
            commands: "M 8 1 L 8 3 M 8 13 L 8 15 M 1 8 L 3 8 M 13 8 L 15 8 M 3 3 L 4.5 4.5 M 11.5 11.5 L 13 13 M 13 3 L 11.5 4.5 M 4.5 11.5 L 3 13";
            stroke: root.tint;
            stroke-width: 1.3px;
            stroke-line-cap: round;
        }
    }

    // Terminal：>_ 提示符。
    if root.kind == SettingsIconKind.terminal : Path {
        width: 100%; height: 100%;
        commands: "M 2.5 3.5 L 7 8 L 2.5 12.5 M 8.5 12.5 L 13.5 12.5";
        stroke: root.tint;
        stroke-width: 1.4px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    // Window：外框 + 标题栏分隔线。
    if root.kind == SettingsIconKind.window : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        Rectangle {
            x: 2px; y: 3px; width: 12px; height: 10px;
            border-radius: 2px;
            background: transparent;
            border-width: 1.3px;
            border-color: root.tint;
        }
        Rectangle {
            x: 2px; y: 6px; width: 12px; height: 1px;
            background: root.tint;
        }
    }

    // Keys：键盘外框 + 键帽点。
    if root.kind == SettingsIconKind.keys : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        Rectangle {
            x: 1.5px; y: 4.5px; width: 13px; height: 7px;
            border-radius: 2px;
            background: transparent;
            border-width: 1.3px;
            border-color: root.tint;
        }
        Path {
            width: 100%; height: 100%;
            commands: "M 4 7 L 4.5 7 M 6.5 7 L 7 7 M 9 7 L 9.5 7 M 11.5 7 L 12 7 M 5 9.5 L 11 9.5";
            stroke: root.tint;
            stroke-width: 1.2px;
            stroke-line-cap: round;
        }
    }

    // Profiles：头像 + 肩线。
    if root.kind == SettingsIconKind.profiles : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        Rectangle {
            x: 5px; y: 1.5px; width: 6px; height: 6px;
            border-radius: 3px;
            background: transparent;
            border-width: 1.3px;
            border-color: root.tint;
        }
        Path {
            width: 100%; height: 100%;
            commands: "M 2.5 14 C 2.5 10.8 5 9.5 8 9.5 C 11 9.5 13.5 10.8 13.5 14";
            stroke: root.tint;
            stroke-width: 1.3px;
            stroke-line-cap: round;
        }
    }

    // Plugins：插头（两脚 + 本体 + 线）。
    if root.kind == SettingsIconKind.plugins : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        Rectangle {
            x: 3px; y: 5px; width: 10px; height: 6px;
            border-radius: 2px;
            background: transparent;
            border-width: 1.3px;
            border-color: root.tint;
        }
        Path {
            width: 100%; height: 100%;
            commands: "M 5.5 1.5 L 5.5 5 M 10.5 1.5 L 10.5 5 M 8 11 L 8 14";
            stroke: root.tint;
            stroke-width: 1.3px;
            stroke-line-cap: round;
        }
    }

    // Vault：锁体 + 锁梁。
    if root.kind == SettingsIconKind.vault : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        Rectangle {
            x: 3px; y: 7px; width: 10px; height: 7px;
            border-radius: 2px;
            background: transparent;
            border-width: 1.3px;
            border-color: root.tint;
        }
        Path {
            width: 100%; height: 100%;
            commands: "M 5 7 L 5 4.5 C 5 1.8 11 1.8 11 4.5 L 11 7 M 8 9.5 L 8 11.5";
            stroke: root.tint;
            stroke-width: 1.3px;
            stroke-line-cap: round;
        }
    }

    // Advanced：三条滑杆 + 旋钮。
    if root.kind == SettingsIconKind.advanced : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        Path {
            width: 100%; height: 100%;
            commands: "M 2 4 L 14 4 M 2 8 L 14 8 M 2 12 L 14 12";
            stroke: root.tint;
            stroke-width: 1.3px;
            stroke-line-cap: round;
        }
        Rectangle {
            x: 5px; y: 2.5px; width: 3px; height: 3px;
            border-radius: 1.5px;
            background: Palette.colors.surface;
            border-width: 1px;
            border-color: root.tint;
        }
        Rectangle {
            x: 9px; y: 6.5px; width: 3px; height: 3px;
            border-radius: 1.5px;
            background: Palette.colors.surface;
            border-width: 1px;
            border-color: root.tint;
        }
        Rectangle {
            x: 4px; y: 10.5px; width: 3px; height: 3px;
            border-radius: 1.5px;
            background: Palette.colors.surface;
            border-width: 1px;
            border-color: root.tint;
        }
    }

    // Gear：8 齿实心轮廓 + 中心圆孔（内圈反向绕序挖空）。
    // 齿与轮体连成一体：旧版“圆环 + 8 条分离短线”在 16px 下会被读成太阳。
    if root.kind == SettingsIconKind.gear : Path {
        width: 100%;
        height: 100%;
        commands: "M 12.78 6.54 L 14.87 6.66 L 14.87 9.34 L 12.78 9.46 L 12.41 10.35 L 13.80 11.91 L 11.91 13.80 L 10.35 12.41 L 9.46 12.78 L 9.34 14.87 L 6.66 14.87 L 6.54 12.78 L 5.65 12.41 L 4.09 13.80 L 2.20 11.91 L 3.59 10.35 L 3.22 9.46 L 1.13 9.34 L 1.13 6.66 L 3.22 6.54 L 3.59 5.65 L 2.20 4.09 L 4.09 2.20 L 5.65 3.59 L 6.54 3.22 L 6.66 1.13 L 9.34 1.13 L 9.46 3.22 L 10.35 3.59 L 11.91 2.20 L 13.80 4.09 L 12.41 5.65 Z M 10.20 8.00 L 10.13 7.43 L 9.91 6.90 L 9.56 6.44 L 9.10 6.09 L 8.57 5.87 L 8.00 5.80 L 7.43 5.87 L 6.90 6.09 L 6.44 6.44 L 6.09 6.90 L 5.87 7.43 L 5.80 8.00 L 5.87 8.57 L 6.09 9.10 L 6.44 9.56 L 6.90 9.91 L 7.43 10.13 L 8.00 10.20 L 8.57 10.13 L 9.10 9.91 L 9.56 9.56 L 9.91 9.10 L 10.13 8.57 Z";
        fill: root.tint;
    }

    // Search：圆环 + 手柄。
    if root.kind == SettingsIconKind.search : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        Rectangle {
            x: 2px; y: 2px; width: 8px; height: 8px;
            border-radius: 4px;
            background: transparent;
            border-width: 1.4px;
            border-color: root.tint;
        }
        Path {
            width: 100%; height: 100%;
            commands: "M 9 9 L 14 14";
            stroke: root.tint;
            stroke-width: 1.4px;
            stroke-line-cap: round;
        }
    }

    // Chevron：下拉箭头。
    if root.kind == SettingsIconKind.chevron : Path {
        width: 100%; height: 100%;
        commands: "M 4 6 L 8 10 L 12 6";
        stroke: root.tint;
        stroke-width: 1.4px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

/// 设置项开关（右侧，整行点击也可切换）。
component SettingsSwitch inherits Rectangle {
    in property <bool> on: false;
    callback toggled();

    width: 42px;
    height: 22px;
    border-radius: 11px;
    background: root.on ? Palette.colors.accent : Palette.colors.hover;
    border-width: 1px;
    border-color: root.on ? Palette.colors.accent : Palette.colors.border;
    animate background, border-color { duration: 120ms; easing: ease-out; }

    Rectangle {
        x: root.on ? parent.width - 19px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.on ? Palette.colors.accent-text : Palette.colors.subtext;
        animate x, background { duration: 120ms; easing: ease-out; }
    }

    TouchArea {
        clicked => { root.toggled(); }
    }
}

/// 布尔设置行：左侧标题/说明，右侧 switch。
component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> description: "";
    spacing: 12px;
    cross-axis-alignment: center;

    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 2px;
        Text {
            text: root.label;
            color: Palette.colors.text;
            font-size: 12px;
            wrap: word-wrap;
        }
        if root.description != "" : Text {
            text: root.description;
            color: Palette.colors.muted;
            font-size: 10px;
            wrap: word-wrap;
        }
    }

    @children
}

/// 堆叠设置项：标题/说明在上，下拉/分段/滑杆/输入占满整行。
component SettingField inherits VerticalLayout {
    in property <string> label;
    in property <string> description: "";
    width: 100%;
    spacing: 6px;

    Text {
        text: root.label;
        color: Palette.colors.text;
        font-size: 12px;
    }
    if root.description != "" : Text {
        text: root.description;
        color: Palette.colors.muted;
        font-size: 10px;
        wrap: word-wrap;
    }

    @children
}

/// 设置分组卡片：标题 + 子项；搜索结果跳转时边框/标题用 accent 高亮。
component SettingsCard inherits Rectangle {
    in property <string> title;
    in property <string> description: "";
    in property <bool> highlighted: false;

    height: card-layout.preferred-height;
    border-radius: 10px;
    background: root.highlighted ? Palette.colors.hover : Palette.colors.surface;
    border-width: 1px;
    border-color: root.highlighted ? Palette.colors.accent : Palette.colors.border;
    animate background, border-color { duration: 160ms; easing: ease-out; }

    card-layout := VerticalLayout {
        width: 100%;
        padding: 14px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.title;
                color: root.highlighted ? Palette.colors.accent : Palette.colors.subtext;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; height: 1px; background: transparent; }
            // 高亮的小圆点：搜索跳转后明确指向当前分组。
            Rectangle {
                visible: root.highlighted;
                width: 6px; height: 6px;
                border-radius: 3px;
                background: Palette.colors.accent;
            }
        }

        if root.description != "" : Text {
            text: root.description;
            color: Palette.colors.muted;
            font-size: 10px;
            wrap: word-wrap;
        }

        @children
    }
}

/// 分段选择器：2–3 个互斥选项；选中态用 accent，不再铺一排 chip。
component Segmented inherits Rectangle {
    in property <[string]> options: [];
    in property <[string]> values: [];
    in property <string> value: "";
    callback picked(string);

    width: 100%;
    height: 32px;
    border-radius: 8px;
    background: Palette.colors.bg;
    border-width: 1px;
    border-color: Palette.colors.border;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;

        for opt[i] in root.options : Rectangle {
            horizontal-stretch: 1;
            height: 26px;
            border-radius: 6px;
            property <bool> selected: i < root.values.length && root.values[i] == root.value;
            background: selected
                ? Palette.colors.accent
                : (seg-hit.has-hover ? Palette.colors.hover : transparent);
            animate background { duration: 120ms; easing: ease-out; }

            seg-hit := TouchArea {
                clicked => {
                    if (i < root.values.length) {
                        root.picked(root.values[i]);
                    }
                }
            }

            Text {
                text: opt;
                color: selected ? Palette.colors.accent-text : Palette.colors.subtext;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
                overflow: elide;
            }
        }
    }
}

/// 数值步进器：− / 当前值 / +（字号、回滚行数等）。
component Stepper inherits Rectangle {
    in property <string> text: "";
    callback minus();
    callback plus();

    width: 100%;
    height: 32px;
    border-radius: 8px;
    background: Palette.colors.bg;
    border-width: 1px;
    border-color: Palette.colors.border;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;

        Rectangle {
            width: 30px;
            height: 26px;
            border-radius: 6px;
            background: step-minus.has-hover ? Palette.colors.hover : Palette.colors.raise;
            Text {
                text: "−";
                color: Palette.colors.text;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
            step-minus := TouchArea { clicked => { root.minus(); } }
        }

        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Palette.colors.text;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            width: 30px;
            height: 26px;
            border-radius: 6px;
            background: step-plus.has-hover ? Palette.colors.hover : Palette.colors.raise;
            Text {
                text: "+";
                color: Palette.colors.text;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
            step-plus := TouchArea { clicked => { root.plus(); } }
        }
    }
}

/// 设置页文本输入：支持占位符、密码掩码、红色错误描边、可选清除按钮。
component SettingsTextField inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder: "";
    in property <bool> masked: false;
    in property <bool> error: false;
    in property <bool> clearable: false;
    /// 失焦提交（仅背景图路径等需要校验的字段）：旧 modal 的 changed has-focus 行为。
    in property <bool> commit-on-blur: false;
    callback edited(string);
    callback accepted(string);
    callback cleared();
    callback blurred(string);

    width: 100%;
    height: 32px;
    border-radius: 8px;
    background: Palette.colors.bg;
    border-width: 1px;
    border-color: root.error ? Palette.colors.danger : Palette.colors.border;

    Text {
        x: 10px;
        width: parent.width - (root.clearable && root.text != "" ? 42px : 20px);
        height: parent.height;
        text: root.placeholder;
        color: Palette.colors.muted;
        font-size: 11px;
        vertical-alignment: center;
        visible: root.text == "";
        overflow: elide;
    }

    TextInput {
        x: 10px;
        width: parent.width - (root.clearable && root.text != "" ? 42px : 20px);
        height: parent.height;
        text <=> root.text;
        single-line: true;
        input-type: root.masked ? InputType.password : InputType.text;
        color: Palette.colors.text;
        font-size: 11px;
        vertical-alignment: center;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
        changed has-focus => {
            if (!self.has-focus && root.commit-on-blur) {
                root.blurred(self.text);
            }
        }
    }

    if root.clearable && root.text != "" : Rectangle {
        x: parent.width - 30px;
        y: 6px;
        width: 20px;
        height: 20px;
        border-radius: 4px;
        background: field-clear.has-hover ? Palette.colors.hover : transparent;
        Text {
            text: "×";
            color: Palette.colors.muted;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }
        field-clear := TouchArea {
            clicked => {
                root.text = "";
                root.cleared();
            }
        }
    }
}

/// 左侧分类项：线性图标 + 标签；选中态用 accent 边条/文字，而不是整块高饱和底。
component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <SettingsIconKind> icon: SettingsIconKind.appearance;
    callback clicked();

    height: 34px;
    border-radius: 7px;
    background: root.active
        ? Palette.colors.hover
        : (hit.has-hover ? Palette.colors.surface : transparent);
    animate background { duration: 120ms; easing: ease-out; }

    Rectangle {
        visible: root.active;
        x: 0px;
        y: 7px;
        width: 2px;
        height: 20px;
        border-radius: 1px;
        background: Palette.colors.accent;
    }

    SettingsIconView {
        x: 11px;
        y: 9px;
        kind: root.icon;
        tint: root.active ? Palette.colors.accent : Palette.colors.subtext;
    }

    Text {
        x: 37px;
        width: parent.width - 47px;
        height: parent.height;
        text: root.label;
        color: root.active ? Palette.colors.accent : Palette.colors.text;
        font-size: 12px;
        font-weight: root.active ? 600 : 400;
        vertical-alignment: center;
        overflow: elide;
    }

    hit := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ResizeHandle inherits TouchArea {
    in property <int> direction: 0;
    callback begin(int);
    callback drag();
    callback stop();

    pointer-event(event) => {
        if (event.kind == PointerEventKind.down) {
            // 只允许左键发起窗口缩放；右键在窗口边缘不做任何事。
            if (event.button != PointerEventButton.left) {
                return EventResult.reject;
            }
            root.begin(root.direction);
            return EventResult.accept;
        }
        if (event.kind == PointerEventKind.move && self.pressed) {
            root.drag();
            return EventResult.accept;
        }
        if (event.kind == PointerEventKind.up) {
            root.stop();
            return EventResult.accept;
        }
        EventResult.reject
    }
}

/// 查找栏开关：Match case / Match regex。
component FindToggle inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback toggled();

    width: 86px;
    height: 20px;
    border-radius: 4px;
    background: active ? Palette.colors.accent : Palette.colors.hover;
    border-width: 1px;
    border-color: active ? Palette.colors.accent : Palette.colors.border;

    hit := TouchArea {
        clicked => { root.toggled(); }
    }
    Text {
        text: root.label;
        color: root.active ? Palette.colors.accent-text : Palette.colors.text;
        font-size: 10px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

export component MainWindow inherits Window {
    /// 当前 UI 语言："en" | "zh"。Rust 在启动/切换/热更新时写入；
    /// Settings 页与右键菜单的静态文案都绑定到 `Lang.t(...)`。
    in-out property <string> language: "en";
    init => { Lang.code = root.language; }
    changed language => { Lang.code = root.language; }

    in property <[PaneView]> panes;
    in property <[DividerView]> dividers;
    /// 原生文件拖放 hover 的目标 pane（-1 = 没有拖放）。
    /// Slint 1.18 的 winit 后端不投递外部拖放的 DataTransfer，Rust 侧用
    /// winit 的 HoveredFile/DroppedFile 桥接并写这个属性做高亮。
    in-out property <int> drop-hover-pane: -1;
    in property <[TabView]> tabs;
    in property <length> tabbar-height: 32px;
    in-out property <bool> menu-open: false;
    in property <length> menu-x: 0px;
    in property <length> menu-y: 0px;
    in property <int> menu-pane: -1;
    // 右键那格命中的链接（OSC 8 优先，普通 URL 兜底）；空 = 不显示 Open/Copy Link。
    in-out property <string> menu-link: "";
    /// 右键目标 pane 当前是否 Read Only（菜单项标签由 Rust 在开菜单时写入）。
    in property <bool> menu-read-only: false;
    // 链接打开失败等短暂提示（底部浮层，Rust 侧 4 秒后清空）。
    in-out property <string> link-status: "";
    // 插件状态提供者的最小状态栏（底部一行文本；空 = 隐藏，不占布局）。
    in-out property <string> plugin-status: "";
    in-out property <string> plugin-status-tooltip: "";
    // 终端右键菜单：宽度按最长标签 + 快捷键提示留足，窄窗口自动收窄；
    // 内容高度固定（分组标题 22px / 菜单项 30px），超过内容区时菜单内滚动，
    // 不做整块溢出到窗口外。
    property <length> menu-width: Math.max(180px, Math.min(280px, root.width - 16px));
    property <length> menu-content-h: root.menu-link != "" ? 572px : 490px;
    property <length> menu-view-h: Math.max(80px,
        Math.min(root.menu-content-h, root.height - root.tabbar-height - 12px));
    // 锚点同原生菜单：优先右/下，放不下翻到左/上，再放不下才夹进窗口。
    property <length> menu-left: root.menu-x + root.menu-width + 8px <= root.width
        ? root.menu-x
        : (root.menu-x - root.menu-width >= 8px
            ? root.menu-x - root.menu-width
            : Math.max(8px, Math.min(root.menu-x, root.width - root.menu-width - 8px)));
    property <length> menu-top: root.menu-y + root.menu-view-h + 8px <= root.height - root.tabbar-height
        ? root.menu-y
        : (root.menu-y - root.menu-view-h >= 0px
            ? root.menu-y - root.menu-view-h
            : Math.max(6px,
                Math.min(root.menu-y, root.height - root.tabbar-height - root.menu-view-h - 6px)));

    callback key-input(string, bool, bool, bool, bool, bool);
    // press/release 配对：只有 kitty REPORT_EVENT_TYPES 且 press 进过 PTY 才回放。
    callback key-release(string, bool, bool, bool, bool);
    // 右键事件到达 UI 层的追踪（日志排查用）
    callback input-trace(string, int, length, length);
    /// 拖动分屏分隔条：index + 内容区坐标
    callback divider-dragged(int, length, length);
    /// 无边框窗口拖边缩放：0=左上 1=上 2=右上 3=右 4=右下 5=下 6=左下 7=左
    callback start-window-resize(int);
    callback window-resize-drag();
    callback end-window-resize();
    /// IME 上屏（无修饰键语义），与物理按键分开，避免中文触发 Ctrl 快捷键。
    callback ime-commit(string);
    callback pane-clicked(int);
    callback pane-right-clicked(int, length, length);
    callback pane-right-up(int, length, length);
    callback pane-middle-click(int);
    /// 菜单被点外部关闭（便于自动化验证）
    callback menu-dismissed();
    /// 由分隔线/边缘等非 pane 控件发起：按内容区坐标找最近的 pane 开菜单
    callback pane-right-clicked-at(length, length);
    callback menu-action(int, int);
    callback pane-mouse-down(int, length, length, int, int);
    callback pane-mouse-move(int, length, length, int, int);
    callback pane-mouse-up(int, length, length, int, int);
    /// 无按键悬停：只有换格时 Rust 侧才扫描链接并切手型指针。
    callback pane-hover(int, length, length);
    /// 指针离开 pane 的 TouchArea：清掉 hover 手型，避免残留在其它控件上。
    callback pane-unhover(int);
    callback pane-scrolled(int, length, length, length, int);
    /// 滚动条交互：pane id + track 归一化位置（0=顶部/最旧，1=底部/最新）。
    callback pane-scrollbar(int, float);
    /// 拖入文件/目录：Slint 把平台 DataTransfer 原样交给 Rust 解路径。
    pure callback can-drop-files(data-transfer) -> bool;
    callback files-dropped(int, data-transfer);
    callback tab-clicked(int);
    callback tab-closed(int);
    callback new-tab();
    // “+” 下拉：默认新 Tab + 各 Profile
    in-out property <bool> profilemenu-open: false;
    in-out property <length> profilemenu-x: 0px;
    in property <[string]> profilemenu-items: [];
    callback profilemenu-menu();
    callback profilemenu-pick(int);
    callback profilemenu-manage();
    callback resized(length, length);
    callback close-window();
    callback minimize-window();
    callback toggle-maximize();
    callback set-theme(string);
    callback language-changed(string);
    callback tabbar-context(length, length);
    callback tabbar-menu-action(int);
    /// 点击插件状态栏：Rust 执行状态项声明的命令（无 command 时忽略）。
    callback plugin-status-clicked();
    in-out property <bool> tabmenu-open: false;
    in-out property <length> tabmenu-x: 0px;
    in-out property <length> tabmenu-y: 32px;
    // 关闭确认弹窗
    in-out property <bool> confirm-open: false;
    in-out property <string> confirm-text: "";
    callback confirm-accept();
    callback confirm-cancel();
    // Tab 重命名：内联输入框（Enter 提交 / Esc 取消）
    in-out property <bool> rename-open: false;
    in-out property <string> rename-text: "";
    in-out property <int> rename-index: -1;
    callback tab-rename(int);
    callback rename-committed(int, string);
    callback rename-cancelled();
    // 设置项开关状态（由 Rust 侧从 Config 下发）
    in-out property <bool> cfg-copy-on-select: true;
    in-out property <bool> cfg-confirm-close: true;
    /// 启动时自动恢复上次退出快照（默认关 = 保持旧行为）。
    in-out property <bool> cfg-restore-session: false;
    in-out property <bool> cfg-confirm-paste: true;
    in-out property <string> cfg-right-click: "menu";
    in-out property <bool> cfg-paste-middle: true;
    in-out property <bool> cfg-desktop-notifications: true;
    in-out property <bool> cfg-visual-bell: true;
    in-out property <bool> cfg-audible-bell: false;
    in-out property <bool> cfg-scroll-output: false;
    in-out property <bool> cfg-scroll-keystroke: true;
    /// Sixel 内联图片（默认开）；关闭后 DA1 不再宣告、已有图片清除。
    in-out property <bool> cfg-sixel: true;
    /// Sixel 图片是否随滚动历史移动（默认开）。
    in-out property <bool> cfg-sixel-scrolling: true;
    /// iTerm2 IIP（OSC 1337 File）内联图片（默认开）；关闭后已有 IIP 图片清除。
    in-out property <bool> cfg-iip: true;
    in-out property <bool> cfg-scrollback-unlimited: false;
    /// "always" | "auto" | "never"
    in-out property <string> cfg-scrollbar-policy: "auto";
    /// "ascii-delete" | "control-h"
    in-out property <string> cfg-backspace-binding: "ascii-delete";
    /// "delete-sequence" | "ascii-del" | "control-h"
    in-out property <string> cfg-delete-binding: "delete-sequence";
    in-out property <bool> cfg-quake: false;
    // GNOME Terminal 外观：光标（形状/闪烁/颜色）+ 粗体
    in-out property <string> cfg-cursor-shape: "block";
    in-out property <string> cfg-cursor-blink: "system";
    in-out property <string> cfg-cursor-color: "";
    in-out property <string> cfg-cursor-text-color: "";
    in-out property <bool> cfg-bold-is-bright: true;
    in-out property <string> cfg-bold-color: "";
    in-out property <bool> cfg-bold-color-same-as-fg: true;
    callback set-cursor-shape(string);
    callback set-cursor-blink(string);
    callback cursor-color-changed(string);
    callback cursor-text-color-changed(string);
    callback toggle-bold-is-bright();
    callback bold-color-changed(string);
    callback toggle-bold-color-same-as-fg();
    in-out property <bool> broadcast: false;
    callback toggle-copy-on-select();
    callback toggle-confirm-close();
    callback toggle-restore-session();
    callback toggle-confirm-paste();
    callback set-right-click(string);
    callback toggle-paste-middle();
    callback toggle-desktop-notifications();
    callback toggle-visual-bell();
    callback toggle-audible-bell();
    callback toggle-scroll-output();
    callback toggle-scroll-keystroke();
    callback toggle-sixel();
    callback toggle-sixel-scrolling();
    callback toggle-iip();
    callback toggle-scrollback-unlimited();
    callback set-scrollbar-policy(string);
    callback set-backspace-binding(string);
    callback set-delete-binding(string);
    callback toggle-quake();
    // 多行粘贴确认
    in-out property <bool> paste-open: false;
    in-out property <string> paste-preview: "";
    in-out property <int> paste-lines: 0;
    callback paste-accept();
    callback paste-always();
    callback paste-cancel();
    callback settings-toggled(bool);
    // Profiles（连接配置）
    in-out property <bool> profiles-open: false;
    in property <[ProfileRow]> profile-items: [];
    /// 搜索框内容：输入即按 name/host/kind 过滤；清空恢复全部。
    in-out property <string> profile-query: "";
    /// 面板底部提示：新 Tab 默认使用的 Profile（或系统 shell）。
    in property <string> profile-default-info: "";
    callback profile-open(int);
    callback profile-new();
    callback profile-delete(int);
    callback profile-set-default(int);
    callback profile-duplicate(int);
    callback profile-filter(string);
    callback profiles-close();
    // Profile 表单（新建）
    in-out property <bool> profile-form-open: false;
    in-out property <string> form-name: "";
    /// 0=local 1=ssh 2=serial 3=telnet
    in-out property <int> form-kind: 0;
    in-out property <string> form-shell: "";
    in-out property <string> form-args: "";
    in-out property <string> form-cwd: "";
    in-out property <string> form-host: "";
    in-out property <string> form-port: "";
    in-out property <string> form-user: "";
    in-out property <string> form-auth: "";
    in-out property <string> form-key: "";
    /// 仅 auth=password 时使用；不回填已有密码，空 = 保留 Vault 原值。
    in-out property <string> form-password: "";
    in-out property <bool> form-save-password: false;
    in-out property <string> form-extra: "";
    /// 本地转发（-L），空格分隔。
    in-out property <string> form-forwards: "";
    /// 远程转发（-R），空格分隔。
    in-out property <string> form-remote-forwards: "";
    /// 动态转发（-D），空格分隔。
    in-out property <string> form-dynamic-forwards: "";
    /// ProxyJump（-J）；空 = 直连。
    in-out property <string> form-proxy-jump: "";
    in-out property <bool> form-agent-forward: false;
    /// -1 = 新建；>0 = 正在编辑的 Profile ID
    in-out property <int> form-edit-id: -1;
    callback profile-edit(int);
    in-out property <string> form-serial-port: "";
    in-out property <string> form-baud: "";
    // 外观（可选；空 = 继承全局）：字号 / 主题 / 光标形状 / 闪烁 / 滚动历史。
    in-out property <string> form-font-size: "";
    in-out property <string> form-theme: "";
    in-out property <string> form-cursor-shape: "";
    in-out property <string> form-cursor-blink: "";
    in-out property <string> form-scrollback: "";
    in-out property <string> form-error: "";
    callback profile-form-save();
    callback profile-form-cancel();
    // known_hosts 主机密钥预检（首次/变更时弹出，绝不静默信任）
    in-out property <bool> hostkey-open: false;
    /// checking | unknown | changed | unverifiable
    in-out property <string> hostkey-mode: "checking";
    in-out property <string> hostkey-title: "";
    in-out property <string> hostkey-detail: "";
    in-out property <string> hostkey-error: "";
    callback hostkey-trust();
    callback hostkey-once();
    callback hostkey-cancel();
    // SSH 会话结束提示 + 重连（不自动改写用户默认行为）
    in-out property <bool> ssh-exit-open: false;
    in-out property <string> ssh-exit-text: "";
    in-out property <bool> ssh-exit-reconnectable: false;
    callback ssh-exit-reconnect();
    callback ssh-exit-dismiss();
    // SFTP 面板
    in-out property <bool> sftp-open: false;
    in property <[string]> sftp-profiles: [];
    in property <[string]> sftp-items: [];
    in-out property <int> sftp-profile: 0;
    in-out property <string> sftp-remote: "/";
    in-out property <string> sftp-local: "/tmp/tervo-sftp";
    in-out property <string> sftp-target: "";
    /// 选中条目的 chmod 权限（八进制，如 644）。
    in-out property <string> sftp-mode: "644";
    in-out property <int> sftp-selected: -1;
    in-out property <string> sftp-status: "";
    /// 上传/下载队列（最多展示 3 行 + 失败重试行）。
    in-out property <[string]> sftp-queue: [];
    in-out property <int> sftp-queue-count: 0;
    in-out property <bool> sftp-retry-available: false;
    in-out property <bool> sftp-op-active: false;
    // 传输进行中：显示当前文件 + 进度（-1 = 不确定）+ Cancel；操作按钮暂时禁用。
    in-out property <bool> sftp-transfer-active: false;
    in property <string> sftp-transfer-name: "";
    in property <int> sftp-transfer-percent: -1;
    in property <string> sftp-transfer-detail: "";
    callback sftp-list();
    callback sftp-pick(int);
    callback sftp-download();
    callback sftp-upload();
    callback sftp-mkdir();
    callback sftp-rename();
    callback sftp-delete();
    callback sftp-chmod();
    callback sftp-cancel();
    callback sftp-retry();
    callback sftp-clear-queue();
    callback sftp-close();
    // Port Forwards 面板
    in-out property <bool> fwd-open: false;
    in property <[string]> fwd-profiles: [];
    in property <[string]> fwd-items: [];
    in-out property <int> fwd-profile: 0;
    in-out property <string> fwd-new: "";
    in-out property <string> fwd-status: "";
    callback fwd-select(int);
    callback fwd-add();
    callback fwd-delete(int);
    callback fwd-close();
    // 后台会话列表
    in-out property <bool> bg-open: false;
    in property <[string]> background-items: [];
    callback bg-reattach(int);
    callback bg-close();
    // Command Palette
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query: "";
    in property <[string]> palette-items: [];
    in-out property <int> palette-selected: 0;
    // Tab 搜索（Chrome 风格，最左侧按钮）
    in-out property <bool> tabsearch-open: false;
    in-out property <string> tabsearch-query: "";
    in property <[string]> tabsearch-items: [];
    in-out property <int> tabsearch-selected: 0;
    /// 结果列表视口高度：最多 10 行，超出后在面板内部滚动。
    property <length> tabsearch-list-height: Math.min(260px,
        Math.max(26px, root.tabsearch-items.length * 26px));
    /// 结果列表滚动位置（负数向上滚）；键盘选择/滚轮/拖拽都改这里。
    in-out property <length> tabsearch-scroll-y: 0px;
    changed tabsearch-selected => { root.tabsearch-reveal(); }
    callback tabsearch-open-requested();
    callback tabsearch-query-changed(string);
    callback tabsearch-move(int);
    callback tabsearch-accept();
    callback tabsearch-cancel();
    callback tabsearch-pick(int);
    callback palette-query-changed(string);
    callback palette-move(int);
    callback palette-accept();
    callback palette-cancel();
    callback palette-pick(int);
    // Tab 拖拽排序：按下记起点，抬起按 x 落位
    property <int> drag-tab: -1;
    property <length> drag-x: 0px;
    property <length> drag-start: 0px;
    callback tab-reorder(int, length, length);
    // 单个 Tab 的右键菜单（窗口坐标）
    in-out property <bool> tabctx-open: false;
    in-out property <length> tabctx-x: 0px;
    in-out property <int> tabctx-index: -1;
    callback tab-context(int, length);
    callback tab-menu-action(int, int);
    /// 绑定到 Window 内置的 always-on-top
    property <bool> pinned: false;
    callback bump-font-size(int);
    callback bump-scrollback(int);
    in-out property <bool> settings-open: false;
    /// Settings Tab 是否仍存在于标签栏。settings-open=false 但 tab-open=true
    /// 表示用户切到了终端：设置只 suspend，不销毁；点齿轮 Tab 可回来。
    in-out property <bool> settings-tab-open: false;
    in property <string> theme-name: "auto";
    /// 主题下拉显示名（Auto 时带解析结果），由 Rust 侧随实际主题一起下发。
    in property <string> theme-display: Lang.t("Auto", "自动");
    /// Auto 主题当前解析到的主题短名（如 "Yaru Dark"）；非 auto 时为空。
    in property <string> auto-resolved: "";
    in property <[ThemeChoice]> theme-choices: [];
    /// 窗口底层背景图。Rust 侧只在路径校验/解码成功后置 has-background-image。
    in property <image> background-image;
    in property <bool> has-background-image: false;
    in-out property <string> background-image-path: "";
    in property <string> background-image-error: "";
    /// resize 拖动期间临时隐藏大背景图：避免 Skia/GPU 每帧重新 cover 缩放整张大图。
    /// 停下 200ms 后自动恢复；终端字符帧仍是 1:1，不会拉伸。
    in-out property <bool> background-suspended: false;
    /// 背景图之上的暗化遮罩（0.0–0.8，默认 0.6）：只压暗图片，不碰文字/面板。
    in-out property <float> background-dim: 0.6;
    /// 终端默认背景不透明度（0.0–1.0）：0 = 完全透出背景图，1 = 主题纯色。
    /// 实际 alpha 由 Rust 渲染器写入帧缓冲；无图时 Rust 强制按 1.0 渲染。
    in-out property <float> background-opacity: 1.0;
    callback background-image-changed(string);
    /// 回车/失焦提交：非法路径在这里报错（输入过程中不闪红字）。
    callback background-image-commit(string);
    callback background-opacity-preview(float);
    callback background-opacity-changed(float);
    callback background-dim-preview(float);
    callback background-dim-changed(float);
    /// 设置分类：0=Appearance 1=Terminal 2=Window 3=Advanced 4=Keys 5=Plugins 6=Vault 7=Profiles
    in-out property <int> settings-category: 0;
    in-out property <string> settings-path: "";
    in-out property <string> settings-query: "";
    in property <[string]> settings-results: [];
    /// 搜索结果点击后要滚动/高亮的卡片锚点（theme/background/cursor/...）。
    in-out property <string> settings-focus: "";
    /// Rust 每次跳转自增；Slint 在 changed 里把 Flickable 滚到锚点。
    in-out property <int> settings-jump-token: 0;
    /// 叠在设置页上的模态关闭后自增；设置 FocusScope 收到后重新拿焦点。
    in-out property <int> settings-refocus-token: 0;
    /// 主题下拉是否展开（面板级浮层，避免 Flickable 裁剪）。
    in-out property <bool> settings-theme-open: false;
    /// TERVO_SETTINGS_LEGACY=1：退回居中 modal；默认 false = 窗口内 Settings Tab。
    in property <bool> settings-legacy: false;
    callback settings-filter(string);
    callback settings-open-result(int);
    callback settings-category-changed(int);
    callback settings-manage-profiles();
    in property <string> hotkey-summary: "";
    in property <[HotkeyRow]> hotkey-rows: [];
    /// 正在录制的行下标；-1 = 未录制
    in-out property <int> hotkey-recording-row: -1;
    in property <int> hotkey-conflict-count: 0;
    in-out property <string> hotkey-error: "";
    in-out property <string> hotkey-status: "";
    callback hotkey-start-edit(int);
    callback hotkey-cancel-edit();
    callback hotkey-reset(int);
    callback hotkey-reset-all();
    in property <[string]> plugin-items: [];
    in property <string> plugin-summary: "";
    in property <string> plugin-dir: "";
    // 最近插件命令/事件活动（新→旧，最多 8 条；只读展示）
    in property <[string]> plugin-activity-items: [];
    in-out property <string> config-status: "";
    // Vault（加密凭据）
    in-out property <string> vault-status: "";
    /// true = 后台 Argon2id 正在跑；设置页仍可重绘/滚动，按钮由 Rust 侧防重入。
    in-out property <bool> vault-busy: false;
    in-out property <string> vault-path: "";
    in-out property <int> vault-entries: 0;
    in-out property <string> vault-password: "";
    in-out property <string> vault-error: "";
    in-out property <string> vault-notice: "";
    callback vault-set-master();
    callback vault-unlock();
    callback vault-lock();
    callback vault-clear();
    callback config-import-tabby();
    callback config-export-tabby();
    callback settings-open-path();
    /// 录制结束/关闭设置后把键盘焦点还给终端 IME 宿主，否则按键会丢失。
    public function focus-terminal() {
        ime.focus();
    }

    /// 切到终端：设置 Tab 留在标签栏，只隐藏内容，不销毁状态。
    public function suspend-settings() {
        if (root.settings-open) {
            root.settings-open = false;
            root.settings-theme-open = false;
            root.settings-toggled(false);
        }
    }

    /// 从标签栏点回 Settings Tab。
    public function resume-settings() {
        if (root.settings-tab-open && !root.settings-open) {
            root.settings-open = true;
            root.settings-theme-open = false;
            root.settings-toggled(true);
        }
    }

    /// 真正关闭（✕ / Settings Tab × / Esc）。只有这里销毁 Tab。
    public function close-settings() {
        if (root.settings-open || root.settings-tab-open) {
            root.settings-open = false;
            root.settings-tab-open = false;
            root.settings-query = "";
            root.settings-theme-open = false;
            root.settings-focus = "";
            root.settings-toggled(false);
        }
    }

    changed settings-open => {
        if (root.settings-open) {
            root.settings-tab-open = true;
        }
    }

    /// 让设置 Tab 在 TabBar 横向滚动时保持可见（Tab 多时贴最右端）。
    public function reveal-settings-tab() {
        if (root.settings-tab-open && tab-flick.content-width > tab-flick.width) {
            tab-flick.content-x = Math.min(0px, tab-flick.width - tab-flick.content-width);
        }
    }

    /// 记录活动 Tab 在滚动内容里的位置；切换/增删/宽度动画时调用。
    public function note-active-tab(left: length, width: length, last: bool) {
        root.active-tab-left = left;
        root.active-tab-width = width;
        root.active-tab-last = last;
        root.reveal-active-tab();
    }

    /// 把活动 Tab（若为最后一个，连同 +/Profile）滚进视口；只写 content-x，
    /// 不建立绑定，用户仍可拖拽/滚轮自由滚动。
    public function reveal-active-tab() {
        if (root.active-tab-width > 0px) {
            let view = tab-flick.width;
            let margin = 8px;
            let left = root.active-tab-left;
            let right = left + root.active-tab-width + (root.active-tab-last ? 58px : 0px);
            let visible-left = -tab-flick.content-x;
            if (left - margin < visible-left) {
                tab-flick.content-x = -(left - margin);
            } else if (right + margin > visible-left + view) {
                tab-flick.content-x = -(right + margin - view);
            }
            let min-x = Math.min(0px, view - tab-flick.content-width);
            tab-flick.content-x = Math.max(min-x, Math.min(0px, tab-flick.content-x));
        }
    }

    /// 搜索浮层结果列表：让 ↑↓ 选中的行保持在视口内。
    public function tabsearch-reveal() {
        if (root.tabsearch-open) {
            let h = root.tabsearch-list-height;
            let top = root.tabsearch-selected * 26px;
            let visible-top = -root.tabsearch-scroll-y;
            if (top < visible-top) {
                root.tabsearch-scroll-y = -top;
            } else if (top + 26px > visible-top + h) {
                root.tabsearch-scroll-y = h - top - 26px;
            }
            let content-h = Math.max(26px, root.tabsearch-items.length * 26px);
            let min-y = Math.min(0px, h - content-h);
            root.tabsearch-scroll-y = Math.max(min-y, Math.min(0px, root.tabsearch-scroll-y));
        }
    }
    in property <int> font-size: 15;
    in property <int> scrollback: 2000;
    in-out property <bool> search-open: false;
    in-out property <string> search-query: "";
    in property <string> search-status: "";
    in property <bool> search-match-case: false;
    in property <bool> search-regex: false;
    /// 非法 regex：搜索框描边变红，状态文字显示 invalid regex。
    in property <bool> search-error: false;
    callback search-toggle-case();
    callback search-toggle-regex();
    /// TextInput 编辑（键入/退格/粘贴/鼠标插入）后同步文本并重新搜索。
    callback search-edited();
    /// Enter / Shift+Enter：向前 / 向后继续搜索。
    callback search-next(bool);
    /// Esc：关闭搜索条并把焦点还给终端。
    callback search-close();

    // Save Contents：Slint 1.18 没有原生文件对话框，这里用显式路径输入 + 错误提示。
    in-out property <bool> save-open: false;
    in-out property <string> save-path: "";
    in-out property <string> save-status: "";
    callback save-commit(string);
    callback save-cancel();
    /// IME 候选窗锚点：聚焦 pane 光标的像素位置（内容区坐标，由 Rust 侧更新）。
    in-out property <length> ime-x: 0px;
    in-out property <length> ime-y: 0px;

    /// 窗口标题：CLI --title 覆盖；默认保持原品牌名。
    in-out property <string> window-title: "Tervo";

    title: root.window-title;
    // 不让内容（长 Tab 标题/很多 Tab）决定窗口最小宽度：否则加 Tab 会把窗口撑大。
    min-width: 240px;
    min-height: 160px;
    background: Palette.colors.surface;
    no-frame: true;
    always-on-top: root.pinned;
    icon: @image-url("../../../assets/icon.png");

    changed width => { root.resized(root.width, root.height); }
    changed height => { root.resized(root.width, root.height); }

    // TabBar 位置可切（上/下）：用绝对定位而不是 VerticalLayout，
    // 否则元素的布局顺序没法在运行时反转。
    in-out property <bool> tabbar-bottom: false;
    // 最近一次活动 Tab 在滚动内容中的位置（由 Tab 自己上报）。
    property <length> active-tab-left: 0px;
    property <length> active-tab-width: 0px;
    property <bool> active-tab-last: false;
    // Tab 自动收缩：把扣除左侧搜索/品牌、+、Profile、窗口按钮后的宽度均分给 Tab。
    // 52px 是可读下限（标题至少保留几个字符）；再窄就横向滚动，并把活动 Tab 滚进视口。
    property <length> tab-width-cap: Math.max(52px, Math.min(180px,
        (root.width - 266px - 4px * root.tabs.length) / Math.max(1, root.tabs.length)));

    Rectangle {
        width: 100%;
        height: 100%;

        // 窗口最底层：背景图铺满并保持比例裁切（cover）。TabBar/设置面板
        // 仍是不透明的，终端默认背景的不透明度由 Rust 写进帧 alpha。
        Image {
            visible: root.has-background-image && !root.background-suspended;
            width: 100%;
            height: 100%;
            source: root.background-image;
            image-fit: cover;
        }

        // 背景图之上的暗化遮罩：压在图片上、所有内容之下。纯黑半透明，
        // 白块也会被压暗，浅色终端文字才有稳定可读的对比度。
        Rectangle {
            visible: root.has-background-image && !root.background-suspended;
            width: 100%;
            height: 100%;
            background: #000000;
            opacity: root.background-dim;
        }

        // ---------------- 标签栏 ----------------
        Rectangle {
            y: root.tabbar-bottom ? root.height - root.tabbar-height : 0px;
            width: 100%;
            height: root.tabbar-height;
            clip: true;
            // 极轻的上下渐变 + 顶部高光，避免整条纯色的“塑料感”
            background: @linear-gradient(180deg, Palette.colors.surface 0%, Palette.colors.bg 100%);
            horizontal-stretch: 0;

            Rectangle {
                y: 0px;
                width: 100%;
                height: 1px;
                background: #ffffff0d;
            }

            // 底部分隔线
            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Palette.colors.border;
            }

            // 品牌图标
            Image {
                x: 32px;
                y: 6px;
                width: 18px;
                height: 18px;
                source: @image-url("../../../assets/icon-small.png");
                image-fit: contain;
            }

            // 没有原生标题栏：整条标签栏空白处可拖动窗口
            WindowMoveArea {
                width: 100%;
                height: 100%;

                // 双击标题栏 = 最大化 / 还原；右键 = 标签栏菜单（置顶等）
                title-hit := TouchArea {
                    width: 100%;
                    height: 100%;
                    double-clicked => { root.toggle-maximize(); }
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                            root.tabbar-context(
                                title-hit.mouse-x,
                                // 菜单贴在 TabBar 所在的那一侧
                                root.tabbar-bottom ? root.height - root.tabbar-height - 366px : root.tabbar-height,
                            );
                            return EventResult.accept;
                        }
                        EventResult.reject
                    }
                }
            }

            // Tab 条放进 Flickable：视口固定，内容再宽也不会把窗口的 preferred/min 宽度撑大。
            // 支持拖拽和滚轮横向滚动；活动 Tab 变化/窗口变化时自动滚进视口。
            tab-flick := Flickable {
                // 左侧 58px 留给固定的搜索/品牌图标；滚动内容从图标右侧开始，
                // 不会钻到图标下面（活动 Tab 自动 reveal 时也安全）。
                x: 58px;
                y: 0px;
                width: parent.width - 198px;
                height: parent.height;
                interactive: true;
                content-width: tab-strip.preferred-width;
                content-height: parent.height;
                changed width => { root.reveal-active-tab(); }
                // 设置 Tab 追加到末尾：打开时滚到最右，保证齿轮 Tab 可见。
                property <bool> settings-tab-open: root.settings-tab-open;
                changed content-width => { root.reveal-settings-tab(); }
                changed settings-tab-open => { root.reveal-settings-tab(); }

                tab-strip := HorizontalLayout {
                padding-left: 0px;
                padding-right: 8px;
                padding-top: 4px;
                spacing: 4px;
                alignment: start;

                for tab[i] in root.tabs : Rectangle {
                    property <bool> is-active: tab.active
                        && !(root.settings-open && !root.settings-legacy);
                    property <bool> show-status: tab.attention || tab.completed
                        || tab.progress-state == 2 || tab.progress-label != "";
                    // 窄 Tab 不预留整块状态区：状态压成右侧小点，标题优先占满。
                    property <bool> show-status-text: show-status && parent.width >= 64px;
                    property <bool> show-close: tab-hit.has-hover || parent.width >= 84px;
                    height: 22px;
                    // 自动收缩：少量 Tab 按标题宽度，多 Tab 均分可用宽度；
                    // 52px 下限后横向滚动（活动 Tab 会被滚进视口）。
                    width: Math.max(52px, Math.min(root.tab-width-cap, tab-area.preferred-width + 36px));
                    animate width { duration: 140ms; easing: ease-out; }
                    border-radius: 6px;
                    background: is-active
                        ? Palette.colors.bg
                        : (tab-hit.has-hover ? Palette.colors.raise : transparent);
                    animate background, border-color { duration: 140ms; easing: ease-out; }
                    border-width: 1px;
                    border-color: is-active ? Palette.colors.border : transparent;

                    changed is-active => {
                        if (is-active) {
                            root.note-active-tab(self.x, self.width, i == root.tabs.length - 1);
                        }
                    }
                    changed x => {
                        if (is-active) {
                            root.note-active-tab(self.x, self.width, i == root.tabs.length - 1);
                        }
                    }
                    changed width => {
                        if (is-active) {
                            root.note-active-tab(self.x, self.width, i == root.tabs.length - 1);
                        }
                    }

                    // 激活态底部的强调线（Yaru 橙 / 主题 accent）
                    Rectangle {
                        visible: is-active;
                        x: 8px;
                        y: parent.height - 2px;
                        width: parent.width - 16px;
                        height: 2px;
                        border-radius: 1px;
                        background: Palette.colors.accent;
                    }

                    // 进度条：盖在强调线上；错误红、暂停灰、进行中/不确定用 accent。
                    Rectangle {
                        visible: tab.progress-state == 1 || tab.progress-state == 2
                            || tab.progress-state == 3 || tab.progress-state == 4;
                        x: 8px;
                        y: parent.height - 2px;
                        width: parent.width - 16px;
                        height: 2px;
                        border-radius: 1px;
                        background: transparent;

                        Rectangle {
                            width: parent.width * tab.progress-ratio;
                            height: 100%;
                            border-radius: 1px;
                            background: tab.progress-state == 2
                                ? Palette.colors.danger
                                : (tab.progress-state == 4 ? Palette.colors.muted : Palette.colors.accent);
                        }
                    }

                    // 未读通知点（Tab 非活动时由 Rust 置位，切到该 Tab 清除）
                    Text {
                        visible: tab.attention && show-status-text;
                        x: parent.width - 44px;
                        y: 0px;
                        width: 18px;
                        height: 22px;
                        text: "●";
                        color: Palette.colors.accent;
                        font-size: 9px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // 错误标记
                    Text {
                        visible: !tab.attention && tab.progress-state == 2 && show-status-text;
                        x: parent.width - 44px;
                        y: 0px;
                        width: 18px;
                        height: 22px;
                        text: "!";
                        color: Palette.colors.danger;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // 完成标记（进度从有到清除；切 Tab 时清除）
                    Text {
                        visible: !tab.attention && tab.progress-state == 0 && tab.completed
                            && show-status-text;
                        x: parent.width - 44px;
                        y: 0px;
                        width: 18px;
                        height: 22px;
                        text: "✓";
                        color: Palette.colors.accent;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // 百分比文本（有合法 percent 时）
                    Text {
                        visible: !tab.attention && tab.progress-state != 2
                            && !tab.completed && tab.progress-label != ""
                            && show-status-text;
                        x: parent.width - 48px;
                        y: 0px;
                        width: 24px;
                        height: 22px;
                        text: tab.progress-label;
                        color: Palette.colors.muted;
                        font-size: 9px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }

                    // 窄 Tab 的状态压缩为 4px 小点，不挤占标题宽度。
                    Rectangle {
                        visible: show-status && !show-status-text;
                        x: parent.width - 7px;
                        y: 4px;
                        width: 4px;
                        height: 4px;
                        border-radius: 2px;
                        background: tab.attention
                            ? Palette.colors.accent
                            : (tab.progress-state == 2
                                ? Palette.colors.danger
                                : (tab.completed ? Palette.colors.accent : Palette.colors.muted));
                    }

                    tab-area := Text {
                        x: parent.width < 60px ? 5px : 8px;
                        // 窄 Tab 的 close 只在 hover 时覆盖显示，不因 hover 重排标题。
                        width: parent.width - self.x
                            - (show-close && parent.width >= 84px ? 26px : 6px)
                            - (show-status-text ? 22px : 0px);
                        text: tab.title;
                        color: is-active ? Palette.colors.text : Palette.colors.muted;
                        font-size: root.tab-width-cap < 60px ? 10px : 12px;
                        font-weight: is-active ? 600 : 400;
                        overflow: elide;
                        vertical-alignment: center;
                        animate color { duration: 140ms; }
                    }

                    tab-hit := TouchArea {
                        clicked => {
                            root.tabctx-open = false;
                            // 切到终端时设置只 suspend，Settings Tab 保留在标签栏。
                            if (root.settings-open) {
                                root.suspend-settings();
                            }
                            root.tab-clicked(i);
                        }
                        double-clicked => {
                            root.tab-rename(i);
                        }
                        pointer-event(event) => {
                            // 左键拖动：记起点，抬起时把落点交给 Rust 算
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                root.drag-tab = i;
                                root.drag-x = self.mouse-x + parent.x;
                                root.drag-start = root.drag-x;
                                return EventResult.reject;   // 不抢按下，否则 clicked/双击会被吞
                            }
                            if (event.kind == PointerEventKind.move && root.drag-tab == i) {
                                root.drag-x = self.mouse-x + parent.x;
                                return EventResult.accept;
                            }
                            if (event.kind == PointerEventKind.up && root.drag-tab == i) {
                                root.drag-tab = -1;
                                // 只有真的拖动过才接管；否则放行给 clicked / double-clicked
                                if (Math.abs(root.drag-x - root.drag-start) > 6px) {
                                    root.tab-reorder(i, root.drag-x, tab-strip.preferred-width);
                                    return EventResult.accept;
                                }
                                return EventResult.reject;
                            }
                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                // 菜单锚在 Tab 上沿：窗口 x ≈ tabbar 左内边距 + tab 偏移
                                root.tab-context(i, 32px + parent.x);
                                return EventResult.accept;
                            }
                            EventResult.reject
                        }
                    }

                    close-hit := TouchArea {
                        visible: show-close;
                        x: parent.width - 22px;
                        y: 1px;
                        width: 20px;
                        height: 20px;
                        clicked => { root.tab-closed(i); }

                        Rectangle {
                            x: 1px;
                            y: 1px;
                            width: 18px;
                            height: 18px;
                            border-radius: 9px;
                            background: close-hit.has-hover ? Palette.colors.hover : transparent;
                            animate background { duration: 120ms; }
                        }

                        Text {
                            text: "×";
                            color: close-hit.has-hover ? Palette.colors.danger : Palette.colors.muted;
                            font-size: 14px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            width: 100%;
                            height: 100%;
                            animate color { duration: 120ms; }
                        }
                    }
                }

                // Settings Tab：不是 PTY Tab，不进入 workspace；只在打开时出现。
                // 用齿轮图标 + 可关闭 ×，按 Esc/✕/点终端 Tab 都退出。
                if root.settings-tab-open && !root.settings-legacy : Rectangle {
                    height: 22px;
                    width: 112px;
                    border-radius: 6px;
                    background: root.settings-open ? Palette.colors.bg : Palette.colors.raise;
                    border-width: 1px;
                    border-color: root.settings-open ? Palette.colors.border : transparent;

                    Rectangle {
                        x: 8px;
                        y: parent.height - 2px;
                        width: parent.width - 16px;
                        height: 2px;
                        border-radius: 1px;
                        background: root.settings-open ? Palette.colors.accent : transparent;
                    }

                    SettingsIconView {
                        x: 8px;
                        y: 3px;
                        kind: SettingsIconKind.gear;
                        tint: root.settings-open ? Palette.colors.accent : Palette.colors.muted;
                    }

                    Text {
                        x: 28px;
                        width: parent.width - 52px;
                        height: parent.height;
                        text: Lang.t("Settings", "设置");
                        color: root.settings-open ? Palette.colors.text : Palette.colors.muted;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    // 点 Tab 本体从终端返回设置（suspend 后不销毁）。
                    TouchArea {
                        x: 0px;
                        y: 0px;
                        width: parent.width - 22px;
                        height: parent.height;
                        clicked => { root.resume-settings(); }
                    }

                    settings-tab-close := TouchArea {
                        x: parent.width - 22px;
                        y: 1px;
                        width: 20px;
                        height: 20px;
                        clicked => { root.close-settings(); }
                        Rectangle {
                            x: 1px; y: 1px; width: 18px; height: 18px;
                            border-radius: 9px;
                            background: settings-tab-close.has-hover ? Palette.colors.hover : transparent;
                        }
                        Text {
                            text: "×";
                            color: settings-tab-close.has-hover ? Palette.colors.danger : Palette.colors.muted;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }

                Rectangle {
                    height: 22px;
                    width: 24px;
                    border-radius: 5px;
                    background: new-hit.has-hover ? Palette.colors.raise : transparent;
                    animate background { duration: 120ms; }

                    new-hit := TouchArea {
                        clicked => {
                            if (root.settings-open) {
                                root.suspend-settings();
                            }
                            root.new-tab();
                        }
                    }

                    Text {
                        text: "+";
                        color: Palette.colors.text;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                // Profile 选择器：独立图标（Tabby 风格），不在 + 的下拉里
                Rectangle {
                    height: 22px;
                    width: 26px;
                    border-radius: 5px;
                    background: profile-menu-hit.has-hover ? Palette.colors.raise : transparent;
                    animate background { duration: 120ms; }

                    profile-menu-hit := TouchArea {
                        clicked => {
                            if (root.settings-open) {
                                root.suspend-settings();
                            }
                            root.profilemenu-x = self.absolute-position.x;
                            root.profilemenu-open = true;
                            root.profilemenu-menu();
                        }
                    }

                    Text {
                        text: ">_";
                        color: Palette.colors.subtext;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
            }

            // 横向滚动条：仅在 Tab + 按钮溢出时出现，提示可拖拽/滚轮滚动。
            Rectangle {
                property <length> bar-w: Math.min(tab-flick.width - 4px,
                    Math.max(18px,
                        tab-flick.width * tab-flick.width / Math.max(1px, tab-flick.content-width)));
                visible: tab-flick.content-width > tab-flick.width + 1px;
                x: 59px + (-tab-flick.content-x)
                    / Math.max(1px, tab-flick.content-width - tab-flick.width)
                    * Math.max(0px, tab-flick.width - self.bar-w - 2px);
                y: parent.height - 3px;
                width: self.bar-w;
                height: 2px;
                border-radius: 1px;
                background: Palette.colors.muted;
            }

        // 最左侧 Tab 搜索按钮（Chrome 风格）：搜索当前窗口所有 Tab
        Rectangle {
            x: 4px;
            y: 4px;
            width: 24px;
            height: 24px;
            border-radius: 5px;
            background: tabsearch-btn.has-hover ? Palette.colors.hover : Palette.colors.raise;
            animate background { duration: 120ms; }

            tabsearch-btn := TouchArea {
                clicked => {
                    root.tabsearch-query = "";
                    root.tabsearch-open = true;
                    root.tabsearch-open-requested();
                }
            }

            // 手绘放大镜：圆环 + 45° 手柄，避免依赖字体里是否有 "⌕"。
            Rectangle {
                x: 6px;
                y: 5px;
                width: 10px;
                height: 10px;
                border-radius: 5px;
                border-width: 1.5px;
                border-color: Palette.colors.text;
                background: transparent;
            }
            Rectangle {
                x: 15px;
                y: 14px;
                width: 7px;
                height: 7px;
                background: transparent;

                Path {
                    width: 100%;
                    height: 100%;
                    commands: "M 0 0 L 5 5";
                    stroke: Palette.colors.text;
                    stroke-width: 1.5px;
                    stroke-line-cap: round;
                }
            }
        }

        // 设置
        win-gear := TouchArea {
            x: parent.width - 132px;
            y: 4px;
            width: 28px;
            height: 24px;
            clicked => {
                if (root.settings-open) {
                    root.close-settings();
                } else if (root.settings-tab-open) {
                    root.resume-settings();
                } else {
                    root.settings-open = true;
                    root.settings-tab-open = true;
                    root.settings-toggled(true);
                }
            }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 5px;
                background: root.settings-open
                    ? Palette.colors.hover
                    : (win-gear.has-hover ? Palette.colors.hover : Palette.colors.raise);
                SettingsIconView {
                    x: 6px;
                    y: 4px;
                    kind: SettingsIconKind.gear;
                    tint: root.settings-open ? Palette.colors.accent : Palette.colors.text;
                }
            }
        }

        // 窗口按钮（无边框后必须自带）
        win-min := TouchArea {
            x: parent.width - 100px;
            y: 4px;
            width: 28px;
            height: 24px;
            clicked => { root.minimize-window(); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 5px;
                background: win-min.has-hover ? Palette.colors.hover : Palette.colors.raise;
                Text {
                    text: "─";
                    color: Palette.colors.text;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }

        win-max := TouchArea {
            x: parent.width - 68px;
            y: 4px;
            width: 28px;
            height: 24px;
            clicked => { root.toggle-maximize(); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 5px;
                background: win-max.has-hover ? Palette.colors.hover : Palette.colors.raise;
                Text {
                    text: root.maximized ? "❐" : "□";
                    color: Palette.colors.text;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }

        win-close := TouchArea {
            x: parent.width - 36px;
            y: 4px;
            width: 28px;
            height: 24px;
            clicked => { root.close-window(); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 5px;
                background: win-close.has-hover ? Palette.colors.danger : Palette.colors.raise;

                Text {
                    text: "✕";
                    color: win-close.has-hover ? Palette.colors.bg : Palette.colors.text;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }
        }

        // ---------------- 分屏内容区 ----------------
        Rectangle {
            y: root.tabbar-bottom ? 0px : root.tabbar-height;
            width: 100%;
            height: root.height - root.tabbar-height;
            // 有背景图时让终端帧的透明背景直接透出图片；否则保持主题底色。
            background: root.has-background-image ? transparent : Palette.colors.bg;

            // focus-on-click 必须关掉：否则点击 pane 时 FocusScope 会把焦点
            // 从下面的 TextInput 抢走，输入法（以及所有按键）立刻失效。
            fs := FocusScope {
                width: 100%;
                height: 100%;
                focus-on-click: false;

                // 隐藏的 IME 宿主。Slint 里只有 TextInput 会向 winit 申请输入法
                // 上下文（XIM/fcitx/ibus），中文上屏经由 edited 转发给 PTY。
                // 放在 pane 之前，保证鼠标事件仍由 pane 的 TouchArea 接收。
                ime := TextInput {
                    x: root.ime-x;
                    y: root.ime-y;
                    width: 2px;
                    height: 2px;
                    text: "";
                    single-line: true;
                    color: transparent;
                    selection-foreground-color: transparent;
                    selection-background-color: transparent;
                    text-cursor-width: 0px;
                    init => { self.focus(); }

                    key-pressed(event) => {
                        // 拼音组合中：回车=上屏候选、退格=删拼音、Esc=取消，
                        // 这些键归输入法，一个字节都不能写进 PTY
                        //（这正是之前“回车没用 / 键盘像失灵”的根源）。
                        if (self.preedit-text != "") {
                            return EventResult.reject;
                        }
                        if (event.text == "\u{1b}" && (root.menu-open || root.tabmenu-open || root.tabctx-open || root.profilemenu-open)) {
                            root.menu-open = false;
                            root.tabmenu-open = false;
                            root.tabctx-open = false;
                            root.profilemenu-open = false;
                            root.menu-dismissed();
                            return EventResult.accept;
                        }
                        root.key-input(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta, event.repeat);
                        EventResult.accept
                    }

                    // 只有应用请求了 kitty REPORT_EVENT_TYPES 才会真正写 PTY；
                    // Rust 侧用 press 登记表过滤快捷键/搜索框，普通 shell 零变化。
                    key-released(event) => {
                        if (self.preedit-text != "") {
                            return EventResult.reject;
                        }
                        root.key-release(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                        EventResult.accept
                    }

                    // 输入法提交（中文、emoji 等）；TextInput 的 text 只当提交缓冲区用。
                    edited => {
                        if (self.text != "") {
                            root.ime-commit(self.text);
                            self.text = "";
                        }
                    }
                }

                for p in root.panes : Rectangle {
                    x: p.x;
                    y: p.y;
                    width: p.w;
                    height: p.h;
                    background: root.has-background-image ? transparent : Palette.colors.bg;
                    clip: true;
                    // 多分屏时用 1px accent 边框标出输入焦点；单 pane 不画，避免常驻边框。
                    border-width: (p.focused && root.panes.length > 1) ? 1px : 0px;
                    border-color: Palette.colors.accent;

                    // 网格像素宽高是 cell 的整数倍，pane 右侧/底部可能余下不到一格。
                    // 这里用“主题底色 + 同样的 opacity”补齐，和终端默认背景的混合结果一致；
                    // 不能给整块 pane 铺这个半透明色，否则帧图下会二次叠 alpha。
                    if root.has-background-image : Rectangle {
                        x: p.iw;
                        width: p.w - p.iw;
                        height: p.ih;
                        background: Palette.colors.bg.with-alpha(root.background-opacity);
                    }
                    if root.has-background-image : Rectangle {
                        y: p.ih;
                        width: p.w;
                        height: p.h - p.ih;
                        background: Palette.colors.bg.with-alpha(root.background-opacity);
                    }

                    Image {
                        source: p.image;
                        // 必须显式钉在左上角：Slint 对未写 x/y 且小于父级的元素会居中，
                        // 窗口尺寸除不尽 cell 时会露出左侧/顶部一条未混合的原图。
                        x: 0px;
                        y: 0px;
                        // 始终 1:1；拖动时由 16ms 节流的实时重排保证字符清晰，不拉伸。
                        width: p.iw;
                        height: p.ih;
                    }

                    // Sixel overlay：独立图片层，绝对定位；pane 的 clip 负责裁掉
                    // 滚出视口/超出网格的部分。图片不进终端帧、不参与选区。
                    for pic in p.images : Image {
                        source: pic.image;
                        x: pic.x;
                        y: pic.y;
                        width: pic.w;
                        height: pic.h;
                    }

                    // Read Only 角标：不拦截鼠标事件，选区/滚动照常工作。
                    if p.read-only : Rectangle {
                        x: Math.max(6px, p.w - 76px);
                        y: 6px;
                        width: 68px;
                        height: 18px;
                        border-radius: 4px;
                        background: Palette.colors.raise.with-alpha(0.92);
                        border-width: 1px;
                        border-color: Palette.colors.accent;

                        Text {
                            text: "READ ONLY";
                            color: Palette.colors.accent;
                            font-size: 9px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }

                    // 光标单独成层：闪烁只切 visible，不重绘/重传整屏终端帧。
                    if p.cursor-visible : Image {
                        source: p.cursor-image;
                        x: p.cursor-x;
                        y: p.cursor-y;
                        width: p.cursor-w;
                        height: p.cursor-h;
                    }

                    pane-hit := TouchArea {
                        // 链接 hover：Rust 按格识别后写 p.link-hover；只在悬停状态变化时
                        // 切换系统指针，不重绘终端帧。离开 TouchArea 时由 changed 清理。
                        mouse-cursor: p.link-hover ? pointer : default;
                        changed has-hover => {
                            if (!pane-hit.has-hover) {
                                root.pane-unhover(p.id);
                            }
                        }
                        // 修饰键位：1=Shift 2=Alt 4=Ctrl，由 Rust 侧解码成 xterm 位掩码。
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                if (event.button == PointerEventButton.right) {
                                    root.input-trace(
                                        event.modifiers.shift ? "pane-down-right-shift" : "pane-down-right",
                                        p.id, pane-hit.mouse-x, pane-hit.mouse-y);
                                }
                                if (event.button == PointerEventButton.left) {
                                    ime.focus();
                                    root.pane-clicked(p.id);
                                    root.pane-mouse-down(p.id, pane-hit.mouse-x, pane-hit.mouse-y, 0,
                                        (event.modifiers.shift ? 1 : 0) + (event.modifiers.alt ? 2 : 0) + (event.modifiers.control ? 4 : 0));
                                    return EventResult.accept;
                                }
                                // 中键：Tabby 语义，始终由 Tervo 处理（配置开启时粘贴），不转发给 TUI。
                                if (event.button == PointerEventButton.middle) {
                                    ime.focus();
                                    root.pane-clicked(p.id);
                                    root.pane-middle-click(p.id);
                                    return EventResult.accept;
                                }
                                // mouse-reporting TUI（dsh-tui/vim/tmux）普通右键先给 TUI：
                                // dsh-tui 用 SGR button 2 的 contextmenu，如果这里拦成本地
                                // 菜单，侧栏右键就会失效。Tervo 菜单改用 Shift+右键。
                                if (p.mouse-reporting
                                    && event.button == PointerEventButton.right
                                    && !event.modifiers.shift) {
                                    root.input-trace("pane-right-forward", p.id,
                                        pane-hit.mouse-x, pane-hit.mouse-y);
                                    ime.focus();
                                    root.pane-clicked(p.id);
                                    root.pane-mouse-down(p.id, pane-hit.mouse-x, pane-hit.mouse-y, 2,
                                        (event.modifiers.shift ? 1 : 0) + (event.modifiers.alt ? 2 : 0) + (event.modifiers.control ? 4 : 0));
                                    return EventResult.accept;
                                }
                                // Shift+右键（或非上报模式）打开 Tervo 菜单。
                                // 非上报模式：右键在“按下”时开菜单并 accept。
                                // 之前只在 up 开：down 被 reject 时 Slint 不保证把 up 再送给本 TouchArea，
                                // 鼠标轻微移动/经过分隔线就会丢事件，表现为“有时候右键唤不出菜单”。
                                if (event.button == PointerEventButton.right) {
                                    ime.focus();
                                    root.pane-clicked(p.id);
                                    root.pane-right-clicked(p.id, p.x + pane-hit.mouse-x, p.y + pane-hit.mouse-y);
                                    return EventResult.accept;
                                }
                            }
                            if (event.kind == PointerEventKind.move) {
                                // 按键拖动/1003 上报之前先做无按键 hover 识别；Rust 按格去重，
                                // 同一格内移动不会重复扫描。悬停状态变化只更新指针，不重绘终端。
                                root.pane-hover(p.id, pane-hit.mouse-x, pane-hit.mouse-y);
                                // 按住拖动 + 1003 悬停都走这里；是否真的上报由 Rust 按模式位过滤。
                                if (pane-hit.pressed || p.mouse-reporting) {
                                    root.pane-mouse-move(p.id, pane-hit.mouse-x, pane-hit.mouse-y, 0,
                                        (event.modifiers.shift ? 1 : 0) + (event.modifiers.alt ? 2 : 0) + (event.modifiers.control ? 4 : 0));
                                    return EventResult.accept;
                                }
                            }
                            if (event.kind == PointerEventKind.up) {
                                if (event.button == PointerEventButton.right) {
                                    root.input-trace("pane-up-right", p.id,
                                        pane-hit.mouse-x, pane-hit.mouse-y);
                                }
                                if (event.button == PointerEventButton.left) {
                                    root.pane-mouse-up(p.id, pane-hit.mouse-x, pane-hit.mouse-y, 0,
                                        (event.modifiers.shift ? 1 : 0) + (event.modifiers.alt ? 2 : 0) + (event.modifiers.control ? 4 : 0));
                                    return EventResult.accept;
                                }
                                if (event.button == PointerEventButton.middle) {
                                    return EventResult.accept;
                                }
                                if (p.mouse-reporting
                                    && event.button == PointerEventButton.right
                                    && !event.modifiers.shift) {
                                    root.pane-mouse-up(p.id, pane-hit.mouse-x, pane-hit.mouse-y, 2,
                                        (event.modifiers.shift ? 1 : 0) + (event.modifiers.alt ? 2 : 0) + (event.modifiers.control ? 4 : 0));
                                    return EventResult.accept;
                                }
                                if (event.button == PointerEventButton.right) {
                                    // 抬起交给 Rust：menu 模式在按下已弹菜单；paste/clipboard
                                    // 用抬起时间判断短按/长按（<250ms 粘贴，否则弹菜单）。
                                    root.pane-right-up(p.id, p.x + pane-hit.mouse-x, p.y + pane-hit.mouse-y);
                                    return EventResult.accept;
                                }
                            }
                            EventResult.reject
                        }
                        scroll-event(event) => {
                            // 1000/1002/1003 下滚轮要上交给应用（tmux/vim 翻页），否则本地回滚。
                            root.pane-scrolled(p.id, event.delta-y, pane-hit.mouse-x, pane-hit.mouse-y,
                                (event.modifiers.shift ? 1 : 0) + (event.modifiers.alt ? 2 : 0) + (event.modifiers.control ? 4 : 0));
                            EventResult.accept
                        }
                    }

                    // ---------------- 视觉铃（只画边框，不遮挡终端） ----------------
                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        background: transparent;
                        border-width: p.bell-flash ? 2px : 0px;
                        border-color: Palette.colors.accent;
                        opacity: p.bell-flash ? 1.0 : 0.0;
                        animate opacity { duration: 160ms; easing: ease-out; }
                        animate border-width { duration: 140ms; easing: ease-out; }
                    }

                    // ---------------- 拖放：文件/目录到 pane ----------------
                    drop := DropArea {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        can-drop(event) => {
                            root.can-drop-files(event.data) ? DragAction.copy : DragAction.none
                        }
                        dropped(event) => {
                            root.files-dropped(p.id, event.data);
                            return event.proposed-action;
                        }
                    }

                    // 拖放 hover 提示：半透明 accent 覆盖 + 边框，不改变命中层。
                    // DropArea 的 has-drag 是 Slint 官方路径；winit 后端下由
                    // drop-hover-pane（原生桥接）承担同样的提示。
                    if drop.has-drag || root.drop-hover-pane == p.id : Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        background: Palette.colors.accent.with-alpha(0.08);
                        border-width: 2px;
                        border-color: Palette.colors.accent;
                    }

                    // ---------------- 滚动条 overlay ----------------
                    // 只有 scrollback 超出视口时出现；track 与终端网格等高，
                    // 不吃掉右侧字符区域的布局（overlay，不改变 pane 尺寸）。
                    if p.scrollbar-visible : Rectangle {
                        // 右侧留 3px 给窗口 resize 命中带（最外 5px），
                        // overlay 本体 9px 宽，thumb 居中偏内。
                        x: p.w - 12px;
                        y: 0px;
                        width: 9px;
                        height: p.scrollbar-track-h;
                        background: transparent;

                        sb-hit := TouchArea {
                            property <bool> dragging: false;
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            height: 100%;

                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down
                                    && event.button == PointerEventButton.left) {
                                    self.dragging = true;
                                    root.pane-scrollbar(p.id, Math.max(0.0,
                                        Math.min(1.0, self.mouse-y / p.scrollbar-track-h)));
                                    return EventResult.accept;
                                }
                                if (event.kind == PointerEventKind.move && self.dragging) {
                                    root.pane-scrollbar(p.id, Math.max(0.0,
                                        Math.min(1.0, self.mouse-y / p.scrollbar-track-h)));
                                    return EventResult.accept;
                                }
                                if (event.kind == PointerEventKind.up) {
                                    self.dragging = false;
                                    return EventResult.accept;
                                }
                                EventResult.reject
                            }
                        }

                        Rectangle {
                            x: 2px;
                            width: 5px;
                            y: p.scrollbar-thumb-y;
                            height: p.scrollbar-thumb-h;
                            border-radius: 3px;
                            background: (sb-hit.has-hover || sb-hit.pressed)
                                ? Palette.colors.accent
                                : Palette.colors.muted.with-alpha(0.8);
                        }
                    }
                }

                // ---------------- 分屏分隔线（可拖拽调整比例） ----------------
                for d in root.dividers : Rectangle {
                    x: d.x;
                    y: d.y;
                    width: d.w;
                    height: d.h;

                    Rectangle {
                        x: d.vertical ? (parent.width - 1px) / 2 : 0px;
                        y: d.vertical ? 0px : (parent.height - 1px) / 2;
                        width: d.vertical ? 1px : parent.width;
                        height: d.vertical ? parent.height : 1px;
                        background: Palette.colors.border;
                    }

                    TouchArea {
                        // 命中区比 1px 线宽 4px，方便抓取
                        x: d.vertical ? -2px : 0px;
                        y: d.vertical ? 0px : -2px;
                        width: d.vertical ? d.w + 4px : d.w;
                        height: d.vertical ? d.h : d.h + 4px;
                        mouse-cursor: d.vertical ? ew-resize : ns-resize;
                        // 只接管左键拖拽。Slint 的 TouchArea 按下会无条件 grab，
                        // 以前这里对任何按键都 accept，右键落在 4px 命中带里就被吞掉，
                        // 表现为「有时候右键呼叫不出菜单」。
                        property <bool> dragging: false;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                if (event.button == PointerEventButton.left) {
                                    self.dragging = true;
                                    return EventResult.accept;
                                }
                                // 右键：占住这次按下，等 up 再开菜单（否则事件不会回落给 pane）
                                return event.button == PointerEventButton.right
                                    ? EventResult.accept
                                    : EventResult.reject;
                            }
                            if (event.kind == PointerEventKind.move && self.dragging) {
                                root.divider-dragged(
                                    d.index,
                                    d.vertical ? d.x - 2px + self.mouse-x : d.x + self.mouse-x,
                                    d.vertical ? d.y + self.mouse-y : d.y - 2px + self.mouse-y,
                                );
                                return EventResult.accept;
                            }
                            if (event.kind == PointerEventKind.up) {
                                self.dragging = false;
                                if (event.button == PointerEventButton.right) {
                                    root.pane-right-clicked-at(
                                        d.vertical ? d.x - 2px + self.mouse-x : d.x + self.mouse-x,
                                        d.vertical ? d.y + self.mouse-y : d.y - 2px + self.mouse-y,
                                    );
                                }
                                return EventResult.accept;
                            }
                            EventResult.reject
                        }
                    }
                }

                // 菜单打开时，点菜单以外的任何地方都先关掉菜单（否则残留菜单会挡住后续右键）。
                // 这层在 pane 之上、菜单之下：菜单项仍然可点。
                if root.menu-open : TouchArea {
                    width: 100%;
                    height: 100%;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            // 左键：关菜单。右键：关掉后在新的位置重新打开，
                            // 避免连续右键时「第二次只是把菜单关掉」看起来像唤不出菜单。
                            let reopen = event.button == PointerEventButton.right;
                            root.menu-open = false;
                            root.menu-dismissed();
                            if (reopen) {
                                root.pane-right-clicked-at(self.mouse-x, self.mouse-y);
                            }
                            return EventResult.accept;
                        }
                        EventResult.reject
                    }
                }

                // ---------------- 右键菜单 ----------------
                // 分类分组（Link / Clipboard / Pane / View / Session）+ 快捷键提示；
                // 无图标，文字与分组标题左对齐。动作 ID 与回调保持原样。
                if root.menu-open : Rectangle {
                    x: root.menu-left;
                    y: root.menu-top;
                    width: root.menu-width;
                    height: root.menu-view-h;
                    background: Palette.colors.raise;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Palette.colors.border;
                    drop-shadow-blur: 22px;
                    drop-shadow-offset-y: 7px;
                    drop-shadow-color: #00000088;
                    clip: true;

                    // interactive=false：滚轮仍可滚动（Slint Flickable 语义），
                    // 但按下/抬起会立即交给菜单行，避免拖拽延迟/吞点击。
                    menu-flick := Flickable {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        interactive: false;
                        mouse-drag-pan-enabled: false;
                        content-width: parent.width;
                        content-height: menu-list.preferred-height;

                        menu-list := VerticalLayout {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            padding: 6px;
                            spacing: 0px;

                            if root.menu-link != "" : MenuGroupLabel {
                                label: Lang.t("Link", "链接");
                                first: true;
                            }
                            if root.menu-link != "" : ContextMenuRow {
                                label: Lang.t("Open Link", "打开链接");
                                picked => { root.menu-open = false; root.menu-action(root.menu-pane, 9); }
                            }
                            if root.menu-link != "" : ContextMenuRow {
                                label: Lang.t("Copy Link", "复制链接");
                                picked => { root.menu-open = false; root.menu-action(root.menu-pane, 10); }
                            }

                            MenuGroupLabel {
                                label: Lang.t("Clipboard", "剪贴板");
                                first: root.menu-link == "";
                            }
                            ContextMenuRow {
                                label: Lang.t("Copy", "复制");
                                shortcut: "Ctrl+Shift+C";
                                picked => { root.menu-open = false; root.menu-action(root.menu-pane, 3); }
                            }
                            ContextMenuRow {
                                label: Lang.t("Paste", "粘贴");
                                shortcut: "Ctrl+Shift+V";
                                picked => { root.menu-open = false; root.menu-action(root.menu-pane, 4); }
                            }

                            MenuGroupLabel {
                                label: Lang.t("Pane", "窗格");
                            }
                            ContextMenuRow {
                                label: Lang.t("Split Right", "向右拆分");
                                shortcut: "Ctrl+Shift+E";
                                picked => { root.menu-open = false; root.menu-action(root.menu-pane, 0); }
                            }
                            ContextMenuRow {
                                label: Lang.t("Split Down", "向下拆分");
                                shortcut: "Ctrl+Shift+D";
                                picked => { root.menu-open = false; root.menu-action(root.menu-pane, 1); }
                            }
                            ContextMenuRow {
                                label: Lang.t("Close Pane", "关闭窗格");
                                shortcut: "Ctrl+Shift+W";
                                danger: true;
                                picked => { root.menu-open = false; root.menu-action(root.menu-pane, 2); }
                            }
                            ContextMenuRow {
                                label: root.broadcast
                                    ? Lang.t("Broadcast Input: ON", "广播输入：开")
                                    : Lang.t("Broadcast Input: OFF", "广播输入：关");
                                active: root.broadcast;
                                picked => { root.menu-open = false; root.menu-action(root.menu-pane, 8); }
                            }

                            MenuGroupLabel {
                                label: Lang.t("View", "视图");
                            }
                            ContextMenuRow {
                                label: Lang.t("Find", "查找");
                                shortcut: "Ctrl+F";
                                picked => { root.menu-open = false; root.menu-action(root.menu-pane, 5); }
                            }
                            ContextMenuRow {
                                label: Lang.t("Select All", "全选");
                                picked => { root.menu-open = false; root.menu-action(root.menu-pane, 6); }
                            }
                            ContextMenuRow {
                                label: Lang.t("Clear", "清除");
                                picked => { root.menu-open = false; root.menu-action(root.menu-pane, 7); }
                            }

                            MenuGroupLabel {
                                label: Lang.t("Session", "会话");
                            }
                            ContextMenuRow {
                                label: root.menu-read-only
                                    ? Lang.t("Read Only: ON", "只读：开")
                                    : Lang.t("Read Only: OFF", "只读：关");
                                active: root.menu-read-only;
                                picked => { root.menu-open = false; root.menu-action(root.menu-pane, 11); }
                            }
                            ContextMenuRow {
                                label: Lang.t("Reset", "重置");
                                picked => { root.menu-open = false; root.menu-action(root.menu-pane, 12); }
                            }
                            ContextMenuRow {
                                label: Lang.t("Reset and Clear", "重置并清空");
                                picked => { root.menu-open = false; root.menu-action(root.menu-pane, 13); }
                            }
                            ContextMenuRow {
                                label: Lang.t("Save Contents…", "保存内容…");
                                picked => { root.menu-open = false; root.menu-action(root.menu-pane, 14); }
                            }
                        }
                    }

                    // 窄窗口：菜单内容高于可用视口时显示细滚动条（提示还有分组/项）。
                    if menu-flick.content-height > menu-flick.height : Rectangle {
                        x: parent.width - 5px;
                        y: 6px + (-menu-flick.content-y)
                            / Math.max(1px, menu-flick.content-height - menu-flick.height)
                            * Math.max(0px, parent.height - self.height - 12px);
                        width: 3px;
                        height: Math.max(24px,
                            parent.height * parent.height / Math.max(1px, menu-flick.content-height));
                        border-radius: 1.5px;
                        background: Palette.colors.subtext;
                        opacity: 0.55;
                    }
                }
            }
        }
    }

    // Profile 选择器菜单：点外部关闭
    if root.profilemenu-open : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.profilemenu-open = false;
                    root.menu-dismissed();
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }
    }

    if root.profilemenu-open : Rectangle {
        x: Math.max(0px, Math.min(root.profilemenu-x, root.width - 220px));
        y: root.tabbar-bottom
            ? root.height - root.tabbar-height - self.height
            : root.tabbar-height;
        width: 220px;
        height: Math.min(root.profilemenu-items.length * 28px + 40px, root.height - root.tabbar-height - 8px);
        background: Palette.colors.raise;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 20px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #000000b0;
        clip: true;

        VerticalLayout {
            padding: 4px;
            spacing: 0px;

            for item[i] in root.profilemenu-items : MenuRow {
                label: item;
                picked => { root.profilemenu-open = false; root.profilemenu-pick(i); }
            }

            Rectangle {
                height: 1px;
                background: Palette.colors.border;
            }

            MenuRow {
                label: Lang.t("Manage Profiles…", "管理配置…");
                picked => { root.profilemenu-open = false; root.profilemenu-manage(); }
            }
        }
    }

    // 点菜单外的任意位置关闭 TabBar / Tab 菜单（此前只能点菜单项，菜单会一直留着）。
    // 这层放在两个菜单之前（下面），菜单项仍在最上层可点。
    if root.tabmenu-open || root.tabctx-open : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.tabmenu-open = false;
                    root.tabctx-open = false;
                    root.menu-dismissed();
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }
    }

    if root.tabmenu-open : Rectangle {
        x: Math.min(root.tabmenu-x, root.width - 180px);
        y: root.tabmenu-y;
        width: 170px;
        // 13 行：13×28 + 12×2 + 上下 padding 8 = 396（新增 New Window 行后正好占满）
        height: 396px;
        background: Palette.colors.raise;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.colors.hover;
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #000000a8;

        VerticalLayout {
            padding: 4px;
            spacing: 2px;

            MenuRow {
                label: root.pinned ? Lang.t("Always on Top  ✓", "总在最前  ✓") : Lang.t("Always on Top", "总在最前");
                picked => { root.tabmenu-open = false; root.pinned = !root.pinned; }
            }
            MenuRow {
                label: Lang.t("New Tab", "新建标签");
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(1); }
            }
            MenuRow {
                label: Lang.t("New Window", "新建窗口");
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(13); }
            }
            MenuRow {
                label: Lang.t("Settings", "设置");
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(2); }
            }
            MenuRow {
                // 存布局 + cwd，重启进程后按快照恢复（不丢分屏）
                label: Lang.t("Restart Session", "重启会话");
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(4); }
            }
            MenuRow {
                label: Lang.t("Command Palette", "命令面板");
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(5); }
            }
            MenuRow {
                label: root.tabbar-bottom ? Lang.t("Tab Bar: Bottom", "标签栏：底部") : Lang.t("Tab Bar: Top", "标签栏：顶部");
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(6); }
            }
            MenuRow {
                label: Lang.t("Background Sessions", "后台会话");
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(8); }
            }
            MenuRow {
                label: Lang.t("Profiles", "配置");
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(9); }
            }
            MenuRow {
                label: "SFTP";
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(10); }
            }
            MenuRow {
                label: Lang.t("Port Forwards", "端口转发");
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(11); }
            }
            MenuRow {
                label: Lang.t("Reopen Closed Tab", "重新打开已关闭标签");
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(12); }
            }
            MenuRow {
                label: Lang.t("Close Window", "关闭窗口");
                picked => { root.tabmenu-open = false; root.tabbar-menu-action(3); }
            }
        }
    }

    if root.tabctx-open : Rectangle {
        x: Math.max(0px, Math.min(root.tabctx-x, root.width - 180px));
        // 菜单 126 高：TabBar 在上时贴其下沿，在下时贴其上沿
        y: root.tabbar-bottom ? root.height - root.tabbar-height - 174px : root.tabbar-height;
        width: 190px;
        height: 174px;
        background: Palette.colors.raise;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.colors.hover;
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #000000a8;

        VerticalLayout {
            padding: 4px;
            spacing: 2px;

            MenuRow {
                label: Lang.t("Close", "关闭");
                picked => { root.tabctx-open = false; root.tab-menu-action(root.tabctx-index, 0); }
            }
            MenuRow {
                label: Lang.t("Close Others", "关闭其他");
                picked => { root.tabctx-open = false; root.tab-menu-action(root.tabctx-index, 1); }
            }
            MenuRow {
                label: Lang.t("Close Left", "关闭左侧");
                picked => { root.tabctx-open = false; root.tab-menu-action(root.tabctx-index, 4); }
            }
            MenuRow {
                label: Lang.t("Close Right", "关闭右侧");
                picked => { root.tabctx-open = false; root.tab-menu-action(root.tabctx-index, 5); }
            }
            MenuRow {
                label: Lang.t("Duplicate", "复制标签");
                picked => { root.tabctx-open = false; root.tab-menu-action(root.tabctx-index, 2); }
            }
            MenuRow {
                label: Lang.t("Rename", "重命名");
                picked => { root.tabctx-open = false; root.tab-menu-action(root.tabctx-index, 3); }
            }
        }
    }

    // ================= Settings =================
    // 默认：窗口内的 Settings Tab（占满 TabBar 下方内容区，不创建 PTY、不进 workspace）。
    // TERVO_SETTINGS_LEGACY=1：同一套控件退回居中 modal（顶部有 LEGACY 标记）。
    if root.settings-open : Rectangle {
        x: 0px;
        y: root.tabbar-bottom ? 0px : root.tabbar-height;
        width: root.width;
        height: root.height - root.tabbar-height;
        background: root.settings-legacy ? #00000080 : Palette.colors.bg;

        // legacy 模式点遮罩关闭；Tab 模式下没有遮罩。
        if root.settings-legacy : TouchArea {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            clicked => { root.close-settings(); }
        }

        settings-panel := Rectangle {
            x: root.settings-legacy ? (parent.width - self.width) / 2 : 0px;
            y: root.settings-legacy ? (parent.height - self.height) / 2 : 0px;
            width: root.settings-legacy ? Math.min(820px, parent.width - 32px) : parent.width;
            height: root.settings-legacy ? Math.min(620px, parent.height - 32px) : parent.height;
            background: Palette.colors.bg;
            border-radius: root.settings-legacy ? 12px : 0px;
            border-width: root.settings-legacy ? 1px : 0px;
            border-color: Palette.colors.border;
            drop-shadow-blur: root.settings-legacy ? 30px : 0px;
            drop-shadow-offset-y: root.settings-legacy ? 10px : 0px;
            drop-shadow-color: #000000b8;
            clip: true;

            settings-body := FocusScope {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                focus-on-click: false;
                init => { self.focus(); }

                // Esc：先收起主题下拉，再关闭设置；其它键不写入终端。
                key-pressed(event) => {
                    if (event.text == "\u{1b}") {
                        if (root.settings-theme-open) {
                            root.settings-theme-open = false;
                        } else {
                            root.close-settings();
                        }
                        return EventResult.accept;
                    }
                    EventResult.reject
                }

                // 模态（Profiles/Profile 表单）关闭后重新拿回键盘焦点。
                property <int> refocus-token: root.settings-refocus-token;
                changed refocus-token => { self.focus(); }

                property <length> sidebar-w: self.width < 900px
                    ? Math.min(164px, Math.max(156px, self.width * 0.32))
                    : 220px;
                // 不设固定上限：设置页必须跟整个窗口一起放大；只保留最小宽度。
                property <length> content-w: Math.max(80px,
                    self.width - self.sidebar-w - 40px);
                property <length> content-x: self.sidebar-w + 20px
                    + Math.max(0px, (self.width - self.sidebar-w - 40px - self.content-w) / 2);
                property <length> content-y: 64px;
                property <length> content-h: self.height - 76px;
                property <length> search-w: Math.max(80px, Math.min(260px, self.width - 210px));
                property <length> search-x: self.width - self.search-w - 56px;

                // 吃掉面板空白处的点击，避免穿透到下面的终端 pane（误选中/误点击）。
                TouchArea {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 100%;
                    pointer-event(event) => { EventResult.accept; }
                }

                // ---------------- 顶栏 ----------------
                Text {
                    x: 24px;
                    y: 0px;
                    width: Math.max(60px, Math.min(180px, settings-body.width - 200px));
                    height: 52px;
                    text: Lang.t("Settings", "设置");
                    color: Palette.colors.text;
                    font-size: 17px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.settings-legacy : Text {
                    x: 120px;
                    y: 0px;
                    width: 130px;
                    height: 52px;
                    text: Lang.t("LEGACY MODAL", "传统模态窗口");
                    color: Palette.colors.accent;
                    font-size: 9px;
                    font-weight: 600;
                    vertical-alignment: center;
                    visible: settings-body.width > 560px;
                }

                Rectangle {
                    x: settings-body.search-x;
                    y: 12px;
                    width: settings-body.search-w;
                    height: 28px;
                    border-radius: 8px;
                    background: Palette.colors.surface;
                    border-width: 1px;
                    border-color: root.settings-query != ""
                        ? Palette.colors.accent
                        : Palette.colors.border;

                    SettingsIconView {
                        x: 8px;
                        y: 6px;
                        kind: SettingsIconKind.search;
                        tint: Palette.colors.muted;
                    }

                    Text {
                        x: 30px;
                        width: parent.width - 40px;
                        height: parent.height;
                        text: Lang.t("Search settings…", "搜索设置…");
                        color: Palette.colors.muted;
                        font-size: 11px;
                        vertical-alignment: center;
                        visible: root.settings-query == "";
                        overflow: elide;
                    }

                    TextInput {
                        x: 30px;
                        width: parent.width - (root.settings-query == "" ? 40px : 64px);
                        height: parent.height;
                        text <=> root.settings-query;
                        single-line: true;
                        color: Palette.colors.text;
                        font-size: 11px;
                        vertical-alignment: center;
                        edited => {
                            root.settings-theme-open = false;
                            root.settings-filter(self.text);
                        }
                        accepted => {
                            if (root.settings-results.length > 0) {
                                root.settings-open-result(0);
                            }
                        }
                        key-pressed(event) => {
                            if (event.text == "\u{1b}") {
                                if (root.settings-query != "") {
                                    root.settings-query = "";
                                    root.settings-filter("");
                                } else {
                                    root.close-settings();
                                }
                                return EventResult.accept;
                            }
                            EventResult.reject
                        }
                    }

                    if root.settings-query != "" : Rectangle {
                        x: parent.width - 28px;
                        y: 4px;
                        width: 20px;
                        height: 20px;
                        border-radius: 5px;
                        background: settings-search-clear.has-hover ? Palette.colors.hover : transparent;
                        Text {
                            text: "×";
                            color: Palette.colors.muted;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                        settings-search-clear := TouchArea {
                            clicked => {
                                root.settings-query = "";
                                root.settings-filter("");
                            }
                        }
                    }
                }

                Rectangle {
                    x: settings-body.width - 42px;
                    y: 10px;
                    width: 30px;
                    height: 30px;
                    border-radius: 7px;
                    background: settings-close-hit.has-hover ? Palette.colors.danger : Palette.colors.hover;
                    Text {
                        text: "✕";
                        color: settings-close-hit.has-hover
                            ? Palette.colors.accent-text
                            : Palette.colors.subtext;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                    settings-close-hit := TouchArea {
                        clicked => { root.close-settings(); }
                    }
                }

                Rectangle {
                    x: 0px;
                    y: 51px;
                    width: 100%;
                    height: 1px;
                    background: Palette.colors.border;
                }

                // ---------------- 左导航 ----------------
                Rectangle {
                    x: 0px;
                    y: 52px;
                    width: settings-body.sidebar-w;
                    height: parent.height - 52px;
                    background: Palette.colors.surface;
                }
                Rectangle {
                    x: settings-body.sidebar-w;
                    y: 52px;
                    width: 1px;
                    height: parent.height - 52px;
                    background: Palette.colors.border;
                }

                settings-nav := Flickable {
                    x: 0px;
                    y: 52px;
                    width: settings-body.sidebar-w;
                    height: parent.height - 52px;
                    interactive: true;
                    content-width: self.width;
                    content-height: nav-layout.preferred-height + 24px;

                    nav-layout := VerticalLayout {
                        x: 10px;
                        y: 12px;
                        width: parent.width - 20px;
                        spacing: 2px;

                        Text {
                            height: 24px;
                            text: Lang.t("PERSONALIZE", "个性化");
                            color: Palette.colors.muted;
                            font-size: 9px;
                            font-weight: 600;
                            letter-spacing: 0.8px;
                            vertical-alignment: bottom;
                        }
                        NavItem {
                            label: Lang.t("Appearance", "外观");
                            icon: SettingsIconKind.appearance;
                            active: root.settings-category == 0;
                            clicked => {
                                root.settings-focus = "";
                                root.settings-theme-open = false;
                                root.settings-category = 0;
                                root.settings-category-changed(0);
                            }
                        }
                        NavItem {
                            label: Lang.t("Terminal", "终端");
                            icon: SettingsIconKind.terminal;
                            active: root.settings-category == 1;
                            clicked => {
                                root.settings-focus = "";
                                root.settings-theme-open = false;
                                root.settings-category = 1;
                                root.settings-category-changed(1);
                            }
                        }
                        NavItem {
                            label: Lang.t("Window", "窗口");
                            icon: SettingsIconKind.window;
                            active: root.settings-category == 2;
                            clicked => {
                                root.settings-focus = "";
                                root.settings-theme-open = false;
                                root.settings-category = 2;
                                root.settings-category-changed(2);
                            }
                        }

                        Rectangle { height: 10px; background: transparent; }

                        Text {
                            height: 24px;
                            text: Lang.t("WORKSPACE", "工作区");
                            color: Palette.colors.muted;
                            font-size: 9px;
                            font-weight: 600;
                            letter-spacing: 0.8px;
                            vertical-alignment: bottom;
                        }
                        NavItem {
                            label: Lang.t("Keys", "快捷键");
                            icon: SettingsIconKind.keys;
                            active: root.settings-category == 4;
                            clicked => {
                                root.settings-focus = "";
                                root.settings-theme-open = false;
                                root.settings-category = 4;
                                root.settings-category-changed(4);
                            }
                        }
                        NavItem {
                            label: Lang.t("Profiles", "配置");
                            icon: SettingsIconKind.profiles;
                            active: root.settings-category == 7;
                            clicked => {
                                root.settings-focus = "";
                                root.settings-theme-open = false;
                                root.settings-category = 7;
                                root.settings-category-changed(7);
                            }
                        }
                        NavItem {
                            label: Lang.t("Plugins", "插件");
                            icon: SettingsIconKind.plugins;
                            active: root.settings-category == 5;
                            clicked => {
                                root.settings-focus = "";
                                root.settings-theme-open = false;
                                root.settings-category = 5;
                                root.settings-category-changed(5);
                            }
                        }

                        Rectangle { height: 10px; background: transparent; }

                        Text {
                            height: 24px;
                            text: Lang.t("SYSTEM", "系统");
                            color: Palette.colors.muted;
                            font-size: 9px;
                            font-weight: 600;
                            letter-spacing: 0.8px;
                            vertical-alignment: bottom;
                        }
                        NavItem {
                            label: Lang.t("Vault", "保险库");
                            icon: SettingsIconKind.vault;
                            active: root.settings-category == 6;
                            clicked => {
                                root.settings-focus = "";
                                root.settings-theme-open = false;
                                root.settings-category = 6;
                                root.settings-category-changed(6);
                            }
                        }
                        NavItem {
                            label: Lang.t("Advanced", "高级");
                            icon: SettingsIconKind.advanced;
                            active: root.settings-category == 3;
                            clicked => {
                                root.settings-focus = "";
                                root.settings-theme-open = false;
                                root.settings-category = 3;
                                root.settings-category-changed(3);
                            }
                        }

                        Text {
                            height: 40px;
                            text: Lang.t("Tervo · changes apply instantly", "Tervo · 更改立即生效");
                            color: Palette.colors.muted;
                            font-size: 9px;
                            vertical-alignment: bottom;
                            wrap: word-wrap;
                        }
                    }
                }

                // ---------------- Appearance ----------------
                if root.settings-category == 0 : Flickable {
                    x: settings-body.content-x;
                    y: settings-body.content-y;
                    width: settings-body.content-w;
                    height: settings-body.content-h;
                    property <int> jump-token: root.settings-jump-token;
                    interactive: true;
                    content-width: self.width;
                    content-height: appearance-layout.preferred-height + 10px;

                    changed jump-token => {
                        let min-y = -Math.max(0px, self.content-height - self.height);
                        if (root.settings-focus == "theme") {
                            self.content-y = Math.max(min-y, Math.min(0px, -theme-card.y + 8px));
                        } else if (root.settings-focus == "background") {
                            self.content-y = Math.max(min-y, Math.min(0px, -background-card.y + 8px));
                        } else if (root.settings-focus == "cursor") {
                            self.content-y = Math.max(min-y, Math.min(0px, -cursor-card.y + 8px));
                        } else if (root.settings-focus == "bold") {
                            self.content-y = Math.max(min-y, Math.min(0px, -bold-card.y + 8px));
                        }
                    }

                    appearance-layout := VerticalLayout {
                        width: 100%;
                        spacing: 10px;

                        language-card := SettingsCard {
                            title: Lang.t("Language", "语言");
                            description: Lang.t("Applies immediately to Settings and context menus.", "立即应用到设置页与右键菜单。");

                            SettingField {
                                label: Lang.t("Interface language", "界面语言");
                                Segmented {
                                    options: ["English", "中文"];
                                    values: ["en", "zh"];
                                    value: root.language;
                                    picked(v) => {
                                        root.language = v;
                                        root.language-changed(v);
                                    }
                                }
                            }
                        }

                        theme-card := SettingsCard {
                            title: Lang.t("Theme", "主题");
                            description: Lang.t("Color scheme applies immediately to every pane and UI chrome.", "配色立即应用到所有窗格与界面。");
                            highlighted: root.settings-focus == "theme";

                            SettingField {
                                label: Lang.t("Color scheme", "配色方案");
                                Rectangle {
                                    width: 100%;
                                    height: 32px;
                                    border-radius: 8px;
                                    background: Palette.colors.bg;
                                    border-width: 1px;
                                    border-color: root.settings-theme-open
                                        ? Palette.colors.accent
                                        : Palette.colors.border;

                                    Text {
                                        x: 12px;
                                        width: parent.width - 46px;
                                        height: parent.height;
                                        text: root.theme-display;
                                        color: Palette.colors.text;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    SettingsIconView {
                                        x: parent.width - 30px;
                                        y: 8px;
                                        kind: SettingsIconKind.chevron;
                                        tint: root.settings-theme-open
                                            ? Palette.colors.accent
                                            : Palette.colors.muted;
                                    }
                                    TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        clicked => {
                                            root.settings-theme-open = !root.settings-theme-open;
                                        }
                                    }
                                }
                            }

                            SettingRow {
                                label: Lang.t("Auto follows system", "自动跟随系统");
                                description: Lang.t("Uses the desktop dark/light preference when available.", "可用时跟随桌面深色/浅色偏好。");
                                SettingsSwitch {
                                    on: root.theme-name == "auto";
                                    toggled => { root.set-theme("auto"); }
                                }
                            }
                        }

                        background-card := SettingsCard {
                            title: Lang.t("Background", "背景");
                            description: Lang.t("Optional wallpaper behind the terminal; text and colors stay readable.", "可选终端壁纸；文字与配色保持可读。");
                            highlighted: root.settings-focus == "background";

                            SettingField {
                                label: Lang.t("Image", "图片");
                                description: Lang.t("PNG / JPEG / SVG path · ~ is expanded · empty = off", "PNG / JPEG / SVG 路径 · 自动展开 ~ · 留空 = 关闭");
                                SettingsTextField {
                                    text <=> root.background-image-path;
                                    placeholder: "/home/you/Pictures/wallpaper.png";
                                    error: root.background-image-error != "";
                                    clearable: true;
                                    commit-on-blur: true;
                                    edited(t) => { root.background-image-changed(t); }
                                    accepted(t) => { root.background-image-commit(t); }
                                    cleared => { root.background-image-changed(""); }
                                    blurred(t) => { root.background-image-commit(t); }
                                }
                            }

                            if root.background-image-error != "" : Text {
                                text: root.background-image-error;
                                color: Palette.colors.danger;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            if root.background-image-error == "" : Text {
                                text: Lang.t("Images are cropped to fill the window; only existing regular files are accepted.", "图片会被裁剪以填满窗口；只接受存在的普通文件。");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }

                            SettingField {
                                label: Lang.t("Dim", "暗化");
                                description: Lang.t("Darkens only the image (default 60%).", "仅压暗图片（默认 60%）。");
                                HorizontalLayout {
                                    spacing: 8px;
                                    OpacitySlider {
                                        height: 22px;
                                        horizontal-stretch: 1;
                                        value: root.background-dim;
                                        min: 0.0;
                                        max: 0.8;
                                        preview(v) => {
                                            root.background-dim = v;
                                            root.background-dim-preview(v);
                                        }
                                        changed(v) => {
                                            root.background-dim = v;
                                            root.background-dim-changed(v);
                                        }
                                    }
                                    Text {
                                        text: "\{Math.round(root.background-dim * 100)}%";
                                        color: Palette.colors.text;
                                        width: 42px;
                                        font-size: 12px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            SettingField {
                                label: Lang.t("Terminal opacity", "终端不透明度");
                                description: !root.has-background-image
                                    ? Lang.t("No background image set — the terminal stays fully opaque.", "未设置背景图 — 终端保持完全不透明。")
                                    : Lang.t("0% reveals the wallpaper completely; 100% keeps the theme color.", "0% 完全透出壁纸；100% 保持主题色。");
                                HorizontalLayout {
                                    spacing: 8px;
                                    OpacitySlider {
                                        height: 22px;
                                        horizontal-stretch: 1;
                                        value: root.background-opacity;
                                        min: 0.0;
                                        max: 1.0;
                                        preview(v) => {
                                            root.background-opacity = v;
                                            root.background-opacity-preview(v);
                                        }
                                        changed(v) => {
                                            root.background-opacity = v;
                                            root.background-opacity-changed(v);
                                        }
                                    }
                                    Text {
                                        text: "\{Math.round(root.background-opacity * 100)}%";
                                        color: Palette.colors.text;
                                        width: 42px;
                                        font-size: 12px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        cursor-card := SettingsCard {
                            title: Lang.t("Cursor", "光标");
                            description: Lang.t("Shape and colors update the overlay without repainting the terminal grid.", "形状与颜色只更新叠加层，不重绘终端网格。");
                            highlighted: root.settings-focus == "cursor";

                            SettingField {
                                label: Lang.t("Shape", "形状");
                                Segmented {
                                    options: [Lang.t("Block", "块状"), Lang.t("Underline", "下划线"), Lang.t("I-beam", "竖线")];
                                    values: ["block", "underline", "ibeam"];
                                    value: root.cfg-cursor-shape;
                                    picked(v) => { root.set-cursor-shape(v); }
                                }
                            }
                            SettingField {
                                label: Lang.t("Blink", "闪烁");
                                Segmented {
                                    options: [Lang.t("Follow system", "跟随系统"), Lang.t("On", "开"), Lang.t("Off", "关")];
                                    values: ["system", "on", "off"];
                                    value: root.cfg-cursor-blink;
                                    picked(v) => { root.set-cursor-blink(v); }
                                }
                            }
                            SettingField {
                                label: Lang.t("Cursor color", "光标颜色");
                                description: Lang.t("Empty = theme cursor color (#rrggbb).", "留空 = 主题光标色（#rrggbb）。");
                                SettingsTextField {
                                    text <=> root.cfg-cursor-color;
                                    placeholder: Lang.t("theme default", "主题默认");
                                    clearable: true;
                                    edited(t) => { root.cursor-color-changed(t); }
                                    cleared => { root.cursor-color-changed(""); }
                                }
                            }
                            SettingField {
                                label: Lang.t("Cursor text color", "光标下文字颜色");
                                description: Lang.t("Empty = theme background (inverse block cursor).", "留空 = 主题背景色（块状光标反色）。");
                                SettingsTextField {
                                    text <=> root.cfg-cursor-text-color;
                                    placeholder: Lang.t("theme background", "主题背景");
                                    clearable: true;
                                    edited(t) => { root.cursor-text-color-changed(t); }
                                    cleared => { root.cursor-text-color-changed(""); }
                                }
                            }
                        }

                        bold-card := SettingsCard {
                            title: Lang.t("Bold", "粗体");
                            highlighted: root.settings-focus == "bold";

                            SettingRow {
                                label: Lang.t("Bold is bright", "粗体使用亮色");
                                description: Lang.t("ANSI 0–7 bold text uses the bright palette.", "ANSI 0–7 的粗体使用亮色调色板。");
                                SettingsSwitch {
                                    on: root.cfg-bold-is-bright;
                                    toggled => { root.toggle-bold-is-bright(); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Bold color same as foreground", "粗体颜色同前景色");
                                description: Lang.t("Disable to use a dedicated bold color below.", "关闭后使用下方单独的粗体颜色。");
                                SettingsSwitch {
                                    on: root.cfg-bold-color-same-as-fg;
                                    toggled => { root.toggle-bold-color-same-as-fg(); }
                                }
                            }
                            SettingField {
                                label: Lang.t("Bold color", "粗体颜色");
                                description: Lang.t("Empty = normal foreground; explicit ANSI colors are unaffected.", "留空 = 普通前景色；显式 ANSI 颜色不受影响。");
                                SettingsTextField {
                                    text <=> root.cfg-bold-color;
                                    placeholder: Lang.t("use foreground", "使用前景色");
                                    clearable: true;
                                    edited(t) => { root.bold-color-changed(t); }
                                    cleared => { root.bold-color-changed(""); }
                                }
                            }
                        }
                    }
                }

                // ---------------- Terminal ----------------
                if root.settings-category == 1 : Flickable {
                    x: settings-body.content-x;
                    y: settings-body.content-y;
                    width: settings-body.content-w;
                    height: settings-body.content-h;
                    property <int> jump-token: root.settings-jump-token;
                    interactive: true;
                    content-width: self.width;
                    content-height: terminal-layout.preferred-height + 10px;

                    changed jump-token => {
                        let min-y = -Math.max(0px, self.content-height - self.height);
                        if (root.settings-focus == "text") {
                            self.content-y = Math.max(min-y, Math.min(0px, -text-card.y + 8px));
                        } else if (root.settings-focus == "scrollback") {
                            self.content-y = Math.max(min-y, Math.min(0px, -scrollback-card.y + 8px));
                        } else if (root.settings-focus == "behavior") {
                            self.content-y = Math.max(min-y, Math.min(0px, -behavior-card.y + 8px));
                        } else if (root.settings-focus == "bell") {
                            self.content-y = Math.max(min-y, Math.min(0px, -bell-card.y + 8px));
                        } else if (root.settings-focus == "scroll") {
                            self.content-y = Math.max(min-y, Math.min(0px, -scrollback-card.y + 8px));
                        } else if (root.settings-focus == "scrollbar") {
                            self.content-y = Math.max(min-y, Math.min(0px, -scrollback-card.y + 8px));
                        } else if (root.settings-focus == "images") {
                            self.content-y = Math.max(min-y, Math.min(0px, -images-card.y + 8px));
                        } else if (root.settings-focus == "keys") {
                            self.content-y = Math.max(min-y, Math.min(0px, -keybind-card.y + 8px));
                        }
                    }

                    terminal-layout := VerticalLayout {
                        width: 100%;
                        spacing: 10px;

                        text-card := SettingsCard {
                            title: Lang.t("Text & history", "文本与历史");
                            highlighted: root.settings-focus == "text"
                                || root.settings-focus == "scrollback";

                            SettingField {
                                label: Lang.t("Font size", "字号");
                                description: Lang.t("Applies immediately to existing panes.", "立即应用到已有窗格。");
                                Stepper {
                                    text: "\{root.font-size} px";
                                    minus => { root.bump-font-size(-1); }
                                    plus => { root.bump-font-size(1); }
                                }
                            }
                            SettingField {
                                label: Lang.t("Scrollback", "回滚缓冲");
                                description: root.cfg-scrollback-unlimited
                                    ? Lang.t("Unlimited mode (safe cap 100,000 lines; new panes only).", "无限模式（安全上限 100,000 行；仅新窗格）。")
                                    : Lang.t("Lines kept per pane (new panes only).", "每个窗格保留的行数（仅新窗格）。");
                                Stepper {
                                    text: root.cfg-scrollback-unlimited
                                        ? Lang.t("Unlimited", "无限")
                                        : Lang.t("\{root.scrollback} lines", "\{root.scrollback} 行");
                                    minus => { root.bump-scrollback(-500); }
                                    plus => { root.bump-scrollback(500); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Unlimited scrollback", "无限回滚");
                                description: Lang.t("Safe cap 100,000 lines; preallocated memory per new pane.", "安全上限 100,000 行；每个新窗格预分配内存。");
                                SettingsSwitch {
                                    on: root.cfg-scrollback-unlimited;
                                    toggled => { root.toggle-scrollback-unlimited(); }
                                }
                            }
                        }

                        scrollback-card := SettingsCard {
                            title: Lang.t("Scrolling", "滚动");
                            description: Lang.t("How the viewport follows output and keyboard input.", "视口如何跟随输出与键盘输入。");
                            highlighted: root.settings-focus == "scroll"
                                || root.settings-focus == "scrollbar";

                            SettingRow {
                                label: Lang.t("Scroll on output", "输出时滚动");
                                description: Lang.t("Any output pulls the viewport back to the newest line.", "任何输出都把视口拉回最新行。");
                                SettingsSwitch {
                                    on: root.cfg-scroll-output;
                                    toggled => { root.toggle-scroll-output(); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Scroll on keystroke", "按键时滚动");
                                description: Lang.t("Jump to the bottom before sending a key (GNOME default).", "发送按键前先跳到最底部（GNOME 默认）。");
                                SettingsSwitch {
                                    on: root.cfg-scroll-keystroke;
                                    toggled => { root.toggle-scroll-keystroke(); }
                                }
                            }
                            SettingField {
                                label: Lang.t("Scrollbar", "滚动条");
                                description: Lang.t("Right-edge overlay scrollbar policy.", "右侧叠加滚动条策略。");
                                Segmented {
                                    options: [Lang.t("Always", "始终"), Lang.t("Auto", "自动"), Lang.t("Never", "从不")];
                                    values: ["always", "auto", "never"];
                                    value: root.cfg-scrollbar-policy;
                                    picked(v) => { root.set-scrollbar-policy(v); }
                                }
                            }
                        }

                        behavior-card := SettingsCard {
                            title: Lang.t("Behavior", "行为");
                            highlighted: root.settings-focus == "behavior";

                            SettingRow {
                                label: Lang.t("Copy on select", "选中即复制");
                                description: Lang.t("Copy the selection to the clipboard automatically.", "自动把选区复制到剪贴板。");
                                SettingsSwitch {
                                    on: root.cfg-copy-on-select;
                                    toggled => { root.toggle-copy-on-select(); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Confirm closing multiple sessions", "关闭多个会话前确认");
                                description: Lang.t("Ask before closing a window with several tabs/panes.", "关闭含多个标签/窗格的窗口前询问。");
                                SettingsSwitch {
                                    on: root.cfg-confirm-close;
                                    toggled => { root.toggle-confirm-close(); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Restore session on startup", "启动时恢复会话");
                                description: Lang.t("Reopen tabs, splits and cwd from the last clean exit (off by default).", "按上次正常退出重新打开标签、分屏与工作目录（默认关闭）。");
                                SettingsSwitch {
                                    on: root.cfg-restore-session;
                                    toggled => { root.toggle-restore-session(); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Confirm multi-line paste", "多行粘贴前确认");
                                description: Lang.t("Show a preview before pasting text with newlines.", "粘贴含换行文本前显示预览。");
                                SettingsSwitch {
                                    on: root.cfg-confirm-paste;
                                    toggled => { root.toggle-confirm-paste(); }
                                }
                            }
                            SettingField {
                                label: Lang.t("Right click", "右键");
                                description: Lang.t("Short press acts immediately; long press (250ms) opens the menu.", "短按立即执行；长按（250ms）打开菜单。");
                                Segmented {
                                    options: [Lang.t("Menu", "菜单"), Lang.t("Paste", "粘贴"), Lang.t("Clipboard", "剪贴板"), Lang.t("Off", "关")];
                                    values: ["menu", "paste", "clipboard", "off"];
                                    value: root.cfg-right-click;
                                    picked(v) => { root.set-right-click(v); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Paste on middle-click", "中键粘贴");
                                SettingsSwitch {
                                    on: root.cfg-paste-middle;
                                    toggled => { root.toggle-paste-middle(); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Desktop notifications", "桌面通知");
                                description: Lang.t("notify-send when an inactive tab emits OSC 9 / 777 / BEL.", "非活动标签收到 OSC 9 / 777 / BEL 时调用 notify-send。");
                                SettingsSwitch {
                                    on: root.cfg-desktop-notifications;
                                    toggled => { root.toggle-desktop-notifications(); }
                                }
                            }
                        }

                        bell-card := SettingsCard {
                            title: Lang.t("Bell", "响铃");
                            highlighted: root.settings-focus == "bell";
                            SettingRow {
                                label: Lang.t("Visual bell", "视觉铃");
                                description: Lang.t("Flash a 1–2px accent border when the active pane receives BEL.", "活动窗格收到 BEL 时闪烁 1–2px 强调边框。");
                                SettingsSwitch {
                                    on: root.cfg-visual-bell;
                                    toggled => { root.toggle-visual-bell(); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Audible bell", "声音铃");
                                description: Lang.t("Ring the system bell via X11 (falls back to the terminal BEL).", "通过 X11 响系统铃（失败时回退终端 BEL）。");
                                SettingsSwitch {
                                    on: root.cfg-audible-bell;
                                    toggled => { root.toggle-audible-bell(); }
                                }
                            }
                        }

                        images-card := SettingsCard {
                            title: Lang.t("Images", "图片");
                            highlighted: root.settings-focus == "images";
                            SettingRow {
                                label: Lang.t("Sixel inline images", "Sixel 内联图片");
                                description: Lang.t("Primary DA advertises parameter 4; 25 MB per image, 16 MP cap.", "主 DA 宣告参数 4；单图上限 25 MB、16 MP。");
                                SettingsSwitch {
                                    on: root.cfg-sixel;
                                    toggled => { root.toggle-sixel(); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("iTerm2 IIP images", "iTerm2 IIP 图片");
                                description: Lang.t("OSC 1337 File (PNG/JPEG); 20 MB per file, 16 MP cap. Independent of Sixel.", "OSC 1337 File（PNG/JPEG）；单文件上限 20 MB、16 MP。与 Sixel 独立。");
                                SettingsSwitch {
                                    on: root.cfg-iip;
                                    toggled => { root.toggle-iip(); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Images scroll with history", "图片随历史滚动");
                                description: Lang.t("Off pins images to the viewport; on moves them with the text.", "关闭时图片固定在视口；开启时随文本移动。");
                                SettingsSwitch {
                                    on: root.cfg-sixel-scrolling;
                                    toggled => { root.toggle-sixel-scrolling(); }
                                }
                            }
                        }

                        keybind-card := SettingsCard {
                            title: Lang.t("Key encoding", "按键编码");
                            highlighted: root.settings-focus == "keys";
                            SettingField {
                                label: Lang.t("Backspace", "退格键");
                                Segmented {
                                    options: [Lang.t("ASCII DEL (0x7F)", "ASCII DEL（0x7F）"), Lang.t("Control-H (0x08)", "Control-H（0x08）")];
                                    values: ["ascii-delete", "control-h"];
                                    value: root.cfg-backspace-binding;
                                    picked(v) => { root.set-backspace-binding(v); }
                                }
                            }
                            SettingField {
                                label: Lang.t("Delete", "删除键");
                                Segmented {
                                    options: ["ESC [3~", "ASCII DEL", "Control-H"];
                                    values: ["delete-sequence", "ascii-del", "control-h"];
                                    value: root.cfg-delete-binding;
                                    picked(v) => { root.set-delete-binding(v); }
                                }
                            }
                            Text {
                                text: Lang.t("Only the bytes sent to the PTY change; defaults match GNOME (Backspace=0x7F, Delete=ESC [3~).", "只有发送给 PTY 的字节会变；默认与 GNOME 一致（退格=0x7F，删除=ESC [3~）。");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // ---------------- Window ----------------
                if root.settings-category == 2 : Flickable {
                    x: settings-body.content-x;
                    y: settings-body.content-y;
                    width: settings-body.content-w;
                    height: settings-body.content-h;
                    property <int> jump-token: root.settings-jump-token;
                    interactive: true;
                    content-width: self.width;
                    content-height: window-layout.preferred-height + 10px;

                    changed jump-token => {
                        if (root.settings-focus == "window") {
                            self.content-y = 0px;
                        }
                    }

                    window-layout := VerticalLayout {
                        width: 100%;
                        spacing: 10px;

                        window-card := SettingsCard {
                            title: Lang.t("Window & Tab bar", "窗口与标签栏");
                            highlighted: root.settings-focus == "window";
                            SettingRow {
                                label: Lang.t("Tab bar at bottom", "标签栏置底");
                                description: Lang.t("Move the tab strip below the terminal content.", "把标签条移到终端内容下方。");
                                SettingsSwitch {
                                    on: root.tabbar-bottom;
                                    toggled => { root.tabbar-menu-action(6); }
                                }
                            }
                            SettingRow {
                                label: Lang.t("Quake mode (F12)", "Quake 模式（F12）");
                                description: Lang.t("Global drop-down terminal: 70% screen width, 50% height (X11).", "全局下拉终端：屏宽 70%、高 50%（X11）。");
                                SettingsSwitch {
                                    on: root.cfg-quake;
                                    toggled => { root.toggle-quake(); }
                                }
                            }
                            Text {
                                text: Lang.t("Tab bar position is written to config immediately. Close confirmation lives in Terminal → Behavior.", "标签栏位置立即写入配置。关闭确认在 终端 → 行为。");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }

                        SettingsCard {
                            title: Lang.t("Settings window", "设置窗口");
                            description: root.settings-legacy
                                ? Lang.t("Legacy modal mode is active (TERVO_SETTINGS_LEGACY=1).", "传统模态模式已启用（TERVO_SETTINGS_LEGACY=1）。")
                                : Lang.t("Settings is a tab inside the main window: close it with ✕, Esc, or by clicking a terminal tab.", "设置是主窗口内的标签页：用 ✕、Esc 或点击终端标签关闭。");
                            Text {
                                text: Lang.t("Start with TERVO_SETTINGS_LEGACY=1 to use the centered modal fallback.", "启动时设置 TERVO_SETTINGS_LEGACY=1 可使用居中模态回退。");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // ---------------- Advanced ----------------
                if root.settings-category == 3 : Flickable {
                    x: settings-body.content-x;
                    y: settings-body.content-y;
                    width: settings-body.content-w;
                    height: settings-body.content-h;
                    property <int> jump-token: root.settings-jump-token;
                    interactive: true;
                    content-width: self.width;
                    content-height: advanced-layout.preferred-height + 10px;

                    changed jump-token => {
                        if (root.settings-focus == "config") {
                            self.content-y = 0px;
                        }
                    }

                    advanced-layout := VerticalLayout {
                        width: 100%;
                        spacing: 10px;

                        config-card := SettingsCard {
                            title: Lang.t("Config file", "配置文件");
                            highlighted: root.settings-focus == "config";
                            SettingField {
                                label: Lang.t("Path", "路径");
                                Text {
                                    text: root.settings-path;
                                    color: Palette.colors.text;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Open Folder", "打开目录");
                                    font-size: 10px;
                                    clicked => { root.settings-open-path(); }
                                }
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Import Tabby", "导入 Tabby");
                                    font-size: 10px;
                                    clicked => { root.config-import-tabby(); }
                                }
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Export Profiles", "导出配置");
                                    font-size: 10px;
                                    clicked => { root.config-export-tabby(); }
                                }
                            }
                            Text {
                                text: root.config-status;
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                                visible: root.config-status != "";
                            }
                            Text {
                                text: Lang.t("Passwords and private keys never live in the plain config; SSH passwords go to the encrypted Vault.", "密码与私钥绝不写入明文配置；SSH 密码保存在加密保险库。");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }

                        SettingsCard {
                            title: Lang.t("Interface", "界面");
                            description: Lang.t("Settings presentation is selected at startup for safety.", "为安全起见，设置页呈现方式在启动时选定。");
                            Text {
                                text: root.settings-legacy
                                    ? Lang.t("Current: legacy centered modal. Remove TERVO_SETTINGS_LEGACY to return to the Settings Tab.", "当前：传统居中模态。移除 TERVO_SETTINGS_LEGACY 可回到设置标签页。")
                                    : Lang.t("Current: in-window Settings Tab. Set TERVO_SETTINGS_LEGACY=1 before launch to fall back to the centered modal.", "当前：窗口内设置标签页。启动前设置 TERVO_SETTINGS_LEGACY=1 可回退到居中模态。");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // ---------------- Keys ----------------
                if root.settings-category == 4 : Flickable {
                    x: settings-body.content-x;
                    y: settings-body.content-y;
                    width: settings-body.content-w;
                    height: settings-body.content-h;
                    property <int> jump-token: root.settings-jump-token;
                    interactive: true;
                    content-width: self.width;
                    content-height: hotkeys-layout.preferred-height + 10px;

                    changed jump-token => {
                        if (root.settings-focus == "hotkeys") {
                            self.content-y = 0px;
                        }
                    }

                    hotkeys-layout := VerticalLayout {
                        width: 100%;
                        spacing: 10px;

                        SettingsCard {
                            title: Lang.t("Keyboard shortcuts", "键盘快捷键");
                            description: Lang.t("Click Edit, then press a single chord. Esc cancels; Backspace restores the default.", "点击“编辑”后按单个组合键。Esc 取消；退格键恢复默认。");

                            HorizontalLayout {
                                height: 22px;
                                spacing: 8px;
                                Text {
                                    text: root.hotkey-summary;
                                    color: Palette.colors.subtext;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.hotkey-conflict-count > 0
                                        ? Lang.t("⚠ \{root.hotkey-conflict-count} conflict(s)", "⚠ \{root.hotkey-conflict-count} 个冲突")
                                        : Lang.t("✓ no conflicts", "✓ 无冲突");
                                    color: root.hotkey-conflict-count > 0
                                        ? Palette.colors.danger
                                        : Palette.colors.muted;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                                ChoiceBtn {
                                    width: 72px;
                                    height: 22px;
                                    font-size: 9px;
                                    label: Lang.t("Reset All", "全部重置");
                                    clicked => { root.hotkey-reset-all(); }
                                }
                            }

                            if root.hotkey-recording-row >= 0 : Text {
                                text: Lang.t("Recording: press Ctrl/Alt/Shift + key · Esc cancel · Backspace reset", "录制中：按 Ctrl/Alt/Shift + 键 · Esc 取消 · 退格键恢复");
                                color: Palette.colors.accent;
                                font-size: 10px;
                                wrap: word-wrap;
                            }

                            VerticalLayout {
                                width: 100%;
                                spacing: 1px;

                                for row[i] in root.hotkey-rows : Rectangle {
                                    height: 30px;
                                    border-radius: 5px;
                                    background: i == root.hotkey-recording-row
                                        ? Palette.colors.hover
                                        : (hotkey-row-hit.has-hover ? Palette.colors.surface : transparent);

                                    hotkey-row-hit := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        pointer-event(event) => { EventResult.reject; }
                                    }

                                    Text {
                                        x: 6px;
                                        width: parent.width - 158px;
                                        height: parent.height;
                                        text: row.title;
                                        color: Palette.colors.text;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    Text {
                                        x: parent.width - 152px;
                                        width: 88px;
                                        height: 15px;
                                        text: i == root.hotkey-recording-row ? Lang.t("Press keys…", "请按键…") : row.chord;
                                        color: i == root.hotkey-recording-row
                                            ? Palette.colors.accent
                                            : (row.conflict ? Palette.colors.danger : Palette.colors.subtext);
                                        font-size: 10px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    Text {
                                        x: parent.width - 152px;
                                        y: 15px;
                                        width: 88px;
                                        height: 12px;
                                        text: row.conflict ? Lang.t("CONFLICT", "冲突") : (row.custom ? Lang.t("CUSTOM", "自定义") : "");
                                        color: row.conflict ? Palette.colors.danger : Palette.colors.accent;
                                        font-size: 7px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }

                                    ChoiceBtn {
                                        x: parent.width - 60px;
                                        y: 4px;
                                        width: 52px;
                                        height: 22px;
                                        font-size: 9px;
                                        label: i == root.hotkey-recording-row ? Lang.t("Cancel", "取消") : Lang.t("Edit", "编辑");
                                        active: i == root.hotkey-recording-row;
                                        clicked => {
                                            if (i == root.hotkey-recording-row) {
                                                root.hotkey-cancel-edit();
                                            } else {
                                                root.hotkey-start-edit(i);
                                            }
                                        }
                                    }
                                }
                            }

                            if root.hotkey-error != "" : Text {
                                text: root.hotkey-error;
                                color: Palette.colors.danger;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            if root.hotkey-error == "" && root.hotkey-status != "" : Text {
                                text: root.hotkey-status;
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: Lang.t("Single chord: Ctrl/Alt/Meta + key, or F1–F24. Conflicting chords are rejected; multi-chord sequences (Ctrl+K Ctrl+T) are not supported.", "单个组合键：Ctrl/Alt/Meta + 键，或 F1–F24。拒绝冲突组合；不支持多段序列（Ctrl+K Ctrl+T）。");
                                color: Palette.colors.muted;
                                font-size: 9px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // ---------------- Profiles ----------------
                if root.settings-category == 7 : Flickable {
                    x: settings-body.content-x;
                    y: settings-body.content-y;
                    width: settings-body.content-w;
                    height: settings-body.content-h;
                    property <int> jump-token: root.settings-jump-token;
                    interactive: true;
                    content-width: self.width;
                    content-height: profiles-layout.preferred-height + 10px;

                    changed jump-token => {
                        if (root.settings-focus == "profiles") {
                            self.content-y = 0px;
                        }
                    }

                    profiles-layout := VerticalLayout {
                        width: 100%;
                        spacing: 10px;

                        profiles-card := SettingsCard {
                            title: Lang.t("Profiles", "配置");
                            description: Lang.t("Saved local / SSH / serial / telnet connections. Click a row to open it in a new tab.", "已保存的本地 / SSH / 串口 / Telnet 连接。点击一行在新标签中打开。");
                            highlighted: root.settings-focus == "profiles";

                            VerticalLayout {
                                width: 100%;
                                spacing: 2px;

                                if root.profile-items.length == 0 : Text {
                                    height: 28px;
                                    text: Lang.t("No profiles yet — create one below.", "还没有配置 — 在下方创建一个。");
                                    color: Palette.colors.muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }

                                for item[i] in root.profile-items : Rectangle {
                                    height: 34px;
                                    border-radius: 6px;
                                    background: profile-row-hit.has-hover ? Palette.colors.hover : transparent;

                                    profile-row-hit := TouchArea {
                                        x: 0px;
                                        y: 0px;
                                        width: parent.width - 108px;
                                        height: parent.height;
                                        clicked => { root.profile-open(i); }
                                    }

                                    Text {
                                        x: 8px;
                                        width: parent.width - 122px;
                                        height: parent.height;
                                        text: item.label;
                                        color: Palette.colors.text;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    Rectangle {
                                        x: parent.width - 104px;
                                        y: 5px;
                                        width: 26px;
                                        height: 24px;
                                        border-radius: 5px;
                                        background: profile-star.has-hover ? Palette.colors.hover : transparent;
                                        Text {
                                            text: item.is-default ? "★" : "☆";
                                            color: item.is-default ? Palette.colors.accent : Palette.colors.muted;
                                            font-size: 13px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%;
                                            height: 100%;
                                        }
                                        profile-star := TouchArea {
                                            clicked => { root.profile-set-default(i); }
                                        }
                                    }

                                    ChoiceBtn {
                                        x: parent.width - 76px;
                                        y: 6px;
                                        width: 42px;
                                        height: 22px;
                                        font-size: 9px;
                                        label: Lang.t("Edit", "编辑");
                                        clicked => { root.profile-edit(i); }
                                    }

                                    Rectangle {
                                        x: parent.width - 30px;
                                        y: 5px;
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 5px;
                                        background: profile-del.has-hover ? Palette.colors.danger : transparent;
                                        Text {
                                            text: "×";
                                            color: profile-del.has-hover
                                                ? Palette.colors.accent-text
                                                : Palette.colors.muted;
                                            font-size: 14px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%;
                                            height: 100%;
                                        }
                                        profile-del := TouchArea {
                                            clicked => { root.profile-delete(i); }
                                        }
                                    }
                                }
                            }

                            Text {
                                text: root.profile-default-info;
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("New Profile", "新建配置");
                                    font-size: 10px;
                                    clicked => { root.profile-new(); }
                                }
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Manage Profiles…", "管理配置…");
                                    font-size: 10px;
                                    clicked => { root.settings-manage-profiles(); }
                                }
                            }
                            Text {
                                text: Lang.t("The full Profiles panel adds search and duplicate; it opens above this page.", "完整配置面板还提供搜索与复制；它会在此页之上打开。");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // ---------------- Plugins ----------------
                if root.settings-category == 5 : Flickable {
                    x: settings-body.content-x;
                    y: settings-body.content-y;
                    width: settings-body.content-w;
                    height: settings-body.content-h;
                    property <int> jump-token: root.settings-jump-token;
                    interactive: true;
                    content-width: self.width;
                    content-height: plugins-layout.preferred-height + 10px;

                    changed jump-token => {
                        if (root.settings-focus == "plugins") {
                            self.content-y = 0px;
                        }
                    }

                    plugins-layout := VerticalLayout {
                        width: 100%;
                        spacing: 10px;

                        plugins-card := SettingsCard {
                            title: Lang.t("Plugins", "插件");
                            highlighted: root.settings-focus == "plugins";

                            Text {
                                text: root.plugin-summary;
                                color: Palette.colors.subtext;
                                font-size: 11px;
                                wrap: word-wrap;
                            }

                            Text {
                                text: Lang.t("Installed", "已安装");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                font-weight: 600;
                            }

                            VerticalLayout {
                                width: 100%;
                                spacing: 0px;
                                for item[i] in root.plugin-items : Text {
                                    height: 22px;
                                    text: item;
                                    color: Palette.colors.text;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if root.plugin-items.length == 0 : Text {
                                    height: 22px;
                                    text: Lang.t("No plugins installed.", "未安装插件。");
                                    color: Palette.colors.muted;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: Lang.t("Recent plugin activity", "最近插件活动");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                font-weight: 600;
                            }

                            VerticalLayout {
                                width: 100%;
                                spacing: 0px;
                                if root.plugin-activity-items.length == 0 : Text {
                                    height: 22px;
                                    text: Lang.t("No plugin activity yet — run a plugin command or open a tab with an event plugin installed.", "还没有插件活动 — 运行插件命令或打开安装了事件插件的标签。");
                                    color: Palette.colors.muted;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                for item[i] in root.plugin-activity-items : Text {
                                    height: 20px;
                                    text: item;
                                    color: Palette.colors.text;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            Text {
                                text: root.plugin-dir;
                                color: Palette.colors.muted;
                                font-size: 9px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: Lang.t("v1 plugins: <name>/plugin.toml. runtime=\"process\" keeps a JSON-Lines host (2s handshake, 10s command timeout, 2 restarts); runtime absent/oneshot runs per command/event. Commands appear in the Palette; status providers show one bottom-bar line; [contributes] theme adds a declarative TOML theme. Permissions are declaration-only: plugins are still unsandboxed user processes. Changing enabled requires a restart.", "v1 插件：<name>/plugin.toml。runtime=\"process\" 保持 JSON-Lines 常驻宿主（2s 握手、10s 命令超时、最多重启 2 次）；缺省 runtime/oneshot 按命令/事件运行。命令出现在命令面板；状态提供者在底栏显示一行；[contributes] theme 添加声明式 TOML 主题。权限仅为声明：插件仍是未沙箱化的用户进程。更改启用状态需要重启。");
                                color: Palette.colors.muted;
                                font-size: 9px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // ---------------- Vault ----------------
                if root.settings-category == 6 : Flickable {
                    x: settings-body.content-x;
                    y: settings-body.content-y;
                    width: settings-body.content-w;
                    height: settings-body.content-h;
                    property <int> jump-token: root.settings-jump-token;
                    interactive: true;
                    content-width: self.width;
                    content-height: vault-layout.preferred-height + 10px;

                    changed jump-token => {
                        if (root.settings-focus == "vault") {
                            self.content-y = 0px;
                        }
                    }

                    vault-layout := VerticalLayout {
                        width: 100%;
                        spacing: 10px;

                        vault-card := SettingsCard {
                            title: Lang.t("Vault", "保险库");
                            description: Lang.t("Local encrypted credential store for SSH passwords.", "SSH 密码的本地加密凭据存储。");
                            highlighted: root.settings-focus == "vault";

                            Text {
                                text: Lang.t("Status: \{root.vault-status}", "状态：\{root.vault-status}");
                                color: Palette.colors.text;
                                font-size: 12px;
                            }
                            if root.vault-busy : Text {
                                text: Lang.t("Argon2id KDF runs on a background thread — this page stays responsive.", "Argon2id 密钥派生在后台线程运行 — 本页保持响应。");
                                color: Palette.colors.accent;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: root.vault-path;
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            SettingField {
                                label: Lang.t("Master password", "主密码");
                                SettingsTextField {
                                    text <=> root.vault-password;
                                    placeholder: Lang.t("Master password", "主密码");
                                    masked: true;
                                    accepted(t) => { root.vault-unlock(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Set / Change", "设置 / 更改");
                                    font-size: 10px;
                                    clicked => { root.vault-set-master(); }
                                }
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Unlock", "解锁");
                                    font-size: 10px;
                                    clicked => { root.vault-unlock(); }
                                }
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Lock", "锁定");
                                    font-size: 10px;
                                    clicked => { root.vault-lock(); }
                                }
                                ActionBtn {
                                    horizontal-stretch: 1;
                                    label: Lang.t("Clear", "清除");
                                    font-size: 10px;
                                    danger: true;
                                    clicked => { root.vault-clear(); }
                                }
                            }
                            if root.vault-error != "" : Text {
                                text: root.vault-error;
                                color: Palette.colors.danger;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            if root.vault-notice != "" : Text {
                                text: root.vault-notice;
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: Lang.t("The master password is only used for Argon2id key derivation; it never touches disk or logs. vault.enc is 0600 and written atomically. Clear must be clicked twice.", "主密码只用于 Argon2id 密钥派生；绝不写入磁盘或日志。vault.enc 权限为 0600 并以原子方式写入。清除需要点击两次。");
                                color: Palette.colors.subtext;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: Lang.t("SSH password auth: saved passwords are injected through askpass after unlock. MVP caveat: askpass passes the secret via environment, observable by the same user in /proc — see docs/VAULT.md.", "SSH 密码认证：解锁后保存的密码通过 askpass 注入。MVP 限制：askpass 通过环境变量传递密钥，同一用户可在 /proc 中看到 — 见 docs/VAULT.md。");
                                color: Palette.colors.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // ---------------- 搜索结果浮层 ----------------
                if root.settings-query != "" : Rectangle {
                    x: settings-body.content-x;
                    y: settings-body.content-y;
                    width: settings-body.content-w;
                    height: Math.min(settings-body.content-h,
                        58px + root.settings-results.length * 30px);
                    background: Palette.colors.raise;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Palette.colors.accent;
                    drop-shadow-blur: 18px;
                    drop-shadow-offset-y: 6px;
                    drop-shadow-color: #000000b0;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 2px;

                        Text {
                            height: 28px;
                            text: root.settings-results.length == 0
                                ? Lang.t("No matches", "无匹配")
                                : (root.settings-results.length == 1
                                    ? Lang.t("1 match — click to jump", "1 个结果 — 点击跳转")
                                    : Lang.t("\{root.settings-results.length} matches — click to jump", "\{root.settings-results.length} 个结果 — 点击跳转"));
                            color: Palette.colors.muted;
                            font-size: 10px;
                            vertical-alignment: center;
                        }

                        Flickable {
                            width: 100%;
                            height: parent.height - 34px;
                            interactive: true;
                            content-width: self.width;
                            content-height: root.settings-results.length * 30px;

                            VerticalLayout {
                                width: 100%;
                                spacing: 0px;
                                for item[i] in root.settings-results : Rectangle {
                                    height: 30px;
                                    border-radius: 5px;
                                    background: search-result-hit.has-hover
                                        ? Palette.colors.hover
                                        : transparent;
                                    Text {
                                        x: 8px;
                                        width: parent.width - 16px;
                                        height: parent.height;
                                        text: item;
                                        color: Palette.colors.text;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    search-result-hit := TouchArea {
                                        clicked => { root.settings-open-result(i); }
                                    }
                                }
                            }
                        }
                    }
                }

                // 主题下拉的点击外部关闭层（只覆盖内容区；sidebar 仍可切分类）。
                if root.settings-theme-open && root.settings-category == 0 : Rectangle {
                    x: settings-body.content-x;
                    y: settings-body.content-y;
                    width: settings-body.content-w;
                    height: settings-body.content-h;
                    background: transparent;
                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.settings-theme-open = false; }
                    }
                }

                // 主题下拉：面板级浮层，避免被 Flickable 裁剪；不依赖 PopupWindow。
                if root.settings-theme-open && root.settings-category == 0 : Rectangle {
                    x: settings-body.content-x + 14px;
                    y: settings-body.content-y + 256px;
                    width: Math.min(320px, settings-body.content-w - 28px);
                    height: Math.min(260px, root.theme-choices.length * 30px + 10px);
                    background: Palette.colors.raise;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: Palette.colors.accent;
                    drop-shadow-blur: 18px;
                    drop-shadow-offset-y: 6px;
                    drop-shadow-color: #000000b0;

                    Flickable {
                        width: 100%;
                        height: 100%;
                        interactive: true;
                        content-width: self.width;
                        content-height: root.theme-choices.length * 30px + 8px;

                        VerticalLayout {
                            x: 4px;
                            y: 4px;
                            width: parent.width - 8px;
                            spacing: 1px;

                            for choice[i] in root.theme-choices : Rectangle {
                                height: 28px;
                                border-radius: 5px;
                                background: choice.id == root.theme-name
                                    ? Palette.colors.accent
                                    : (theme-pick.has-hover ? Palette.colors.hover : transparent);
                                theme-pick := TouchArea {
                                    clicked => {
                                        root.set-theme(choice.id);
                                        root.settings-theme-open = false;
                                    }
                                }
                                Text {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: parent.height;
                                    text: choice.label;
                                    color: choice.id == root.theme-name
                                        ? Palette.colors.accent-text
                                        : Palette.colors.text;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }
    }


    // profiles-open 的遮罩：点外部（左右键都行）关闭
    if root.profiles-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000040;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.profiles-open = false;
                    root.profiles-close();
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }
    }

    if root.profiles-open : Rectangle {
        x: (root.width - 420px) / 2;
        y: (root.height - 404px) / 2;
        width: 420px;
        height: 404px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        // 吃掉面板内空白处的点击，避免穿透到遮罩把面板关掉；
        // 右键直接关闭面板（面板内没有右键菜单）。
        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.right) {
                    root.profiles-open = false; root.profiles-close();
                }
                EventResult.accept
            }
        }

        Text {
            x: 16px; y: 10px;
            text: Lang.t("Profiles", "配置");
            color: Palette.colors.text;
            font-size: 15px;
            font-weight: 600;
        }

        // 搜索框：输入即过滤，× 或 Esc 清空后恢复完整列表。
        Rectangle {
            x: 16px; y: 38px;
            width: 388px; height: 28px;
            border-radius: 5px;
            background: Palette.colors.bg;
            border-width: 1px;
            border-color: Palette.colors.border;

            TextInput {
                x: 8px;
                width: parent.width - 40px;
                height: parent.height;
                text <=> root.profile-query;
                single-line: true;
                color: Palette.colors.text;
                font-size: 11px;
                vertical-alignment: center;
                init => { self.focus(); }
                edited => { root.profile-filter(self.text); }
                key-pressed(event) => {
                    if (event.text == "\u{1b}") {
                        if (root.profile-query != "") {
                            root.profile-query = "";
                            root.profile-filter("");
                        } else {
                            root.profiles-open = false;
                            root.profiles-close();
                        }
                        return EventResult.accept;
                    }
                    EventResult.reject
                }
            }

            // 占位提示放在 TextInput 之后（上层），空查询时可见。
            Text {
                x: 8px;
                width: parent.width - 40px;
                height: parent.height;
                text: Lang.t("Search name / host / kind…", "搜索名称 / 主机 / 类型…");
                color: Palette.colors.muted;
                font-size: 11px;
                vertical-alignment: center;
                visible: root.profile-query == "";
            }

            if root.profile-query != "" : Rectangle {
                x: parent.width - 26px;
                y: 4px;
                width: 20px; height: 20px;
                border-radius: 4px;
                background: prof-search-clear.has-hover ? Palette.colors.hover : transparent;

                Text {
                    text: "×";
                    color: Palette.colors.muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }

                prof-search-clear := TouchArea {
                    clicked => {
                        root.profile-query = "";
                        root.profile-filter("");
                    }
                }
            }
        }

        Rectangle {
            x: 16px; y: 74px;
            width: 388px; height: 1px;
            background: Palette.colors.border;
        }

        // 列表放进 Flickable：过滤后仍可能超过一屏，滚动而不是撑破面板。
        Flickable {
            x: 16px; y: 84px;
            width: 388px; height: 208px;
            interactive: true;
            content-width: self.width;
            content-height: root.profile-items.length * 34px;

            VerticalLayout {
                width: parent.width;
                spacing: 4px;

                for item[i] in root.profile-items : Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    background: profile-pick-hit.has-hover ? Palette.colors.hover : transparent;

                    Text {
                        x: 30px;
                        width: parent.width - 114px;
                        text: item.label;
                        color: Palette.colors.text;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    profile-pick-hit := TouchArea {
                        clicked => { root.profile-open(i); }
                    }

                    // 星标：★ = 新 Tab 默认 Profile；点击切换/取消。
                    Rectangle {
                        x: 2px; y: 3px;
                        width: 24px; height: 24px;
                        border-radius: 4px;
                        background: prof-star-hit.has-hover ? Palette.colors.hover : transparent;

                        Text {
                            text: item.is-default ? "★" : "☆";
                            color: item.is-default ? Palette.colors.accent : Palette.colors.muted;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        prof-star-hit := TouchArea {
                            clicked => { root.profile-set-default(i); }
                        }
                    }

                    // Duplicate：复制该行 Profile（名字自动 `(copy N)` 去重）。
                    Rectangle {
                        x: parent.width - 82px; y: 3px;
                        width: 30px; height: 24px;
                        border-radius: 4px;
                        background: prof-dup-hit.has-hover ? Palette.colors.hover : transparent;

                        Text {
                            text: Lang.t("Dup", "复制");
                            color: Palette.colors.muted;
                            font-size: 9px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        prof-dup-hit := TouchArea {
                            clicked => { root.profile-duplicate(i); }
                        }
                    }

                    Rectangle {
                        x: parent.width - 52px;
                        y: 3px;
                        width: 22px;
                        height: 24px;
                        border-radius: 4px;
                        background: prof-edit-hit.has-hover ? Palette.colors.hover : transparent;

                        Text {
                            text: "✎";
                            color: Palette.colors.muted;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        prof-edit-hit := TouchArea {
                            clicked => { root.profile-edit(i); }
                        }
                    }

                    Rectangle {
                        x: parent.width - 26px;
                        y: 3px;
                        width: 22px;
                        height: 24px;
                        border-radius: 4px;
                        background: prof-del-hit.has-hover ? Palette.colors.danger : transparent;

                        Text {
                            text: "×";
                            color: prof-del-hit.has-hover ? Palette.colors.bg : Palette.colors.muted;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        prof-del-hit := TouchArea {
                            clicked => { root.profile-delete(i); }
                        }
                    }
                }
            }
        }

        // 空列表提示区分「没有 Profile」与「搜索无命中」。
        Text {
            x: 16px; y: 150px;
            width: 388px;
            text: Lang.t("No profiles yet — click New Profile to create one", "还没有配置 — 点击“新建配置”创建一个");
            color: Palette.colors.muted;
            font-size: 11px;
            horizontal-alignment: center;
            wrap: word-wrap;
            visible: root.profile-items.length == 0 && root.profile-query == "";
        }

        Text {
            x: 16px; y: 150px;
            width: 388px;
            text: Lang.t("No profiles match the search", "没有匹配的配置");
            color: Palette.colors.muted;
            font-size: 11px;
            horizontal-alignment: center;
            wrap: word-wrap;
            visible: root.profile-items.length == 0 && root.profile-query != "";
        }

        Text {
            x: 16px; y: 297px;
            width: 388px;
            text: Lang.t("Click to open · ★ default for new tabs · Dup = duplicate", "点击打开 · ★ 新标签默认 · 复制=复制");
            color: Palette.colors.muted;
            font-size: 10px;
            horizontal-alignment: center;
        }

        Rectangle {
            x: 16px; y: 320px; width: 120px; height: 28px; border-radius: 6px;
            background: prof-save-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            prof-save-hit := TouchArea {
                clicked => { root.profile-new(); }
            }
            Text {
                text: Lang.t("New Profile", "新建配置");
                color: Palette.colors.text;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Rectangle {
            x: 324px; y: 320px; width: 80px; height: 28px; border-radius: 6px;
            background: prof-close-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            prof-close-hit := TouchArea {
                clicked => { root.profiles-open = false; root.profiles-close(); }
            }
            Text {
                text: Lang.t("Close", "关闭");
                color: Palette.colors.text;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        // 新 Tab 默认行为提示（由 Rust 按 config.default_profile_id 解析后下发）。
        Text {
            x: 16px; y: 368px;
            width: 388px;
            text: root.profile-default-info;
            color: Palette.colors.subtext;
            font-size: 11px;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    if root.profile-form-open : Rectangle {
        x: (root.width - 440px) / 2;
        // local/serial/telnet 用紧凑高度；SSH 展开 password/转发/跳板时需要更高。
        property <length> form-h: root.form-kind == 1 ? 700px : 440px;
        y: (root.height - form-h) / 2 < 8px ? 8px : (root.height - form-h) / 2;
        width: 440px;
        height: form-h;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        // 绝对定位：切换类型时字段数量变化，布局不会整体位移（否则自动化/点击都不稳）
        Text {
            x: 16px;
            y: 14px;
            text: root.form-edit-id < 0 ? Lang.t("New Profile", "新建配置") : Lang.t("Edit Profile", "编辑配置");
            color: Palette.colors.text;
            font-size: 15px;
            font-weight: 600;
        }

        HorizontalLayout {
            x: 16px;
            y: 44px;
            width: 408px;
            height: 24px;
            spacing: 8px;

            ChoiceBtn {
                width: 92px; height: 24px; font-size: 11px;
                label: Lang.t("Local", "本地"); active: root.form-kind == 0;
                clicked => { root.form-kind = 0; root.form-error = ""; }
            }
            ChoiceBtn {
                width: 92px; height: 24px; font-size: 11px;
                label: "SSH"; active: root.form-kind == 1;
                clicked => { root.form-kind = 1; root.form-error = ""; }
            }
            ChoiceBtn {
                width: 92px; height: 24px; font-size: 11px;
                label: Lang.t("Serial", "串口"); active: root.form-kind == 2;
                clicked => { root.form-kind = 2; root.form-error = ""; }
            }
            ChoiceBtn {
                width: 92px; height: 24px; font-size: 11px;
                label: "Telnet"; active: root.form-kind == 3;
                clicked => { root.form-kind = 3; root.form-error = ""; }
            }
        }

        FormRow {
            x: 16px; y: 80px; width: 408px; height: 26px;
            label: Lang.t("Name", "名称"); text <=> root.form-name;
        }

        if root.form-kind == 0 : VerticalLayout {
            x: 16px; y: 116px; width: 408px; height: 130px;
            spacing: 12px;
            FormRow { label: "Shell"; text <=> root.form-shell; }
            FormRow { label: Lang.t("Args", "参数"); text <=> root.form-args; }
            FormRow { label: Lang.t("Cwd", "工作目录"); text <=> root.form-cwd; }
        }

        if root.form-kind == 1 : VerticalLayout {
            x: 16px; y: 116px; width: 408px; height: 380px;
            spacing: 5px;
            FormRow { label: Lang.t("Host", "主机"); text <=> root.form-host; }
            FormRow { label: Lang.t("Port", "端口"); text <=> root.form-port; }
            FormRow { label: Lang.t("User", "用户名"); text <=> root.form-user; }
            FormRow { label: Lang.t("Auth", "认证"); text <=> root.form-auth; }
            FormRow { label: Lang.t("Key", "密钥"); text <=> root.form-key; }
            if root.form-auth == "password" : VerticalLayout {
                spacing: 5px;
                FormRow {
                    label: Lang.t("Password", "密码");
                    text <=> root.form-password;
                    masked: true;
                }
                ToggleRow {
                    label: Lang.t("Save password to Vault", "保存密码到保险库");
                    on: root.form-save-password;
                    toggled => { root.form-save-password = !root.form-save-password; }
                }
            }
            FormRow { label: Lang.t("Jump", "跳板"); text <=> root.form-proxy-jump; }
            FormRow { label: Lang.t("R-Forwards", "远程转发"); text <=> root.form-remote-forwards; }
            FormRow { label: Lang.t("D-Forwards", "动态转发"); text <=> root.form-dynamic-forwards; }
            ToggleRow {
                label: Lang.t("Agent forwarding (-A)", "代理转发（-A）");
                on: root.form-agent-forward;
                toggled => { root.form-agent-forward = !root.form-agent-forward; }
            }
            FormRow { label: Lang.t("Extra", "额外参数"); text <=> root.form-extra; }
            FormRow { label: Lang.t("L-Forwards", "本地转发"); text <=> root.form-forwards; }
        }

        if root.form-kind == 2 : VerticalLayout {
            x: 16px; y: 116px; width: 408px; height: 80px;
            spacing: 12px;
            FormRow { label: Lang.t("Serial", "串口"); text <=> root.form-serial-port; }
            FormRow { label: Lang.t("Baud", "波特率"); text <=> root.form-baud; }
        }

        if root.form-kind == 3 : VerticalLayout {
            x: 16px; y: 116px; width: 408px; height: 80px;
            spacing: 12px;
            FormRow { label: Lang.t("Host", "主机"); text <=> root.form-host; }
            FormRow { label: Lang.t("Port", "端口"); text <=> root.form-port; }
        }

        // 外观覆盖（所有类型共用；空 = 继承全局 Config）。
        // 绝对定位在不同类型间固定：local 在字段下方，SSH 留出 password 展开空间。
        VerticalLayout {
            x: 16px;
            y: root.form-kind == 0 ? 232px : (root.form-kind == 1 ? 510px : 196px);
            width: 408px;
            height: 110px;
            spacing: 6px;

            Text {
                height: 14px;
                text: Lang.t("Appearance · empty = inherit global", "外观 · 留空 = 继承全局");
                color: Palette.colors.subtext;
                font-size: 11px;
                vertical-alignment: center;
            }
            HorizontalLayout {
                height: 26px;
                spacing: 12px;
                FormRow {
                    width: 198px;
                    label-width: 64px;
                    label: Lang.t("Font", "字号"); text <=> root.form-font-size;
                }
                FormRow {
                    width: 198px;
                    label-width: 64px;
                    label: Lang.t("History", "历史"); text <=> root.form-scrollback;
                }
            }
            HorizontalLayout {
                height: 26px;
                spacing: 12px;
                FormRow {
                    width: 198px;
                    label-width: 64px;
                    label: Lang.t("Cursor", "光标"); text <=> root.form-cursor-shape;
                }
                FormRow {
                    width: 198px;
                    label-width: 64px;
                    label: Lang.t("Blink", "闪烁"); text <=> root.form-cursor-blink;
                }
            }
            FormRow {
                height: 26px;
                label: Lang.t("Theme", "主题"); text <=> root.form-theme;
            }
        }

        Text {
            x: 16px;
            y: form-h - 82px;
            width: 408px;
            text: root.form-error;
            color: Palette.colors.danger;
            font-size: 11px;
            wrap: word-wrap;
        }

        Rectangle {
            x: 252px; y: form-h - 50px; width: 80px; height: 28px; border-radius: 6px;
            background: form-cancel-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            form-cancel-hit := TouchArea {
                clicked => { root.profile-form-open = false; root.profile-form-cancel(); }
            }
            Text {
                text: Lang.t("Cancel", "取消");
                color: Palette.colors.text;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Rectangle {
            x: 340px; y: form-h - 50px; width: 80px; height: 28px; border-radius: 6px;
            background: form-save-hit.has-hover ? Palette.colors.danger : Palette.colors.accent;
            form-save-hit := TouchArea {
                clicked => { root.profile-form-save(); }
            }
            Text {
                text: Lang.t("Save", "保存");
                color: Palette.colors.accent-text;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
    }

    // known_hosts 主机密钥预检：首次连接 / 密钥变更时明确提示，绝不静默信任。
    if root.hostkey-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000040;
    }

    if root.hostkey-open : Rectangle {
        x: (root.width - 520px) / 2;
        y: (root.height - 470px) / 2 < 8px ? 8px : (root.height - 470px) / 2;
        width: 520px;
        height: 470px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        Text {
            x: 18px; y: 14px; width: 484px; height: 24px;
            text: root.hostkey-title;
            color: root.hostkey-mode == "changed" ? Palette.colors.danger : Palette.colors.text;
            font-size: 15px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            x: 16px; y: 46px; width: 488px; height: 300px;
            background: Palette.colors.bg;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.colors.border;

            Text {
                x: 10px; y: 8px; width: 468px; height: 284px;
                text: root.hostkey-detail;
                color: Palette.colors.subtext;
                font-size: 11px;
                wrap: word-wrap;
                overflow: elide;
            }
        }

        if root.hostkey-error != "" : Text {
            x: 18px; y: 352px; width: 484px; height: 30px;
            text: root.hostkey-error;
            color: Palette.colors.danger;
            font-size: 11px;
            wrap: word-wrap;
            overflow: elide;
        }

        if root.hostkey-mode != "checking" : Rectangle {
            x: 18px; y: 410px; width: 150px; height: 28px; border-radius: 6px;
            background: hk-cancel-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            hk-cancel-hit := TouchArea {
                clicked => { root.hostkey-cancel(); }
            }
            Text {
                text: root.hostkey-mode == "unverifiable" ? Lang.t("Cancel", "取消") : Lang.t("Cancel", "取消");
                color: Palette.colors.text;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        if root.hostkey-mode == "unknown" || root.hostkey-mode == "changed" : Rectangle {
            x: 180px; y: 410px; width: 140px; height: 28px; border-radius: 6px;
            background: hk-once-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            hk-once-hit := TouchArea {
                clicked => { root.hostkey-once(); }
            }
            Text {
                text: "Once in terminal";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        if root.hostkey-mode == "unverifiable" : Rectangle {
            x: 180px; y: 410px; width: 160px; height: 28px; border-radius: 6px;
            background: hk-continue-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            hk-continue-hit := TouchArea {
                clicked => { root.hostkey-once(); }
            }
            Text {
                text: "Continue (terminal)";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        if root.hostkey-mode == "unknown" || root.hostkey-mode == "changed" : Rectangle {
            x: 330px; y: 410px; width: 172px; height: 28px; border-radius: 6px;
            background: hk-trust-hit.has-hover ? Palette.colors.danger : Palette.colors.accent;
            hk-trust-hit := TouchArea {
                clicked => { root.hostkey-trust(); }
            }
            Text {
                text: root.hostkey-mode == "changed" ? "Update key & connect" : "Trust & connect";
                color: Palette.colors.accent-text;
                font-size: 11px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        if root.hostkey-mode == "checking" : Rectangle {
            x: 340px; y: 410px; width: 162px; height: 28px; border-radius: 6px;
            background: hk-checking-cancel.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            hk-checking-cancel := TouchArea {
                clicked => { root.hostkey-cancel(); }
            }
            Text {
                text: Lang.t("Cancel", "取消");
                color: Palette.colors.text;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
    }

    // SSH 会话结束：小横幅（不遮终端内容，可重连/关闭）。
    if root.ssh-exit-open : Rectangle {
        x: root.width - 500px;
        y: 52px;
        width: 484px;
        height: 92px;
        background: Palette.colors.raise;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.colors.danger;
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #00000080;

        Text {
            x: 14px; y: 8px; width: 456px; height: 20px;
            text: "SSH session ended";
            color: Palette.colors.danger;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            x: 14px; y: 30px; width: 456px; height: 26px;
            text: root.ssh-exit-text;
            color: Palette.colors.text;
            font-size: 11px;
            wrap: word-wrap;
            overflow: elide;
        }
        Rectangle {
            x: 270px; y: 58px; width: 92px; height: 24px; border-radius: 5px;
            background: ssh-exit-dismiss-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            ssh-exit-dismiss-hit := TouchArea { clicked => { root.ssh-exit-dismiss(); } }
            Text {
                text: "Dismiss";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
        if root.ssh-exit-reconnectable : Rectangle {
            x: 372px; y: 58px; width: 98px; height: 24px; border-radius: 5px;
            background: ssh-exit-reconnect-hit.has-hover ? Palette.colors.danger : Palette.colors.accent;
            ssh-exit-reconnect-hit := TouchArea { clicked => { root.ssh-exit-reconnect(); } }
            Text {
                text: "Reconnect";
                color: Palette.colors.accent-text;
                font-size: 11px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
    }

    // sftp-open 的遮罩：点外部（左右键都行）关闭
    if root.sftp-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000040;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    if (!root.sftp-transfer-active) {
                        root.sftp-open = false;
                        root.sftp-close();
                    }
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }
    }

    if root.sftp-open : Rectangle {
        x: (root.width - 480px) / 2;
        y: (root.height - 610px) / 2 < 8px ? 8px : (root.height - 610px) / 2;
        width: 480px;
        height: 610px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        // 吃掉面板内空白处的点击，避免穿透到遮罩把面板关掉；
        // 右键直接关闭面板（面板内没有右键菜单）。
        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.right) {
                    root.sftp-open = false; root.sftp-close();
                }
                EventResult.accept
            }
        }

        Text {
            x: 16px; y: 10px;
            text: "SFTP";
            color: Palette.colors.text;
            font-size: 15px;
            font-weight: 600;
        }

        // SSH Profile 选择（只列 SSH 类型）
        HorizontalLayout {
            x: 16px; y: 38px;
            width: 448px; height: 24px;
            spacing: 8px;
            for p[i] in root.sftp-profiles : ChoiceBtn {
                width: 120px; height: 24px; font-size: 11px;
                label: p;
                active: root.sftp-profile == i;
                clicked => { root.sftp-profile = i; }
            }
        }

        FormRow {
            x: 16px; y: 72px; width: 448px; height: 26px;
            label: "Remote"; text <=> root.sftp-remote;
        }

        Rectangle {
            x: 16px; y: 108px; width: 80px; height: 26px; border-radius: 5px;
            background: sftp-list-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-list-hit := TouchArea { clicked => { root.sftp-list(); } }
            Text {
                text: "List";
                color: Palette.colors.text;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Text {
            x: 104px; y: 114px;
            width: 360px;
            text: root.sftp-status;
            color: Palette.colors.muted;
            font-size: 11px;
            overflow: elide;
        }

        // 远端条目列表（固定行高 24px）
        Rectangle {
            x: 16px; y: 142px; width: 448px; height: 150px;
            background: Palette.colors.bg;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.colors.border;

            VerticalLayout {
                x: 2px; y: 2px; width: 444px; height: 146px;
                spacing: 0px;

                for item[i] in root.sftp-items : Rectangle {
                    height: 24px;
                    background: root.sftp-selected == i
                        ? Palette.colors.hover
                        : (row-hit.has-hover ? Palette.colors.surface : transparent);

                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        text: item;
                        color: Palette.colors.text;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    row-hit := TouchArea {
                        clicked => { root.sftp-pick(i); }
                    }
                }
            }
        }

        FormRow {
            x: 16px; y: 300px; width: 448px; height: 26px;
            label: "Target"; text <=> root.sftp-target;
        }

        FormRow {
            x: 16px; y: 332px; width: 448px; height: 26px;
            label: Lang.t("Local", "本地"); text <=> root.sftp-local;
        }

        FormRow {
            x: 16px; y: 364px; width: 200px; height: 26px;
            label: "Mode"; text <=> root.sftp-mode;
        }

        Rectangle {
            x: 240px; y: 364px; width: 90px; height: 24px; border-radius: 5px;
            background: sftp-chmod-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-chmod-hit := TouchArea { clicked => { root.sftp-chmod(); } }
            Text {
                text: "Chmod";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        // 第一行操作：传输类（允许在传输中继续入队）。
        Rectangle {
            x: 16px; y: 398px; width: 148px; height: 24px; border-radius: 5px;
            background: sftp-get-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-get-hit := TouchArea { clicked => { root.sftp-download(); } }
            Text {
                text: "Download selected";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Rectangle {
            x: 172px; y: 398px; width: 80px; height: 24px; border-radius: 5px;
            background: sftp-put-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-put-hit := TouchArea { clicked => { root.sftp-upload(); } }
            Text {
                text: "Upload";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        if root.sftp-retry-available : Rectangle {
            x: 260px; y: 398px; width: 70px; height: 24px; border-radius: 5px;
            background: sftp-retry-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-retry-hit := TouchArea { clicked => { root.sftp-retry(); } }
            Text {
                text: "Retry";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Rectangle {
            x: 384px; y: 398px; width: 80px; height: 24px; border-radius: 5px;
            background: sftp-del-hit.has-hover ? Palette.colors.danger : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-del-hit := TouchArea { clicked => { root.sftp-delete(); } }
            Text {
                text: Lang.t("Delete", "删除");
                color: sftp-del-hit.has-hover ? Palette.colors.bg : Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        // 第二行操作：元数据（远端操作进行中由 Rust 侧拒绝并发）。
        Rectangle {
            x: 16px; y: 430px; width: 80px; height: 24px; border-radius: 5px;
            background: sftp-mkdir-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-mkdir-hit := TouchArea { clicked => { root.sftp-mkdir(); } }
            Text {
                text: "New Dir";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Rectangle {
            x: 104px; y: 430px; width: 80px; height: 24px; border-radius: 5px;
            background: sftp-rename-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-rename-hit := TouchArea { clicked => { root.sftp-rename(); } }
            Text {
                text: Lang.t("Rename", "重命名");
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Rectangle {
            x: 192px; y: 430px; width: 96px; height: 24px; border-radius: 5px;
            background: sftp-clearq-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-clearq-hit := TouchArea { clicked => { root.sftp-clear-queue(); } }
            Text {
                text: "Clear queue";
                color: root.sftp-queue-count > 0 ? Palette.colors.text : Palette.colors.muted;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Rectangle {
            x: 384px; y: 430px; width: 80px; height: 24px; border-radius: 5px;
            background: sftp-close-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            sftp-close-hit := TouchArea { clicked => { root.sftp-open = false; root.sftp-close(); } }
            Text {
                text: Lang.t("Close", "关闭");
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        // 上传/下载队列（最多 3 行 + 失败重试行；完整计数在标题里）。
        Rectangle {
            x: 16px; y: 464px; width: 448px; height: 68px;
            background: Palette.colors.bg;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.colors.border;

            VerticalLayout {
                x: 8px; y: 4px; width: 432px; height: 60px;
                spacing: 1px;
                Text {
                    height: 15px;
                    text: "Queue (\{root.sftp-queue-count}) · completed transfers leave this list";
                    color: Palette.colors.subtext;
                    font-size: 10px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                for q[i] in root.sftp-queue : Text {
                    height: 14px;
                    text: q;
                    color: Palette.colors.muted;
                    font-size: 10px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // 传输/远端操作进度 + Cancel（取消当前的传输或元数据操作）。
        if root.sftp-transfer-active || root.sftp-op-active : Rectangle {
            x: 16px; y: 540px; width: 448px; height: 54px;

            Text {
                x: 0; y: 0; width: 250px; height: 24px;
                text: root.sftp-transfer-active ? root.sftp-transfer-name : "Remote operation";
                color: Palette.colors.text;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                x: 250px; y: 0; width: 118px; height: 24px;
                text: root.sftp-transfer-active ? root.sftp-transfer-detail : "10s timeout";
                color: Palette.colors.muted;
                font-size: 10px;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }

            Rectangle {
                x: 376px; y: 0; width: 72px; height: 24px; border-radius: 5px;
                background: sftp-cancel-hit.has-hover ? Palette.colors.danger : Palette.colors.raise;
                border-width: 1px;
                border-color: Palette.colors.border;
                sftp-cancel-hit := TouchArea { clicked => { root.sftp-cancel(); } }
                Text {
                    text: Lang.t("Cancel", "取消");
                    color: sftp-cancel-hit.has-hover ? Palette.colors.bg : Palette.colors.danger;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }

            if root.sftp-transfer-active : Rectangle {
                x: 0; y: 30px; width: 448px; height: 8px;
                background: Palette.colors.bg;
                border-radius: 4px;
                border-width: 1px;
                border-color: Palette.colors.border;

                Rectangle {
                    x: 1px; y: 1px;
                    height: parent.height - 2px;
                    width: root.sftp-transfer-percent < 0
                        ? (parent.width - 2px) * 25 / 100
                        : (parent.width - 2px) * root.sftp-transfer-percent / 100;
                    background: root.sftp-transfer-percent < 0
                        ? Palette.colors.muted
                        : Palette.colors.accent;
                    border-radius: 3px;
                }
            }
        }
    }

    // fwd-open 的遮罩：点外部（左右键都行）关闭
    if root.fwd-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000040;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.fwd-open = false;
                    root.fwd-close();
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }
    }

    if root.fwd-open : Rectangle {
        x: (root.width - 460px) / 2;
        y: (root.height - 400px) / 2;
        width: 460px;
        height: 400px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        // 吃掉面板内空白处的点击，避免穿透到遮罩把面板关掉；
        // 右键直接关闭面板（面板内没有右键菜单）。
        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.right) {
                    root.fwd-open = false; root.fwd-close();
                }
                EventResult.accept
            }
        }

        Text {
            x: 16px; y: 10px;
            text: Lang.t("Port Forwards", "端口转发");
            color: Palette.colors.text;
            font-size: 15px;
            font-weight: 600;
        }

        HorizontalLayout {
            x: 16px; y: 38px;
            width: 428px; height: 24px;
            spacing: 8px;
            for p[i] in root.fwd-profiles : ChoiceBtn {
                width: 120px; height: 24px; font-size: 11px;
                label: p;
                active: root.fwd-profile == i;
                clicked => { root.fwd-profile = i; root.fwd-select(i); }
            }
        }

        Text {
            x: 16px; y: 70px;
            width: 428px;
            text: "规则写入 Profile，下次建立 SSH 连接时生效（当前会话需重连）";
            color: Palette.colors.muted;
            font-size: 10px;
            wrap: word-wrap;
        }

        Rectangle {
            x: 16px; y: 94px; width: 428px; height: 196px;
            background: Palette.colors.bg;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.colors.border;

            VerticalLayout {
                x: 2px; y: 2px; width: 424px; height: 192px;
                spacing: 0px;

                for item[i] in root.fwd-items : Rectangle {
                    height: 24px;
                    background: transparent;

                    Text {
                        x: 8px;
                        width: parent.width - 40px;
                        text: item;
                        color: Palette.colors.text;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Rectangle {
                        x: parent.width - 26px;
                        y: 2px;
                        width: 22px;
                        height: 20px;
                        border-radius: 4px;
                        background: fwd-del-hit.has-hover ? Palette.colors.danger : transparent;

                        Text {
                            text: "×";
                            color: fwd-del-hit.has-hover ? Palette.colors.bg : Palette.colors.muted;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        fwd-del-hit := TouchArea {
                            clicked => { root.fwd-delete(i); }
                        }
                    }

                }
            }
        }

        FormRow {
            x: 16px; y: 300px; width: 428px; height: 26px;
            label: "New"; text <=> root.fwd-new;
        }

        Rectangle {
            x: 16px; y: 334px; width: 90px; height: 26px; border-radius: 5px;
            background: fwd-add-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            fwd-add-hit := TouchArea { clicked => { root.fwd-add(); } }
            Text {
                text: "Add rule";
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Text {
            x: 116px; y: 340px;
            width: 236px;
            text: root.fwd-status;
            color: Palette.colors.muted;
            font-size: 10px;
            overflow: elide;
        }

        Rectangle {
            x: 364px; y: 334px; width: 80px; height: 26px; border-radius: 5px;
            background: fwd-close-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
            border-width: 1px;
            border-color: Palette.colors.border;
            fwd-close-hit := TouchArea { clicked => { root.fwd-open = false; root.fwd-close(); } }
            Text {
                text: Lang.t("Close", "关闭");
                color: Palette.colors.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
    }

    // bg-open 的遮罩：点外部（左右键都行）关闭
    if root.bg-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000040;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.bg-open = false;
                    root.bg-close();
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }
    }

    if root.bg-open : Rectangle {
        x: (root.width - 380px) / 2;
        y: (root.height - 300px) / 2;
        width: 380px;
        height: 300px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        // 吃掉面板内空白处的点击，避免穿透到遮罩把面板关掉；
        // 右键直接关闭面板（面板内没有右键菜单）。
        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.right) {
                    root.bg-open = false; root.bg-close();
                }
                EventResult.accept
            }
        }

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            Text {
                text: Lang.t("Background Sessions", "后台会话");
                color: Palette.colors.text;
                font-size: 15px;
                font-weight: 600;
            }

            Rectangle {
                height: 1px;
                horizontal-stretch: 1;
                background: Palette.colors.border;
            }

            for item[i] in root.background-items : Rectangle {
                height: 30px;
                border-radius: 4px;
                background: bg-hit.has-hover ? Palette.colors.hover : transparent;

                Text {
                    x: 8px;
                    width: parent.width - 16px;
                    text: item;
                    color: Palette.colors.text;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                bg-hit := TouchArea {
                    clicked => { root.bg-reattach(i); }
                }
            }

            Text {
                text: root.background-items.length == 0
                    ? "No background sessions"
                    : "Click a session to reattach it in a new tab";
                color: Palette.colors.muted;
                font-size: 11px;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: end;
                Rectangle {
                    width: 80px; height: 28px; border-radius: 6px;
                    background: bg-close-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
                    border-width: 1px;
                    border-color: Palette.colors.border;
                    bg-close-hit := TouchArea {
                        clicked => { root.bg-open = false; root.bg-close(); }
                    }
                    Text {
                        text: Lang.t("Close", "关闭");
                        color: Palette.colors.text;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }
    }

    // Tab 搜索浮层：点外部关闭；输入过滤，↑↓选择，Enter 跳转，Esc 关闭。
    if root.tabsearch-open : Rectangle {
        width: 100%;
        height: 100%;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.tabsearch-open = false;
                    root.tabsearch-cancel();
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }
    }

    if root.tabsearch-open : Rectangle {
        x: 4px;
        y: root.tabbar-bottom
            ? root.height - root.tabbar-height - self.height - 4px
            : root.tabbar-height + 4px;
        width: Math.min(340px, root.width - 8px);
        height: 49px + root.tabsearch-list-height;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;
        clip: true;

        VerticalLayout {
            padding: 8px;
            spacing: 3px;

            TextInput {
                height: 30px;
                text <=> root.tabsearch-query;
                single-line: true;
                color: Palette.colors.text;
                font-size: 13px;
                init => {
                    self.focus();
                    root.tabsearch-scroll-y = 0px;
                }
                edited => {
                    root.tabsearch-query-changed(self.text);
                    // 过滤条件变了，列表回到顶部；选中项由 Rust 重置为 0。
                    root.tabsearch-scroll-y = 0px;
                }
                key-pressed(event) => {
                    if (event.text == "\u{1b}") { root.tabsearch-cancel(); return EventResult.accept; }
                    if (event.text == "\u{F700}") { root.tabsearch-move(-1); return EventResult.accept; }
                    if (event.text == "\u{F701}") { root.tabsearch-move(1); return EventResult.accept; }
                    if (event.text == "\u{a}" || event.text == "\u{d}") { root.tabsearch-accept(); return EventResult.accept; }
                    EventResult.reject
                }
            }

            // 结果多时在面板内部滚动；↑↓ 选中项会自动滚进视口。
            tabsearch-flick := Flickable {
                height: root.tabsearch-list-height;
                content-height: Math.max(26px, root.tabsearch-items.length * 26px);
                content-width: self.width;
                interactive: true;
                property <length> scroll-request: root.tabsearch-scroll-y;
                changed scroll-request => { self.content-y = self.scroll-request; }
                flicked => { root.tabsearch-scroll-y = self.content-y; }

                VerticalLayout {
                    width: tabsearch-flick.width;
                    spacing: 0px;

                    for item[i] in root.tabsearch-items : Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: i == root.tabsearch-selected ? Palette.colors.accent : transparent;
                        animate background { duration: 100ms; }

                        Text {
                            x: 8px;
                            text: item;
                            color: i == root.tabsearch-selected ? Palette.colors.accent-text : Palette.colors.text;
                            font-size: 12px;
                            vertical-alignment: center;
                            width: parent.width - 16px;
                            overflow: elide;
                        }

                        TouchArea {
                            clicked => { root.tabsearch-selected = i; root.tabsearch-pick(i); }
                        }
                    }

                    Rectangle {
                        visible: root.tabsearch-items.length == 0;
                        height: 26px;

                        Text {
                            x: 8px;
                            text: "No matching tabs";
                            color: Palette.colors.muted;
                            font-size: 11px;
                            vertical-alignment: center;
                            width: parent.width - 16px;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        // 空输入时的占位提示；不拦截点击，焦点仍在下面的 TextInput。
        Text {
            x: 12px;
            y: 8px;
            width: parent.width - 24px;
            height: 30px;
            text: "Search tabs";
            color: Palette.colors.muted;
            font-size: 13px;
            vertical-alignment: center;
            visible: root.tabsearch-query == "";
        }
    }

    if root.palette-open : Rectangle {
        x: (root.width - 420px) / 2;
        y: 56px;
        width: 420px;
        height: 348px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        VerticalLayout {
            padding: 10px;
            spacing: 6px;

            TextInput {
                height: 30px;
                text <=> root.palette-query;
                single-line: true;
                color: Palette.colors.text;
                font-size: 14px;
                init => { self.focus(); }
                edited => { root.palette-query-changed(self.text); }
                key-pressed(event) => {
                    if (event.text == "\u{1b}") { root.palette-cancel(); return EventResult.accept; }
                    if (event.text == "\u{F700}") { root.palette-move(-1); return EventResult.accept; }
                    if (event.text == "\u{F701}") { root.palette-move(1); return EventResult.accept; }
                    if (event.text == "\u{a}" || event.text == "\u{d}") { root.palette-accept(); return EventResult.accept; }
                    EventResult.reject
                }
            }

            for item[i] in root.palette-items : Rectangle {
                height: 26px;
                border-radius: 4px;
                background: i == root.palette-selected ? Palette.colors.accent : transparent;

                Text {
                    x: 8px;
                    text: item;
                    color: i == root.palette-selected ? Palette.colors.accent-text : Palette.colors.text;
                    font-size: 13px;
                    vertical-alignment: center;
                    width: parent.width - 16px;
                    overflow: elide;
                }

                TouchArea {
                    clicked => { root.palette-selected = i; root.palette-pick(i); }
                }
            }
        }
    }

    if root.paste-open : Rectangle {
        x: (root.width - 420px) / 2;
        y: (root.height - 200px) / 2;
        width: 420px;
        height: 200px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            Text {
                text: "Paste \{root.paste-lines} lines?";
                color: Palette.colors.text;
                font-size: 15px;
                font-weight: 600;
            }
            Text {
                text: root.paste-preview;
                color: Palette.colors.subtext;
                font-size: 12px;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                Rectangle {
                    width: 84px; height: 28px; border-radius: 6px;
                    background: paste-cancel-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
                    border-width: 1px;
                    border-color: Palette.colors.border;
                    paste-cancel-hit := TouchArea {
                        clicked => { root.paste-open = false; root.paste-cancel(); }
                    }
                    Text {
                        text: Lang.t("Cancel", "取消");
                        color: Palette.colors.text;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                Rectangle {
                    width: 110px; height: 28px; border-radius: 6px;
                    background: paste-always-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
                    border-width: 1px;
                    border-color: Palette.colors.border;
                    paste-always-hit := TouchArea {
                        clicked => { root.paste-open = false; root.paste-always(); }
                    }
                    Text {
                        text: "Always Allow";
                        color: Palette.colors.text;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                Rectangle {
                    width: 84px; height: 28px; border-radius: 6px;
                    background: paste-ok-hit.has-hover ? Palette.colors.danger : Palette.colors.accent;
                    paste-ok-hit := TouchArea {
                        clicked => { root.paste-open = false; root.paste-accept(); }
                    }
                    Text {
                        text: Lang.t("Paste", "粘贴");
                        color: Palette.colors.accent-text;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }
    }

    if root.confirm-open : Rectangle {
        x: (root.width - 340px) / 2;
        y: (root.height - 150px) / 2;
        width: 340px;
        height: 150px;
        background: Palette.colors.raise;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.colors.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000c0;

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            Text {
                text: "Close Tervo?";
                color: Palette.colors.text;
                font-size: 15px;
                font-weight: 600;
            }
            Text {
                text: root.confirm-text;
                color: Palette.colors.subtext;
                font-size: 12px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                Rectangle {
                    width: 88px; height: 28px; border-radius: 6px;
                    background: cancel-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
                    border-width: 1px;
                    border-color: Palette.colors.border;
                    cancel-hit := TouchArea {
                        clicked => { root.confirm-open = false; root.confirm-cancel(); }
                    }
                    Text {
                        text: Lang.t("Cancel", "取消");
                        color: Palette.colors.text;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
                Rectangle {
                    width: 88px; height: 28px; border-radius: 6px;
                    background: ok-hit.has-hover ? Palette.colors.danger : Palette.colors.accent;
                    ok-hit := TouchArea {
                        clicked => { root.confirm-open = false; root.confirm-accept(); }
                    }
                    Text {
                        text: Lang.t("Close", "关闭");
                        color: Palette.colors.accent-text;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }
    }

    if root.rename-open : Rectangle {
        x: 32px;
        y: root.tabbar-height + 8px;
        width: 260px;
        height: 40px;
        background: Palette.colors.raise;
        border-radius: 6px;
        border-width: 1px;
        border-color: Palette.colors.accent;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #000000a8;

        Text {
            x: 10px; y: 4px;
            text: "Rename tab";
            color: Palette.colors.muted;
            font-size: 10px;
        }

        rename-input := TextInput {
            x: 8px;
            y: 16px;
            width: parent.width - 16px;
            height: parent.height - 20px;
            text <=> root.rename-text;
            single-line: true;
            color: Palette.colors.text;
            font-size: 13px;
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == "\u{a}" || event.text == "\u{d}") {
                    root.rename-committed(root.rename-index, self.text);
                    root.rename-open = false;
                    root.focus-terminal();
                    return EventResult.accept;
                }
                if (event.text == "\u{1b}") {
                    root.rename-cancelled();
                    root.rename-open = false;
                    root.focus-terminal();
                    return EventResult.accept;
                }
                EventResult.reject
            }
        }
    }

    if root.search-open : Rectangle {
        x: root.width - 388px;
        y: root.tabbar-height + 8px;
        width: 360px;
        height: 62px;
        background: Palette.colors.raise;
        border-radius: 8px;
        border-width: 1px;
        border-color: root.search-error ? Palette.colors.danger : Palette.colors.accent;
        drop-shadow-blur: 14px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000090;

        // 吃掉查找条内部的空白点击，避免穿透到后面的终端切换焦点/触发选区；
        // 输入框与 FindToggle 是后置子元素，会先拿到各自的鼠标事件。
        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => EventResult.accept;
        }

        VerticalLayout {
            padding: 7px;
            spacing: 4px;

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: "🔍";
                    color: Palette.colors.subtext;
                    font-size: 12px;
                    height: 20px;
                    vertical-alignment: center;
                }
                Rectangle {
                    height: 20px;
                    horizontal-stretch: 1;
                    clip: true;
                    background: transparent;

                    // 空查询占位符画在下面：Text 不接收鼠标事件，点击仍落到输入框。
                    Text {
                        visible: root.search-query == "";
                        text: "Search…";
                        color: Palette.colors.muted;
                        font-size: 13px;
                        height: 100%;
                        vertical-alignment: center;
                    }
                    search-input := TextInput {
                        width: 100%;
                        height: 100%;
                        text <=> root.search-query;
                        single-line: true;
                        color: Palette.colors.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        selection-background-color: Palette.colors.accent;
                        selection-foreground-color: Palette.colors.accent-text;
                        init => { self.focus(); }
                        edited => { root.search-edited(); }
                        key-pressed(event) => {
                            // 拼音/IME 组合中：Enter=上屏候选、Esc=取消，键归输入法，
                            // 不能被搜索下一个/关闭截走（与终端 IME 宿主同策略）。
                            if (self.preedit-text != "") {
                                return EventResult.reject;
                            }
                            if (event.text == "\u{1b}") {
                                root.search-close();
                                return EventResult.accept;
                            }
                            if (event.text == "\u{a}" || event.text == "\u{d}") {
                                root.search-next(!event.modifiers.shift);
                                return EventResult.accept;
                            }
                            // Ctrl+F 在搜索框内全选，仍符合“打开并聚焦”的直觉。
                            if (event.modifiers.control && !event.modifiers.alt
                                && !event.modifiers.shift
                                && (event.text == "f" || event.text == "F"
                                    || event.text == "\u{6}")) {
                                self.select-all();
                                return EventResult.accept;
                            }
                            // 保留 GNOME Terminal 风格的 Alt+C / Alt+R 开关快捷键。
                            if (event.modifiers.alt && !event.modifiers.control
                                && !event.modifiers.shift) {
                                if (event.text == "c" || event.text == "C") {
                                    root.search-toggle-case();
                                    return EventResult.accept;
                                }
                                if (event.text == "r" || event.text == "R") {
                                    root.search-toggle-regex();
                                    return EventResult.accept;
                                }
                            }
                            // 其余按键（字符、方向键、Ctrl+A/C/V、鼠标选区扩展）交给
                            // Slint TextInput 内置编辑逻辑；不会进入终端输入路径。
                            EventResult.reject
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 6px;

                FindToggle {
                    label: "Match case";
                    active: root.search-match-case;
                    toggled => { root.search-toggle-case(); }
                }
                FindToggle {
                    label: "Match regex";
                    active: root.search-regex;
                    toggled => { root.search-toggle-regex(); }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 1px;
                    background: transparent;
                }
                Text {
                    text: root.search-status;
                    color: root.search-error ? Palette.colors.danger : Palette.colors.muted;
                    font-size: 10px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    // Save Contents：没有原生文件对话框，显式路径 + 错误提示的最小实现。
    if root.save-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000080;

        // 吃掉点击，避免穿透到终端误触；不点外部关闭（防误丢已输入路径）。
        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => { EventResult.accept; }
        }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: Math.min(560px, root.width - 24px);
            height: 264px;
            background: Palette.colors.raise;
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.colors.border;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #000000c0;

            VerticalLayout {
                padding: 16px;
                spacing: 9px;

                Text {
                    text: "Save Contents";
                    color: Palette.colors.text;
                    font-size: 15px;
                    font-weight: 600;
                }
                Text {
                    text: "No native file dialog: enter an explicit path (~ is expanded).";
                    color: Palette.colors.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                TextInput {
                    height: 30px;
                    text <=> root.save-path;
                    single-line: true;
                    color: Palette.colors.text;
                    font-size: 13px;
                    init => { self.focus(); }
                    key-pressed(event) => {
                        if (event.text == "\u{a}" || event.text == "\u{d}") {
                            root.save-commit(self.text);
                            return EventResult.accept;
                        }
                        if (event.text == "\u{1b}") {
                            root.save-open = false;
                            root.save-cancel();
                            return EventResult.accept;
                        }
                        EventResult.reject
                    }
                }
                Text {
                    text: root.save-path;
                    color: Palette.colors.subtext;
                    font-size: 10px;
                    wrap: word-wrap;
                }
                Text {
                    text: root.save-status;
                    color: Palette.colors.danger;
                    font-size: 11px;
                    wrap: word-wrap;
                    visible: root.save-status != "";
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 1px;
                    background: transparent;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    Rectangle {
                        width: 88px; height: 28px; border-radius: 6px;
                        background: save-cancel-hit.has-hover ? Palette.colors.hover : Palette.colors.raise;
                        border-width: 1px;
                        border-color: Palette.colors.border;
                        save-cancel-hit := TouchArea {
                            clicked => {
                                root.save-open = false;
                                root.save-cancel();
                            }
                        }
                        Text {
                            text: Lang.t("Cancel", "取消");
                            color: Palette.colors.text;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                    Rectangle {
                        width: 88px; height: 28px; border-radius: 6px;
                        background: Palette.colors.accent;
                        save-ok-hit := TouchArea {
                            clicked => { root.save-commit(root.save-path); }
                        }
                        Text {
                            text: Lang.t("Save", "保存");
                            color: Palette.colors.accent-text;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }
            }
        }
    }

    // 插件状态栏：只显示文本（tooltip/command 由 Rust 保存），不改变终端布局。
    if root.plugin-status != "" : Rectangle {
        x: 8px;
        y: root.tabbar-bottom ? root.height - root.tabbar-height - 24px : root.height - 24px;
        height: 20px;
        width: Math.min(560px, root.width - 16px);
        background: Palette.colors.surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: Palette.colors.border;
        opacity: 0.94;

        Text {
            x: 8px;
            width: parent.width - 16px;
            height: parent.height;
            text: root.plugin-status;
            color: Palette.colors.subtext;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }
        TouchArea {
            clicked => { root.plugin-status-clicked(); }
        }
    }

    // 链接打开失败等短暂提示：不拦截鼠标事件，4 秒后由 Rust 清空。
    if root.link-status != "" : Rectangle {
        x: 12px;
        // 插件状态栏可见时浮层上移，避免盖住状态文本。
        y: root.plugin-status != "" ? root.height - 84px : root.height - 54px;
        width: root.width - 24px;
        height: 36px;
        background: Palette.colors.raise;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.colors.danger;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #000000a8;

        Text {
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            text: root.link-status;
            color: Palette.colors.text;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // ---------------- 无边框窗口拖边/拖角缩放 ----------------
    // 自绘命中区：直接改窗口 size/position，不依赖 WM 的 moveresize。
    ResizeHandle {
        x: 0px; y: 6px; width: 5px; height: root.height - 12px;
        direction: 7;
        mouse-cursor: ew-resize;
        begin(d) => { root.start-window-resize(d); }
        drag => { root.window-resize-drag(); }
        stop => { root.end-window-resize(); }
    }
    ResizeHandle {
        x: root.width - 5px; y: 6px; width: 5px; height: root.height - 12px;
        direction: 3;
        mouse-cursor: ew-resize;
        begin(d) => { root.start-window-resize(d); }
        drag => { root.window-resize-drag(); }
        stop => { root.end-window-resize(); }
    }
    ResizeHandle {
        x: 6px; y: 0px; width: root.width - 12px; height: 5px;
        direction: 1;
        mouse-cursor: ns-resize;
        begin(d) => { root.start-window-resize(d); }
        drag => { root.window-resize-drag(); }
        stop => { root.end-window-resize(); }
    }
    ResizeHandle {
        x: 6px; y: root.height - 5px; width: root.width - 12px; height: 5px;
        direction: 5;
        mouse-cursor: ns-resize;
        begin(d) => { root.start-window-resize(d); }
        drag => { root.window-resize-drag(); }
        stop => { root.end-window-resize(); }
    }
    ResizeHandle {
        x: 0px; y: 0px; width: 8px; height: 8px;
        direction: 0;
        mouse-cursor: nwse-resize;
        begin(d) => { root.start-window-resize(d); }
        drag => { root.window-resize-drag(); }
        stop => { root.end-window-resize(); }
    }
    ResizeHandle {
        x: root.width - 8px; y: 0px; width: 8px; height: 8px;
        direction: 2;
        mouse-cursor: nesw-resize;
        begin(d) => { root.start-window-resize(d); }
        drag => { root.window-resize-drag(); }
        stop => { root.end-window-resize(); }
    }
    ResizeHandle {
        x: 0px; y: root.height - 8px; width: 8px; height: 8px;
        direction: 6;
        mouse-cursor: nesw-resize;
        begin(d) => { root.start-window-resize(d); }
        drag => { root.window-resize-drag(); }
        stop => { root.end-window-resize(); }
    }
    ResizeHandle {
        x: root.width - 8px; y: root.height - 8px; width: 8px; height: 8px;
        direction: 4;
        mouse-cursor: nwse-resize;
        begin(d) => { root.start-window-resize(d); }
        drag => { root.window-resize-drag(); }
        stop => { root.end-window-resize(); }
    }
}
