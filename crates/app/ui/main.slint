    in-out property <string> feedback-text: "";
    in-out property <string> feedback-status: "";
    callback create-feedback();
    in-out property <string> settings-query: "";
    in property <[string]> settings-results: [];
    /// 搜索结果点击后要滚动/高亮的卡片锚点（theme/background/cursor/...）。
    in-out property <string> settings-focus: "";
    /// Rust 每次跳转自增；Slint 在 changed 里把 Flickable 滚到锚点。
