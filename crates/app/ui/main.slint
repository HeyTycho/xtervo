    /// TERVO_SETTINGS_LEGACY=1：退回居中 modal；默认 false = 窗口内 Settings Tab。
    in property <bool> settings-legacy: false;
    callback settings-filter(string);
    callback settings-open-result(int);
    callback settings-category-changed(int);
    callback settings-manage-profiles();
    in property <string> hotkey-summary: "";
    in property <[HotkeyRow]> hotkey-rows: [];
    /// 正在录制的行下标；-1 = 未录制
    in-out property <int> hotkey-recording-row: -1;
    in property <int> hotkey-conflict-count: 0;
    /// 两段录制模式：开 = 先按第一段再按第二段（Enter 保存单段）。
    in-out property <bool> hotkey-record-two: false;
    in-out property <string> hotkey-error: "";
    in-out property <string> hotkey-status: "";
    callback hotkey-start-edit(int);
    callback hotkey-cancel-edit();
    callback hotkey-reset(int);
    callback hotkey-reset-all();
    in property <[PluginRowView]> plugin-rows: [];
    in property <string> plugin-summary: "";
    in property <string> plugin-dir: "";
    // 最近插件命令/事件活动（新→旧，最多 8 条；只读展示）
    in property <[string]> plugin-activity-items: [];
    // 本地安装/更新/回滚路径与签名要求（不访问网络/市场）
    in-out property <string> plugin-install-path: "";
    in-out property <bool> cfg-plugin-require-signature: false;
    callback plugin-pick-install(string);
    callback plugin-install-apply(string, string, string);
    callback toggle-plugin-require-signature();
    // ---- MCP / Privacy：默认开启但默认只读；分组可热更新 ----
    in-out property <bool> cfg-mcp-enabled: true;
    in-out property <bool> cfg-mcp-read: true;
    in-out property <bool> cfg-mcp-input: false;
    in-out property <bool> cfg-mcp-tabs: false;
    in-out property <bool> cfg-mcp-destructive: false;
    in property <string> mcp-socket-path: "";
    in property <string> mcp-token-path: "";
    in property <bool> mcp-active: false;
    in property <string> mcp-status: "";
    callback toggle-mcp-enabled();
    callback toggle-mcp-read();
    callback toggle-mcp-input();
    callback toggle-mcp-tabs();
    callback toggle-mcp-destructive();
    // ---- Plugin API v3：宿主渲染的操作/确认/surface/ask ----
    callback plugin-action(string, string);
    callback plugin-open-surface(string, string);
    in property <bool> plugin-confirm-visible: false;
    in property <string> plugin-confirm-name: "";
    in property <string> plugin-confirm-permissions: "";
    callback plugin-confirm-enable();
    callback plugin-confirm-cancel();
    in property <bool> plugin-surface-open: false;
    in property <string> plugin-surface-title: "";
    in property <string> plugin-surface-error: "";
    in property <bool> plugin-surface-loading: false;
